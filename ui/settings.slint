import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme, Middle, Label } from "theme.slint";
import { ActionButton, IconButton, Avatar, SensitivitySlider } from "controls.slint";
import { DiscordLinkPanel } from "discord.slint";
import { ChannelRow } from "rail.slint";

// Settings: a section's title, a group's heading, a switch with what it does, and
// a row of exclusive choices with the current one raised.
export component SettingsTitle inherits Text {
    color: Theme.text; font-size: 20px; font-weight: 700;
}

export component SettingsHeading inherits Text {
    color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
}

// A marigold switch, with its label beside it and what it does below. A click on
// either, or Space or Enter with the keyboard, toggles it.
export component SettingsSwitch inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: column.preferred-height;
    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    column := VerticalLayout {
        spacing: 4px;
        row := HorizontalLayout {
            spacing: 12px;
            Middle {
                Rectangle {
                    width: 40px; height: 22px; border-radius: 11px;
                    background: !root.enabled ? Theme.field : root.checked ? (pointer.has-hover ? Theme.accent-hover : Theme.accent) : (pointer.has-hover ? Theme.active : Theme.field);
                    border-width: focus.has-focus ? 2px : 1px;
                    border-color: focus.has-focus ? Theme.text : root.checked && root.enabled ? transparent : Theme.line;
                    animate background { duration: Theme.quick; }
                    Rectangle {
                        x: root.checked ? parent.width - self.width - 3px : 3px;
                        width: 16px; height: 16px; border-radius: 8px;
                        background: !root.enabled ? Theme.faint : root.checked ? Theme.on-accent : Theme.secondary;
                        animate x, background { duration: Theme.quick; easing: ease-out; }
                    }
                }
            }
            Text {
                text: root.text; color: root.enabled ? Theme.text : Theme.muted; font-size: 15px;
                vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1;
            }
        }
        if root.description != "": Label { text: root.description; }
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: root.width; height: row.height;
        enabled: root.enabled;
        accessible-role: switch;
        accessible-label: root.text;
        accessible-description: root.description;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-enabled: root.enabled;
        accessible-action-default => { root.toggle(); }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.toggle(); return accept; }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled; mouse-cursor: MouseCursor.pointer;
            clicked => { root.toggle(); }
        }
    }
}

export component Choices inherits Rectangle {
    in property <[string]> options;
    in property <string> label;
    in-out property <int> current;
    callback chosen(int);
    height: 36px; max-width: 360px;
    border-radius: 8px; background: Theme.sunken;
    accessible-role: groupbox;
    accessible-label: root.label;
    HorizontalLayout {
        padding: 3px; spacing: 3px;
        for option[index] in root.options: Rectangle {
            border-radius: 6px;
            background: index == root.current ? Theme.active : choice.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.quick; }
            accessible-role: button;
            accessible-label: index == root.current ? option + ", chosen" : option;
            accessible-action-default => { root.current = index; root.chosen(index); }
            Text {
                text: option; font-size: 14px;
                color: index == root.current ? Theme.text : Theme.secondary;
                font-weight: index == root.current ? 700 : 500;
            }
            choice := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.current = index; root.chosen(index); }
            }
        }
    }
}

// Settings cover the window: sections on the left, the chosen one, given as
// children, on the right. Escape or the close button returns to the conversation.
export component SettingsScreen inherits Rectangle {
    /// The section showing: 0 account, 1 voice and audio, 2 messages,
    /// 3 notifications, 4 Discord.
    in-out property <int> settings-section;
    in property <bool> discord-build;
    in property <bool> preview;
    callback close;
    callback refresh-devices;
    background: Theme.chat;
    accessible-role: groupbox;
    accessible-label: "Settings";
    TouchArea { }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.close(); return accept; }
            return reject;
        }
        HorizontalLayout {
            Rectangle {
                background: Theme.sidebar; horizontal-stretch: 1; min-width: 232px;
                HorizontalLayout {
                    alignment: end;
                    VerticalLayout {
                        width: 232px; padding: 16px; padding-top: 56px; spacing: 2px; alignment: start;
                        HorizontalLayout { padding-left: 8px; padding-bottom: 6px; SettingsHeading { text: "SETTINGS"; } }
                        ChannelRow {
                            text: "My account"; icon: @image-url("icons/user.svg");
                            selected: root.settings-section == 0; clicked => { root.settings-section = 0; }
                        }
                        ChannelRow {
                            text: "Voice & audio"; icon: @image-url("icons/headphones.svg");
                            selected: root.settings-section == 1; clicked => { root.settings-section = 1; root.refresh-devices(); }
                        }
                        ChannelRow {
                            text: "Messages"; icon: @image-url("icons/message-circle.svg");
                            selected: root.settings-section == 2; clicked => { root.settings-section = 2; }
                        }
                        ChannelRow {
                            text: "Notifications"; icon: @image-url("icons/bell.svg");
                            selected: root.settings-section == 3; clicked => { root.settings-section = 3; }
                        }
                        if root.discord-build && !root.preview: ChannelRow {
                            text: "Discord"; icon: @image-url("icons/discord.svg");
                            selected: root.settings-section == 4; clicked => { root.settings-section = 4; }
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 2; min-width: 440px;
                ScrollView {
                    HorizontalLayout {
                        padding-left: 40px; padding-right: 96px; padding-top: 56px; padding-bottom: 56px;
                        VerticalLayout {
                            max-width: 660px; horizontal-stretch: 1; spacing: 16px; alignment: start;
                            @children
                        }
                    }
                }
                VerticalLayout {
                    x: parent.width - 80px; y: 48px; width: 56px; height: self.preferred-height; spacing: 6px;
                    HorizontalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("icons/x.svg"); label: "Close settings"; size: 36px; glyph: 18px; radius: 18px;
                            fill: Theme.raised; clicked => { root.close(); }
                        }
                    }
                    Text { text: "ESC"; color: Theme.muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                }
            }
        }
    }
}

// Settings: who's signed in, and ways to reconnect, set a custom status and sign out.
export component AccountSettings inherits VerticalLayout {
    in property <string> account-name;
    in property <string> account-status;
    in property <string> account-initial;
    in property <color> account-tint;
    in property <image> account-picture;
    in property <string> storage;
    in property <bool> preview;
    in property <bool> online;
    in property <bool> busy;
    in property <bool> sending;
    in property <bool> discord-linked;
    in property <bool> has-custom-status;
    callback retry-sync;
    callback set-custom-status;
    callback sign-out;
    spacing: 16px;
    SettingsTitle { text: "My account"; }
    Rectangle {
        background: Theme.sidebar; border-radius: 8px;
        HorizontalLayout {
            padding: 16px; spacing: 16px;
            Middle { Avatar { size: 64px; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture; } }
            VerticalLayout {
                alignment: center; spacing: 2px; horizontal-stretch: 1;
                Text { text: root.account-name; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; }
                Label { text: root.account-status; wrap: no-wrap; overflow: elide; }
            }
        }
    }
    if root.storage != "": Label { text: root.storage; }
    HorizontalLayout {
        spacing: 8px;
        if !root.preview && !root.online: ActionButton {
            text: "Reconnect"; icon: @image-url("icons/refresh-cw.svg"); enabled: !root.busy;
            clicked => { root.retry-sync(); }
        }
        if root.discord-linked: ActionButton {
            text: root.has-custom-status ? "Change custom status" : "Set a custom status"; icon: @image-url("icons/smile-plus.svg");
            clicked => { root.set-custom-status(); }
        }
        ActionButton {
            text: root.preview ? "Back to sign in" : "Sign out"; icon: @image-url("icons/log-out.svg");
            danger: !root.preview; enabled: !root.busy && !root.sending;
            clicked => { root.sign-out(); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// Settings: the audio devices, and how calls start and sound.
export component VoiceSettings inherits VerticalLayout {
    in property <[string]> microphones;
    in property <[string]> speakers;
    in property <int> microphone-index;
    in property <int> speaker-index;
    in-out property <bool> unmute-on-join;
    in-out property <bool> level-voice;
    /// What suppresses noise in Discord calls: 0 DeepFilterNet, 1 RNNoise, 2
    /// nothing; and how far: 0 full, 1 medium, 2 light.
    in-out property <int> noise-suppression;
    in-out property <int> noise-strength;
    /// The quietest speech Discord calls send, in dBFS; and the microphone as
    /// the voice gate hears it, refreshed while this shows.
    in-out property <int> sensitivity: -60;
    in property <float> gate-level: -100;
    in property <bool> gate-sending;
    /// Why the gate's level can't be shown, if it can't.
    in property <string> gate-meter-note;
    /// Discord is linked, so its calls' noise suppression shows.
    in property <bool> discord;
    callback select-microphone(int);
    callback select-speaker(int);
    callback refresh-devices;
    callback preferences-changed;
    spacing: 16px;
    SettingsTitle { text: "Voice & audio"; }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1;
            SettingsHeading { text: "MICROPHONE"; }
            ComboBox { model: root.microphones; current-index: root.microphone-index; enabled: root.microphones.length > 0; accessible-label: "Microphone device"; selected => { root.select-microphone(self.current-index); } }
        }
        VerticalLayout {
            spacing: 8px; horizontal-stretch: 1;
            SettingsHeading { text: "SPEAKERS"; }
            ComboBox { model: root.speakers; current-index: root.speaker-index; enabled: root.speakers.length > 0; accessible-label: "Speaker device"; selected => { root.select-speaker(self.current-index); } }
        }
    }
    if root.microphones.length == 0 && root.speakers.length == 0: Label { text: "No audio devices found. Connect one, then refresh."; }
    HorizontalLayout {
        ActionButton { text: "Refresh devices"; icon: @image-url("icons/refresh-cw.svg"); ghost: true; small: true; clicked => { root.refresh-devices(); } }
        Rectangle { horizontal-stretch: 1; }
    }
    Rectangle { height: 1px; background: Theme.line; }
    SettingsSwitch {
        text: "Turn on your microphone when you join a call";
        description: "Otherwise you join muted, and unmute when you're ready.";
        checked <=> root.unmute-on-join;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Even out your voice";
        description: "Keeps your voice steady as you lean towards the microphone or away from it. Whispers and shouts still come through as they are.";
        checked <=> root.level-voice;
        toggled => { root.preferences-changed(); }
    }
    if root.discord: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "NOISE SUPPRESSION IN DISCORD CALLS"; }
        Choices {
            label: "Noise suppression in Discord calls"; options: ["DeepFilterNet", "RNNoise", "Off"];
            current <=> root.noise-suppression;
            chosen => { root.preferences-changed(); }
        }
        Label { text: "DeepFilterNet also takes out typing and other sudden noise. RNNoise uses less processing. Off sends your microphone as it is, for a quiet room. A call going on switches straight away."; }
    }
    if root.discord && root.noise-suppression != 2: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "NOISE SUPPRESSION STRENGTH"; }
        Choices {
            label: "Noise suppression strength"; options: ["Full", "Medium", "Light"];
            current <=> root.noise-strength;
            chosen => { root.preferences-changed(); }
        }
        Label { text: "Medium and Light leave a little of the room's sound in, which can sound more natural, and let a little more noise through."; }
    }
    if root.discord: VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "INPUT SENSITIVITY IN DISCORD CALLS"; }
        SensitivitySlider {
            label: "Input sensitivity"; value <=> root.sensitivity;
            level: root.gate-level; sending: root.gate-sending;
            committed => { root.preferences-changed(); }
        }
        Label {
            text: root.gate-meter-note != "" ? root.gate-meter-note
                : "Talk sends your voice when it's louder than the handle, and other sounds when they're 18 dB louder still. The bar is your microphone after noise suppression, as Talk hears it to decide.";
        }
    }
}

// Settings: how messages look, and what they share.
export component MessageSettings inherits VerticalLayout {
    in property <length> message-font-size;
    in-out property <bool> twelve-hour-clock;
    /// Message text: 0 small, 1 default, 2 large.
    in-out property <int> text-size;
    in-out property <bool> link-previews;
    in-out property <bool> share-typing;
    /// The networks in use, which the descriptions name.
    in property <bool> matrix;
    in property <bool> discord;
    callback preferences-changed;
    spacing: 16px;
    SettingsTitle { text: "Messages"; }
    // A message as the chosen text size and clock show it.
    Rectangle {
        border-radius: 8px; border-width: 1px; border-color: Theme.line;
        accessible-role: groupbox; accessible-label: "Preview";
        HorizontalLayout {
            padding: 16px; spacing: 16px;
            VerticalLayout { alignment: start; Avatar { initial: "S"; tint: #c0679a; } }
            VerticalLayout {
                spacing: 3px; horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Sam"; color: Theme.text; font-size: root.message-font-size; font-weight: 700; }
                    Text { text: root.twelve-hour-clock ? "9:41 PM" : "21:41"; color: Theme.muted; font-size: root.message-font-size - 3px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                Text { text: "Thinking co-op after nine, if people are up for it."; color: Theme.text; font-size: root.message-font-size; wrap: word-wrap; }
            }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "TEXT SIZE"; }
        Choices {
            label: "Text size"; options: ["Small", "Default", "Large"];
            current <=> root.text-size;
            chosen => { root.preferences-changed(); }
        }
    }
    VerticalLayout {
        spacing: 8px;
        SettingsHeading { text: "CLOCK"; }
        Choices {
            label: "Clock"; options: ["24-hour", "12-hour"];
            current: root.twelve-hour-clock ? 1 : 0;
            chosen(index) => { root.twelve-hour-clock = index == 1; root.preferences-changed(); }
        }
    }
    Rectangle { height: 1px; background: Theme.line; }
    SettingsSwitch {
        text: "Show link previews";
        description: "Cards for links, videos and bots under messages. Linked pictures still show.";
        checked <=> root.link-previews;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Let others see when you're typing";
        description: (root.matrix && root.discord ? "Discord and Matrix show" : root.matrix ? "Matrix shows" : "Discord shows")
            + " \"typing...\" while you write. Others still show here when they type.";
        checked <=> root.share-typing;
        toggled => { root.preferences-changed(); }
    }
}

// Settings: desktop notifications.
export component NotificationSettings inherits VerticalLayout {
    in-out property <bool> notifications;
    in-out property <bool> notification-sound;
    in-out property <bool> notification-text;
    /// The networks in use, whose rules decide what notifies.
    in property <bool> matrix;
    in property <bool> discord;
    callback preferences-changed;
    spacing: 16px;
    SettingsTitle { text: "Notifications"; }
    SettingsSwitch {
        text: "Show desktop notifications";
        description: "For new messages while Talk isn't in front. "
            + (root.matrix && root.discord ? "Each Discord server's notification settings and your Matrix notification rules decide"
                : root.matrix ? "Your Matrix notification rules decide" : "Each Discord server's notification settings decide")
            + " which: usually DMs and mentions. Clicking one opens the conversation.";
        checked <=> root.notifications;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Play a sound";
        description: "Your desktop's message sound, with each notification.";
        checked <=> root.notification-sound;
        enabled: root.notifications;
        toggled => { root.preferences-changed(); }
    }
    SettingsSwitch {
        text: "Show what messages say";
        description: "Off shows only who wrote and where, for a screen others can see.";
        checked <=> root.notification-text;
        enabled: root.notifications;
        toggled => { root.preferences-changed(); }
    }
}

// Settings: linking a Discord account.
export component DiscordLinkSettings inherits VerticalLayout {
    // Linking Discord by QR code; see DiscordLinkPanel.
    in property <int> link-phase;
    in property <image> link-code;
    in property <string> link-name;
    in property <string> link-note;
    callback link-discord;
    spacing: 16px;
    SettingsTitle { text: "Discord"; }
    Label { text: "Link your Discord account to see its servers and DMs in Talk, and join its calls. The login stays on this computer, in the system's credential store."; }
    DiscordLinkPanel {
        phase: root.link-phase; code: root.link-code; name: root.link-name; note: root.link-note;
        begin => { root.link-discord(); }
    }
}

// Settings: the linked Discord account.
export component DiscordSettings inherits VerticalLayout {
    in property <bool> matrix-build;
    in property <bool> show-hidden-channels;
    in property <bool> sync-discord-reads;
    callback unlink-discord;
    callback show-hidden-channels-toggled(bool);
    callback sync-discord-reads-toggled(bool);
    spacing: 16px;
    SettingsTitle { text: "Discord"; }
    if root.matrix-build: HorizontalLayout {
        spacing: 12px;
        Label { text: "Unlinking signs Talk out of Discord on this computer."; vertical-alignment: center; horizontal-stretch: 1; }
        ActionButton {
            text: "Unlink Discord"; icon: @image-url("icons/log-out.svg"); danger: true;
            clicked => { root.unlink-discord(); }
        }
    }
    SettingsSwitch {
        text: "Show channels you can't access";
        description: "They appear locked. Server admins hid them on purpose.";
        checked: root.show-hidden-channels;
        toggled(shown) => { root.show-hidden-channels-toggled(shown); }
    }
    SettingsSwitch {
        text: "Mark messages read on Discord";
        description: "Channels you read in Talk show as read in the Discord apps too.";
        checked: root.sync-discord-reads;
        toggled(sync) => { root.sync-discord-reads-toggled(sync); }
    }
}
