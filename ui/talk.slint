import { ListView, Palette } from "std-widgets.slint";
// The UI's typeface, Atkinson Hyperlegible Next; ExtraBold serves weight 900.
import "fonts/AtkinsonHyperlegibleNext-Regular.ttf";
import "fonts/AtkinsonHyperlegibleNext-Italic.ttf";
import "fonts/AtkinsonHyperlegibleNext-Medium.ttf";
import "fonts/AtkinsonHyperlegibleNext-Bold.ttf";
import "fonts/AtkinsonHyperlegibleNext-BoldItalic.ttf";
import "fonts/AtkinsonHyperlegibleNext-ExtraBold.ttf";
// The second choice, Satoshi: to switch back, import these instead, set
// `default-font-family` below to "Satoshi", and use Satoshi's metrics in
// src/emoji_font.rs.
// import "fonts/Satoshi-Regular.ttf";
// import "fonts/Satoshi-Italic.ttf";
// import "fonts/Satoshi-Medium.ttf";
// import "fonts/Satoshi-Bold.ttf";
// import "fonts/Satoshi-BoldItalic.ttf";
// import "fonts/Satoshi-Black.ttf";

// Talk's window. Its parts live beside it, by area: theme.slint, controls.slint,
// discord.slint, voice.slint, rail.slint, composer.slint, messages.slint,
// settings.slint, people.slint, friends.slint, dialogs.slint and sign-in.slint.
import { Theme, Tip, Middle } from "theme.slint";
import { ActionButton, IconButton, DeviceToggle, Avatar, TextField, MessagesSkeleton, MenuItem, DeviceMenu, HeaderToggle, Banner } from "controls.slint";
import { PersonRow, VoiceDock, CallInvite, JoinVoice, StreamView, ParticipantGrid, CallControls, IncomingCall, SwitchDialog, InputLevel, ShareMenu, VolumeMenu } from "voice.slint";
import { ServerRow, RoomRow, StatusDot, ServerRail, RoomList } from "rail.slint";
import { StagedFile, StagedTile, Composer, MentionRow, MentionList, EmojiSuggestions, RequestBar } from "composer.slint";
import { EmojiCell, EmojiRow, MessageRow, ReactionToggle, EmojiButton, EmojiPicker, MessageMenu, MessageGallery, MessageStickers, FileCard, EmbedView, BotTag, NoConversation, ConversationStart, HistoryEdge, ImageViewer } from "messages.slint";
import { SettingsScreen, AccountSettings, VoiceSettings, MessageSettings, NotificationSettings, DiscordLinkSettings, DiscordSettings } from "settings.slint";
import { MemberRow, ProfileData, ProfileServerRow, MemberPanel, ProfileCard, ServerCard, RoleCard } from "people.slint";
import { FriendRequestRow, FriendRow, FriendsScreen, HeaderTab, RequestsScreen, AddFriendDialog } from "friends.slint";
import { ContactRow, ForwardRow, StatusDialog, NewDmDialog, ForwardDialog, StatusMenu } from "dialogs.slint";
import { SignInScreen, VerifyBanner } from "sign-in.slint";

// Rust sees these, besides TalkWindow.
export { Badges } from "theme.slint";
export { PersonRow } from "voice.slint";
export { ServerRow, RoomRow } from "rail.slint";
export { StagedFile, MentionRow } from "composer.slint";
export { EmojiCell, EmojiRow, ReactionChip, ImageCell, FileCell, EmbedField, EmbedFieldRow, EmbedCard, MessageRow } from "messages.slint";
export { MemberRow, ProfileRole, ProfileRoleRow, ProfileServerRow, ProfileFriendRow, ProfileData } from "people.slint";
export { FriendRequestRow, FriendRow } from "friends.slint";
export { ContactRow, ForwardRow } from "dialogs.slint";

export component TalkWindow inherits Window {
    title: "Talk";
    preferred-width: 1120px; preferred-height: 760px;
    min-width: 800px; min-height: 560px;
    background: Theme.chat;
    default-font-family: "Atkinson Hyperlegible Next";
    // default-font-family: "Satoshi";
    // Both faces' x-heights are about half their size, small, so text
    // defaults to 16px.
    default-font-size: 16px;
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }
    in property <bool> workspace;
    in property <bool> preview;
    in property <bool> busy;
    in property <bool> trusted;
    in property <bool> online;
    in property <bool> restore-available;
    in property <bool> dms-selected;
    in property <bool> dms-unread;
    in property <string> dms-badge;
    // The dialog for starting a DM: who it found, and whether one is starting.
    // Adding a Discord friend by username: whether the request went, and what to say.
    in property <bool> add-friend-open;
    in property <bool> add-friend-sending;
    in property <string> add-friend-note;
    in property <bool> add-friend-sent;
    in-out property <string> add-friend-name;
    callback open-add-friend;
    callback add-friend(string);
    callback close-add-friend;
    // The Discord custom status and its dialog. Clear-after picks from
    // never, 30 minutes, an hour, four hours and today.
    in property <bool> has-custom-status;
    in property <bool> status-open;
    in property <bool> status-saving;
    in property <string> status-error;
    in-out property <string> status-text;
    in-out property <EmojiCell> status-emoji;
    in-out property <int> status-clear-after;
    callback open-status;
    /// Set the Discord status: "online", "idle", "dnd" or "invisible".
    callback set-status(string);
    /// The Discord status as its settings keep it, for the status menu.
    in property <string> discord-status;
    callback save-status;
    callback clear-status;
    callback close-status;
    in property <bool> new-dm-open;
    in-out property <string> new-dm-query;
    in property <[ContactRow]> new-dm-people;
    in property <bool> new-dm-starting;
    in property <string> new-dm-note;
    callback open-new-dm;
    callback new-dm-search;
    callback start-dm(int);
    callback close-new-dm;
    in property <string> sidebar-title;
    in property <string> filter-placeholder;
    in property <string> sidebar-empty;
    in property <[ServerRow]> servers;
    in property <[RoomRow]> rooms;
    in property <[MessageRow]> messages;
    in property <string> account;
    in property <string> account-name;
    in property <string> account-initial;
    /// The Discord-only build's own status for the account's dot, as
    /// StatusDot takes it; empty to show the connection instead.
    in property <string> account-presence;
    in property <color> account-tint;
    in property <image> account-picture;
    in property <string> account-status;
    in property <string> storage;
    in property <string> notice;
    in-out property <string> graphics-notice;
    in property <string> room-name;
    in property <image> room-icon;
    in property <bool> room-direct;
    in property <string> room-initial;
    in property <color> room-tint;
    in property <image> room-picture;
    in property <string> members;
    /// The open room lists its members: a text channel or a group DM.
    /// The zoom level, such as "110%", shown for a moment after it changes.
    in property <string> zoom-note;
    in property <bool> members-available;
    /// A one-to-one DM is open, whose other person's profile can show beside it.
    in property <bool> profile-available;
    /// Whether it does: shown until someone hides it.
    in-out property <bool> profile-panel: true;
    callback profile-panel-toggled(bool);
    /// That profile, once Talk has it.
    in property <bool> panel-profile-shown;
    in property <ProfileData> panel-profile;
    callback enlarge-panel-profile;
    /// A one-to-one DM's other person, as in RoomRow: whether they're around,
    /// and their custom status or what they're doing.
    in property <string> room-presence;
    in property <string> room-activity;
    in property <[MemberRow]> roster;
    in property <string> roster-note;
    /// Whether the member list is wanted beside the conversation; Talk stores it.
    in-out property <bool> member-list: true;
    callback member-list-toggled(bool);
    /// A Discord account is linked, so its settings show.
    in property <bool> discord-linked;
    // Which networks this build carries.
    in property <bool> discord-build;
    in property <bool> matrix-build: true;
    // Linking Discord by QR code; see DiscordLinkPanel.
    in property <int> link-phase;
    in property <image> link-code;
    in property <string> link-name;
    in property <string> link-note;
    callback link-discord;
    callback cancel-discord-link;
    callback unlink-discord;
    in-out property <bool> show-hidden-channels;
    callback show-hidden-channels-toggled(bool);
    /// A link in a message was clicked.
    callback open-link(string);
    in-out property <bool> sync-discord-reads;
    callback sync-discord-reads-toggled(bool);
    in property <bool> room-selected;
    in property <bool> room-ready;
    in property <bool> room-encrypted;
    in property <bool> voice-room;
    in property <bool> composer-enabled;
    /// The selected conversation is a Discord message request, introduced by
    /// the title; it's answered instead of written to.
    in property <bool> room-request;
    in property <string> request-title;
    callback accept-request;
    callback ignore-request;
    in property <bool> can-send;
    in property <bool> sending;
    in property <bool> loading-history;
    // The first message is loaded, or loading earlier ones failed and waits
    // for Retry.
    in property <bool> history-start;
    in property <bool> history-failed;
    in property <string> composer-hint;
    // Who else is typing in the open conversation; it takes the hint's place.
    in property <string> typing;
    // Who the `@` word being typed may mention; the chosen one is highlighted.
    in property <[MentionRow]> mentions;
    in-out property <int> mention-index;
    callback composer-caret(string, int);
    callback mention-chosen(int);
    callback mention-dismissed;
    // Emoji for the `:name` being typed, the chosen one highlighted.
    in property <[EmojiCell]> emoji-suggestions;
    in property <string> emoji-suggestion-query;
    in-out property <int> emoji-suggestion-index;
    callback emoji-suggestion-chosen(int);
    callback emoji-suggestion-dismissed;
    // An emoji from the picker, by its reaction key, goes in at the composer's cursor.
    callback insert-emoji(string);
    /// "Replying to …" or "Editing your message"; empty for a new message.
    in property <string> compose-label;
    in property <bool> can-attach;
    /// Files waiting to go with the next message.
    in property <[StagedFile]> staged;
    callback unstage(int);
    callback paste-into-composer;
    public function paste-composer-text() { composer.paste-text(); }
    in property <string> confirm-delete;
    in-out property <string> react-item;
    in-out property <string> active-item;
    // Where the active message is in the timeline, so the keyboard can step from it.
    in-out property <int> active-index: -1;
    // The message list has the keyboard: Up and Down step through messages and
    // letters act on the active one.
    property <bool> browsing: timeline-keys.has-focus;
    // A popup the keyboard asked for, "menu" or "react", which the active row opens
    // beside itself.
    property <string> keyboard-popup;
    property <MessageRow> keyed-message: root.active-index >= 0 && root.active-index < root.messages.length ? root.messages[root.active-index] : {};
    // Room kept around the keyboard's message, so the next one is in view.
    property <length> keyboard-margin: min(160px, timeline.height / 3);
    callback edit-last;
    // Moves the keyboard to the newest message, from the composer.
    public function browse-messages() {
        if root.messages.length > 0 {
            root.step-message(root.messages.length - 1);
            timeline-keys.focus();
        }
    }
    function step-message(index: int) {
        root.active-index = max(0, min(root.messages.length - 1, index));
        root.active-item = root.messages[root.active-index].item;
    }
    /// The reactions this device uses most: three on the hover bar, four in the menu.
    in property <[EmojiCell]> bar-reactions;
    in property <[EmojiCell]> menu-reactions;
    /// The emoji picker's grid for `emoji-query`, refreshed through emoji-search.
    in property <[EmojiRow]> emoji-rows;
    in-out property <string> emoji-query;
    /// The forward dialog, open while Talk forwards a message of the open room.
    in property <bool> forward-open;
    /// The image viewer: the image, its full size in pixels, and what to say about it.
    /// The open profile card: beside the member list, or large over the window.
    in property <bool> profile-open;
    in property <bool> profile-large;
    in property <ProfileData> profile;
    /// Where the member whose card is open is listed.
    property <length> profile-y;
    /// The card opened from a mention or a role's list, beside the pointer rather
    /// than the member list.
    in-out property <bool> profile-at-pointer;
    /// A role mentioned in a message, with the members known to have it.
    in property <bool> role-open;
    in property <string> role-name;
    in property <color> role-color;
    in property <bool> role-has-color;
    in property <[MemberRow]> role-members;
    in property <string> role-note;
    callback close-role();
    // Where the role's card opened; a card opened from it moves the anchor, not it.
    property <length> role-x;
    property <length> role-y;
    property <length> role-width;
    changed role-open => {
        if root.role-open { root.role-x = root.anchor-x; root.role-y = root.anchor-y; root.role-width = root.anchor-width; }
    }
    /// The member whose card is beside the list, highlighted in it.
    in property <string> profile-member;
    callback show-profile(string);
    callback show-dm-profile(string);
    /// Show a mutual friend's profile, by Discord user id: as a card, or large.
    callback show-friend-profile(string, bool);
    /// A mutual server's card, beside the profile that lists it.
    property <bool> server-card-open;
    property <ProfileServerRow> server-card;
    function open-server-card(server: ProfileServerRow, x: length, y: length, width: length, height: length) {
        root.anchor(x, y, width, height, false);
        root.server-card = server;
        root.server-card-open = true;
    }
    callback enlarge-profile();
    callback close-profile();
    in property <bool> viewer-open;
    in property <image> viewer-image;
    in property <[image]> viewer-frames;
    in property <[int]> viewer-delays;
    in property <int> viewer-width;
    in property <int> viewer-height;
    in property <string> viewer-name;
    /// Such as "2 / 3"; empty for a message's only image.
    in property <string> viewer-position;
    /// While the full image loads, or why it can't show.
    in property <string> viewer-note;
    in property <string> viewer-item;
    in property <int> viewer-index;
    in property <string> forward-preview;
    in property <[ForwardRow]> forward-targets;
    in-out property <string> forward-query;
    /// The platform's color emoji font, so reactions do not fall back to outline glyphs.
    in property <string> emoji-font;
    in-out property <string> homeserver: "https://matrix.org";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> recovery;
    in-out property <string> draft;
    in-out property <string> filter;
    in property <bool> voice-visible;
    in property <bool> voice-active;
    in property <bool> voice-ready;
    in property <bool> voice-leaving;
    in property <bool> voice-here;
    /// The voice channel this account is connected to, whose participants are listed under it.
    in property <string> voice-channel;
    /// 0 while joining or reconnecting, 1 when connected, 2 after a failure.
    in property <int> voice-tone;
    in property <bool> can-join;
    in property <bool> muted;
    in property <bool> deafened;
    in property <string> voice-status;
    in property <string> voice-name;
    in property <string> voice-detail;
    in property <string> voice-microphone-status;
    in property <string> voice-description;
    in property <string> voice-error;
    in property <string> voice-warning;
    in property <[PersonRow]> participants;
    /// Sharing a screen is offered in Discord calls.
    in property <bool> can-share;
    in property <bool> sharing;
    in property <bool> share-live;
    /// The quality chosen last time: 0 for 720p, 1 for 1080p, 2 for the
    /// screen's own size, and frames a second.
    in property <int> share-resolution: 1;
    in property <int> share-fps: 30;
    in property <string> share-status;
    /// The newest preview of what's shared, refreshed by stream-tick while sharing.
    in-out property <image> share-frame;
    /// Watching someone's stream in the call.
    in property <bool> watching;
    in property <string> watch-title;
    in property <string> watch-status;
    /// The newest picture of the watched stream, refreshed by stream-tick.
    in-out property <image> watch-frame;
    in property <string> switch-prompt;
    /// Discord friend requests, message requests and spam, on the requests
    /// screen, which the top of the DM list opens.
    in property <[FriendRequestRow]> friend-requests;
    in property <[RoomRow]> message-requests;
    in property <[RoomRow]> spam-rooms;
    in property <bool> requests-open;
    /// The Discord friends list, the friends around in it, and how many
    /// friends there are before its search.
    in property <bool> friends-open;
    in property <[FriendRow]> friends;
    in property <[FriendRow]> friends-online;
    in property <int> friend-count;
    in-out property <string> friend-filter;
    /// The list shows all friends rather than those around.
    in-out property <bool> friends-all;
    callback friend-filter-edited;
    callback open-friends;
    /// Open the DM with a friend, by user id.
    callback message-friend(string);
    /// The requests screen, or a request from it, is on screen.
    in property <bool> requests-current;
    /// Requests waiting for an answer, as a badge.
    in property <string> requests-badge;
    callback open-requests;
    /// Send a Discord user a friend request or accept theirs, by user id, or
    /// ignore or cancel one.
    callback befriend(string);
    callback remove-friend-request(string);
    /// The open DM's other person, as in ProfileData.friend: whether the header
    /// offers to send them a friend request or accept theirs.
    in property <int> dm-friend;
    in property <string> dm-person;
    /// A Discord DM is open, whose call can be started or joined from its header.
    in property <bool> can-call;
    /// Someone is in the open DM's call, so the header joins rather than starts it.
    in property <bool> call-going;
    callback start-call;
    /// The open DM's call shows above its messages: this account is in it, or
    /// others are, or it rings this account.
    in property <bool> call-shown;
    /// The open DM, whose call the panel answers.
    in property <string> call-room;
    /// Who is in the open DM's call, while this account isn't.
    in property <[PersonRow]> call-people;
    in property <string> call-note;
    /// The open DM's call rings this account.
    in property <bool> call-incoming;
    /// Join a DM call ringing this account, by the DM's id, or decline it.
    callback answer-call(string, bool);
    /// A call ringing this account in a DM that isn't open, shown over everything.
    in property <bool> incoming-open;
    in property <string> incoming-room;
    in property <string> incoming-name;
    in property <string> incoming-detail;
    in property <string> incoming-initial;
    in property <color> incoming-tint;
    in property <image> incoming-picture;
    /// The settings screen covers the window, showing one section: 0 account, 1 voice and
    /// audio, 2 messages, 3 notifications, 4 Discord.
    in-out property <bool> settings-open;
    // Closing settings stops linking Discord there.
    changed settings-open => { if !self.settings-open && self.link-phase != 0 { self.cancel-discord-link(); } }
    in-out property <int> settings-section;
    /// Preferences people set in the settings; preferences-changed reports any change.
    in-out property <bool> twelve-hour-clock;
    /// Message text: 0 small, 1 default, 2 large.
    in-out property <int> text-size: 1;
    in-out property <bool> link-previews: true;
    in-out property <bool> unmute-on-join;
    in-out property <bool> level-voice: true;
    in-out property <bool> share-typing: true;
    in-out property <bool> notifications: true;
    in-out property <bool> notification-sound: true;
    in-out property <bool> notification-text: true;
    callback preferences-changed();
    out property <length> message-font-size: root.text-size == 0 ? 14px : root.text-size == 2 ? 18px : 16px;
    // The sidebar keeps 180 to 380px. Dragging also leaves the conversation 420px;
    // the window width cannot enter this binding, because it depends on the layout.
    out property <length> sidebar-shown: max(180px, min(380px, root.sidebar-width));
    in property <[string]> microphones;
    in property <[string]> speakers;
    in property <int> microphone-index;
    in property <int> speaker-index;
    /// The microphone level from 0 to 1, refreshed by meter-tick while the input menu is open.
    in-out property <float> input-level;
    /// Why the level can't be shown, if it can't.
    in-out property <string> meter-note;

    callback login;
    callback restore;
    callback explore-preview;
    callback logout;
    callback recover;
    callback refresh-trust;
    callback retry-sync;
    callback navigate-dms;
    callback navigate-server(string);
    callback select-room(string);
    callback draft-edited(string);
    callback filter-edited;
    callback send;
    callback earlier;
    callback join-voice;
    callback toggle-mute;
    callback toggle-deafen;
    callback toggle-share;
    /// Share the screen at this resolution, as in share-resolution, and frame rate.
    callback go-live(int, int);
    callback stream-tick;
    /// Watch the participant with this id's stream.
    callback watch-stream(string);
    /// A channel category's heading was clicked; see RoomList.
    callback toggle-category(string);
    // Someone's volumes, from a right click on them in a call, as percentages.
    callback volume-of(string, bool) -> int;
    /// A person, whether it's their stream, the volume, and whether it's
    /// the last of a drag, which is when it's remembered.
    callback volume-changed(string, bool, int, bool);
    property <string> volume-person;
    property <string> volume-name;
    property <bool> volume-live;
    property <int> voice-volume: 100;
    property <int> stream-volume: 100;
    function open-volume(person: PersonRow, x: length, y: length) {
        if person.local || person.person == "" { return; }
        root.anchor(x, y, 0px, 0px, true);
        root.volume-person = person.person;
        root.volume-name = person.name;
        root.volume-live = person.live;
        root.voice-volume = root.volume-of(person.person, false);
        root.stream-volume = root.volume-of(person.person, true);
        volume-menu.show();
    }
    callback stop-watching;
    callback leave-voice;
    callback confirm-switch;
    callback cancel-switch;
    callback dismiss-voice-error;
    callback refresh-devices;
    callback select-microphone(int);
    callback select-speaker(int);
    /// Whether the input menu wants the microphone level measured.
    callback metering(bool);
    callback meter-tick;
    callback reply(string);
    callback edit(string);
    callback react(string, string);
    callback request-delete(string);
    callback emoji-search(string);
    callback start-forward(string);
    callback forward-to(string);
    callback forward-search;
    callback close-forward;
    callback confirm-delete-message;
    callback cancel-delete;
    callback retry(string);
    callback cancel-send(string);
    callback attach;
    callback save-attachment(string, int);
    callback view-image(string, int);
    callback step-image(int);
    callback close-image();
    callback cancel-compose;
    callback dismiss-notice;
    // The sidebar's width, chosen by dragging its edge; Talk stores it on release.
    in-out property <length> sidebar-width: 240px;
    callback sidebar-resized(length);

    public function focus-composer() { composer.focus-input(); }
    public function place-composer-caret(offset: int) { composer.place-caret(offset); }
    // The Matrix sign-in, which only a build with Matrix has, focuses its first
    // field each time this counts up.
    property <int> sign-in-focus;
    public function focus-sign-in() { root.sign-in-focus += 1; }
    public function timeline-at-end() -> bool { return root.follow-latest; }
    // How far the newest message is below the view; zero at the end.
    public function timeline-below() -> length { return max(0px, timeline.content-y - min(0px, timeline.height - timeline.content-height)); }
    public function timeline-extent() -> length { return timeline.content-height; }
    /// Where in the window the link just clicked is, so a card it opens sits beside it.
    public function anchor-link(x: length, y: length, width: length, height: length) {
        root.anchor(x, y, width, height, false);
    }
    // The message a reply's click jumped to, highlighted while it's set.
    in-out property <string> jump-item;
    property <int> jump-tick;
    callback jump-to(string);
    // Uncovers a spoiler picture: the message's item and the attachment's index.
    callback reveal-attachment(string, int);
    /// Brings the message at `index` into view: an estimate first, so the list builds its
    /// row, then the row places itself on each `settle-jump` as the rows around it measure.
    public function show-message(index: int, item: string) {
        root.follow-latest = false;
        root.jump-item = item;
        timeline.content-y = max(min(0px, timeline.height - timeline.content-height),
            min(0px, timeline.height / 3 - timeline.content-height * index / max(1, root.messages.length)));
        root.jump-tick += 1;
    }
    public function settle-jump() { root.jump-tick += 1; }
    public function scroll-to-latest() {
        root.follow-latest = true;
        timeline.content-y = min(0px, timeline.height - timeline.content-height);
    }
    // While the newest message is in view, keep it there as rows grow, for example
    // when an image preview or a reaction arrives after the row first appeared.
    // Only scrolling stops following, and reaching the end again resumes it. The
    // list re-estimates its height as it measures rows, so heights can't tell
    // whether someone scrolled; and a wheel scroll is reported before its
    // animation moves the list, so the position at that moment can't either.
    property <bool> follow-latest: true;
    property <length> timeline-position: timeline.content-y;
    property <length> timeline-content: timeline.content-height;
    // The composer grows for a reply or edit, which shortens the list.
    property <length> timeline-viewport: timeline.height;
    // A short history sits against the composer, as in a conversation: the first
    // row is padded by the space the rows leave. A changed handler, not a binding,
    // because the list's height decides which rows it measures.
    property <length> lead;
    function settle-lead() { root.lead = max(0px, timeline.height - (timeline.content-height - root.lead)); }
    changed timeline-viewport => { root.settle-lead(); if root.follow-latest { root.scroll-to-latest(); } }
    changed timeline-position => {
        if timeline.content-y <= min(0px, timeline.height - timeline.content-height) + 0.5px { root.follow-latest = true; }
    }
    changed timeline-content => {
        root.settle-lead();
        if root.follow-latest { root.scroll-to-latest(); }
    }
    // The rows at the top and bottom of the view, by index, and the top one's
    // item and bottom edge in the view; the rows report them as they move,
    // and each row made counts `view-tick` up, so that the others report too.
    out property <int> top-index: -1;
    out property <string> top-item;
    out property <length> top-edge;
    out property <int> bottom-index: -1;
    property <int> view-tick;
    // Earlier messages load as the timeline nears its top, a page at a time,
    // until the first message. After a failure they wait for Retry.
    property <bool> wants-earlier: root.room-ready && !root.preview && !root.busy && !root.voice-room
        && root.messages.length > 0 && !root.loading-history && !root.history-start && !root.history-failed
        && -timeline.content-y < timeline.height;
    changed wants-earlier => { if self.wants-earlier { root.earlier(); } }
    // Formatted messages are not selectable, so Copy goes through a hidden text field.
    function copy-text(text: string) { clipboard.text = text; clipboard.select-all(); clipboard.copy(); clipboard.text = ""; }
    clipboard := TextInput { visible: false; width: 0px; height: 0px; }
    // A tooltip must not outlive the toolbar that showed it.
    changed active-item => { Tip.text = ""; }

    // The member list is a second sidebar, on the right of the conversation.
    property <bool> members-docked: root.members-available && root.member-list;
    // Rows remade under the pointer show their tooltip again; it goes with the screen.
    changed friends-open => { Tip.text = ""; }
    property <bool> profile-docked: root.profile-available && root.profile-panel && root.panel-profile-shown;
    function toggle-profile-panel() {
        root.profile-panel = !root.profile-panel;
        root.profile-panel-toggled(root.profile-panel);
    }
    function toggle-members() {
        root.member-list = !root.member-list;
        root.member-list-toggled(root.member-list);
    }

    property <bool> is-editing: root.compose-label == "Editing your message";
    property <color> voice-color: root.voice-tone == 1 ? Theme.live : root.voice-tone == 2 ? Theme.danger : Theme.accent;

    // Talk joins calls muted; this preference turns the microphone on once connected.
    changed voice-ready => {
        if root.voice-ready && root.unmute-on-join && root.muted { root.toggle-mute(); }
    }

    // The device menus open above the toggle whose caret was clicked.
    property <length> menu-x;
    property <length> menu-y;
    function open-settings() { input-menu.close(); output-menu.close(); root.settings-section = 1; root.settings-open = true; root.refresh-devices(); }
    property <bool> input-open: input-menu.is-open;
    property <bool> output-open: output-menu.is-open;
    changed input-open => { root.input-level = 0; root.meter-note = ""; root.metering(root.input-open); }
    Timer { interval: 50ms; running: root.input-open; triggered => { root.meter-tick(); } }
    Timer { interval: 33ms; running: root.sharing || root.watching; triggered => { root.stream-tick(); } }
    input-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        width: 280px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        DeviceMenu {
            heading: "INPUT DEVICE"; devices: root.microphones; current: root.microphone-index;
            empty: "No microphones found. Connect one, then reopen this menu.";
            select(index) => { root.select-microphone(index); }
            settings => { root.open-settings(); }
            Rectangle { height: 1px; background: Theme.line; }
            InputLevel { input-level: root.input-level; muted: root.muted; meter-note: root.meter-note; }
        }
    }
    output-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        width: 280px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        DeviceMenu {
            heading: "OUTPUT DEVICE"; devices: root.speakers; current: root.speaker-index;
            empty: "No speakers found. Connect one, then reopen this menu.";
            select(index) => { root.select-speaker(index); }
            settings => { root.open-settings(); }
        }
    }
    // The quality picked in the share menu, from the last choice each time it opens.
    property <int> pick-resolution;
    property <int> pick-fps;
    function open-share-menu(x: length, y: length) {
        root.menu-x = x; root.menu-y = y;
        root.pick-resolution = root.share-resolution;
        root.pick-fps = root.share-fps;
        share-menu.show();
    }
    share-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        width: 240px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        ShareMenu {
            pick-resolution <=> root.pick-resolution; pick-fps <=> root.pick-fps;
            go-live(resolution, fps) => { root.go-live(resolution, fps); share-menu.close(); }
        }
    }
    // The emoji picker and a message's menu open beside the control that asked for
    // them, flipping above it near the bottom of the window. A menu opened by a
    // right click starts at the pointer.
    property <length> anchor-x;
    property <length> anchor-y;
    property <length> anchor-width;
    property <length> anchor-height;
    property <bool> anchor-pointer;
    function anchor(x: length, y: length, width: length, height: length, pointer: bool) {
        root.anchor-x = x; root.anchor-y = y; root.anchor-width = width; root.anchor-height = height;
        root.anchor-pointer = pointer;
    }
    // A card opened from a mention sits right of what was clicked, or left of it
    // when there isn't room.
    pure function beside(x: length, width: length, card: length) -> length {
        return x + width + 8px + card <= root.width - 8px ? x + width + 8px : max(8px, x - card - 8px);
    }
    // Closing a popup ends the handler that closed it, so callers close last.
    function open-picker(item: string) {
        root.react-item = item;
        root.emoji-query = "";
        root.emoji-hover = { glyph: "", name: "" };
        root.emoji-search("");
        emoji-picker.show();
    }
    // The message whose menu is open.
    property <MessageRow> menu-message;
    property <string> menu-item: menu-open ? root.menu-message.item : "";
    property <bool> menu-open: message-menu.is-open;
    // The DM whose menu is open.
    property <string> menu-room;
    room-menu := PopupWindow {
        width: 200px; height: room-menu-content.preferred-height;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-x));
        y: root.anchor-y + self.height <= root.height - 8px ? root.anchor-y : max(8px, root.anchor-y - self.height);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            room-menu-content := VerticalLayout {
                padding: 6px;
                MenuItem {
                    text: "Profile"; icon: @image-url("icons/user.svg");
                    clicked => { root.show-dm-profile(root.menu-room); room-menu.close(); }
                }
            }
        }
    }
    // The status menu opens above the account panel, along its left edge.
    function open-status-menu() {
        root.menu-x = account-panel.absolute-position.x + 8px;
        root.menu-y = account-panel.absolute-position.y;
        status-menu.show();
    }
    status-menu := PopupWindow {
        width: 248px; height: status-menu-content.preferred-height;
        x: max(8px, min(root.width - self.width - 8px, root.menu-x));
        y: max(8px, root.menu-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        status-menu-content := StatusMenu {
            status: root.discord-status; has-custom-status: root.has-custom-status;
            choose(status) => { root.set-status(status); status-menu.close(); }
            custom-status => { root.open-status(); status-menu.close(); }
        }
    }
    function open-menu(message: MessageRow) {
        root.menu-message = message;
        message-menu.show();
    }
    property <bool> picker-open: emoji-picker.is-open;
    changed picker-open => {
        if !root.picker-open {
            if root.react-item == "talk:composer" { root.focus-composer(); }
            root.react-item = "";
        }
    }
    property <EmojiCell> emoji-hover;
    // The status dialog borrows the picker for its emoji.
    function pick(cell: EmojiCell) {
        if root.react-item == "talk:status" {
            root.status-emoji = cell;
        } else if root.react-item == "talk:composer" {
            root.insert-emoji(cell.key);
        } else {
            root.react(root.react-item, cell.key);
        }
        emoji-picker.close();
    }
    emoji-picker := PopupWindow {
        width: 360px; height: 432px;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-pointer ? root.anchor-x : root.anchor-x + root.anchor-width - self.width));
        y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
            ? root.anchor-y + root.anchor-height + 4px : max(8px, root.anchor-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        EmojiPicker {
            emoji-rows: root.emoji-rows; emoji-query <=> root.emoji-query; emoji-hover <=> root.emoji-hover;
            emoji-font: root.emoji-font; react-item: root.react-item;
            emoji-search(text) => { root.emoji-search(text); }
            pick(cell) => { root.pick(cell); }
            close-picker => { emoji-picker.close(); }
        }
    }
    // A message's actions, from its hover bar's "More" button or a right click.
    property <bool> menu-can-react: root.menu-message.can-react && root.composer-enabled;
    volume-menu := PopupWindow {
        width: 260px; height: volume-content.content-height;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-x));
        y: root.anchor-y + self.height <= root.height - 8px ? root.anchor-y : max(8px, root.anchor-y - self.height);
        close-policy: PopupClosePolicy.close-on-click-outside;
        volume-content := VolumeMenu {
            volume-person: root.volume-person; volume-name: root.volume-name; volume-live: root.volume-live;
            voice-volume <=> root.voice-volume; stream-volume <=> root.stream-volume;
            volume-changed(person, stream, volume, last) => { root.volume-changed(person, stream, volume, last); }
        }
    }
    message-menu := PopupWindow {
        width: 224px; height: menu-content.content-height;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-pointer ? root.anchor-x : root.anchor-x + root.anchor-width - self.width));
        y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
            ? root.anchor-y + root.anchor-height + (root.anchor-pointer ? 0px : 4px) : max(8px, root.anchor-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        menu-content := MessageMenu {
            menu-message: root.menu-message; menu-can-react: root.menu-can-react; menu-reactions: root.menu-reactions;
            emoji-font: root.emoji-font; composer-enabled: root.composer-enabled; trusted: root.trusted; preview: root.preview;
            react(item, key) => { root.react(item, key); message-menu.close(); }
            open-picker(item) => { root.open-picker(item); message-menu.close(); }
            edit(item) => { root.edit(item); root.focus-composer(); message-menu.close(); }
            reply(item) => { root.reply(item); root.focus-composer(); message-menu.close(); }
            start-forward(item) => { root.start-forward(item); message-menu.close(); }
            copy-text(text) => { root.copy-text(text); message-menu.close(); }
            request-delete(item) => { root.request-delete(item); message-menu.close(); }
        }
    }

    // Sign in; see SignInScreen.
    SignInScreen {
        visible: !root.workspace;
        busy: root.busy; notice: root.notice; restore-available: root.restore-available; matrix-build: root.matrix-build;
        link-phase: root.link-phase; link-code: root.link-code; link-name: root.link-name; link-note: root.link-note;
        sign-in-focus: root.sign-in-focus;
        graphics-notice <=> root.graphics-notice;
        homeserver <=> root.homeserver; username <=> root.username; password <=> root.password;
        login => { root.login(); }
        restore => { root.restore(); }
        explore-preview => { root.explore-preview(); }
        link-discord => { root.link-discord(); }
    }

    HorizontalLayout {
        visible: root.workspace;
        spacing: 0px;
        // Navigation: the rail and the sidebar, with the voice and account dock across both.
        Rectangle {
            width: 72px + root.sidebar-shown; background: Theme.rail;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    vertical-stretch: 1; spacing: 0px;
                    // Server rail.
                    ServerRail {
                        dms-selected: root.dms-selected; dms-unread: root.dms-unread; dms-badge: root.dms-badge; servers: root.servers;
                        navigate-dms => { root.navigate-dms(); }
                        navigate-server(id) => { root.navigate-server(id); }
                    }
                    // Channel sidebar: a lighter sheet held by the rail and the dock.
                    Rectangle {
                        width: root.sidebar-shown; background: Theme.sidebar;
                        border-top-left-radius: 10px; border-bottom-left-radius: 10px;
                        clip: true;
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: 48px;
                                Text { x: 16px; width: parent.width - (root.dms-selected && !root.preview ? (root.discord-linked ? 88px : 56px) : 32px); text: root.sidebar-title; font-size: 16px; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                if root.dms-selected && !root.preview && root.discord-linked: IconButton {
                                    x: parent.width - 2 * self.width - 14px;
                                    icon: @image-url("icons/user-plus.svg"); label: "Add a friend"; size: 28px; glyph: 18px; tip-side: 2;
                                    clicked => { root.open-add-friend(); }
                                }
                                if root.dms-selected && !root.preview: IconButton {
                                    x: parent.width - self.width - 10px;
                                    icon: @image-url("icons/square-pen.svg"); label: "New message"; size: 28px; glyph: 18px; tip-side: 2;
                                    clicked => { root.open-new-dm(); }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
                            }
                            HorizontalLayout {
                                padding: 10px; padding-bottom: 6px;
                                TextField {
                                    min-height: 30px; text-size: 14px; pad: 8px; fill: Theme.sunken; ring: false;
                                    placeholder: root.filter-placeholder; text <=> root.filter; label: root.filter-placeholder;
                                    edited => { root.filter-edited(); }
                                }
                            }
                            RoomList {
                                rooms: root.rooms; dms-selected: root.dms-selected; discord-linked: root.discord-linked; preview: root.preview;
                                friends-open: root.friends-open; requests-current: root.requests-current; requests-badge: root.requests-badge;
                                voice-channel: root.voice-channel; participants: root.participants; sidebar-empty: root.sidebar-empty;
                                select-room(id) => { root.select-room(id); }
                                open-friends => { root.open-friends(); }
                                open-requests => { root.open-requests(); }
                                open-room-menu(id, x, y) => {
                                    root.anchor(x, y, 0px, 0px, true);
                                    root.menu-room = id;
                                    room-menu.show();
                                }
                                open-volume(person, x, y) => { root.open-volume(person, x, y); }
                                watch-stream(id) => { root.watch-stream(id); }
                                toggle-category(heading) => { root.toggle-category(heading); }
                            }
                        }
                    }
                }
                // The dock spans the rail and the sidebar. Its avatar and voice icon sit on the
                // rail's axis, 36px from the left; names and status start at 64px.
                if root.voice-visible: VoiceDock {
                    voice-status: root.voice-status; voice-detail: root.voice-detail; voice-color: root.voice-color;
                    voice-active: root.voice-active; voice-leaving: root.voice-leaving;
                    voice-warning: root.voice-warning; voice-error: root.voice-error;
                    leave-voice => { root.leave-voice(); }
                    dismiss-voice-error => { root.dismiss-voice-error(); }
                }
                // Account panel.
                account-panel := Rectangle {
                    height: 56px; background: Theme.panel;
                    if root.voice-visible: Rectangle { x: 12px; y: 0px; width: parent.width - 24px; height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        padding-right: 8px; spacing: 2px;
                        Rectangle {
                            width: 58px;
                            Avatar { x: 19px; y: (parent.height - self.height) / 2; size: 34px; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture; }
                            if root.account-presence != "": StatusDot {
                                x: 40px; y: parent.height / 2 + 3px; presence: root.account-presence; ring: Theme.panel;
                            }
                            if root.account-presence == "": Rectangle {
                                x: 41px; y: parent.height / 2 + 4px; width: 14px; height: 14px; border-radius: 7px; background: Theme.panel;
                                Rectangle {
                                    width: 8px; height: 8px; border-radius: 4px;
                                    background: root.preview ? Theme.accent : root.online ? Theme.live : Theme.faint;
                                }
                            }
                            if root.discord-linked: TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.open-status-menu(); }
                            }
                        }
                        // With Discord linked, the avatar and name open the status menu.
                        Rectangle {
                            horizontal-stretch: 1; y: 6px; height: parent.height - 12px; border-radius: 6px;
                            background: account-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-enabled: root.discord-linked;
                            accessible-label: root.account-name + ", " + root.account-status + (root.discord-linked ? ". Set your status" : "");
                            accessible-action-default => { if root.discord-linked { root.open-status-menu(); } }
                            VerticalLayout {
                                alignment: center; padding-left: 6px; padding-right: 6px;
                                Text { text: root.account-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                                Text { text: root.account-status; color: Theme.muted; font-size: 13px; overflow: elide; }
                            }
                            account-touch := TouchArea {
                                enabled: root.discord-linked; mouse-cursor: MouseCursor.pointer;
                                clicked => { root.open-status-menu(); }
                            }
                        }
                        if root.voice-active: DeviceToggle {
                            icon: root.muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                            label: root.muted ? "Unmute" : "Mute"; alert: root.muted;
                            menu-label: "Input options"; open: root.input-open;
                            enabled: root.voice-ready;
                            clicked => { root.toggle-mute(); }
                            menu => {
                                root.menu-x = self.absolute-position.x; root.menu-y = self.absolute-position.y + (self.height - 32px) / 2;
                                root.refresh-devices(); input-menu.show();
                            }
                        }
                        if root.voice-active: DeviceToggle {
                            icon: root.deafened ? @image-url("icons/headphone-off.svg") : @image-url("icons/headphones.svg");
                            label: root.deafened ? "Undeafen" : "Deafen"; alert: root.deafened;
                            menu-label: "Output options"; open: root.output-open;
                            enabled: root.voice-ready;
                            clicked => { root.toggle-deafen(); }
                            menu => {
                                root.menu-x = self.absolute-position.x; root.menu-y = self.absolute-position.y + (self.height - 32px) / 2;
                                root.refresh-devices(); output-menu.show();
                            }
                        }
                        if !root.preview && !root.online: IconButton {
                            icon: @image-url("icons/refresh-cw.svg"); label: "Reconnect"; enabled: !root.busy;
                            clicked => { root.retry-sync(); }
                        }
                        IconButton {
                            icon: @image-url("icons/settings.svg"); label: "Settings";
                            clicked => { root.settings-open = true; root.refresh-devices(); }
                        }
                    }
                }
            }
        }
        // Conversation.
        Rectangle {
            background: Theme.chat;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px;
                        if root.room-direct: Middle {
                            Rectangle {
                                width: 26px; height: 26px;
                                Avatar { size: 26px; initial: root.room-initial; tint: root.room-tint; picture: root.room-picture; }
                                if root.room-presence != "": StatusDot {
                                    x: 14px; y: 14px; width: 14px; height: 14px; presence: root.room-presence; ring: Theme.chat;
                                }
                            }
                        }
                        if !root.room-direct && root.room-selected: Image { source: root.room-icon; width: 22px; image-fit: contain; colorize: Theme.muted; }
                        if root.requests-open: Image { source: @image-url("icons/inbox.svg"); width: 22px; image-fit: contain; colorize: Theme.muted; }
                        if root.friends-open: Image { source: @image-url("icons/users.svg"); width: 22px; image-fit: contain; colorize: Theme.muted; }
                        Text {
                            text: root.room-selected ? root.room-name : root.requests-open ? "Requests" : root.friends-open ? "Friends" : root.sidebar-title;
                            color: root.room-selected || root.requests-open || root.friends-open ? Theme.text : Theme.secondary;
                            font-size: 16px; font-weight: 700; overflow: elide; vertical-alignment: center;
                            // The name gives way to what follows it, and fills the bar when nothing does.
                            horizontal-stretch: (root.room-activity != "" && root.room-direct) || root.friends-open ? 0 : 1;
                        }
                        // What they're up to, as a bubble beside their name.
                        if root.room-direct && root.room-activity != "": Middle {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 24px; border-radius: 12px; background: Theme.raised;
                                    accessible-role: text; accessible-label: "Status: " + root.room-activity;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        Text {
                                            text: root.room-activity; color: Theme.secondary; font-size: 13px; font-weight: 500;
                                            overflow: elide; vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        if root.friends-open: Middle { Rectangle { width: 1px; height: 24px; background: Theme.line; } }
                        if root.friends-open: Middle {
                            HeaderTab { text: "Online"; selected: !root.friends-all; clicked => { root.friends-all = false; } }
                        }
                        if root.friends-open: Middle {
                            HeaderTab { text: "All"; selected: root.friends-all; clicked => { root.friends-all = true; } }
                        }
                        if root.friends-open: Middle {
                            ActionButton { text: "Add Friend"; small: true; primary: true; clicked => { root.open-add-friend(); } }
                        }
                        if root.friends-open: Rectangle { horizontal-stretch: 1; }
                        if root.dm-friend == 1 || root.dm-friend == 3: Middle {
                            ActionButton {
                                icon: @image-url("icons/user-plus.svg");
                                text: root.dm-friend == 1 ? "Add Friend" : "Accept Friend Request";
                                label: root.dm-friend == 1 ? "Send friend request" : "Accept friend request";
                                small: true; primary: root.dm-friend == 3;
                                clicked => { root.befriend(root.dm-person); }
                            }
                        }
                        if root.can-call: Middle {
                            IconButton {
                                icon: @image-url("icons/phone.svg"); label: root.call-going ? "Join the call" : "Start a call";
                                size: 32px; glyph: 20px; enabled: root.can-join; tip-side: 2;
                                clicked => { root.start-call(); }
                            }
                        }
                        if root.members-available: Middle {
                            HeaderToggle {
                                icon: @image-url("icons/users.svg"); text: root.members; open: root.member-list;
                                label: root.member-list ? "Hide member list" : "Show member list";
                                clicked => { root.toggle-members(); }
                            }
                        }
                        if root.profile-available: Middle {
                            IconButton {
                                icon: @image-url("icons/user.svg"); label: root.profile-panel ? "Hide profile" : "Show profile";
                                size: 32px; glyph: 20px; tip-side: 2;
                                clicked => { root.toggle-profile-panel(); }
                            }
                        }
                        if !root.members-available && !root.profile-available && root.members != "": HorizontalLayout {
                            spacing: 6px;
                            Image { source: @image-url("icons/users.svg"); width: 18px; image-fit: contain; colorize: Theme.muted; }
                            Text { text: root.members; color: Theme.muted; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
                }
                HorizontalLayout {
                    spacing: 0px;
                    VerticalLayout {
                        spacing: 0px; horizontal-stretch: 1;
                        if root.preview: Rectangle {
                            min-height: preview-content.preferred-height; background: Theme.raised; vertical-stretch: 0;
                            preview-content := HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; padding-top: 7px; padding-bottom: 7px; spacing: 10px;
                                Image { source: @image-url("icons/triangle-alert.svg"); width: 16px; image-fit: contain; colorize: Theme.accent; }
                                Text {
                                    text: "Local preview: sample data. Nothing leaves this computer.";
                                    color: Theme.secondary; font-size: 14px; font-weight: 500; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
                                }
                            }
                        }
                        if !root.preview && !root.trusted: VerifyBanner {
                            busy: root.busy; recovery <=> root.recovery;
                            recover => { root.recover(); }
                            refresh-trust => { root.refresh-trust(); }
                        }
                        if root.graphics-notice != "": Banner { text <=> root.graphics-notice; dismissed => { root.graphics-notice = ""; } }
                        if root.notice != "": Banner { text: root.notice; dismissed => { root.dismiss-notice(); } }
                        // Voice channel: a stage of participants, or an invitation to join.
                        // A DM's call shows the same above its messages.
                        if root.voice-room || root.call-shown: Rectangle {
                            // Above a DM's messages, a call takes less than half the room,
                            // more while watching a stream, and little while offering to join.
                            vertical-stretch: root.voice-room ? 1 : !root.voice-here ? 0 : root.watching ? 1.8 : 0.8;
                            min-height: root.voice-room ? 0px : root.voice-here ? 260px : 210px;
                            max-height: root.voice-room || root.voice-here ? 100000px : 210px;
                            background: Theme.stage;
                            if !root.voice-here && !root.voice-room: CallInvite {
                                call-people: root.call-people; call-note: root.call-note; call-incoming: root.call-incoming;
                                call-room: root.call-room; can-join: root.can-join;
                                answer-call(room, accept) => { root.answer-call(room, accept); }
                            }
                            if !root.voice-room: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
                            if !root.voice-here && root.voice-room: JoinVoice {
                                room-name: root.room-name; voice-description: root.voice-description; preview: root.preview;
                                room-encrypted: root.room-encrypted; voice-active: root.voice-active; can-join: root.can-join;
                                join-voice => { root.join-voice(); }
                            }
                            if root.voice-here: VerticalLayout {
                                spacing: 0px;
                                HorizontalLayout {
                                    padding: 16px; padding-bottom: 0px;
                                    Text { text: root.voice-description; color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
                                }
                                if root.watching: StreamView {
                                    watch-title: root.watch-title; watch-status: root.watch-status; watch-frame: root.watch-frame;
                                    stop-watching => { root.stop-watching(); }
                                }
                                if !root.watching: ParticipantGrid {
                                    participants: root.participants; sharing: root.sharing; share-live: root.share-live;
                                    share-status: root.share-status; share-frame: root.share-frame;
                                    watch-stream(id) => { root.watch-stream(id); }
                                    open-volume(person, x, y) => { root.open-volume(person, x, y); }
                                }
                                CallControls {
                                    muted: root.muted; deafened: root.deafened; voice-ready: root.voice-ready; voice-leaving: root.voice-leaving;
                                    can-share: root.can-share; sharing: root.sharing;
                                    toggle-mute => { root.toggle-mute(); }
                                    toggle-deafen => { root.toggle-deafen(); }
                                    toggle-share => { root.toggle-share(); }
                                    open-share-menu(x, y) => { root.open-share-menu(x, y); }
                                    leave-voice => { root.leave-voice(); }
                                }
                            }
                        }
                        // Text conversation.
                        Rectangle {
                            visible: !root.voice-room;
                            min-height: 0px;
                            max-height: root.voice-room ? 0px : 100000px;
                            vertical-stretch: root.voice-room ? 0 : 1;
                            // Up and Down step through messages; R replies, E edits, Delete deletes,
                            // C copies, F forwards, + reacts, Enter opens the menu, Escape returns
                            // to the composer.
                            timeline-keys := FocusScope {
                                width: parent.width; height: parent.height;
                                focus-on-click: false;
                                accessible-role: list;
                                accessible-label: "Messages";
                                key-pressed(event) => {
                                    if root.messages.length == 0 { return reject; }
                                    if root.confirm-delete != "" && root.confirm-delete == root.active-item {
                                        if event.text == Key.Return { root.confirm-delete-message(); return accept; }
                                        if event.text == Key.Escape { root.cancel-delete(); return accept; }
                                    }
                                    if event.text == Key.UpArrow { root.step-message(root.active-index < 0 ? root.messages.length - 1 : root.active-index - 1); return accept; }
                                    if event.text == Key.DownArrow { root.step-message(root.active-index < 0 ? root.messages.length - 1 : root.active-index + 1); return accept; }
                                    if event.text == Key.PageUp { root.step-message(root.active-index - 5); return accept; }
                                    if event.text == Key.PageDown { root.step-message(root.active-index + 5); return accept; }
                                    if event.text == Key.Home { root.step-message(0); return accept; }
                                    if event.text == Key.End { root.step-message(root.messages.length - 1); return accept; }
                                    if event.text == Key.Escape { root.focus-composer(); return accept; }
                                    if root.active-index < 0 || root.active-index >= root.messages.length { return reject; }
                                    if root.keyed-message.deleted || root.keyed-message.delivery != "" { return reject; }
                                    if event.text == Key.Return || event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                                        root.keyboard-popup = "menu"; return accept;
                                    }
                                    if (event.text == "+" || event.text == "=") && root.keyed-message.can-react && root.composer-enabled {
                                        root.keyboard-popup = "react"; return accept;
                                    }
                                    if (event.text == "r" || event.text == "R") && root.keyed-message.can-reply && root.composer-enabled {
                                        root.reply(root.keyed-message.item); root.focus-composer(); return accept;
                                    }
                                    if (event.text == "e" || event.text == "E") && root.keyed-message.own && root.keyed-message.can-edit && root.composer-enabled {
                                        root.edit(root.keyed-message.item); root.focus-composer(); return accept;
                                    }
                                    if (event.text == Key.Delete || event.text == Key.Backspace) && root.keyed-message.can-delete && root.composer-enabled {
                                        root.request-delete(root.keyed-message.item); return accept;
                                    }
                                    if (event.text == "c" || event.text == "C") && root.keyed-message.body != "" {
                                        root.copy-text(root.keyed-message.body); return accept;
                                    }
                                    if (event.text == "f" || event.text == "F") && root.keyed-message.can-forward && (root.trusted || root.preview) {
                                        root.start-forward(root.keyed-message.item); return accept;
                                    }
                                    return reject;
                                }
                                timeline := ListView {
                                    width: parent.width; height: parent.height;
                                    scrolled => { root.follow-latest = false; }
                                    for message[index] in root.messages: Rectangle {
                                        property <bool> lit: root.active-item == message.item;
                                        property <bool> jumped: root.jump-item != "" && root.jump-item == message.item;
                                        property <int> jump-tick: root.jump-tick;
                                        changed jump-tick => {
                                            if self.jumped {
                                                timeline.content-y = max(min(0px, timeline.height - timeline.content-height), min(0px, timeline.height / 3 - self.y));
                                            }
                                        }
                                        // The keyboard's message stays in view, with room for the next one,
                                        // so stepping on finds it built.
                                        changed lit => {
                                            if self.lit && root.browsing {
                                                root.active-index = index;
                                                if self.y + timeline.content-y < root.keyboard-margin {
                                                    root.follow-latest = false;
                                                    timeline.content-y = min(0px, root.keyboard-margin - self.y);
                                                } else if self.y + self.height + timeline.content-y > timeline.height - root.keyboard-margin {
                                                    timeline.content-y = max(min(0px, timeline.height - timeline.content-height), timeline.height - root.keyboard-margin - self.y - self.height);
                                                }
                                            }
                                        }
                                        property <bool> keyed: self.lit && root.keyboard-popup != "";
                                        changed keyed => {
                                            if self.keyed {
                                                root.anchor(self.absolute-position.x + self.width - 16px, self.absolute-position.y + self.top - 16px, 0px, 32px, false);
                                                if root.keyboard-popup == "menu" { root.open-menu(message); } else { root.open-picker(message.item); }
                                                root.keyboard-popup = "";
                                            }
                                        }
                                        // Where it is in the view, for `top-index` and `bottom-index`.
                                        property <length> view-y: self.y + timeline.content-y;
                                        property <int> view-tick: root.view-tick;
                                        property <int> row-index: index;
                                        function report-view() {
                                            if self.view-y <= 0px && self.view-y + self.height > 0px {
                                                root.top-index = index; root.top-item = message.item; root.top-edge = self.view-y + self.height;
                                            }
                                            if self.view-y < timeline.height && self.view-y + self.height >= timeline.height { root.bottom-index = index; }
                                        }
                                        init => { root.view-tick += 1; }
                                        changed view-y => { self.report-view(); }
                                        changed height => { self.report-view(); }
                                        changed view-tick => { self.report-view(); }
                                        changed row-index => { self.report-view(); }
                                        // The space that holds a short history down stays outside the row.
                                        property <length> top: index == 0 ? root.lead : 0px;
                                        height: col.preferred-height + self.top;
                                        Rectangle {
                                            y: parent.top; height: parent.height - parent.top;
                                            background: parent.jumped ? Theme.accent.transparentize(0.86) : parent.lit ? Theme.row-hover : transparent;
                                            animate background { duration: 400ms; }
                                        }
                                        // The keyboard's message has a marigold edge.
                                        if self.lit && root.browsing: Rectangle { x: 0px; y: parent.top; width: 3px; height: parent.height - parent.top; background: Theme.accent; }
                                        // The pointer area wraps the row, so hovering selectable text still counts.
                                        // The last hovered or clicked message keeps its actions: the list takes
                                        // the pointer when a press starts, which ends hover, so a hover-only bar
                                        // would vanish before its button saw the click.
                                        row-pointer := TouchArea {
                                            y: parent.top; height: parent.height - parent.top;
                                            changed has-hover => { if self.has-hover { root.active-item = message.item; root.active-index = index; } }
                                            clicked => { root.active-item = message.item; root.active-index = index; }
                                            // A right click opens the same menu as the hover bar's More button.
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                                                    && !message.deleted && message.delivery == "" {
                                                    root.active-item = message.item;
                                                    root.anchor(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0px, 0px, true);
                                                    root.open-menu(message);
                                                }
                                            }
                                            col := VerticalLayout {
                                                padding-top: message.day != "" ? 12px : message.first ? 14px : 1px;
                                                padding-bottom: index == root.messages.length - 1 ? 20px : 1px;
                                                spacing: 0px;
                                                // History starts with what's before it: earlier messages
                                                // loading, or the conversation's start.
                                                if index == 0 && root.room-ready: HistoryEdge {
                                                    loading: root.loading-history; failed: root.history-failed; start: root.history-start;
                                                    enabled: !root.busy && !root.preview; room-direct: root.room-direct; room-name: root.room-name;
                                                    earlier => { root.earlier(); }
                                                }
                                                if message.day != "": HorizontalLayout {
                                                    padding-left: 16px; padding-right: 16px; padding-bottom: 6px; spacing: 10px; height: 26px;
                                                    Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.line; } }
                                                    Text { text: message.day; color: Theme.muted; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                                    Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.line; } }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 16px; padding-right: 48px; padding-top: 2px; padding-bottom: 2px; spacing: 16px;
                                                    Rectangle {
                                                        width: 40px;
                                                        min-height: message.first ? (message.has-reply ? 64px : 40px) : 0px;
                                                        if message.has-reply: Rectangle {
                                                            x: 19px; y: 11px; width: 33px; height: 13px; clip: true;
                                                            Rectangle {
                                                                x: 0px; y: 0px; width: parent.width + 12px; height: parent.height + 12px;
                                                                border-width: 2px; border-color: #4a4c56; border-top-left-radius: 6px;
                                                            }
                                                        }
                                                        if message.first: Avatar {
                                                            x: 0px; y: message.has-reply ? 24px : 2px;
                                                            initial: message.initial; tint: message.tint; picture: message.picture;
                                                        }
                                                        if !message.first && root.active-item == message.item: Text {
                                                            x: 0px; y: 4px; width: 40px;
                                                            text: message.short-time; color: Theme.muted; font-size: 12px; font-weight: 500;
                                                            horizontal-alignment: right; overflow: elide;
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        spacing: 3px; horizontal-stretch: 1;
                                                        // Clicking the quote jumps to the message it quotes.
                                                        if message.has-reply: Rectangle {
                                                            height: 22px;
                                                            accessible-role: button;
                                                            accessible-enabled: message.reply-item != "";
                                                            accessible-label: "Jump to the original message: " + message.reply-body;
                                                            accessible-action-default => { if message.reply-item != "" { root.jump-to(message.reply-item); } }
                                                            HorizontalLayout {
                                                                spacing: 6px;
                                                                if message.reply-author != "": Middle { Avatar { size: 16px; initial: message.reply-initial; tint: message.reply-tint; picture: message.reply-picture; } }
                                                                if message.reply-author != "": Text { text: message.reply-author; color: Theme.secondary; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                                Text {
                                                                    text: message.reply-body; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                                                                    color: reply-touch.has-hover ? Theme.text : Theme.muted;
                                                                }
                                                            }
                                                            reply-touch := TouchArea {
                                                                enabled: message.reply-item != "";
                                                                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                                                                clicked => { root.jump-to(message.reply-item); }
                                                            }
                                                        }
                                                        if message.first: HorizontalLayout {
                                                            spacing: 8px;
                                                            StyledText { text: message.author-styled; link-color: Theme.link; default-color: message.has-color ? message.color : Theme.text; default-font-size: root.message-font-size; max-lines: 1; vertical-alignment: center; }
                                                            if message.bot: Middle { BotTag { } }
                                                            StyledText { text: message.time-styled; link-color: Theme.link; default-color: Theme.muted; default-font-size: root.message-font-size - 3px; max-lines: 1; vertical-alignment: center; }
                                                            Rectangle { horizontal-stretch: 1; }
                                                        }
                                                        if message.body != "": StyledText {
                                                            text: message.styled; default-color: message.deleted || message.delivery != "" ? Theme.muted : Theme.text; link-color: Theme.link;
                                                            // Discord's large emoji are 48 pixels where text's are 22.
                                                            default-font-size: message.jumbo ? root.message-font-size * 2.2 : root.message-font-size;
                                                            // A mention's card opens beside the pointer.
                                                            link-clicked(link) => {
                                                                root.anchor(row-pointer.absolute-position.x + row-pointer.mouse-x, row-pointer.absolute-position.y + row-pointer.mouse-y, 0px, 0px, true);
                                                                root.open-link(link);
                                                            }
                                                            accessible-role: text; accessible-label: "Message from " + message.author + ": " + message.body;
                                                        }
                                                        if message.edited && !message.deleted: Text { text: "(edited)"; color: Theme.muted; font-size: 12px; }
                                                        // Fixed-size children sit beside a spacer, so they do not cap the column's width.
                                                        if message.images.length > 0: MessageGallery {
                                                            message: message; active-item: root.active-item; preview: root.preview;
                                                            reveal-attachment(id, index) => { root.reveal-attachment(id, index); }
                                                            view-image(id, index) => { root.view-image(id, index); }
                                                            save-attachment(id, index) => { root.save-attachment(id, index); }
                                                        }
                                                        if message.stickers.length > 0: MessageStickers { stickers: message.stickers; }
                                                        for file in message.files: FileCard {
                                                            file: file; preview: root.preview; delivery: message.delivery;
                                                            save => { root.save-attachment(message.item, file.index); }
                                                        }
                                                        if message.hidden-card != "": Text {
                                                            text: message.hidden-card; color: Theme.muted; font-size: root.message-font-size * 0.875; font-italic: true; wrap: word-wrap;
                                                        }
                                                        for embed in message.embeds: EmbedView {
                                                            embed: embed; item: message.item;
                                                            open-link(link) => { root.open-link(link); }
                                                            reveal-attachment(id, index) => { root.reveal-attachment(id, index); }
                                                            view-image(id, index) => { root.view-image(id, index); }
                                                        }
                                                        if message.reactions.length > 0: HorizontalLayout {
                                                            spacing: 6px; alignment: start; padding-top: 4px;
                                                            for reaction in message.reactions: ReactionToggle {
                                                                key: reaction.key; label: reaction.label; count: reaction.count; mine: reaction.mine; emoji-font: root.emoji-font;
                                                                enabled: message.can-react && root.composer-enabled;
                                                                clicked => { root.react(message.item, reaction.key); }
                                                            }
                                                        }
                                                        if message.delivery != "": HorizontalLayout {
                                                            spacing: 4px; alignment: start;
                                                            Text { text: message.delivery; color: message.delivery-failed ? Theme.danger : Theme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                                            if message.can-retry: ActionButton { text: "Retry"; ghost: true; small: true; clicked => { root.retry(message.item); } }
                                                            if message.can-cancel: ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { root.cancel-send(message.item); } }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // Actions, the reaction picker and delete confirmation float over the
                                        // row's top edge, so opening them never moves the timeline.
                                        if (self.lit || root.react-item == message.item || root.menu-item == message.item || root.confirm-delete == message.item) && !message.deleted && message.delivery == "": Rectangle {
                                            x: parent.width - self.width - 16px; y: parent.top + (index == 0 ? 4px : -16px);
                                            width: actions.preferred-width; height: actions.preferred-height;
                                            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                                            drop-shadow-blur: 10px; drop-shadow-color: #00000059; drop-shadow-offset-y: 2px;
                                            actions := HorizontalLayout {
                                                padding: 3px; spacing: 0px;
                                                if root.confirm-delete == message.item: HorizontalLayout {
                                                    spacing: 4px; padding-left: 8px;
                                                    Text { text: "Delete for everyone?"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                    ActionButton { text: "Delete"; danger: true; small: true; clicked => { root.confirm-delete-message(); } }
                                                    ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { root.cancel-delete(); } }
                                                }
                                                // Frequent reactions, then the picker, Edit on your own message or
                                                // Reply on someone else's, and everything else under More.
                                                if root.confirm-delete != message.item: HorizontalLayout {
                                                    spacing: 0px;
                                                    if message.can-react && root.composer-enabled: HorizontalLayout {
                                                        spacing: 0px;
                                                        for cell in root.bar-reactions: EmojiButton {
                                                            emoji: cell; font: root.emoji-font;
                                                            clicked => { root.react(message.item, cell.key); }
                                                        }
                                                        Rectangle {
                                                            width: 9px;
                                                            Rectangle { width: 1px; height: 20px; background: Theme.line; }
                                                        }
                                                        IconButton {
                                                            icon: @image-url("icons/smile-plus.svg"); label: "Add reaction";
                                                            clicked => {
                                                                root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                                root.open-picker(message.item);
                                                            }
                                                        }
                                                    }
                                                    if message.own && message.can-edit && root.composer-enabled: IconButton { icon: @image-url("icons/pencil.svg"); label: "Edit"; clicked => { root.edit(message.item); root.focus-composer(); } }
                                                    if !(message.own && message.can-edit) && message.can-reply && root.composer-enabled: IconButton { icon: @image-url("icons/reply.svg"); label: "Reply"; clicked => { root.reply(message.item); root.focus-composer(); } }
                                                    IconButton {
                                                        icon: @image-url("icons/ellipsis.svg"); label: "More";
                                                        clicked => {
                                                            root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                            root.open-menu(message);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.requests-open: RequestsScreen {
                                width: parent.width; height: parent.height;
                                friend-requests: root.friend-requests;
                                message-requests: root.message-requests;
                                spam: root.spam-rooms;
                                accept(id) => { root.befriend(id); }
                                remove(id) => { root.remove-friend-request(id); }
                                open(id) => { root.select-room(id); }
                            }
                            if root.friends-open: FriendsScreen {
                                width: parent.width; height: parent.height;
                                rows: root.friends-all ? root.friends : root.friends-online;
                                all: root.friends-all; total: root.friend-count;
                                filter <=> root.friend-filter;
                                filter-edited => { root.friend-filter-edited(); }
                                message(id) => { root.message-friend(id); }
                                add-friend => { root.open-add-friend(); }
                            }
                            // The conversation's opening, or what to do when none is chosen.
                            if !root.room-selected && !root.requests-open && !root.friends-open: NoConversation {
                                width: parent.width; height: parent.height;
                            }
                            if root.room-selected && root.messages.length == 0 && !root.room-ready: MessagesSkeleton {
                                width: parent.width; height: parent.height;
                            }
                            if root.room-selected && root.messages.length == 0 && root.room-ready: ConversationStart {
                                width: parent.width; height: parent.height;
                                room-selected: root.room-selected; room-ready: root.room-ready; room-direct: root.room-direct; room-name: root.room-name;
                                room-icon: root.room-icon; room-initial: root.room-initial; room-tint: root.room-tint; room-picture: root.room-picture;
                            }
                            // Who else is typing, just above the composer in the room the
                            // last message leaves under it, so the timeline doesn't move.
                            // Its text lines up with the messages' (16px, a 40px avatar
                            // and 16px in), and it breathes gently while they type.
                            if root.typing != "" && root.room-selected && !root.voice-room: Rectangle {
                                x: 72px - 4px; y: parent.height - self.height;
                                width: min(parent.width - 72px - 12px, typing-text.preferred-width + 8px); height: 20px;
                                background: Theme.chat;
                                typing-text := Text {
                                    x: 4px; width: parent.width - 8px;
                                    text: root.typing; color: Theme.text; font-size: 13px; font-weight: 500;
                                    vertical-alignment: center; overflow: elide;
                                    opacity: 0.75 + 0.25 * sin(animation-tick() / 1ms * 0.25deg);
                                }
                            }
                        }
                        // Composer.
                        VerticalLayout {
                            visible: !root.voice-room && root.room-selected;
                            min-height: 0px;
                            max-height: root.voice-room || !root.room-selected ? 0px : 100000px;
                            padding-left: 16px; padding-right: 16px; padding-top: 0px; padding-bottom: 0px;
                            spacing: 0px; vertical-stretch: 0;
                            if root.room-request: RequestBar {
                                request-title: root.request-title;
                                accept-request => { root.accept-request(); }
                                ignore-request => { root.ignore-request(); }
                            }
                            if root.compose-label != "": Rectangle {
                                height: 36px; background: Theme.sidebar;
                                border-top-left-radius: 10px; border-top-right-radius: 10px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 4px; spacing: 8px;
                                    Image { source: root.is-editing ? @image-url("icons/pencil.svg") : @image-url("icons/reply.svg"); width: 16px; image-fit: contain; colorize: Theme.muted; }
                                    Text { text: root.compose-label; color: Theme.secondary; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    IconButton { icon: @image-url("icons/x.svg"); label: root.is-editing ? "Cancel editing" : "Cancel reply"; size: 28px; glyph: 16px; clicked => { root.cancel-compose(); } }
                                }
                            }
                            composer-box := Rectangle {
                                visible: !root.room-request;
                                min-height: root.room-request ? 0px : 48px; max-height: root.room-request ? 0px : 100000px;
                                background: Theme.field;
                                border-radius: 10px;
                                border-top-left-radius: root.compose-label != "" ? 0px : 10px;
                                border-top-right-radius: root.compose-label != "" ? 0px : 10px;
                                VerticalLayout {
                                    spacing: 0px;
                                    // Files waiting to go with the message, in a row that scrolls sideways.
                                    if root.staged.length > 0: Flickable {
                                        height: 152px;
                                        content-width: max(self.width, staged-row.preferred-width);
                                        staged-row := HorizontalLayout {
                                            padding: 10px; padding-bottom: 2px; spacing: 8px; alignment: start;
                                            for file[index] in root.staged: StagedTile {
                                                file: file;
                                                remove => { root.unstage(index); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 8px; spacing: 6px;
                                        // The buttons stay on the last line as the composer grows.
                                        VerticalLayout {
                                            alignment: end; padding-bottom: 8px;
                                            IconButton {
                                                icon: @image-url("icons/circle-plus.svg"); label: "Attach files";
                                                glyph: 22px;
                                                enabled: root.can-attach; clicked => { root.attach(); }
                                            }
                                        }
                                        composer := Composer {
                                            text <=> root.draft; enabled: root.composer-enabled; label: "Message";
                                            placeholder: root.is-editing ? "Edit your message" : root.compose-label != "" ? "Write a reply" : root.room-selected && !root.room-direct ? "Message #" + root.room-name : root.room-selected ? "Message " + root.room-name : "Write a message";
                                            edited(text) => { root.draft-edited(text); }
                                            accepted => { root.send(); }
                                            suggesting: root.mentions.length > 0 || root.emoji-suggestions.length > 0;
                                            caret(text, offset) => { root.composer-caret(text, offset); }
                                            suggestion-moved(step) => {
                                                if root.mentions.length > 0 {
                                                    root.mention-index = Math.mod(root.mention-index + step + root.mentions.length, root.mentions.length);
                                                } else {
                                                    root.emoji-suggestion-index = Math.mod(root.emoji-suggestion-index + step + root.emoji-suggestions.length, root.emoji-suggestions.length);
                                                }
                                            }
                                            suggestion-chosen => {
                                                if root.mentions.length > 0 { root.mention-chosen(root.mention-index); }
                                                else { root.emoji-suggestion-chosen(root.emoji-suggestion-index); }
                                            }
                                            suggestion-dismissed => {
                                                if root.mentions.length > 0 { root.mention-dismissed(); } else { root.emoji-suggestion-dismissed(); }
                                            }
                                            up-from-empty => { root.edit-last(); }
                                            up-to-messages => { root.browse-messages(); }
                                            paste => { root.paste-into-composer(); }
                                        }
                                        VerticalLayout {
                                            alignment: end; padding-bottom: 8px;
                                            IconButton {
                                                icon: @image-url("icons/smile.svg"); label: "Add an emoji";
                                                glyph: 22px; enabled: root.composer-enabled;
                                                tint: root.react-item == "talk:composer" ? Theme.text : Theme.secondary;
                                                clicked => {
                                                    root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                    root.open-picker("talk:composer");
                                                }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: end; padding-bottom: 8px;
                                            IconButton {
                                                icon: @image-url("icons/send-horizontal.svg");
                                                label: root.sending ? "Sending..." : root.is-editing ? "Save" : "Send";
                                                enabled: root.can-send; emphasis: root.can-send;
                                                clicked => { root.send(); }
                                            }
                                        }
                                    }
                                }
                            }
                            // A hint under the field when there is one; otherwise as much
                            // room below it as beside it.
                            if root.composer-hint != "": HorizontalLayout {
                                height: 22px; spacing: 6px; padding-left: 4px;
                                if root.room-encrypted || root.preview: Image { source: @image-url("icons/lock.svg"); width: 12px; image-fit: contain; colorize: Theme.muted; }
                                Text { text: root.composer-hint; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                            if root.composer-hint == "": Rectangle { height: 16px; }
                        }
                    }
                    if root.members-docked: MemberPanel {
                        width: 240px; rows: root.roster; note: root.roster-note; selected: root.profile-member;
                        open-profile(id, y) => { root.profile-y = y; root.profile-at-pointer = false; root.show-profile(id); }
                    }
                    if root.profile-docked: Rectangle {
                        width: 300px;
                        ProfileCard {
                            docked: true; width: parent.width; height: parent.height;
                            data: root.panel-profile;
                            enlarge => { root.enlarge-panel-profile(); }
                            befriend => { root.befriend(root.panel-profile.id); }
                            open-link(link) => { root.open-link(link); }
                            open-server(server, x, y, width, height) => { root.open-server-card(server, x, y, width, height); }
                            open-friend(id, x, y, width, height) => {
                                root.anchor(x, y, width, height, false);
                                root.profile-at-pointer = true;
                                root.show-friend-profile(id, false);
                            }
                        }
                    }
                }
            }
            // The header casts a soft shadow over the conversation.
            Rectangle {
                y: 48px; height: 6px;
                background: @linear-gradient(180deg, #00000040 0%, #00000000 100%);
            }
        }
    }
    // The edge between sidebar and conversation resizes the sidebar. A double-click
    // restores the default width.
    if root.workspace: TouchArea {
        x: 72px + root.sidebar-shown - 4px; y: 0px; width: 8px; height: root.height;
        mouse-cursor: ew-resize;
        moved => {
            if self.pressed {
                root.sidebar-width = max(180px, min(380px, root.width - 72px - 420px - (root.members-docked ? 240px : 0px) - (root.profile-docked ? 300px : 0px), root.sidebar-shown + self.mouse-x - self.pressed-x));
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up { root.sidebar-resized(root.sidebar-shown); }
        }
        double-clicked => { root.sidebar-width = 240px; root.sidebar-resized(240px); }
        Rectangle {
            x: 3px; width: 2px;
            background: parent.pressed ? Theme.faint : Theme.line;
            opacity: parent.has-hover || parent.pressed ? 1 : 0;
            animate opacity { duration: 120ms; }
        }
    }

    // A call ringing this account elsewhere, at the top until it's answered or stops.
    if root.incoming-open: IncomingCall {
        x: (root.width - self.width) / 2; y: 64px;
        incoming-room: root.incoming-room; incoming-name: root.incoming-name; incoming-detail: root.incoming-detail;
        incoming-initial: root.incoming-initial; incoming-tint: root.incoming-tint; incoming-picture: root.incoming-picture;
        answer-call(room, accept) => { root.answer-call(room, accept); }
    }

    property <bool> switching: root.switch-prompt != "";
    property <string> switch-text;
    changed switch-prompt => { if root.switch-prompt != "" { root.switch-text = root.switch-prompt; } }
    changed switching => { if root.switching { switch-dialog.focus-keys(); } else { switch-dialog.release-keys(); } }
    // Switching voice channels asks first; see SwitchDialog.
    switch-dialog := SwitchDialog {
        switching: root.switching; switch-text: root.switch-text;
        cancel-switch => { root.cancel-switch(); }
        confirm-switch => { root.confirm-switch(); }
    }
    // Mention suggestions, just above the composer and as wide as it, over a
    // reply's or an edit's bar; see MentionList.
    if root.mentions.length > 0 && root.composer-enabled: MentionList {
        x: composer-box.absolute-position.x;
        width: composer-box.width;
        y: composer-box.absolute-position.y - (root.compose-label != "" ? 36px : 0px) - self.height - 8px;
        mentions: root.mentions; mention-index: root.mention-index;
        mention-chosen(index) => { root.mention-chosen(index); }
    }
    // Emoji suggestions, in the same place; see EmojiSuggestions.
    if root.emoji-suggestions.length > 0 && root.mentions.length == 0 && root.composer-enabled: EmojiSuggestions {
        x: composer-box.absolute-position.x;
        width: composer-box.width;
        y: composer-box.absolute-position.y - (root.compose-label != "" ? 36px : 0px) - self.height - 8px;
        emoji: root.emoji-suggestions; query: root.emoji-suggestion-query;
        emoji-index: root.emoji-suggestion-index; emoji-font: root.emoji-font;
        emoji-chosen(index) => { root.emoji-suggestion-chosen(index); }
    }
    // Settings cover the window, showing one section.
    if root.settings-open: SettingsScreen {
        settings-section <=> root.settings-section;
        discord-build: root.discord-build; preview: root.preview;
        close => { root.settings-open = false; }
        refresh-devices => { root.refresh-devices(); }
        if root.settings-section == 0: AccountSettings {
            account-name: root.account-name; account-status: root.account-status;
            account-initial: root.account-initial; account-tint: root.account-tint; account-picture: root.account-picture;
            storage: root.storage; preview: root.preview; online: root.online; busy: root.busy; sending: root.sending;
            discord-linked: root.discord-linked; has-custom-status: root.has-custom-status;
            retry-sync => { root.retry-sync(); }
            set-custom-status => { root.settings-open = false; root.open-status(); }
            sign-out => { root.settings-open = false; root.logout(); }
        }
        if root.settings-section == 1: VoiceSettings {
            microphones: root.microphones; microphone-index: root.microphone-index;
            speakers: root.speakers; speaker-index: root.speaker-index;
            unmute-on-join <=> root.unmute-on-join; level-voice <=> root.level-voice;
            select-microphone(index) => { root.select-microphone(index); }
            select-speaker(index) => { root.select-speaker(index); }
            refresh-devices => { root.refresh-devices(); }
            preferences-changed => { root.preferences-changed(); }
        }
        if root.settings-section == 2: MessageSettings {
            message-font-size: root.message-font-size;
            twelve-hour-clock <=> root.twelve-hour-clock; text-size <=> root.text-size;
            link-previews <=> root.link-previews; share-typing <=> root.share-typing;
            matrix: root.matrix-build; discord: root.discord-linked;
            preferences-changed => { root.preferences-changed(); }
        }
        if root.settings-section == 3: NotificationSettings {
            notifications <=> root.notifications; notification-sound <=> root.notification-sound;
            notification-text <=> root.notification-text;
            matrix: root.matrix-build; discord: root.discord-linked;
            preferences-changed => { root.preferences-changed(); }
        }
        if root.settings-section == 4 && !root.discord-linked: DiscordLinkSettings {
            link-phase: root.link-phase; link-code: root.link-code; link-name: root.link-name; link-note: root.link-note;
            link-discord => { root.link-discord(); }
        }
        if root.settings-section == 4 && root.discord-linked: DiscordSettings {
            matrix-build: root.matrix-build;
            show-hidden-channels: root.show-hidden-channels; sync-discord-reads: root.sync-discord-reads;
            unlink-discord => { root.unlink-discord(); }
            show-hidden-channels-toggled(shown) => { root.show-hidden-channels = shown; root.show-hidden-channels-toggled(shown); }
            sync-discord-reads-toggled(sync) => { root.sync-discord-reads = sync; root.sync-discord-reads-toggled(sync); }
        }
    }
    // A role mentioned in a message: who Talk knows has it. Clicking someone opens
    // their card over it; Escape or a click outside closes it.
    if root.role-open: Rectangle {
        TouchArea { clicked => { root.close-role(); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-role(); return accept; }
                return reject;
            }
        }
        RoleCard {
            x: root.beside(root.role-x, root.role-width, self.width);
            y: max(8px, min(root.height - self.height - 8px, root.role-y - 8px));
            limit: root.height - 16px;
            role-name: root.role-name; role-color: root.role-color; role-has-color: root.role-has-color;
            role-members: root.role-members; role-note: root.role-note;
            open-member(id, x, y, width, height) => {
                root.anchor(x, y, width, height, true);
                root.profile-at-pointer = true;
                root.show-profile(id);
            }
            choose-member(id) => { root.profile-at-pointer = true; root.show-profile(id); }
        }
    }
    // A member's card, beside the member list. Escape or a click outside closes it.
    if root.profile-open && !root.profile-large: Rectangle {
        TouchArea { clicked => { root.close-profile(); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-profile(); return accept; }
                return reject;
            }
        }
        ProfileCard {
            width: 300px; limit: root.height - 16px;
            x: root.profile-at-pointer
                ? root.beside(root.anchor-x, root.anchor-width, self.width)
                : root.width - 240px - 8px - self.width;
            y: max(8px, min(root.height - self.height - 8px, (root.profile-at-pointer ? root.anchor-y - 8px : root.profile-y - 16px)));
            data: root.profile;
            enlarge => { root.enlarge-profile(); }
            close => { root.close-profile(); }
            befriend => { root.befriend(root.profile.id); }
            open-link(link) => { root.open-link(link); }
        }
    }
    // A full profile over the window, as the viewer shows images.
    if root.profile-open && root.profile-large: Rectangle {
        background: #000000b3;
        TouchArea { clicked => { root.close-profile(); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-profile(); return accept; }
                return reject;
            }
        }
        ProfileCard {
            large: true;
            width: min(600px, root.width - 64px); limit: root.height - 64px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            data: root.profile;
            close => { root.close-profile(); }
            befriend => { root.befriend(root.profile.id); }
            open-link(link) => { root.open-link(link); }
            open-server(server, x, y, width, height) => { root.open-server-card(server, x, y, width, height); }
            // In the full profile, a friend's opens full too.
            open-friend(id, x, y, width, height) => { root.show-friend-profile(id, true); }
        }
    }
    // A mutual server's card, over the profile that lists it. Clicking
    // outside or Escape closes it.
    if root.server-card-open: Rectangle {
        TouchArea { clicked => { root.server-card-open = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.server-card-open = false; return accept; }
                return reject;
            }
        }
        ServerCard {
            width: 300px;
            x: root.beside(root.anchor-x, root.anchor-width, self.width);
            y: max(8px, min(root.height - self.height - 8px, root.anchor-y - 8px));
            server: root.server-card;
            open => {
                root.server-card-open = false;
                root.close-profile();
                root.navigate-server(root.server-card.id);
            }
        }
    }
    // An image shown large over everything; see ImageViewer.
    if root.viewer-open: ImageViewer {
        viewer-image: root.viewer-image; viewer-frames: root.viewer-frames; viewer-delays: root.viewer-delays;
        viewer-width: root.viewer-width; viewer-height: root.viewer-height; viewer-name: root.viewer-name;
        viewer-position: root.viewer-position; viewer-note: root.viewer-note;
        viewer-item: root.viewer-item; viewer-index: root.viewer-index; preview: root.preview;
        close-image => { root.close-image(); }
        step-image(step) => { root.step-image(step); }
        save-attachment(item, index) => { root.save-attachment(item, index); }
    }
    // Adding a Discord friend by username; see AddFriendDialog.
    if root.add-friend-open: AddFriendDialog {
        add-friend-name <=> root.add-friend-name;
        add-friend-sending: root.add-friend-sending; add-friend-sent: root.add-friend-sent; add-friend-note: root.add-friend-note;
        add-friend(name) => { root.add-friend(name); }
        close-add-friend => { root.close-add-friend(); }
    }
    // The custom status; see StatusDialog.
    if root.status-open: StatusDialog {
        status-text <=> root.status-text; status-emoji <=> root.status-emoji; status-clear-after <=> root.status-clear-after;
        has-custom-status: root.has-custom-status; status-saving: root.status-saving; status-error: root.status-error;
        emoji-font: root.emoji-font;
        pick-emoji => { root.open-picker("talk:status"); }
        pick-emoji-beside(x, y, width, height) => {
            root.anchor(x, y, width, height, true);
            root.open-picker("talk:status");
        }
        save-status => { root.save-status(); }
        clear-status => { root.clear-status(); }
        close-status => { root.close-status(); }
    }
    // Starting a DM; see NewDmDialog.
    if root.new-dm-open: NewDmDialog {
        new-dm-query <=> root.new-dm-query; matrix: root.matrix-build;
        new-dm-people: root.new-dm-people; new-dm-starting: root.new-dm-starting; new-dm-note: root.new-dm-note;
        new-dm-search => { root.new-dm-search(); }
        start-dm(index) => { root.start-dm(index); }
        close-new-dm => { root.close-new-dm(); }
    }
    // Forwarding a message; see ForwardDialog.
    if root.forward-open: ForwardDialog {
        forward-preview: root.forward-preview; forward-targets: root.forward-targets;
        forward-query <=> root.forward-query;
        forward-search => { root.forward-search(); }
        forward-to(id) => { root.forward-to(id); }
        close-forward => { root.close-forward(); }
    }
    // The zoom level, for a moment after it changes.
    if root.zoom-note != "": Rectangle {
        x: (root.width - self.width) / 2; y: 12px;
        width: zoom-text.preferred-width + 28px; height: 36px;
        border-radius: 18px; background: #0b0c0e;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 3px;
        accessible-role: text; accessible-label: "Zoom " + root.zoom-note;
        zoom-text := Text { text: root.zoom-note; color: Theme.text; font-size: 15px; font-weight: 700; }
    }
    if Tip.text != "": Rectangle {
        property <length> w: tip-text.preferred-width + 20px;
        property <length> h: 32px;
        x: Tip.side == 1 ? Tip.x + 10px : max(8px, min(root.width - self.w - 8px, Tip.x - self.w / 2));
        y: Tip.side == 1 ? Tip.y - self.h / 2 : Tip.side == 0 ? max(4px, Tip.y - self.h - 6px) : Tip.y + 6px;
        width: self.w; height: self.h;
        border-radius: 6px; background: #0b0c0e;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 3px;
        tip-text := Text { text: Tip.text; color: Theme.text; font-size: 14px; font-weight: 700; }
    }
}
