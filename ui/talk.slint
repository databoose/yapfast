import { ComboBox, ScrollView, ListView, Palette, Switch } from "std-widgets.slint";
import "fonts/Satoshi-Regular.ttf";
import "fonts/Satoshi-Italic.ttf";
import "fonts/Satoshi-Medium.ttf";
import "fonts/Satoshi-Bold.ttf";
import "fonts/Satoshi-BoldItalic.ttf";
import "fonts/Satoshi-Black.ttf";

// Layered graphite: the rail is darkest, the conversation lightest. Marigold marks
// selection and primary actions, red mentions and destructive actions, green live voice.
global Theme {
    out property <color> rail: #111215;
    out property <color> sidebar: #17181c;
    out property <color> panel: #121316;
    out property <color> chat: #1e1f24;
    out property <color> stage: #1e1f24;
    out property <color> raised: #26272e;
    out property <color> field: #2a2b32;
    out property <color> sunken: #0e0f12;
    out property <color> hover: #222329;
    out property <color> active: #2c2d35;
    out property <color> row-hover: #1a1b20;
    out property <color> line: #2c2d34;
    out property <color> edge: #0c0d0f;
    out property <color> text: #eef0f4;
    out property <color> secondary: #b5b8c1;
    out property <color> muted: #8d919c;
    out property <color> faint: #5c606a;
    out property <color> accent: #ffbf47;
    out property <color> accent-hover: #ffcd70;
    out property <color> on-accent: #1d1607;
    out property <color> accent-soft: #ffbf4726;
    out property <color> danger: #f0545e;
    out property <color> danger-hover: #f46f77;
    out property <color> live: #3ecf7e;
    out property <color> link: #7cc4ff;
    out property <duration> quick: 120ms;
}

// One tooltip for the whole window, drawn above everything else.
global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    /// 0 above the anchor, 1 to its right, 2 below it.
    in-out property <int> side;
}

// Centres a fixed-size child across a row, which Slint layouts align to the top.
component Middle inherits VerticalLayout {
    alignment: center;
}

component Label inherits Text {
    color: Theme.muted; font-size: 13px; wrap: word-wrap;
    vertical-stretch: 0;
}

// A labelled action. Primary is marigold, danger red, ghost transparent until hovered.
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> ghost;
    in property <bool> danger;
    in property <bool> small;
    callback clicked;
    min-width: max(root.small ? 28px : 36px, content.preferred-width);
    min-height: root.small ? 28px : 36px;
    max-height: self.min-height;
    vertical-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? (root.primary ? Theme.accent.with-alpha(0.3) : root.ghost ? transparent : Theme.raised)
        : root.primary ? (pointer.has-hover ? Theme.accent-hover : Theme.accent)
        : root.danger ? (pointer.has-hover ? Theme.danger-hover : Theme.danger)
        : root.ghost ? (pointer.has-hover ? #ffffff14 : transparent)
        : (pointer.has-hover ? #3c3d46 : #33343c);
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    property <color> ink: !root.enabled ? (root.primary ? Theme.on-accent.with-alpha(0.6) : Theme.faint)
        : root.primary ? Theme.on-accent : root.danger ? #ffffff
        : root.ghost && !pointer.has-hover ? Theme.secondary : Theme.text;
    content := HorizontalLayout {
        padding-left: root.small ? 10px : 16px; padding-right: self.padding-left;
        spacing: 8px; alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon; width: root.small ? 16px : 18px; image-fit: contain;
            colorize: root.ink;
        }
        if root.text != "": Text {
            text: root.text; color: root.ink; font-size: root.small ? 14px : 15px; font-weight: 700;
            vertical-alignment: center; overflow: elide;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}

// An icon-only action with a tooltip naming it.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    /// A state worth warning about, such as a muted microphone: drawn in red.
    in property <bool> alert;
    in property <bool> danger;
    in property <bool> emphasis;
    in property <length> size: 32px;
    in property <length> glyph: 20px;
    in property <color> tint: Theme.secondary;
    in property <color> fill: transparent;
    in property <int> tip-side: 0;
    in property <length> radius: 6px;
    out property <bool> hovered: pointer.has-hover;
    callback clicked;
    // The root fills its row; the visible face stays square and centred.
    width: root.size; min-height: root.size;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    face := Rectangle {
        width: root.size; height: root.size;
        border-radius: root.radius;
        background: !root.enabled ? root.fill
            : root.emphasis ? (pointer.has-hover ? Theme.accent-hover : Theme.accent)
            : root.danger && pointer.has-hover ? Theme.danger.with-alpha(0.16)
            : pointer.has-hover ? root.fill.mix(#ffffff, 0.9) : root.fill;
        animate background { duration: Theme.quick; }
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.accent;
        Image {
            source: root.icon; width: root.glyph; height: root.glyph;
            colorize: !root.enabled ? Theme.faint : root.emphasis ? Theme.on-accent
                : root.alert || (root.danger && pointer.has-hover) ? Theme.danger
                : pointer.has-hover ? Theme.text : root.tint;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => { Tip.text = ""; root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.label;
                    Tip.side = root.tip-side;
                    Tip.x = root.tip-side == 1 ? face.absolute-position.x + root.size : face.absolute-position.x + root.size / 2;
                    Tip.y = root.tip-side == 0 ? face.absolute-position.y : root.tip-side == 1 ? face.absolute-position.y + root.size / 2 : face.absolute-position.y + root.size;
                } else if Tip.text == root.label {
                    Tip.text = "";
                }
            }
        }
    }
}

// A toggle with a caret beside it that opens its device menu. The pair shares one
// hover ground, so the caret reads as part of the control it configures.
component DeviceToggle inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> menu-label;
    in property <bool> alert;
    in property <bool> enabled: true;
    in property <bool> open;
    callback clicked;
    callback menu;
    width: 52px; min-height: 32px;
    // The ground is the visible pair only, centred in the row like IconButton's face.
    Rectangle {
        y: (parent.height - self.height) / 2; height: 32px;
        border-radius: 6px;
        background: root.open || toggle.hovered || caret.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.quick; }
    }
    HorizontalLayout {
        toggle := IconButton {
            icon: root.icon; label: root.label; alert: root.alert; enabled: root.enabled;
            clicked => { root.clicked(); }
        }
        Rectangle {
            width: 20px;
            accessible-role: button;
            accessible-label: root.menu-label;
            accessible-action-default => { root.menu(); }
            Rectangle {
                y: (parent.height - self.height) / 2; width: 20px; height: 32px; border-radius: 6px;
                background: caret.has-hover ? #ffffff14 : transparent;
                animate background { duration: Theme.quick; }
                border-width: caret-focus.has-focus ? 2px : 0px;
                border-color: Theme.accent;
                Image {
                    source: @image-url("icons/chevron-down.svg"); width: 14px; height: 14px;
                    colorize: caret.has-hover || root.open ? Theme.text : Theme.muted;
                    transform-rotation: root.open ? 180deg : 0deg;
                    animate transform-rotation { duration: Theme.quick; }
                }
            }
            caret-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == "\n" || event.text == " " {
                        root.menu(); return accept;
                    }
                    return reject;
                }
                caret := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { Tip.text = ""; root.menu(); }
                    changed has-hover => {
                        if self.has-hover && !root.open {
                            Tip.text = root.menu-label;
                            Tip.side = 0;
                            Tip.x = self.absolute-position.x + self.width / 2;
                            Tip.y = self.absolute-position.y + (self.height - 32px) / 2;
                        } else if Tip.text == root.menu-label {
                            Tip.text = "";
                        }
                    }
                }
            }
        }
    }
}

// A person's picture, or a round initial in their own tint until it arrives;
// optionally ringed while they speak.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint: #6b7280;
    in property <image> picture;
    in property <length> size: 40px;
    in property <bool> speaking;
    width: root.size; height: root.size;
    border-radius: root.size / 2;
    background: root.picture.width > 0 ? transparent : root.tint;
    if root.picture.width == 0: Text {
        text: root.initial; color: #ffffff; font-size: root.size * 0.42; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.picture.width > 0: Rectangle {
        width: root.size; height: root.size;
        border-radius: root.size / 2; clip: true;
        Image { source: root.picture; width: root.size; height: root.size; image-fit: cover; }
    }
    if root.speaking: Rectangle {
        x: -3px; y: -3px; width: root.size + 6px; height: root.size + 6px;
        border-radius: self.width / 2; border-width: 2px; border-color: Theme.live;
    }
}

// A single-line text field. Long text scrolls to keep the cursor visible.
component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> password;
    in property <string> label;
    in property <length> text-size: 16px;
    in property <length> pad: 12px;
    in property <color> fill: Theme.sunken;
    in property <bool> ring: true;
    callback edited(string);
    callback accepted;
    public function focus-input() { input.focus(); }
    min-height: 40px; vertical-stretch: 0; horizontal-stretch: 1;
    border-radius: 6px;
    background: root.fill;
    border-width: root.ring && input.has-focus ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.8);
    Text {
        x: root.pad; width: root.width - 2 * root.pad; height: root.height;
        visible: root.text == "";
        text: root.placeholder; color: root.enabled ? Theme.muted : Theme.faint; font-size: root.text-size;
        vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: root.pad; width: root.width - 2 * root.pad; height: root.height; clip: true;
        input := TextInput {
            property <length> scroll: 0px;
            x: min(0px, max(parent.width - self.width, self.scroll));
            width: max(parent.width, self.preferred-width + self.text-cursor-width);
            height: parent.height;
            text <=> root.text;
            enabled: root.enabled;
            single-line: true;
            vertical-alignment: center;
            font-size: root.text-size;
            color: root.enabled ? Theme.text : Theme.muted;
            input-type: root.password ? InputType.password : InputType.text;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            accessible-label: root.label;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }
            cursor-position-changed(position) => {
                if position.x + self.scroll < 0px {
                    self.scroll = -position.x;
                } else if position.x + self.scroll > parent.width - self.text-cursor-width {
                    self.scroll = parent.width - self.text-cursor-width - position.x;
                }
            }
        }
    }
}

// A server or the DM home: a circle that becomes a squircle, with a pill at the rail edge.
component RailItem inherits Rectangle {
    in property <string> label;
    /// The tooltip; the accessible label may add state such as "unread".
    in property <string> tip: root.label;
    in property <string> initial;
    in property <image> icon;
    /// The server's own icon, filling the item instead of the initial.
    in property <image> picture;
    in property <bool> selected;
    in property <bool> unread;
    /// Marks a Discord server.
    in property <bool> discord;
    callback clicked;
    width: 72px; height: 48px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <bool> lit: root.selected || pointer.has-hover;
    Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: 4px;
        height: root.selected ? 40px : pointer.has-hover ? 20px : root.unread ? 8px : 0px;
        border-top-right-radius: 4px; border-bottom-right-radius: 4px;
        background: Theme.text;
        animate height { duration: 160ms; easing: ease-out; }
    }
    // A picture only changes shape when lit, as in Discord.
    tile := Rectangle {
        x: 12px; width: 48px; height: 48px;
        border-radius: root.lit ? 16px : 24px;
        background: root.lit && root.picture.width == 0 ? Theme.accent : Theme.raised;
        animate border-radius, background { duration: 160ms; easing: ease-out; }
        clip: true;
        if root.picture.width > 0: Image {
            source: root.picture; width: 48px; height: 48px; image-fit: cover;
        }
        if root.icon.width > 0: Image {
            source: root.icon; width: 24px; height: 24px;
            colorize: root.lit ? Theme.on-accent : Theme.text;
        }
        if root.icon.width == 0 && root.picture.width == 0: Text {
            text: root.initial; font-size: 17px; font-weight: 700;
            color: root.lit ? Theme.on-accent : Theme.text;
        }
        // The focus ring, drawn over the picture.
        Rectangle {
            width: 48px; height: 48px; border-radius: tile.border-radius;
            border-width: focus.has-focus ? 2px : 0px;
            border-color: Theme.text;
        }
    }
    // Discord's blurple, on a ring of the rail's colour so it reads as a tag.
    if root.discord: Rectangle {
        x: 12px + 48px - 14px; y: (parent.height + 48px) / 2 - 14px;
        width: 18px; height: 18px; border-radius: 9px;
        background: Theme.rail;
        Rectangle {
            width: 12px; height: 12px; border-radius: 6px;
            background: #5865f2;
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.tip;
                    Tip.side = 1;
                    Tip.x = root.absolute-position.x + root.width;
                    Tip.y = root.absolute-position.y + root.height / 2;
                } else if Tip.text == root.tip {
                    Tip.text = "";
                }
            }
        }
    }
}

// A channel or DM in the sidebar.
component ChannelRow inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <bool> person;
    in property <string> initial;
    in property <color> tint;
    in property <bool> selected;
    in property <bool> unread;
    in property <string> badge;
    /// A channel this account may not join: drawn faint.
    in property <bool> locked;
    callback clicked;
    height: root.person ? 42px : 34px;
    border-radius: 6px;
    background: root.selected ? Theme.active : pointer.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <color> ink: root.locked ? (root.selected ? Theme.muted : Theme.faint) : root.selected || root.unread ? Theme.text : pointer.has-hover ? Theme.secondary : Theme.muted;
    // Unread activity is marked at the sidebar's edge, as on the server rail.
    if root.unread && !root.selected: Rectangle {
        x: -8px; y: (parent.height - self.height) / 2; width: 4px; height: 8px;
        border-top-right-radius: 4px; border-bottom-right-radius: 4px; background: Theme.text;
    }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: root.person ? 12px : 8px;
        if root.person: Middle { Avatar { size: 32px; initial: root.initial; tint: root.tint; } }
        if !root.person: Image { source: root.icon; width: 20px; image-fit: contain; colorize: root.selected || root.unread ? Theme.secondary : Theme.faint; }
        Text {
            text: root.text; color: root.ink; font-size: 16px; font-weight: root.unread || root.selected ? 700 : 500;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        }
        if root.badge != "": Middle {
            Rectangle {
                width: max(18px, badge-text.preferred-width + 10px); height: 18px; border-radius: 9px; background: Theme.danger;
                badge-text := Text { text: root.badge; color: #ffffff; font-size: 11px; font-weight: 700; }
            }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
}

// One choice in a menu, with a check beside the current one.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> checked;
    /// A destructive choice, such as deleting: drawn in red.
    in property <bool> danger;
    callback clicked;
    height: 32px;
    border-radius: 4px;
    background: pointer.has-hover ? (root.danger ? Theme.danger.with-alpha(0.16) : Theme.active) : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        Image {
            source: root.checked ? @image-url("icons/check.svg") : root.icon;
            width: 16px; image-fit: contain;
            colorize: root.checked ? Theme.accent : root.danger ? Theme.danger : pointer.has-hover ? Theme.text : Theme.muted;
        }
        Text {
            text: root.text; color: root.danger ? Theme.danger : root.checked || pointer.has-hover ? Theme.text : Theme.secondary;
            font-size: 15px; font-weight: root.checked ? 700 : 400;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
}

export struct EmojiCell { glyph: string, name: string }
/// A heading, or up to a row's worth of emoji, in the emoji picker.
export struct EmojiRow { heading: string, cells: [EmojiCell] }

// An emoji to react with, named by a tooltip unless it reports hovering instead.
component EmojiButton inherits Rectangle {
    in property <EmojiCell> emoji;
    in property <string> font;
    in property <length> size: 32px;
    in property <length> glyph: 20px;
    in property <color> fill: transparent;
    in property <bool> tip: true;
    callback clicked;
    callback hovered;
    width: root.size; height: root.size;
    border-radius: 6px;
    background: pointer.has-hover ? #ffffff1f : root.fill;
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: "React with " + root.emoji.name;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    Text {
        text: root.emoji.glyph; font-family: root.font; font-size: root.glyph;
        horizontal-alignment: center; vertical-alignment: center;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { Tip.text = ""; root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    root.hovered();
                    if root.tip {
                        Tip.text = root.emoji.name;
                        Tip.side = 0;
                        Tip.x = root.absolute-position.x + root.width / 2;
                        Tip.y = root.absolute-position.y;
                    }
                } else if Tip.text == root.emoji.name {
                    Tip.text = "";
                }
            }
        }
    }
}

// The menu behind a toggle's caret: its devices, anything placed inside, then
// a way into the full settings.
component DeviceMenu inherits Rectangle {
    in property <string> heading;
    in property <[string]> devices;
    in property <int> current;
    in property <string> empty;
    callback select(int);
    callback settings;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    VerticalLayout {
        padding: 6px; spacing: 6px;
        HorizontalLayout {
            padding-left: 8px; padding-top: 4px;
            Text { text: root.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
        }
        if root.devices.length > 0: ScrollView {
            // Five devices before the list scrolls.
            height: min(5, root.devices.length) * 32px;
            VerticalLayout {
                for device[index] in root.devices: MenuItem {
                    text: device; checked: index == root.current;
                    clicked => { root.select(index); }
                }
            }
        }
        if root.devices.length == 0: HorizontalLayout {
            padding-left: 8px; padding-right: 8px;
            Label { text: root.empty; }
        }
        @children
        Rectangle { height: 1px; background: Theme.line; }
        MenuItem { text: "Voice settings"; icon: @image-url("icons/settings.svg"); clicked => { root.settings(); } }
    }
}

// A reaction under a message: the emoji in a color emoji font, then the count.
component ReactionToggle inherits Rectangle {
    in property <string> key;
    in property <int> count;
    in property <bool> mine;
    in property <bool> enabled;
    in property <string> emoji-font;
    callback clicked;
    min-width: chip.preferred-width; height: 28px; border-radius: 8px;
    background: root.mine ? Theme.accent-soft : Theme.raised;
    border-width: 1px;
    border-color: root.mine ? Theme.accent.with-alpha(0.7) : pointer.has-hover && root.enabled ? #ffffff26 : transparent;
    accessible-role: button;
    accessible-label: root.key + ", " + root.count + (root.mine ? ", including you. Remove your reaction" : ". Add this reaction");
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    chip := HorizontalLayout {
        padding-left: 8px; padding-right: 9px; spacing: 6px;
        Text { text: root.key; font-family: root.emoji-font; font-size: 16px; vertical-alignment: center; }
        Text { text: root.count; color: root.mine ? Theme.accent : Theme.secondary; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    }
    pointer := TouchArea { enabled: root.enabled; mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

// A header control with an icon and a short text that opens or closes a panel.
component HeaderToggle inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> label;
    in property <bool> open;
    callback clicked;
    width: content.preferred-width; height: 32px;
    border-radius: 6px;
    background: pointer.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <color> ink: root.open || pointer.has-hover ? Theme.text : Theme.muted;
    content := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 6px;
        Image { source: root.icon; width: 18px; image-fit: contain; colorize: root.ink; }
        Text { text: root.text; color: root.ink; font-size: 14px; font-weight: 500; vertical-alignment: center; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { Tip.text = ""; root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.label;
                    Tip.side = 2;
                    Tip.x = root.absolute-position.x + root.width / 2;
                    Tip.y = root.absolute-position.y + root.height;
                } else if Tip.text == root.label {
                    Tip.text = "";
                }
            }
        }
    }
}

/// A member of the open room. A heading starts each role's group.
export struct MemberRow {
    id: string, name: string, initial: string, tint: color, picture: image, heading: string,
    /// Discord's presence: "online", "idle", "dnd" or "offline"; empty for Matrix.
    presence: string,
    /// The name's colour, from a coloured Discord role.
    color: color, has-color: bool,
    /// A custom status or what they're doing, under the name.
    activity: string,
}

// A presence dot on a ring cut from the background, as in Discord: green when
// online, a moon when idle, a bar when they don't want to be disturbed.
component StatusDot inherits Rectangle {
    in property <string> presence;
    in property <color> ring;
    width: 16px; height: 16px; border-radius: 8px;
    background: root.ring;
    accessible-role: image;
    accessible-label: root.presence == "dnd" ? "Do not disturb" : root.presence == "idle" ? "Idle" : "Online";
    Rectangle {
        width: 10px; height: 10px; border-radius: 5px;
        background: root.presence == "dnd" ? Theme.danger : root.presence == "idle" ? Theme.accent : Theme.live;
    }
    if root.presence == "idle": Rectangle {
        x: 2px; y: 2px; width: 6px; height: 6px; border-radius: 3px; background: root.ring;
    }
    if root.presence == "dnd": Rectangle {
        width: 6px; height: 2px; border-radius: 1px; background: root.ring;
    }
}

// The open room's members, grouped by role under the conversation header.
component MemberPanel inherits Rectangle {
    in property <[MemberRow]> rows;
    /// Shown instead of the list while it loads or when it can't.
    in property <string> note;
    background: Theme.sidebar;
    accessible-role: list;
    accessible-label: "Members";
    ScrollView {
        VerticalLayout {
            padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 12px; spacing: 2px;
            for member in root.rows: VerticalLayout {
                spacing: 2px; vertical-stretch: 0;
                if member.heading != "": HorizontalLayout {
                    padding-left: 8px; height: 36px;
                    Text { text: member.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    height: 42px; padding-left: 8px; padding-right: 8px; spacing: 12px;
                    accessible-role: list-item;
                    accessible-label: member.name + ", " + member.id;
                    // Offline Discord members are faded, as in Discord.
                    Middle {
                        Rectangle {
                            width: 32px; height: 32px;
                            Avatar { size: 32px; initial: member.initial; tint: member.tint; picture: member.picture; opacity: member.presence == "offline" ? 0.4 : 1; }
                            if member.presence != "" && member.presence != "offline": StatusDot { x: 20px; y: 20px; presence: member.presence; ring: Theme.sidebar; }
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1;
                        Text {
                            text: member.name; color: member.has-color ? member.color : Theme.secondary; font-size: 16px; font-weight: 500; overflow: elide;
                            opacity: member.presence == "offline" ? 0.5 : 1;
                        }
                        if member.activity != "": Text {
                            text: member.activity; color: Theme.muted; font-size: 12px; overflow: elide;
                            opacity: member.presence == "offline" ? 0.5 : 1;
                        }
                    }
                }
            }
            if root.note != "": HorizontalLayout { padding: 8px; Label { text: root.note; } }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

// A dismissible message that applies to the whole window, such as a renderer fallback.
component Banner inherits Rectangle {
    in-out property <string> text;
    callback dismissed;
    min-height: banner-content.preferred-height; vertical-stretch: 0; background: Theme.raised;
    banner-content := HorizontalLayout {
        padding-left: 16px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
        Image { source: @image-url("icons/triangle-alert.svg"); width: 18px; image-fit: contain; colorize: Theme.accent; }
        Text { text: root.text; color: Theme.text; font-size: 15px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
        Middle { ActionButton { text: "Dismiss"; ghost: true; small: true; clicked => { root.dismissed(); } } }
    }
}

export struct ServerRow { id: string, name: string, initial: string, picture: image, selected: bool, unread: bool, discord: bool }
export struct PersonRow {
    id: string, name: string, status: string, muted: bool, deafened: bool, speaking: bool, connected: bool, initial: string, tint: color, picture: image,
    /// Sharing their screen.
    live: bool,
    /// This account, in a call.
    local: bool,
}

// Marks someone sharing their screen, as Discord's red LIVE tag does.
// Clickable when it opens the stream.
component LivePill inherits Rectangle {
    in property <bool> clickable;
    in property <string> label: "Watch stream";
    callback clicked;
    width: live-text.preferred-width + 10px; height: 16px; border-radius: 8px;
    background: root.clickable && live-touch.has-hover ? Theme.danger-hover : Theme.danger;
    accessible-role: button; accessible-enabled: root.clickable; accessible-label: root.clickable ? root.label : "Live";
    accessible-action-default => { if root.clickable { root.clicked(); } }
    live-text := Text { text: "LIVE"; color: #ffffff; font-size: 10px; font-weight: 800; letter-spacing: 0.4px; }
    live-touch := TouchArea {
        enabled: root.clickable; mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}
export struct RoomRow {
    id: string, name: string, heading: string, icon: image, selected: bool, unread: bool, badge: string,
    voice: bool, direct: bool, initial: string, tint: color,
    /// Listed but not open to join, such as a Discord channel the account's roles keep it out of.
    locked: bool,
    /// Who is in a Discord voice channel, shown without joining it.
    people: [PersonRow],
}
export struct ReactionChip { key: string, count: int, mine: bool }
/// An image in a message's gallery, placed in pixels; `index` is its place
/// among the message's attachments.
export struct ImageCell { index: int, name: string, image: image, x: int, y: int, width: int, height: int }
/// A file, or an image without a preview, as a card.
export struct FileCell { index: int, name: string, detail: string }
export struct MessageRow {
    id: string, item: string, author: string, initial: string, tint: color, picture: image, body: string, time: string, short-time: string, own: bool,
    /// Starts a group: shows the avatar and author. Later messages from the same person follow compactly.
    first: bool,
    /// A date divider above this message, when it starts a new day.
    day: string,
    formatted: bool, styled: styled-text, edited: bool, deleted: bool,
    reply-author: string, reply-body: string, reply-initial: string, reply-tint: color, has-reply: bool,
    reactions: [ReactionChip],
    /// Images with previews, laid out in a gallery of this size; other
    /// attachments show as file cards.
    images: [ImageCell], gallery-width: int, gallery-height: int,
    files: [FileCell],
    delivery: string, delivery-failed: bool, can-retry: bool, can-cancel: bool,
    can-reply: bool, can-edit: bool, can-delete: bool, can-react: bool, can-forward: bool,
}
/// A conversation a message can be forwarded to.
export struct ForwardRow {
    id: string, name: string, place: string, icon: image, direct: bool, initial: string, tint: color,
    /// The message went there during this forward.
    sent: bool,
}

export component TalkWindow inherits Window {
    title: "Talk";
    preferred-width: 1120px; preferred-height: 760px;
    min-width: 800px; min-height: 560px;
    background: Theme.chat;
    default-font-family: "Satoshi";
    // Satoshi's x-height is small, so text defaults to 16px.
    default-font-size: 16px;
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }
    in property <bool> workspace;
    in property <bool> preview;
    in property <bool> busy;
    in property <bool> trusted;
    in property <bool> online;
    in property <bool> restore-available;
    in property <bool> dms-selected;
    in property <bool> dms-unread;
    in property <string> sidebar-title;
    in property <string> filter-placeholder;
    in property <string> sidebar-empty;
    in property <[ServerRow]> servers;
    in property <[RoomRow]> rooms;
    in property <[MessageRow]> messages;
    in property <string> account;
    in property <string> account-name;
    in property <string> account-initial;
    in property <color> account-tint;
    in property <image> account-picture;
    in property <string> account-status;
    in property <string> storage;
    in property <string> notice;
    in-out property <string> graphics-notice;
    in property <string> room-name;
    in property <image> room-icon;
    in property <bool> room-direct;
    in property <string> room-initial;
    in property <color> room-tint;
    in property <string> members;
    /// The open room lists its members: a text channel or a group DM.
    in property <bool> members-available;
    in property <[MemberRow]> roster;
    in property <string> roster-note;
    /// Whether the member list is wanted beside the conversation; Talk stores it.
    in-out property <bool> member-list: true;
    callback member-list-toggled(bool);
    /// A Discord account is linked, so its settings show.
    in property <bool> discord-linked;
    in-out property <bool> show-hidden-channels;
    callback show-hidden-channels-toggled(bool);
    /// A link in a message was clicked.
    callback open-link(string);
    in-out property <bool> sync-discord-reads;
    callback sync-discord-reads-toggled(bool);
    in property <bool> room-selected;
    in property <bool> room-ready;
    in property <bool> room-encrypted;
    in property <bool> voice-room;
    in property <bool> composer-enabled;
    in property <bool> can-send;
    in property <bool> sending;
    in property <bool> loading-history;
    in property <string> composer-hint;
    /// "Replying to …" or "Editing your message"; empty for a new message.
    in property <string> compose-label;
    in property <bool> can-attach;
    in property <bool> attaching;
    in property <string> confirm-delete;
    in-out property <string> react-item;
    in-out property <string> active-item;
    /// The reactions this device uses most: three on the hover bar, four in the menu.
    in property <[EmojiCell]> bar-reactions;
    in property <[EmojiCell]> menu-reactions;
    /// The emoji picker's grid for `emoji-query`, refreshed through emoji-search.
    in property <[EmojiRow]> emoji-rows;
    in-out property <string> emoji-query;
    /// The forward dialog, open while Talk forwards a message of the open room.
    in property <bool> forward-open;
    /// The image viewer: the image, its full size in pixels, and what to say about it.
    in property <bool> viewer-open;
    in property <image> viewer-image;
    in property <int> viewer-width;
    in property <int> viewer-height;
    in property <string> viewer-name;
    /// Such as "2 / 3"; empty for a message's only image.
    in property <string> viewer-position;
    /// While the full image loads, or why it can't show.
    in property <string> viewer-note;
    in property <string> viewer-item;
    in property <int> viewer-index;
    in property <string> forward-preview;
    in property <[ForwardRow]> forward-targets;
    in-out property <string> forward-query;
    /// The platform's color emoji font, so reactions do not fall back to outline glyphs.
    in property <string> emoji-font;
    in-out property <string> homeserver: "https://matrix.org";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> recovery;
    in-out property <string> draft;
    in-out property <string> filter;
    in property <bool> voice-visible;
    in property <bool> voice-active;
    in property <bool> voice-ready;
    in property <bool> voice-leaving;
    in property <bool> voice-here;
    /// The voice channel this account is connected to, whose participants are listed under it.
    in property <string> voice-channel;
    /// 0 while joining or reconnecting, 1 when connected, 2 after a failure.
    in property <int> voice-tone;
    in property <bool> can-join;
    in property <bool> muted;
    in property <bool> deafened;
    in property <string> voice-status;
    in property <string> voice-name;
    in property <string> voice-detail;
    in property <string> voice-microphone-status;
    in property <string> voice-description;
    in property <string> voice-error;
    in property <string> voice-warning;
    in property <[PersonRow]> participants;
    /// Sharing a screen is offered in Discord calls.
    in property <bool> can-share;
    in property <bool> sharing;
    in property <bool> share-live;
    in property <string> share-status;
    /// The newest preview of what's shared, refreshed by stream-tick while sharing.
    in-out property <image> share-frame;
    /// Watching someone's stream in the call.
    in property <bool> watching;
    in property <string> watch-title;
    in property <string> watch-status;
    /// The newest picture of the watched stream, refreshed by stream-tick.
    in-out property <image> watch-frame;
    in property <string> switch-prompt;
    in-out property <bool> audio-settings;
    // The sidebar keeps 180 to 380px. Dragging also leaves the conversation 420px;
    // the window width cannot enter this binding, because it depends on the layout.
    out property <length> sidebar-shown: max(180px, min(380px, root.sidebar-width));
    in property <[string]> microphones;
    in property <[string]> speakers;
    in property <int> microphone-index;
    in property <int> speaker-index;
    /// The microphone level from 0 to 1, refreshed by meter-tick while the input menu is open.
    in-out property <float> input-level;
    /// Why the level can't be shown, if it can't.
    in-out property <string> meter-note;

    callback login;
    callback restore;
    callback explore-preview;
    callback logout;
    callback recover;
    callback refresh-trust;
    callback retry-sync;
    callback navigate-dms;
    callback navigate-server(string);
    callback select-room(string);
    callback draft-edited(string);
    callback filter-edited;
    callback send;
    callback earlier;
    callback join-voice;
    callback toggle-mute;
    callback toggle-deafen;
    callback toggle-share;
    callback stream-tick;
    /// Watch the participant with this id's stream.
    callback watch-stream(string);
    callback stop-watching;
    callback leave-voice;
    callback confirm-switch;
    callback cancel-switch;
    callback dismiss-voice-error;
    callback refresh-devices;
    callback select-microphone(int);
    callback select-speaker(int);
    /// Whether the input menu wants the microphone level measured.
    callback metering(bool);
    callback meter-tick;
    callback reply(string);
    callback edit(string);
    callback react(string, string);
    callback request-delete(string);
    callback emoji-search(string);
    callback start-forward(string);
    callback forward-to(string);
    callback forward-search;
    callback close-forward;
    callback confirm-delete-message;
    callback cancel-delete;
    callback retry(string);
    callback cancel-send(string);
    callback attach;
    callback save-attachment(string, int);
    callback view-image(string, int);
    callback step-image(int);
    callback close-image();
    callback cancel-compose;
    callback dismiss-notice;
    // The sidebar's width, chosen by dragging its edge; Talk stores it on release.
    in-out property <length> sidebar-width: 240px;
    callback sidebar-resized(length);

    public function focus-composer() { composer.focus-input(); }
    public function focus-sign-in() { username-field.focus-input(); }
    public function timeline-at-end() -> bool { return root.follow-latest; }
    // How far the newest message is below the view; zero at the end.
    public function timeline-below() -> length { return max(0px, timeline.content-y - min(0px, timeline.height - timeline.content-height)); }
    public function timeline-extent() -> length { return timeline.content-height; }
    public function scroll-to-latest() {
        root.follow-latest = true;
        timeline.content-y = min(0px, timeline.height - timeline.content-height);
    }
    // While the newest message is in view, keep it there as rows grow, for example
    // when an image preview or a reaction arrives after the row first appeared.
    // Only scrolling stops following, and reaching the end again resumes it. The
    // list re-estimates its height as it measures rows, so heights can't tell
    // whether someone scrolled; and a wheel scroll is reported before its
    // animation moves the list, so the position at that moment can't either.
    property <bool> follow-latest: true;
    property <length> timeline-position: timeline.content-y;
    property <length> timeline-content: timeline.content-height;
    // The composer grows for a reply or edit, which shortens the list.
    property <length> timeline-viewport: timeline.height;
    // A short history sits against the composer, as in a conversation: the first
    // row is padded by the space the rows leave. A changed handler, not a binding,
    // because the list's height decides which rows it measures.
    property <length> lead;
    function settle-lead() { root.lead = max(0px, timeline.height - (timeline.content-height - root.lead)); }
    changed timeline-viewport => { root.settle-lead(); if root.follow-latest { root.scroll-to-latest(); } }
    changed timeline-position => {
        if timeline.content-y <= min(0px, timeline.height - timeline.content-height) + 0.5px { root.follow-latest = true; }
    }
    changed timeline-content => {
        root.settle-lead();
        if root.follow-latest { root.scroll-to-latest(); }
    }
    public function preserve-history-position(delta: length) { timeline.content-y = timeline.content-y - delta; }
    // Formatted messages are not selectable, so Copy goes through a hidden text field.
    function copy-text(text: string) { clipboard.text = text; clipboard.select-all(); clipboard.copy(); clipboard.text = ""; }
    clipboard := TextInput { visible: false; width: 0px; height: 0px; }
    // A tooltip must not outlive the toolbar that showed it.
    changed active-item => { Tip.text = ""; }

    // The member list is a second sidebar, on the right of the conversation.
    property <bool> members-docked: root.members-available && root.member-list;
    function toggle-members() {
        root.member-list = !root.member-list;
        root.member-list-toggled(root.member-list);
    }

    property <bool> is-editing: root.compose-label == "Editing your message";
    property <color> voice-color: root.voice-tone == 1 ? Theme.live : root.voice-tone == 2 ? Theme.danger : Theme.accent;

    changed audio-settings => {
        if root.audio-settings { settings-popup.show(); } else { settings-popup.close(); }
    }
    property <bool> settings-open: settings-popup.is-open;
    changed settings-open => { root.audio-settings = root.settings-open; }

    // The device menus open above the toggle whose caret was clicked.
    property <length> menu-x;
    property <length> menu-y;
    function open-settings() { input-menu.close(); output-menu.close(); root.audio-settings = true; root.refresh-devices(); }
    property <bool> input-open: input-menu.is-open;
    property <bool> output-open: output-menu.is-open;
    changed input-open => { root.input-level = 0; root.meter-note = ""; root.metering(root.input-open); }
    Timer { interval: 50ms; running: root.input-open; triggered => { root.meter-tick(); } }
    Timer { interval: 33ms; running: root.sharing || root.watching; triggered => { root.stream-tick(); } }
    input-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        width: 280px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        DeviceMenu {
            heading: "INPUT DEVICE"; devices: root.microphones; current: root.microphone-index;
            empty: "No microphones found. Connect one, then reopen this menu.";
            select(index) => { root.select-microphone(index); }
            settings => { root.open-settings(); }
            Rectangle { height: 1px; background: Theme.line; }
            VerticalLayout {
                padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 8px;
                Text { text: "INPUT LEVEL"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                HorizontalLayout {
                    height: 10px; spacing: 3px;
                    accessible-role: progress-indicator;
                    accessible-label: "Input level";
                    accessible-value: round(root.input-level * 100) + "%" + (root.muted ? ", muted" : "");
                    // Muted, the level still shows, in a faded green: heard here, sent nowhere.
                    for segment in 24: Rectangle {
                        border-radius: 2px;
                        background: (segment + 0.5) / 24 > root.input-level ? Theme.line
                            : root.muted ? Theme.live.with-alpha(0.4) : Theme.live;
                    }
                }
                if root.meter-note != "": Label { text: root.meter-note; }
                if root.meter-note == "" && root.muted: Label { text: "Muted. Nothing you say is sent."; }
            }
        }
    }
    output-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        width: 280px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        DeviceMenu {
            heading: "OUTPUT DEVICE"; devices: root.speakers; current: root.speaker-index;
            empty: "No speakers found. Connect one, then reopen this menu.";
            select(index) => { root.select-speaker(index); }
            settings => { root.open-settings(); }
        }
    }
    settings-popup := PopupWindow {
        x: 8px; y: max(16px, root.height - self.height - 64px);
        width: 340px;
        height: settings-content.preferred-height;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 10px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            settings-content := VerticalLayout {
                padding: 16px; spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Middle { Avatar { size: 40px; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture; } }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1;
                        Text { text: root.account; color: Theme.text; font-weight: 700; overflow: elide; }
                        Label { text: root.account-status; wrap: no-wrap; overflow: elide; }
                    }
                    IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.audio-settings = false; } }
                }
                if root.storage != "": Label { text: root.storage; }
                Rectangle { height: 1px; background: Theme.line; }
                Text { text: "VOICE & AUDIO"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                Label { text: "Microphone"; color: Theme.secondary; }
                ComboBox { model: root.microphones; current-index: root.microphone-index; enabled: root.microphones.length > 0; accessible-label: "Microphone device"; selected => { root.select-microphone(self.current-index); } }
                Label { text: "Speakers"; color: Theme.secondary; }
                ComboBox { model: root.speakers; current-index: root.speaker-index; enabled: root.speakers.length > 0; accessible-label: "Speaker device"; selected => { root.select-speaker(self.current-index); } }
                if root.microphones.length == 0 && root.speakers.length == 0: Label { text: "No audio devices found. Connect one, then refresh."; }
                HorizontalLayout {
                    ActionButton { text: "Refresh devices"; icon: @image-url("icons/refresh-cw.svg"); ghost: true; small: true; clicked => { root.refresh-devices(); } }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.discord-linked: VerticalLayout {
                    spacing: 10px;
                    Rectangle { height: 1px; background: Theme.line; }
                    Text { text: "DISCORD"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                    Switch {
                        text: "Show channels you can't access";
                        checked: root.show-hidden-channels;
                        toggled => { root.show-hidden-channels = self.checked; root.show-hidden-channels-toggled(self.checked); }
                    }
                    Label { text: "They appear locked. Server admins hid them on purpose."; }
                    Switch {
                        text: "Mark messages read on Discord";
                        checked: root.sync-discord-reads;
                        toggled => { root.sync-discord-reads = self.checked; root.sync-discord-reads-toggled(self.checked); }
                    }
                    Label { text: "Channels you read in Talk show as read in the Discord apps too."; }
                }
                Rectangle { height: 1px; background: Theme.line; }
                HorizontalLayout {
                    spacing: 8px;
                    if !root.preview && !root.online: ActionButton { text: "Reconnect"; icon: @image-url("icons/refresh-cw.svg"); small: true; enabled: !root.busy; clicked => { root.retry-sync(); } }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        text: root.preview ? "Back to sign in" : "Sign out"; icon: @image-url("icons/log-out.svg");
                        small: true; danger: !root.preview; enabled: !root.busy && !root.sending;
                        clicked => { root.audio-settings = false; root.logout(); }
                    }
                }
            }
        }
    }

    // The emoji picker and a message's menu open beside the control that asked for
    // them, flipping above it near the bottom of the window. A menu opened by a
    // right click starts at the pointer.
    property <length> anchor-x;
    property <length> anchor-y;
    property <length> anchor-width;
    property <length> anchor-height;
    property <bool> anchor-pointer;
    function anchor(x: length, y: length, width: length, height: length, pointer: bool) {
        root.anchor-x = x; root.anchor-y = y; root.anchor-width = width; root.anchor-height = height;
        root.anchor-pointer = pointer;
    }
    // Closing a popup ends the handler that closed it, so callers close last.
    function open-picker(item: string) {
        root.react-item = item;
        root.emoji-query = "";
        root.emoji-hover = { glyph: "", name: "" };
        root.emoji-search("");
        emoji-picker.show();
    }
    // The message whose menu is open.
    property <MessageRow> menu-message;
    property <string> menu-item: menu-open ? root.menu-message.item : "";
    property <bool> menu-open: message-menu.is-open;
    function open-menu(message: MessageRow) {
        root.menu-message = message;
        message-menu.show();
    }
    property <bool> picker-open: emoji-picker.is-open;
    changed picker-open => { if !root.picker-open { root.react-item = ""; } }
    property <EmojiCell> emoji-hover;
    function pick(glyph: string) {
        root.react(root.react-item, glyph);
        emoji-picker.close();
    }
    emoji-picker := PopupWindow {
        width: 360px; height: 432px;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-pointer ? root.anchor-x : root.anchor-x + root.anchor-width - self.width));
        y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
            ? root.anchor-y + root.anchor-height + 4px : max(8px, root.anchor-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 10px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            clip: true;
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { emoji-picker.close(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        padding: 10px; padding-bottom: 6px;
                        // The picker's contents are created each time it opens.
                        picker-field := TextField {
                            init => { self.focus-input(); }
                            min-height: 34px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                            placeholder: "Find an emoji"; label: "Find an emoji"; text <=> root.emoji-query;
                            edited(text) => { root.emoji-search(text); }
                            // Enter picks the first match.
                            accepted => {
                                if root.emoji-query != "" && root.emoji-rows.length > 0 && root.emoji-rows[0].cells.length > 0 {
                                    root.pick(root.emoji-rows[0].cells[0].glyph);
                                }
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.emoji-rows: VerticalLayout {
                            padding-left: 8px; padding-right: 8px;
                            if row.heading != "": HorizontalLayout {
                                padding-left: 4px; height: 30px;
                                Text { text: row.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: bottom; }
                            }
                            if row.cells.length > 0: HorizontalLayout {
                                alignment: start; padding-top: 2px;
                                for cell in row.cells: EmojiButton {
                                    emoji: cell; font: root.emoji-font; size: 40px; glyph: 26px; tip: false;
                                    hovered => { root.emoji-hover = cell; }
                                    clicked => { root.pick(cell.glyph); }
                                }
                            }
                        }
                    }
                    if root.emoji-rows.length == 0: HorizontalLayout {
                        padding: 16px; vertical-stretch: 1;
                        Label { text: "No emoji match \"" + root.emoji-query + "\"."; horizontal-alignment: center; }
                    }
                    // The hovered emoji, larger, with its name.
                    Rectangle {
                        height: 48px; background: Theme.panel;
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; spacing: 10px;
                            if root.emoji-hover.glyph != "": Text { text: root.emoji-hover.glyph; font-family: root.emoji-font; font-size: 26px; vertical-alignment: center; }
                            Text {
                                text: root.emoji-hover.glyph != "" ? root.emoji-hover.name : "Pick an emoji to react with.";
                                color: root.emoji-hover.glyph != "" ? Theme.text : Theme.muted; font-size: 15px;
                                font-weight: root.emoji-hover.glyph != "" ? 700 : 400;
                                vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
    // A message's actions, from its hover bar's "More" button or a right click.
    property <bool> menu-can-react: root.menu-message.can-react && root.composer-enabled;
    message-menu := PopupWindow {
        width: 224px; height: menu-content.preferred-height;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-pointer ? root.anchor-x : root.anchor-x + root.anchor-width - self.width));
        y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
            ? root.anchor-y + root.anchor-height + (root.anchor-pointer ? 0px : 4px) : max(8px, root.anchor-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            menu-content := VerticalLayout {
                padding: 6px; spacing: 2px;
                if root.menu-can-react: HorizontalLayout {
                    spacing: 4px; padding-bottom: 4px;
                    for cell in root.menu-reactions: EmojiButton {
                        emoji: cell; font: root.emoji-font; size: 50px; height: 40px; glyph: 22px; fill: Theme.field;
                        clicked => { root.react(root.menu-message.item, cell.glyph); message-menu.close(); }
                    }
                }
                if root.menu-can-react: MenuItem {
                    text: "Add reaction"; icon: @image-url("icons/smile-plus.svg");
                    clicked => { root.open-picker(root.menu-message.item); message-menu.close(); }
                }
                if root.menu-message.can-edit && root.composer-enabled: MenuItem {
                    text: "Edit message"; icon: @image-url("icons/pencil.svg");
                    clicked => { root.edit(root.menu-message.item); root.focus-composer(); message-menu.close(); }
                }
                if root.menu-message.can-reply && root.composer-enabled: MenuItem {
                    text: "Reply"; icon: @image-url("icons/reply.svg");
                    clicked => { root.reply(root.menu-message.item); root.focus-composer(); message-menu.close(); }
                }
                if root.menu-message.can-forward && (root.trusted || root.preview): MenuItem {
                    text: "Forward"; icon: @image-url("icons/forward.svg");
                    clicked => { root.start-forward(root.menu-message.item); message-menu.close(); }
                }
                if root.menu-message.body != "": MenuItem {
                    text: "Copy text"; icon: @image-url("icons/copy.svg");
                    clicked => { root.copy-text(root.menu-message.body); message-menu.close(); }
                }
                if root.menu-message.can-delete && root.composer-enabled: Rectangle { height: 1px; background: Theme.line; }
                if root.menu-message.can-delete && root.composer-enabled: MenuItem {
                    text: "Delete message"; icon: @image-url("icons/trash-2.svg"); danger: true;
                    clicked => { root.request-delete(root.menu-message.item); message-menu.close(); }
                }
            }
        }
    }

    // Sign in: a centred card on the darkest ground, with the local preview beside it.
    Rectangle {
        visible: !root.workspace;
        background: Theme.rail;
        Text { x: 32px; y: 24px; text: "Talk"; color: Theme.accent; font-size: 24px; font-weight: 900; letter-spacing: -0.4px; }
        ScrollView {
            y: 64px; height: parent.height - 64px;
            VerticalLayout {
                padding: 24px; padding-top: 0px; spacing: 16px;
                alignment: center;
                min-height: root.height - 64px;
                if root.graphics-notice != "": HorizontalLayout {
                    alignment: center;
                    Banner { max-width: 760px; text <=> root.graphics-notice; dismissed => { root.graphics-notice = ""; } }
                }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        max-width: 760px; horizontal-stretch: 1;
                        background: Theme.chat; border-radius: 12px;
                        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
                        HorizontalLayout {
                            padding: 32px; spacing: 32px;
                            VerticalLayout {
                                spacing: 8px; horizontal-stretch: 1; min-width: 300px;
                                Text { text: "Sign in to Talk"; color: Theme.text; font-size: 26px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "Use your existing Matrix account."; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
                                Rectangle { height: 12px; }
                                Text { text: "HOMESERVER"; color: Theme.secondary; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                                TextField { text <=> root.homeserver; enabled: !root.busy; label: "Homeserver"; }
                                Rectangle { height: 4px; }
                                Text { text: "MATRIX ID"; color: Theme.secondary; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                                username-field := TextField { text <=> root.username; placeholder: "@you:matrix.org"; enabled: !root.busy; label: "Matrix ID"; }
                                Rectangle { height: 4px; }
                                Text { text: "PASSWORD"; color: Theme.secondary; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                                TextField { text <=> root.password; password: true; enabled: !root.busy; label: "Password"; accepted => { root.login(); } }
                                Rectangle { height: 12px; }
                                ActionButton { min-height: 44px; text: root.busy ? "Connecting..." : "Sign in"; primary: true; enabled: !root.busy; clicked => { root.login(); } }
                                if root.notice != "": Text { text: root.notice; color: Theme.danger; font-size: 15px; wrap: word-wrap; }
                                if root.restore-available && !root.busy: ActionButton { text: "Retry saved session"; clicked => { root.restore(); } }
                                Label { text: "Sign in with your Matrix password. Single sign-on isn't available yet."; }
                            }
                            Rectangle { width: 1px; background: Theme.line; }
                            VerticalLayout {
                                width: 220px; spacing: 12px; alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px; height: 72px; border-radius: 24px; background: Theme.raised;
                                        Image { source: @image-url("icons/message-circle.svg"); width: 34px; height: 34px; colorize: Theme.accent; }
                                    }
                                }
                                Text { text: "Just looking?"; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "Try the layout with sample conversations. Nothing leaves this computer."; color: Theme.secondary; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
                                ActionButton { text: "Explore local preview"; enabled: !root.busy; clicked => { root.explore-preview(); } }
                            }
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        visible: root.workspace;
        spacing: 0px;
        // Navigation: the rail and the sidebar, with the voice and account dock across both.
        Rectangle {
            width: 72px + root.sidebar-shown; background: Theme.rail;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    vertical-stretch: 1; spacing: 0px;
                    // Server rail.
                    Rectangle {
                        width: 72px; background: Theme.rail;
                        VerticalLayout {
                            padding-top: 12px; padding-bottom: 12px; spacing: 8px;
                            RailItem {
                                icon: @image-url("icons/message-circle.svg");
                                label: root.dms-unread ? "Direct messages, unread" : "Direct messages"; tip: "Direct messages";
                                selected: root.dms-selected; unread: root.dms-unread;
                                clicked => { root.navigate-dms(); }
                            }
                            HorizontalLayout {
                                alignment: center;
                                Rectangle { width: 32px; height: 2px; border-radius: 1px; background: Theme.line; }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 8px;
                                    for server in root.servers: RailItem {
                                        initial: server.initial; picture: server.picture;
                                        label: server.name + (server.discord ? ", Discord" : "") + (server.unread ? ", unread" : "");
                                        tip: server.discord ? server.name + " (Discord)" : server.name;
                                        selected: server.selected; unread: server.unread; discord: server.discord;
                                        clicked => { root.navigate-server(server.id); }
                                    }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                    }
                    // Channel sidebar: a lighter sheet held by the rail and the dock.
                    Rectangle {
                        width: root.sidebar-shown; background: Theme.sidebar;
                        border-top-left-radius: 10px; border-bottom-left-radius: 10px;
                        clip: true;
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: 48px;
                                Text { x: 16px; width: parent.width - 32px; text: root.sidebar-title; font-size: 16px; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
                            }
                            HorizontalLayout {
                                padding: 10px; padding-bottom: 6px;
                                TextField {
                                    min-height: 30px; text-size: 14px; pad: 8px; fill: Theme.sunken; ring: false;
                                    placeholder: root.filter-placeholder; text <=> root.filter; label: root.filter-placeholder;
                                    edited => { root.filter-edited(); }
                                }
                            }
                            ScrollView {
                                min-height: 96px; vertical-stretch: 1;
                                VerticalLayout {
                                    padding-left: 8px; padding-right: 8px; padding-bottom: 12px; spacing: 2px;
                                    for room in root.rooms: VerticalLayout {
                                        spacing: 2px; vertical-stretch: 0;
                                        if room.heading != "": HorizontalLayout {
                                            padding-left: 8px; height: 36px;
                                            Text { text: room.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: center; }
                                        }
                                        ChannelRow {
                                            text: room.name;
                                            label: room.name + (room.locked ? ", locked" : "") + (room.badge != "" ? ", " + room.badge + " mentions" : room.unread ? ", unread" : "");
                                            icon: room.icon; person: room.direct; initial: room.initial; tint: room.tint;
                                            selected: room.selected; unread: room.unread; badge: room.badge; locked: room.locked;
                                            clicked => { root.select-room(room.id); }
                                        }
                                        // Discord reports who is in every voice channel; Matrix
                                        // only shows the call Talk is in, below.
                                        if room.voice && room.id != root.voice-channel && room.people.length > 0: VerticalLayout {
                                            padding-left: 32px; padding-bottom: 4px; spacing: 0px;
                                            for person in room.people: HorizontalLayout {
                                                height: 30px; spacing: 8px; padding-left: 4px; padding-right: 8px;
                                                Middle { Avatar { size: 22px; initial: person.initial; tint: person.tint; picture: person.picture; } }
                                                Text {
                                                    text: person.name; font-size: 15px; font-weight: 500; color: Theme.secondary;
                                                    vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                                                }
                                                if person.live: Middle { LivePill { } }
                                                if person.muted && !person.deafened: Image {
                                                    source: @image-url("icons/mic-off.svg"); width: 16px; image-fit: contain;
                                                    colorize: Theme.muted; accessible-role: image; accessible-label: person.name + " is muted";
                                                }
                                                if person.deafened: Image {
                                                    source: @image-url("icons/headphone-off.svg"); width: 16px; image-fit: contain;
                                                    colorize: Theme.muted; accessible-role: image; accessible-label: person.name + " is deafened";
                                                }
                                            }
                                        }
                                        if room.voice && room.id == root.voice-channel: VerticalLayout {
                                            padding-left: 32px; padding-bottom: 4px; spacing: 0px;
                                            for person in root.participants: HorizontalLayout {
                                                height: 30px; spacing: 8px; padding-left: 4px; padding-right: 8px;
                                                Middle { Avatar { size: 22px; initial: person.initial; tint: person.tint; picture: person.picture; speaking: person.speaking; } }
                                                Text {
                                                    text: person.name; font-size: 15px; font-weight: person.speaking ? 700 : 500;
                                                    color: person.speaking ? Theme.text : person.connected ? Theme.secondary : Theme.muted;
                                                    vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                                                }
                                                if person.live: Middle {
                                                    LivePill {
                                                        clickable: !person.local; label: "Watch " + person.name + "'s stream";
                                                        clicked => { root.watch-stream(person.id); }
                                                    }
                                                }
                                                if person.muted: Image {
                                                    source: @image-url("icons/mic-off.svg"); width: 16px; image-fit: contain;
                                                    colorize: Theme.muted; accessible-role: image; accessible-label: person.name + " is muted";
                                                }
                                            }
                                        }
                                    }
                                    if root.sidebar-empty != "": HorizontalLayout { padding: 8px; Label { text: root.sidebar-empty; } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                    }
                }
                // The dock spans the rail and the sidebar. Its avatar and voice icon sit on the
                // rail's axis, 36px from the left; names and status start at 64px.
                if root.voice-visible: Rectangle {
                    background: Theme.panel;
                    VerticalLayout {
                        padding-top: 10px; padding-bottom: 8px; padding-right: 8px; spacing: 6px;
                        HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 64px;
                                Image {
                                    x: 26px; width: 20px; height: 20px; source: @image-url("icons/volume-2.svg");
                                    image-fit: contain; colorize: root.voice-color;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1;
                                Text { text: root.voice-status; color: root.voice-color; font-size: 15px; font-weight: 700; overflow: elide; }
                                if root.voice-active: Text { text: root.voice-detail; color: Theme.muted; font-size: 13px; overflow: elide; }
                            }
                            if root.voice-active: IconButton {
                                icon: @image-url("icons/phone-off.svg"); label: "Leave voice"; danger: true;
                                enabled: !root.voice-leaving;
                                clicked => { root.leave-voice(); }
                            }
                        }
                        if root.voice-warning != "" && root.voice-error == "": HorizontalLayout {
                            padding-left: 64px;
                            ScrollView {
                                max-height: 64px;
                                Label { text: root.voice-warning; color: Theme.accent; }
                            }
                        }
                        if root.voice-error != "": HorizontalLayout {
                            padding-left: 64px;
                            ScrollView {
                                max-height: 48px;
                                Text { text: root.voice-error; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                            }
                        }
                        if !root.voice-active: HorizontalLayout {
                            padding-left: 54px;
                            ActionButton { text: "Dismiss"; ghost: true; small: true; clicked => { root.dismiss-voice-error(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                // Account panel.
                Rectangle {
                    height: 56px; background: Theme.panel;
                    if root.voice-visible: Rectangle { x: 12px; y: 0px; width: parent.width - 24px; height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        padding-right: 8px; spacing: 2px;
                        Rectangle {
                            width: 64px;
                            Avatar { x: 19px; y: (parent.height - self.height) / 2; size: 34px; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture; }
                            Rectangle {
                                x: 41px; y: parent.height / 2 + 4px; width: 14px; height: 14px; border-radius: 7px; background: Theme.panel;
                                Rectangle {
                                    width: 8px; height: 8px; border-radius: 4px;
                                    background: root.preview ? Theme.accent : root.online ? Theme.live : Theme.faint;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center; horizontal-stretch: 1;
                            Text { text: root.account-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                            Text { text: root.account-status; color: Theme.muted; font-size: 13px; overflow: elide; }
                        }
                        if root.voice-active: DeviceToggle {
                            icon: root.muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                            label: root.muted ? "Unmute" : "Mute"; alert: root.muted;
                            menu-label: "Input options"; open: root.input-open;
                            enabled: root.voice-ready;
                            clicked => { root.toggle-mute(); }
                            menu => {
                                root.menu-x = self.absolute-position.x; root.menu-y = self.absolute-position.y + (self.height - 32px) / 2;
                                root.refresh-devices(); input-menu.show();
                            }
                        }
                        if root.voice-active: DeviceToggle {
                            icon: root.deafened ? @image-url("icons/headphone-off.svg") : @image-url("icons/headphones.svg");
                            label: root.deafened ? "Undeafen" : "Deafen"; alert: root.deafened;
                            menu-label: "Output options"; open: root.output-open;
                            enabled: root.voice-ready;
                            clicked => { root.toggle-deafen(); }
                            menu => {
                                root.menu-x = self.absolute-position.x; root.menu-y = self.absolute-position.y + (self.height - 32px) / 2;
                                root.refresh-devices(); output-menu.show();
                            }
                        }
                        if !root.preview && !root.online: IconButton {
                            icon: @image-url("icons/refresh-cw.svg"); label: "Reconnect"; enabled: !root.busy;
                            clicked => { root.retry-sync(); }
                        }
                        IconButton {
                            icon: @image-url("icons/settings.svg"); label: "Settings";
                            clicked => { root.audio-settings = !root.audio-settings; if root.audio-settings { root.refresh-devices(); } }
                        }
                    }
                }
            }
        }
        // Conversation.
        Rectangle {
            background: Theme.chat;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px;
                        if root.room-direct: Middle { Avatar { size: 26px; initial: root.room-initial; tint: root.room-tint; } }
                        if !root.room-direct && root.room-selected: Image { source: root.room-icon; width: 22px; image-fit: contain; colorize: Theme.muted; }
                        Text { text: root.room-selected ? root.room-name : root.sidebar-title; color: root.room-selected ? Theme.text : Theme.secondary; font-size: 16px; font-weight: 700; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        if root.members-available: Middle {
                            HeaderToggle {
                                icon: @image-url("icons/users.svg"); text: root.members; open: root.member-list;
                                label: root.member-list ? "Hide member list" : "Show member list";
                                clicked => { root.toggle-members(); }
                            }
                        }
                        if !root.members-available && root.members != "": HorizontalLayout {
                            spacing: 6px;
                            Image { source: @image-url("icons/users.svg"); width: 18px; image-fit: contain; colorize: Theme.muted; }
                            Text { text: root.members; color: Theme.muted; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
                }
                HorizontalLayout {
                    spacing: 0px;
                    VerticalLayout {
                        spacing: 0px; horizontal-stretch: 1;
                        if root.preview: Rectangle {
                            min-height: preview-content.preferred-height; background: Theme.raised; vertical-stretch: 0;
                            preview-content := HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; padding-top: 7px; padding-bottom: 7px; spacing: 10px;
                                Image { source: @image-url("icons/triangle-alert.svg"); width: 16px; image-fit: contain; colorize: Theme.accent; }
                                Text {
                                    text: "Local preview: sample data. Nothing leaves this computer.";
                                    color: Theme.secondary; font-size: 14px; font-weight: 500; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
                                }
                            }
                        }
                        if !root.preview && !root.trusted: Rectangle {
                            min-height: trust-content.preferred-height; background: Theme.raised; vertical-stretch: 0;
                            trust-content := HorizontalLayout {
                                padding: 16px; spacing: 14px;
                                Rectangle {
                                    width: 36px; height: 36px; border-radius: 18px; background: Theme.accent-soft;
                                    Image { source: @image-url("icons/lock.svg"); width: 18px; height: 18px; colorize: Theme.accent; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Verify this device to send messages"; color: Theme.text; font-weight: 700; }
                                    Label { text: "Use your Matrix recovery key, or verify Talk in another client and check again."; color: Theme.secondary; font-size: 14px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        TextField { text <=> root.recovery; password: true; placeholder: "Recovery key"; label: "Matrix recovery key"; enabled: !root.busy; min-height: 36px; accepted => { root.recover(); } }
                                        ActionButton { text: "Recover"; primary: true; enabled: !root.busy; clicked => { root.recover(); } }
                                        ActionButton { text: "Check again"; enabled: !root.busy; clicked => { root.refresh-trust(); } }
                                    }
                                }
                            }
                        }
                        if root.graphics-notice != "": Banner { text <=> root.graphics-notice; dismissed => { root.graphics-notice = ""; } }
                        if root.notice != "": Banner { text: root.notice; dismissed => { root.dismiss-notice(); } }
                        // Voice channel: a stage of participants, or an invitation to join.
                        if root.voice-room: Rectangle {
                            vertical-stretch: 1; background: Theme.stage;
                            if !root.voice-here: VerticalLayout {
                                padding: 32px; spacing: 14px; alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
                                        Image { source: @image-url("icons/volume-2.svg"); width: 38px; height: 38px; colorize: Theme.secondary; }
                                    }
                                }
                                Text { text: root.room-name; color: Theme.text; font-size: 26px; font-weight: 900; horizontal-alignment: center; overflow: elide; }
                                Text { text: root.voice-description; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
                                if !root.preview && !root.room-encrypted: Text { text: "This channel is unencrypted. Talk only joins encrypted voice channels."; color: Theme.accent; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
                                HorizontalLayout {
                                    alignment: center; padding-top: 6px;
                                    ActionButton { min-height: 42px; text: root.voice-active ? "Switch voice channel" : "Join voice"; primary: true; enabled: root.can-join; clicked => { root.join-voice(); } }
                                }
                            }
                            if root.voice-here: VerticalLayout {
                                spacing: 0px;
                                HorizontalLayout {
                                    padding: 16px; padding-bottom: 0px;
                                    Text { text: root.voice-description; color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
                                }
                                if root.watching: Rectangle {
                                    vertical-stretch: 1;
                                    Rectangle {
                                        x: 16px; y: 12px; width: parent.width - 32px; height: parent.height - 12px;
                                        border-radius: 12px; background: #000000; clip: true;
                                        accessible-role: image; accessible-label: root.watch-title;
                                        Image { width: parent.width; height: parent.height; source: root.watch-frame; image-fit: contain; }
                                        if root.watch-frame.width == 0: Text {
                                            width: parent.width; height: parent.height;
                                            text: root.watch-status; color: Theme.secondary; font-size: 15px;
                                            horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                                        }
                                        Rectangle {
                                            x: 12px; y: 12px; height: 28px;
                                            width: min(parent.width - 72px, watch-chip.preferred-width);
                                            border-radius: 6px; background: #000000a6;
                                            watch-chip := HorizontalLayout {
                                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                                Text { text: root.watch-title; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Middle { LivePill { } }
                                            }
                                        }
                                        IconButton {
                                            x: parent.width - self.width - 10px; y: 10px; height: self.size;
                                            icon: @image-url("icons/x.svg"); label: "Stop watching"; tint: #ffffff;
                                            fill: #000000a6; radius: 16px;
                                            clicked => { root.stop-watching(); }
                                        }
                                    }
                                }
                                if !root.watching: stage := Flickable {
                                    vertical-stretch: 1;
                                    property <length> gap: 12px;
                                    property <length> inset: 24px;
                                    property <length> span: self.width - 2 * self.inset;
                                    // Your shared screen leads the grid.
                                    property <int> extra: root.sharing ? 1 : 0;
                                    property <int> count: root.participants.length + self.extra;
                                    property <int> columns: max(1, min(self.count, floor((self.span + self.gap) / (240px + self.gap))));
                                    property <length> tile-width: min(420px, (self.span - (self.columns - 1) * self.gap) / self.columns);
                                    property <length> tile-height: self.tile-width * 0.5625;
                                    property <int> rows: ceil(self.count / self.columns);
                                    property <length> grid-height: self.rows * self.tile-height + max(0, self.rows - 1) * self.gap;
                                    property <length> grid-width: self.columns * self.tile-width + (self.columns - 1) * self.gap;
                                    content-height: max(self.height, self.grid-height + 2 * self.inset);
                                    if root.sharing: Rectangle {
                                        x: (stage.width - stage.grid-width) / 2;
                                        y: max(stage.inset, (stage.height - stage.grid-height) / 2);
                                        width: stage.tile-width; height: stage.tile-height;
                                        border-radius: 12px; background: #000000; clip: true;
                                        accessible-role: text;
                                        accessible-label: "Your screen, " + root.share-status;
                                        Image { width: parent.width; height: parent.height; source: root.share-frame; image-fit: contain; }
                                        if root.share-frame.width == 0: VerticalLayout {
                                            alignment: center; spacing: 10px;
                                            Image { height: 34px; source: @image-url("icons/screen-share.svg"); image-fit: contain; colorize: Theme.secondary; }
                                            Text { text: root.share-status; color: Theme.secondary; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                                        }
                                        Rectangle {
                                            x: 10px; y: parent.height - self.height - 10px;
                                            width: min(parent.width - 20px, share-chip.preferred-width); height: 26px;
                                            border-radius: 6px; background: #000000a6;
                                            share-chip := HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                                Text { text: "Your screen"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                if root.share-live: Middle { LivePill { } }
                                                if !root.share-live && root.share-frame.width > 0: Text {
                                                    text: root.share-status; color: Theme.accent; font-size: 13px; vertical-alignment: center; overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                    for person[position] in root.participants: Rectangle {
                                        property <int> index: position + stage.extra;
                                        x: (stage.width - stage.grid-width) / 2 + mod(self.index, stage.columns) * (stage.tile-width + stage.gap);
                                        y: max(stage.inset, (stage.height - stage.grid-height) / 2) + floor(self.index / stage.columns) * (stage.tile-height + stage.gap);
                                        width: stage.tile-width; height: stage.tile-height;
                                        border-radius: 12px; background: Theme.raised;
                                        border-width: person.speaking ? 3px : 0px; border-color: Theme.live;
                                        accessible-role: text;
                                        accessible-label: person.name + ", " + person.status;
                                        Avatar {
                                            size: min(80px, parent.height * 0.45); initial: person.initial; tint: person.tint; picture: person.picture;
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 - 8px;
                                            opacity: person.connected ? 1 : 0.5;
                                        }
                                        if person.live && !person.local: TouchArea {
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.watch-stream(person.id); }
                                        }
                                        if person.live && !person.local: Rectangle {
                                            x: parent.width - self.width - 10px; y: 10px; height: 26px;
                                            width: watch-label.preferred-width + 20px; border-radius: 13px;
                                            background: Theme.danger;
                                            accessible-role: button; accessible-label: "Watch " + person.name + "'s stream";
                                            accessible-action-default => { root.watch-stream(person.id); }
                                            watch-label := Text { text: "Watch stream"; color: #ffffff; font-size: 13px; font-weight: 700; }
                                        }
                                        Rectangle {
                                            x: 10px; y: parent.height - self.height - 10px;
                                            width: min(parent.width - 20px, chip.preferred-width); height: 26px;
                                            border-radius: 6px; background: #000000a6;
                                            chip := HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                                if person.muted: Image { source: @image-url("icons/mic-off.svg"); width: 14px; image-fit: contain; colorize: Theme.danger; }
                                                Text { text: person.name; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                if person.live: Middle { LivePill { } }
                                                if person.status != "Muted" && person.status != "Speaking" && person.status != "Listening": Text {
                                                    text: person.status; color: Theme.accent; font-size: 13px; vertical-alignment: center; overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: center; spacing: 12px; padding: 16px; padding-top: 8px;
                                    IconButton {
                                        size: 52px; glyph: 22px; radius: 26px;
                                        icon: root.muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                                        label: root.muted ? "Unmute" : "Mute"; alert: root.muted; tint: Theme.text;
                                        enabled: root.voice-ready;
                                        fill: self.alert ? Theme.danger.with-alpha(0.18) : Theme.raised;
                                        clicked => { root.toggle-mute(); }
                                    }
                                    IconButton {
                                        size: 52px; glyph: 22px; radius: 26px;
                                        icon: root.deafened ? @image-url("icons/headphone-off.svg") : @image-url("icons/headphones.svg");
                                        label: root.deafened ? "Undeafen" : "Deafen"; alert: root.deafened; tint: Theme.text;
                                        enabled: root.voice-ready;
                                        fill: self.alert ? Theme.danger.with-alpha(0.18) : Theme.raised;
                                        clicked => { root.toggle-deafen(); }
                                    }
                                    if root.can-share || root.sharing: IconButton {
                                        size: 52px; glyph: 22px; radius: 26px;
                                        icon: root.sharing ? @image-url("icons/screen-share-off.svg") : @image-url("icons/screen-share.svg");
                                        label: root.sharing ? "Stop sharing" : "Share your screen"; tint: Theme.text;
                                        enabled: root.voice-ready;
                                        fill: root.sharing ? Theme.live.with-alpha(0.22) : Theme.raised;
                                        clicked => { root.toggle-share(); }
                                    }
                                    Rectangle {
                                        width: 76px; height: 52px; border-radius: 26px;
                                        background: leave-touch.has-hover ? Theme.danger-hover : Theme.danger;
                                        opacity: root.voice-leaving ? 0.5 : 1;
                                        accessible-role: button; accessible-label: "Leave voice"; accessible-enabled: !root.voice-leaving;
                                        accessible-action-default => { if !root.voice-leaving { root.leave-voice(); } }
                                        Image { source: @image-url("icons/phone-off.svg"); width: 22px; height: 22px; colorize: #ffffff; }
                                        leave-touch := TouchArea { enabled: !root.voice-leaving; mouse-cursor: MouseCursor.pointer; clicked => { root.leave-voice(); } }
                                    }
                                }
                            }
                        }
                        // Text conversation.
                        Rectangle {
                            visible: !root.voice-room;
                            min-height: 0px;
                            max-height: root.voice-room ? 0px : 100000px;
                            vertical-stretch: root.voice-room ? 0 : 1;
                            timeline := ListView {
                                width: parent.width; height: parent.height;
                                scrolled => { root.follow-latest = false; }
                                for message[index] in root.messages: Rectangle {
                                    property <bool> lit: root.active-item == message.item;
                                    // The space that holds a short history down stays outside the row.
                                    property <length> top: index == 0 ? root.lead : 0px;
                                    height: col.preferred-height + self.top;
                                    Rectangle { y: parent.top; height: parent.height - parent.top; background: parent.lit ? Theme.row-hover : transparent; }
                                    // The pointer area wraps the row, so hovering selectable text still counts.
                                    // The last hovered or clicked message keeps its actions: the list takes
                                    // the pointer when a press starts, which ends hover, so a hover-only bar
                                    // would vanish before its button saw the click.
                                    row-pointer := TouchArea {
                                        y: parent.top; height: parent.height - parent.top;
                                        changed has-hover => { if self.has-hover { root.active-item = message.item; } }
                                        clicked => { root.active-item = message.item; }
                                        // A right click opens the same menu as the hover bar's More button.
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                                                && !message.deleted && message.delivery == "" {
                                                root.active-item = message.item;
                                                root.anchor(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0px, 0px, true);
                                                root.open-menu(message);
                                            }
                                        }
                                        col := VerticalLayout {
                                            padding-top: message.day != "" ? 12px : message.first ? 14px : 1px;
                                            padding-bottom: index == root.messages.length - 1 ? 16px : 1px;
                                            spacing: 0px;
                                            // History starts with a way to load more of it.
                                            if index == 0 && !root.preview && root.room-ready: HorizontalLayout {
                                                alignment: center; padding-top: 4px; padding-bottom: 8px;
                                                Rectangle {
                                                    width: earlier-content.preferred-width; height: 30px; border-radius: 15px;
                                                    background: earlier-touch.has-hover && !root.loading-history ? Theme.active : Theme.raised;
                                                    accessible-role: button; accessible-label: "Earlier messages"; accessible-enabled: !root.loading-history && !root.busy;
                                                    accessible-action-default => { if !root.loading-history && !root.busy { root.earlier(); } }
                                                    earlier-content := HorizontalLayout {
                                                        padding-left: 12px; padding-right: 14px; spacing: 6px;
                                                        Image { source: @image-url("icons/history.svg"); width: 16px; image-fit: contain; colorize: Theme.secondary; }
                                                        Text { text: root.loading-history ? "Loading..." : "Earlier messages"; color: Theme.secondary; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                                                    }
                                                    earlier-touch := TouchArea { enabled: !root.loading-history && !root.busy; mouse-cursor: MouseCursor.pointer; clicked => { root.earlier(); } }
                                                }
                                            }
                                            if message.day != "": HorizontalLayout {
                                                padding-left: 16px; padding-right: 16px; padding-bottom: 6px; spacing: 10px; height: 26px;
                                                Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.line; } }
                                                Text { text: message.day; color: Theme.muted; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                                Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.line; } }
                                            }
                                            HorizontalLayout {
                                                padding-left: 16px; padding-right: 48px; padding-top: 2px; padding-bottom: 2px; spacing: 16px;
                                                Rectangle {
                                                    width: 40px;
                                                    min-height: message.first ? (message.has-reply ? 64px : 40px) : 0px;
                                                    if message.has-reply: Rectangle {
                                                        x: 19px; y: 11px; width: 33px; height: 13px; clip: true;
                                                        Rectangle {
                                                            x: 0px; y: 0px; width: parent.width + 12px; height: parent.height + 12px;
                                                            border-width: 2px; border-color: #4a4c56; border-top-left-radius: 6px;
                                                        }
                                                    }
                                                    if message.first: Avatar {
                                                        x: 0px; y: message.has-reply ? 24px : 2px;
                                                        initial: message.initial; tint: message.tint; picture: message.picture;
                                                    }
                                                    if !message.first && root.active-item == message.item: Text {
                                                        x: 0px; y: 4px; width: 40px;
                                                        text: message.short-time; color: Theme.muted; font-size: 12px; font-weight: 500;
                                                        horizontal-alignment: right; overflow: elide;
                                                    }
                                                }
                                                VerticalLayout {
                                                    spacing: 3px; horizontal-stretch: 1;
                                                    if message.has-reply: HorizontalLayout {
                                                        height: 22px; spacing: 6px;
                                                        if message.reply-author != "": Middle { Avatar { size: 16px; initial: message.reply-initial; tint: message.reply-tint; } }
                                                        if message.reply-author != "": Text { text: message.reply-author; color: Theme.secondary; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                        Text { text: message.reply-body; color: Theme.muted; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                    }
                                                    if message.first: HorizontalLayout {
                                                        spacing: 8px;
                                                        Text { text: message.author; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; vertical-alignment: center; }
                                                        Text { text: message.time; color: Theme.muted; font-size: 13px; font-weight: 500; wrap: no-wrap; vertical-alignment: center; }
                                                        Rectangle { horizontal-stretch: 1; }
                                                    }
                                                    if message.formatted: StyledText {
                                                        text: message.styled; default-color: message.delivery != "" ? Theme.muted : Theme.text; link-color: Theme.link;
                                                        link-clicked(link) => { root.open-link(link); }
                                                        accessible-role: text; accessible-label: "Message from " + message.author + ": " + message.body;
                                                    }
                                                    if !message.formatted && message.body != "": TextInput {
                                                        text: message.body; color: message.deleted || message.delivery != "" ? Theme.muted : Theme.text;
                                                        read-only: true; single-line: false; wrap: word-wrap;
                                                        selection-background-color: Theme.accent.with-alpha(0.35); selection-foreground-color: Theme.text;
                                                        accessible-label: "Message from " + message.author;
                                                    }
                                                    if message.edited && !message.deleted: Text { text: "(edited)"; color: Theme.muted; font-size: 12px; }
                                                    // Fixed-size children sit beside a spacer, so they do not cap the column's width.
                                                    // Clicking an image opens it large.
                                                    if message.images.length > 0: HorizontalLayout {
                                                        padding-top: 4px;
                                                        Rectangle {
                                                            width: message.gallery-width * 1px; height: message.gallery-height * 1px;
                                                            for cell in message.images: Rectangle {
                                                                x: cell.x * 1px; y: cell.y * 1px; width: cell.width * 1px; height: cell.height * 1px;
                                                                border-radius: 8px; clip: true; background: Theme.sunken;
                                                                Image { source: cell.image; width: parent.width; height: parent.height; image-fit: cover; accessible-role: image; accessible-label: cell.name; }
                                                                TouchArea {
                                                                    mouse-cursor: MouseCursor.pointer;
                                                                    clicked => { root.view-image(message.item, cell.index); }
                                                                }
                                                                if root.active-item == message.item && !root.preview && message.delivery == "": Rectangle {
                                                                    x: parent.width - self.width - 8px; y: 8px; width: 32px; height: 32px; border-radius: 6px; background: #000000b3;
                                                                    IconButton {
                                                                        icon: @image-url("icons/download.svg"); label: "Save " + cell.name; tint: Theme.text;
                                                                        clicked => { root.save-attachment(message.item, cell.index); }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                    }
                                                    for file in message.files: HorizontalLayout {
                                                        padding-top: 4px;
                                                        Rectangle {
                                                            min-height: file-card.preferred-height; max-width: 432px; horizontal-stretch: 100;
                                                            background: Theme.sidebar; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                                                            file-card := HorizontalLayout {
                                                                padding: 12px; padding-right: 8px; spacing: 12px;
                                                                Image { source: @image-url("icons/file.svg"); width: 30px; image-fit: contain; colorize: Theme.accent; }
                                                                VerticalLayout {
                                                                    alignment: center; horizontal-stretch: 1;
                                                                    Text { text: file.name; color: Theme.text; font-weight: 500; overflow: elide; }
                                                                    if file.detail != "": Label { text: file.detail; }
                                                                }
                                                                IconButton {
                                                                    icon: @image-url("icons/download.svg"); label: "Save " + file.name;
                                                                    enabled: !root.preview && message.delivery == "";
                                                                    clicked => { root.save-attachment(message.item, file.index); }
                                                                }
                                                            }
                                                        }
                                                        Rectangle { horizontal-stretch: 1; }
                                                    }
                                                    if message.reactions.length > 0: HorizontalLayout {
                                                        spacing: 6px; alignment: start; padding-top: 4px;
                                                        for reaction in message.reactions: ReactionToggle {
                                                            key: reaction.key; count: reaction.count; mine: reaction.mine; emoji-font: root.emoji-font;
                                                            enabled: message.can-react && root.composer-enabled;
                                                            clicked => { root.react(message.item, reaction.key); }
                                                        }
                                                    }
                                                    if message.delivery != "": HorizontalLayout {
                                                        spacing: 4px; alignment: start;
                                                        Text { text: message.delivery; color: message.delivery-failed ? Theme.danger : Theme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                                        if message.can-retry: ActionButton { text: "Retry"; ghost: true; small: true; clicked => { root.retry(message.item); } }
                                                        if message.can-cancel: ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { root.cancel-send(message.item); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    // Actions, the reaction picker and delete confirmation float over the
                                    // row's top edge, so opening them never moves the timeline.
                                    if (self.lit || root.react-item == message.item || root.menu-item == message.item || root.confirm-delete == message.item) && !message.deleted && message.delivery == "": Rectangle {
                                        x: parent.width - self.width - 16px; y: parent.top + (index == 0 ? 4px : -16px);
                                        width: actions.preferred-width; height: actions.preferred-height;
                                        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                                        drop-shadow-blur: 10px; drop-shadow-color: #00000059; drop-shadow-offset-y: 2px;
                                        actions := HorizontalLayout {
                                            padding: 3px; spacing: 0px;
                                            if root.confirm-delete == message.item: HorizontalLayout {
                                                spacing: 4px; padding-left: 8px;
                                                Text { text: "Delete for everyone?"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                ActionButton { text: "Delete"; danger: true; small: true; clicked => { root.confirm-delete-message(); } }
                                                ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { root.cancel-delete(); } }
                                            }
                                            // Frequent reactions, then the picker, Edit on your own message or
                                            // Reply on someone else's, and everything else under More.
                                            if root.confirm-delete != message.item: HorizontalLayout {
                                                spacing: 0px;
                                                if message.can-react && root.composer-enabled: HorizontalLayout {
                                                    spacing: 0px;
                                                    for cell in root.bar-reactions: EmojiButton {
                                                        emoji: cell; font: root.emoji-font;
                                                        clicked => { root.react(message.item, cell.glyph); }
                                                    }
                                                    Rectangle {
                                                        width: 9px;
                                                        Rectangle { width: 1px; height: 20px; background: Theme.line; }
                                                    }
                                                    IconButton {
                                                        icon: @image-url("icons/smile-plus.svg"); label: "Add reaction";
                                                        clicked => {
                                                            root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                            root.open-picker(message.item);
                                                        }
                                                    }
                                                }
                                                if message.own && message.can-edit && root.composer-enabled: IconButton { icon: @image-url("icons/pencil.svg"); label: "Edit"; clicked => { root.edit(message.item); root.focus-composer(); } }
                                                if !(message.own && message.can-edit) && message.can-reply && root.composer-enabled: IconButton { icon: @image-url("icons/reply.svg"); label: "Reply"; clicked => { root.reply(message.item); root.focus-composer(); } }
                                                IconButton {
                                                    icon: @image-url("icons/ellipsis.svg"); label: "More";
                                                    clicked => {
                                                        root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                        root.open-menu(message);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            // The conversation's opening, or what to do when none is chosen.
                            if !root.room-selected: VerticalLayout {
                                width: parent.width; height: parent.height;
                                padding: 32px; spacing: 10px; alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
                                        Image { source: @image-url("icons/message-circle.svg"); width: 36px; height: 36px; colorize: Theme.secondary; }
                                    }
                                }
                                Text { text: "Pick a conversation"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "Choose a DM or a server channel on the left."; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
                            }
                            if root.room-selected && root.messages.length == 0: VerticalLayout {
                                width: parent.width; height: parent.height;
                                padding: 24px; spacing: 8px; alignment: end;
                                if root.room-selected && root.room-ready && root.room-direct: Avatar { size: 72px; initial: root.room-initial; tint: root.room-tint; }
                                if root.room-selected && root.room-ready && !root.room-direct: Rectangle {
                                    width: 68px; height: 68px; border-radius: 34px; background: Theme.raised;
                                    Image { source: root.room-icon; width: 36px; height: 36px; colorize: Theme.text; }
                                }
                                Text {
                                    text: !root.room-ready ? "Loading conversation..." : root.room-direct ? root.room-name : "Welcome to #" + root.room-name;
                                    color: Theme.text; font-size: root.room-ready ? 28px : 18px; font-weight: 900; wrap: word-wrap;
                                }
                                if root.room-ready: Text {
                                    text: root.room-direct ? "This is the beginning of your messages with " + root.room-name + "."
                                        : "This is the start of #" + root.room-name + ". No messages here yet.";
                                    color: Theme.secondary; wrap: word-wrap;
                                }
                            }
                        }
                        // Composer.
                        VerticalLayout {
                            visible: !root.voice-room && root.room-selected;
                            min-height: 0px;
                            max-height: root.voice-room || !root.room-selected ? 0px : 100000px;
                            padding-left: 16px; padding-right: 16px; padding-top: 0px; padding-bottom: 0px;
                            spacing: 0px; vertical-stretch: 0;
                            if root.compose-label != "": Rectangle {
                                height: 36px; background: Theme.sidebar;
                                border-top-left-radius: 10px; border-top-right-radius: 10px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 4px; spacing: 8px;
                                    Image { source: root.is-editing ? @image-url("icons/pencil.svg") : @image-url("icons/reply.svg"); width: 16px; image-fit: contain; colorize: Theme.muted; }
                                    Text { text: root.compose-label; color: Theme.secondary; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    IconButton { icon: @image-url("icons/x.svg"); label: root.is-editing ? "Cancel editing" : "Cancel reply"; size: 28px; glyph: 16px; clicked => { root.cancel-compose(); } }
                                }
                            }
                            Rectangle {
                                min-height: 48px; background: Theme.field;
                                border-radius: 10px;
                                border-top-left-radius: root.compose-label != "" ? 0px : 10px;
                                border-top-right-radius: root.compose-label != "" ? 0px : 10px;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 8px; spacing: 6px;
                                    IconButton {
                                        icon: @image-url("icons/circle-plus.svg"); label: root.attaching ? "Attaching..." : "Attach a file";
                                        glyph: 22px;
                                        enabled: root.can-attach; clicked => { root.attach(); }
                                    }
                                    composer := TextField {
                                        min-height: 48px; fill: transparent; ring: false; pad: 6px; text-size: 16px;
                                        text <=> root.draft; enabled: root.composer-enabled; label: "Message";
                                        placeholder: root.is-editing ? "Edit your message" : root.compose-label != "" ? "Write a reply" : root.room-selected && !root.room-direct ? "Message #" + root.room-name : root.room-selected ? "Message " + root.room-name : "Write a message";
                                        edited(text) => { root.draft-edited(text); }
                                        accepted => { root.send(); }
                                    }
                                    IconButton {
                                        icon: @image-url("icons/send-horizontal.svg");
                                        label: root.sending ? "Sending..." : root.is-editing ? "Save" : "Send";
                                        enabled: root.can-send; emphasis: root.can-send;
                                        clicked => { root.send(); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                height: 28px; spacing: 6px; padding-left: 4px;
                                if root.room-encrypted || root.preview: Image { source: @image-url("icons/lock.svg"); width: 12px; image-fit: contain; colorize: Theme.muted; }
                                Text { text: root.attaching ? "Attaching..." : root.composer-hint; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                        }
                    }
                    if root.members-docked: MemberPanel { width: 240px; rows: root.roster; note: root.roster-note; }
                }
            }
            // The header casts a soft shadow over the conversation.
            Rectangle {
                y: 48px; height: 6px;
                background: @linear-gradient(180deg, #00000040 0%, #00000000 100%);
            }
        }
    }
    // The edge between sidebar and conversation resizes the sidebar. A double-click
    // restores the default width.
    if root.workspace: TouchArea {
        x: 72px + root.sidebar-shown - 4px; y: 0px; width: 8px; height: root.height;
        mouse-cursor: ew-resize;
        moved => {
            if self.pressed {
                root.sidebar-width = max(180px, min(380px, root.width - 72px - 420px - (root.members-docked ? 240px : 0px), root.sidebar-shown + self.mouse-x - self.pressed-x));
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up { root.sidebar-resized(root.sidebar-shown); }
        }
        double-clicked => { root.sidebar-width = 240px; root.sidebar-resized(240px); }
        Rectangle {
            x: 3px; width: 2px;
            background: parent.pressed ? Theme.faint : Theme.line;
            opacity: parent.has-hover || parent.pressed ? 1 : 0;
            animate opacity { duration: 120ms; }
        }
    }

    // Switching voice channels asks first, over everything else. Clicking
    // outside or Escape cancels; Enter switches. The dialog stays in the tree
    // so it can fade out, keeping its text while it goes.
    property <bool> switching: root.switch-prompt != "";
    property <string> switch-text;
    changed switch-prompt => { if root.switch-prompt != "" { root.switch-text = root.switch-prompt; } }
    changed switching => { if root.switching { switch-keys.focus(); } else { switch-keys.clear-focus(); } }
    Rectangle {
        visible: self.opacity > 0;
        opacity: root.switching ? 1 : 0;
        animate opacity { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        background: #00000099;
        TouchArea { enabled: root.switching; clicked => { root.cancel-switch(); } }
        Rectangle {
            width: min(420px, root.width - 48px); height: switch-content.preferred-height;
            y: (parent.height - self.height) / 2 + (root.switching ? 0px : 10px);
            transform-scale: root.switching ? 1 : 0.96;
            animate y, transform-scale { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
            drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
            accessible-role: groupbox;
            accessible-label: "Switch voice channel?";
            // Clicks on the dialog itself never reach the backdrop.
            TouchArea { enabled: root.switching; }
            switch-keys := FocusScope {
                enabled: root.switching;
                key-pressed(event) => {
                    if event.text == Key.Escape { root.cancel-switch(); return accept; }
                    if event.text == "\n" { root.confirm-switch(); return accept; }
                    return reject;
                }
                switch-content := VerticalLayout {
                    padding: 20px; spacing: 18px;
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 40px; height: 40px; border-radius: 20px; background: Theme.accent-soft;
                                Image { source: @image-url("icons/volume-2.svg"); width: 20px; height: 20px; colorize: Theme.accent; }
                            }
                        }
                        VerticalLayout {
                            spacing: 6px; horizontal-stretch: 1;
                            Text { text: "Switch voice channel?"; color: Theme.text; font-size: 18px; font-weight: 700; }
                            Text { text: root.switch-text; color: Theme.secondary; font-size: 15px; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        alignment: end; spacing: 8px;
                        // A fading dialog no longer acts.
                        ActionButton { text: "Cancel"; ghost: true; clicked => { if root.switching { root.cancel-switch(); } } }
                        ActionButton { text: "Switch channel"; primary: true; clicked => { if root.switching { root.confirm-switch(); } } }
                    }
                }
            }
        }
    }
    // An image shown large over everything. Arrow keys or the side buttons
    // step through the message's images; Escape, the close button or a click
    // outside the image closes it.
    if root.viewer-open: Rectangle {
        background: #000000e6;
        accessible-role: groupbox;
        accessible-label: "Image viewer";
        TouchArea { clicked => { root.close-image(); } }
        viewer-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-image(); return accept; }
                if event.text == Key.LeftArrow && root.viewer-position != "" { root.step-image(-1); return accept; }
                if event.text == Key.RightArrow && root.viewer-position != "" { root.step-image(1); return accept; }
                return reject;
            }
            // Shown at full size, shrunk to fit beside the bars and arrows.
            property <length> room-width: root.width - 160px;
            property <length> room-height: root.height - 128px;
            property <length> natural-width: max(1, root.viewer-width) * 1px;
            property <length> natural-height: max(1, root.viewer-height) * 1px;
            property <float> scale: min(1, min(self.room-width / self.natural-width, self.room-height / self.natural-height));
            Image {
                width: viewer-keys.natural-width * viewer-keys.scale; height: viewer-keys.natural-height * viewer-keys.scale;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                source: root.viewer-image; image-fit: contain;
                accessible-role: image; accessible-label: root.viewer-name;
                TouchArea { }
            }
            HorizontalLayout {
                y: 0px; height: 64px; padding-left: 20px; padding-right: 12px; spacing: 8px;
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1;
                    Text { text: root.viewer-name; color: #ffffff; font-size: 15px; font-weight: 700; overflow: elide; }
                    if root.viewer-position != "": Text { text: root.viewer-position; color: #ffffffb3; font-size: 13px; }
                }
                if !root.preview: Middle {
                    IconButton {
                        icon: @image-url("icons/download.svg"); label: "Save " + root.viewer-name; tint: #ffffff;
                        clicked => { root.save-attachment(root.viewer-item, root.viewer-index); }
                    }
                }
                Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Close"; tint: #ffffff; clicked => { root.close-image(); } } }
            }
            if root.viewer-position != "": Rectangle {
                x: 20px; y: (parent.height - self.height) / 2; width: 48px; height: 48px; border-radius: 24px;
                background: previous-touch.has-hover ? #ffffff33 : #ffffff1a;
                Image { source: @image-url("icons/chevron-left.svg"); width: 28px; height: 28px; colorize: #ffffff; }
                previous-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.step-image(-1); } }
                accessible-role: button; accessible-label: "Previous image";
                accessible-action-default => { root.step-image(-1); }
            }
            if root.viewer-position != "": Rectangle {
                x: parent.width - self.width - 20px; y: (parent.height - self.height) / 2; width: 48px; height: 48px; border-radius: 24px;
                background: next-touch.has-hover ? #ffffff33 : #ffffff1a;
                Image { source: @image-url("icons/chevron-right.svg"); width: 28px; height: 28px; colorize: #ffffff; }
                next-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.step-image(1); } }
                accessible-role: button; accessible-label: "Next image";
                accessible-action-default => { root.step-image(1); }
            }
            if root.viewer-note != "": Rectangle {
                x: (parent.width - self.width) / 2; y: parent.height - self.height - 20px;
                width: viewer-note-text.preferred-width + 24px; height: 32px; border-radius: 6px; background: #000000b3;
                viewer-note-text := Text { text: root.viewer-note; color: #ffffffd9; font-size: 13px; }
            }
        }
    }
    // Forwarding a message: pick conversations to send it to, one click each.
    // Clicking outside or Escape closes it.
    if root.forward-open: Rectangle {
        background: #00000099;
        TouchArea { clicked => { root.close-forward(); } }
        Rectangle {
            width: min(440px, root.width - 48px); height: min(520px, root.height - 48px);
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
            drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
            accessible-role: groupbox;
            accessible-label: "Forward message";
            TouchArea { }
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { root.close-forward(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: "Forward message"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close-forward(); } }
                    }
                    // The message, as a quote.
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle { width: 3px; border-radius: 1.5px; background: Theme.line; }
                        Text { text: root.forward-preview; color: Theme.secondary; font-size: 15px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    forward-field := TextField {
                        init => { self.focus-input(); }
                        min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                        placeholder: "Find a conversation"; label: "Find a conversation"; text <=> root.forward-query;
                        edited => { root.forward-search(); }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px; alignment: start;
                            for target in root.forward-targets: Rectangle {
                                height: 48px; border-radius: 6px;
                                background: target-touch.has-hover && !target.sent ? Theme.hover : transparent;
                                accessible-role: button;
                                accessible-label: (target.sent ? "Sent to " : "Forward to ") + target.name + ", " + target.place;
                                accessible-action-default => { if !target.sent { root.forward-to(target.id); } }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 12px;
                                    if target.direct: Middle { Avatar { size: 32px; initial: target.initial; tint: target.tint; } }
                                    if !target.direct: Middle {
                                        Rectangle {
                                            width: 32px; height: 32px; border-radius: 16px; background: Theme.field;
                                            Image { source: target.icon; width: 18px; height: 18px; colorize: Theme.secondary; }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 1;
                                        Text { text: target.name; color: Theme.text; font-size: 16px; font-weight: 500; overflow: elide; }
                                        Text { text: target.place; color: Theme.muted; font-size: 13px; overflow: elide; }
                                    }
                                    if target.sent: HorizontalLayout {
                                        spacing: 4px;
                                        Image { source: @image-url("icons/check.svg"); width: 16px; image-fit: contain; colorize: Theme.live; }
                                        Text { text: "Sent"; color: Theme.secondary; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    }
                                    if !target.sent: Middle {
                                        ActionButton { text: "Send"; small: true; primary: target-touch.has-hover; clicked => { root.forward-to(target.id); } }
                                    }
                                }
                                target-touch := TouchArea {
                                    enabled: !target.sent; mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.forward-to(target.id); }
                                }
                            }
                            if root.forward-targets.length == 0: HorizontalLayout {
                                padding: 8px;
                                Label { text: root.forward-query != "" ? "No conversations match." : "There's nowhere to forward to yet. Talk forwards only into encrypted conversations."; }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        ActionButton { text: "Done"; clicked => { root.close-forward(); } }
                    }
                }
            }
        }
    }
    if Tip.text != "": Rectangle {
        property <length> w: tip-text.preferred-width + 20px;
        property <length> h: 32px;
        x: Tip.side == 1 ? Tip.x + 10px : max(8px, min(root.width - self.w - 8px, Tip.x - self.w / 2));
        y: Tip.side == 1 ? Tip.y - self.h / 2 : Tip.side == 0 ? max(4px, Tip.y - self.h - 6px) : Tip.y + 6px;
        width: self.w; height: self.h;
        border-radius: 6px; background: #0b0c0e;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 3px;
        tip-text := Text { text: Tip.text; color: Theme.text; font-size: 14px; font-weight: 700; }
    }
}
