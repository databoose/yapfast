import { ComboBox, ScrollView, ListView, Palette } from "std-widgets.slint";
import "fonts/Satoshi-Regular.ttf";
import "fonts/Satoshi-Italic.ttf";
import "fonts/Satoshi-Medium.ttf";
import "fonts/Satoshi-Bold.ttf";
import "fonts/Satoshi-BoldItalic.ttf";
import "fonts/Satoshi-Black.ttf";

// Layered graphite: the rail is darkest, the conversation lightest. Marigold marks
// selection and primary actions, red mentions and destructive actions, green live voice.
global Theme {
    out property <color> rail: #111215;
    out property <color> sidebar: #17181c;
    out property <color> panel: #121316;
    out property <color> chat: #1e1f24;
    out property <color> stage: #1e1f24;
    out property <color> raised: #26272e;
    out property <color> field: #2a2b32;
    out property <color> sunken: #0e0f12;
    out property <color> hover: #222329;
    out property <color> active: #2c2d35;
    out property <color> row-hover: #1a1b20;
    out property <color> line: #2c2d34;
    out property <color> edge: #0c0d0f;
    out property <color> text: #eef0f4;
    out property <color> secondary: #b5b8c1;
    out property <color> muted: #8d919c;
    out property <color> faint: #5c606a;
    out property <color> accent: #ffbf47;
    out property <color> accent-hover: #ffcd70;
    out property <color> on-accent: #1d1607;
    out property <color> accent-soft: #ffbf4726;
    out property <color> danger: #f0545e;
    out property <color> danger-hover: #f46f77;
    out property <color> live: #3ecf7e;
    out property <color> link: #7cc4ff;
    out property <duration> quick: 120ms;
}

// One tooltip for the whole window, drawn above everything else.
global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    /// 0 above the anchor, 1 to its right, 2 below it.
    in-out property <int> side;
}

// Centres a fixed-size child across a row, which Slint layouts align to the top.
component Middle inherits VerticalLayout {
    alignment: center;
}

component Label inherits Text {
    color: Theme.muted; font-size: 13px; wrap: word-wrap;
    vertical-stretch: 0;
}

// A labelled action. Primary is marigold, danger red, ghost transparent until hovered.
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> ghost;
    in property <bool> danger;
    in property <bool> small;
    callback clicked;
    min-width: max(root.small ? 28px : 36px, content.preferred-width);
    min-height: root.small ? 28px : 36px;
    max-height: self.min-height;
    vertical-stretch: 0;
    border-radius: 6px;
    background: !root.enabled ? (root.primary ? Theme.accent.with-alpha(0.3) : root.ghost ? transparent : Theme.raised)
        : root.primary ? (pointer.has-hover ? Theme.accent-hover : Theme.accent)
        : root.danger ? (pointer.has-hover ? Theme.danger-hover : Theme.danger)
        : root.ghost ? (pointer.has-hover ? #ffffff14 : transparent)
        : (pointer.has-hover ? #3c3d46 : #33343c);
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    property <color> ink: !root.enabled ? (root.primary ? Theme.on-accent.with-alpha(0.6) : Theme.faint)
        : root.primary ? Theme.on-accent : root.danger ? #ffffff
        : root.ghost && !pointer.has-hover ? Theme.secondary : Theme.text;
    content := HorizontalLayout {
        padding-left: root.small ? 10px : 16px; padding-right: self.padding-left;
        spacing: 8px; alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon; width: root.small ? 16px : 18px; image-fit: contain;
            colorize: root.ink;
        }
        if root.text != "": Text {
            text: root.text; color: root.ink; font-size: root.small ? 14px : 15px; font-weight: 700;
            vertical-alignment: center; overflow: elide;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
    }
}

// An icon-only action with a tooltip naming it.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    /// A state worth warning about, such as a muted microphone: drawn in red.
    in property <bool> alert;
    in property <bool> danger;
    in property <bool> emphasis;
    in property <length> size: 32px;
    in property <length> glyph: 20px;
    in property <color> tint: Theme.secondary;
    in property <color> fill: transparent;
    in property <int> tip-side: 0;
    in property <length> radius: 6px;
    out property <bool> hovered: pointer.has-hover;
    callback clicked;
    // The root fills its row; the visible face stays square and centred.
    width: root.size; min-height: root.size;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    face := Rectangle {
        width: root.size; height: root.size;
        border-radius: root.radius;
        background: !root.enabled ? root.fill
            : root.emphasis ? (pointer.has-hover ? Theme.accent-hover : Theme.accent)
            : root.danger && pointer.has-hover ? Theme.danger.with-alpha(0.16)
            : pointer.has-hover ? root.fill.mix(#ffffff, 0.9) : root.fill;
        animate background { duration: Theme.quick; }
        border-width: focus.has-focus ? 2px : 0px;
        border-color: Theme.accent;
        Image {
            source: root.icon; width: root.glyph; height: root.glyph;
            colorize: !root.enabled ? Theme.faint : root.emphasis ? Theme.on-accent
                : root.alert || (root.danger && pointer.has-hover) ? Theme.danger
                : pointer.has-hover ? Theme.text : root.tint;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => { Tip.text = ""; root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.label;
                    Tip.side = root.tip-side;
                    Tip.x = root.tip-side == 1 ? face.absolute-position.x + root.size : face.absolute-position.x + root.size / 2;
                    Tip.y = root.tip-side == 0 ? face.absolute-position.y : root.tip-side == 1 ? face.absolute-position.y + root.size / 2 : face.absolute-position.y + root.size;
                } else if Tip.text == root.label {
                    Tip.text = "";
                }
            }
        }
    }
}

// A toggle with a caret beside it that opens its device menu. The pair shares one
// hover ground, so the caret reads as part of the control it configures.
component DeviceToggle inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> menu-label;
    in property <bool> alert;
    in property <bool> enabled: true;
    in property <bool> open;
    callback clicked;
    callback menu;
    width: 52px; min-height: 32px;
    // The ground is the visible pair only, centred in the row like IconButton's face.
    Rectangle {
        y: (parent.height - self.height) / 2; height: 32px;
        border-radius: 6px;
        background: root.open || toggle.hovered || caret.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.quick; }
    }
    HorizontalLayout {
        toggle := IconButton {
            icon: root.icon; label: root.label; alert: root.alert; enabled: root.enabled;
            clicked => { root.clicked(); }
        }
        Rectangle {
            width: 20px;
            accessible-role: button;
            accessible-label: root.menu-label;
            accessible-action-default => { root.menu(); }
            Rectangle {
                y: (parent.height - self.height) / 2; width: 20px; height: 32px; border-radius: 6px;
                background: caret.has-hover ? #ffffff14 : transparent;
                animate background { duration: Theme.quick; }
                border-width: caret-focus.has-focus ? 2px : 0px;
                border-color: Theme.accent;
                Image {
                    source: @image-url("icons/chevron-down.svg"); width: 14px; height: 14px;
                    colorize: caret.has-hover || root.open ? Theme.text : Theme.muted;
                    transform-rotation: root.open ? 180deg : 0deg;
                    animate transform-rotation { duration: Theme.quick; }
                }
            }
            caret-focus := FocusScope {
                key-pressed(event) => {
                    if event.text == "\n" || event.text == " " {
                        root.menu(); return accept;
                    }
                    return reject;
                }
                caret := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { Tip.text = ""; root.menu(); }
                    changed has-hover => {
                        if self.has-hover && !root.open {
                            Tip.text = root.menu-label;
                            Tip.side = 0;
                            Tip.x = self.absolute-position.x + self.width / 2;
                            Tip.y = self.absolute-position.y + (self.height - 32px) / 2;
                        } else if Tip.text == root.menu-label {
                            Tip.text = "";
                        }
                    }
                }
            }
        }
    }
}

// A person's picture, or a round initial in their own tint until it arrives;
// optionally ringed while they speak.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <color> tint: #6b7280;
    in property <image> picture;
    in property <length> size: 40px;
    in property <bool> speaking;
    width: root.size; height: root.size;
    border-radius: root.size / 2;
    background: root.picture.width > 0 ? transparent : root.tint;
    if root.picture.width == 0: Text {
        text: root.initial; color: #ffffff; font-size: root.size * 0.42; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if root.picture.width > 0: Rectangle {
        width: root.size; height: root.size;
        border-radius: root.size / 2; clip: true;
        Image { source: root.picture; width: root.size; height: root.size; image-fit: cover; }
    }
    if root.speaking: Rectangle {
        x: -3px; y: -3px; width: root.size + 6px; height: root.size + 6px;
        border-radius: self.width / 2; border-width: 2px; border-color: Theme.live;
    }
}

// A single-line text field. Long text scrolls to keep the cursor visible.
component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> password;
    in property <string> label;
    in property <length> text-size: 16px;
    in property <length> pad: 12px;
    in property <color> fill: Theme.sunken;
    in property <bool> ring: true;
    callback edited(string);
    callback accepted;
    public function focus-input() { input.focus(); }
    min-height: 40px; vertical-stretch: 0; horizontal-stretch: 1;
    border-radius: 6px;
    background: root.fill;
    border-width: root.ring && input.has-focus ? 1px : 0px;
    border-color: Theme.accent.with-alpha(0.8);
    Text {
        x: root.pad; width: root.width - 2 * root.pad; height: root.height;
        visible: root.text == "";
        text: root.placeholder; color: root.enabled ? Theme.muted : Theme.faint; font-size: root.text-size;
        vertical-alignment: center; overflow: elide;
    }
    Rectangle {
        x: root.pad; width: root.width - 2 * root.pad; height: root.height; clip: true;
        input := TextInput {
            property <length> scroll: 0px;
            x: min(0px, max(parent.width - self.width, self.scroll));
            width: max(parent.width, self.preferred-width + self.text-cursor-width);
            height: parent.height;
            text <=> root.text;
            enabled: root.enabled;
            single-line: true;
            vertical-alignment: center;
            font-size: root.text-size;
            color: root.enabled ? Theme.text : Theme.muted;
            input-type: root.password ? InputType.password : InputType.text;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            accessible-label: root.label;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }
            cursor-position-changed(position) => {
                if position.x + self.scroll < 0px {
                    self.scroll = -position.x;
                } else if position.x + self.scroll > parent.width - self.text-cursor-width {
                    self.scroll = parent.width - self.text-cursor-width - position.x;
                }
            }
        }
    }
}

/// A file waiting to go with the next message.
export struct StagedFile { name: string, size: string, has-picture: bool, picture: image }

// A file waiting to go with the next message: its picture or a file icon, its
// name and size, and a button that takes it out.
component StagedTile inherits Rectangle {
    in property <StagedFile> file;
    callback remove;
    width: 120px; height: 140px; border-radius: 8px; background: Theme.raised;
    accessible-role: groupbox;
    accessible-label: root.file.name + ", " + root.file.size;
    VerticalLayout {
        padding: 6px; spacing: 2px;
        Rectangle {
            height: 86px; border-radius: 6px; clip: true; background: Theme.sidebar;
            if root.file.has-picture: Image { width: parent.width; height: parent.height; source: root.file.picture; image-fit: cover; }
            if !root.file.has-picture: Image {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: 32px; height: 32px; source: @image-url("icons/file.svg"); colorize: Theme.muted;
            }
        }
        Text { text: root.file.name; color: Theme.text; font-size: 13px; font-weight: 500; overflow: elide; }
        Text { text: root.file.size; color: Theme.muted; font-size: 12px; overflow: elide; }
    }
    Rectangle {
        x: parent.width - self.width - 4px; y: 4px; width: 28px; height: 28px; border-radius: 14px;
        background: #000000b3;
        IconButton {
            icon: @image-url("icons/x.svg"); label: "Remove " + root.file.name;
            size: 28px; glyph: 16px; radius: 14px; tint: #ffffff;
            clicked => { root.remove(); }
        }
    }
}

// The message composer. Text wraps and the field grows to about ten lines, then
// scrolls to keep the cursor in view. Enter sends; Shift+Enter starts a new line.
component Composer inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <string> label;
    in property <length> text-size: 16px;
    // Mention suggestions show, so the arrow keys, Tab, Enter and Escape go to them.
    in property <bool> suggesting;
    callback edited(string);
    callback accepted;
    // The text and the cursor's byte offset in it, after an edit or a move.
    callback caret(string, int);
    callback suggestion-moved(int);
    callback suggestion-chosen;
    callback suggestion-dismissed;
    // Up in an empty composer, and Alt+Up anywhere in it.
    callback up-from-empty;
    callback up-to-messages;
    // Ctrl+V: the clipboard may hold files or a picture rather than text, so the
    // application looks first and, finding text, pastes it with paste-text.
    callback paste;
    public function paste-text() { input.paste(); }
    public function focus-input() { input.focus(); }
    public function place-caret(offset: int) { input.set-selection-offsets(offset, offset); }
    property <length> pad: 12px;
    property <length> line: root.text-size * 1.5;
    horizontal-stretch: 1;
    height: max(48px, min(input.preferred-height + 2 * root.pad, 10 * root.line + 2 * root.pad));
    Text {
        x: 6px; y: root.pad; width: root.width - 12px; height: root.line;
        visible: root.text == "";
        text: root.placeholder; color: root.enabled ? Theme.muted : Theme.faint; font-size: root.text-size;
        vertical-alignment: center; overflow: elide;
    }
    FocusScope {
        x: 6px; y: root.pad; width: root.width - 12px; height: root.height - 2 * root.pad;
        capture-key-pressed(event) => {
            if root.suggesting {
                if event.text == Key.UpArrow { root.suggestion-moved(-1); return accept; }
                if event.text == Key.DownArrow { root.suggestion-moved(1); return accept; }
                if (event.text == Key.Return || event.text == Key.Tab) && !event.modifiers.shift { root.suggestion-chosen(); return accept; }
                if event.text == Key.Escape { root.suggestion-dismissed(); return accept; }
            }
            if event.text == Key.UpArrow && event.modifiers.alt { root.up-to-messages(); return accept; }
            if event.text == Key.UpArrow && root.text == "" && !event.modifiers.shift && !event.modifiers.control {
                root.up-from-empty();
                return accept;
            }
            if event.text == Key.Return && !event.modifiers.shift && !event.modifiers.control && !event.modifiers.alt {
                root.accepted();
                return accept;
            }
            if (event.text == "v" || event.text == "V") && event.modifiers.control && !event.modifiers.alt && root.enabled {
                root.paste();
                return accept;
            }
            return reject;
        }
        flick := Flickable {
            content-height: input.height;
            input := TextInput {
                width: flick.width;
                height: max(flick.height, self.preferred-height);
                text <=> root.text;
                enabled: root.enabled;
                single-line: false;
                wrap: word-wrap;
                font-size: root.text-size;
                color: root.enabled ? Theme.text : Theme.muted;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                accessible-label: root.label;
                edited => { root.edited(self.text); root.caret(self.text, self.cursor-position-byte-offset); }
                cursor-position-changed(position) => {
                    root.caret(self.text, self.cursor-position-byte-offset);
                    if position.y + flick.content-y < 0px {
                        flick.content-y = -position.y;
                    } else if position.y + root.line + flick.content-y > flick.height {
                        flick.content-y = flick.height - position.y - root.line;
                    }
                }
            }
        }
    }
}

// Marks something from Discord: its logo, white on blurple, on a ring of the
// colour behind it.
// A round button answering or ending a call.
component CallButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> fill;
    in property <bool> enabled: true;
    callback clicked;
    width: 64px; height: 48px; border-radius: 24px;
    background: touch.has-hover ? root.fill.darker(0.15) : root.fill;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button; accessible-label: root.label; accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Image { source: root.icon; width: 22px; height: 22px; colorize: #ffffff; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

// Lies over a spoiler's blurred picture until it's clicked.
// A picture, or an animation's frames in turn while it shows.
component Picture inherits Image {
    in property <image> still;
    in property <[image]> frames;
    in property <[int]> delays;
    property <int> frame;
    source: root.frames.length > 1 ? root.frames[root.frame] : root.still;
    Timer {
        running: root.frames.length > 1;
        interval: max(20, root.delays[root.frame]) * 1ms;
        triggered => { root.frame = mod(root.frame + 1, root.frames.length); }
    }
}

// Stands in for something on its way, such as a picture or the messages,
// with a light sweeping across it as in Discord.
component Skeleton inherits Rectangle {
    background: Theme.raised;
    clip: true;
    accessible-role: image;
    accessible-label: "Loading";
    Rectangle {
        width: max(120px, parent.width * 0.5); height: parent.height;
        x: Math.mod(animation-tick() / 1ms, 1500) / 1500 * (parent.width + self.width) - self.width;
        background: @linear-gradient(90deg, #ffffff00 0%, #ffffff10 50%, #ffffff00 100%);
    }
}

// Messages on their way: rows the shape of messages.
component MessagesSkeleton inherits VerticalLayout {
    padding: 16px; spacing: 22px; alignment: end;
    for line in [
        { name: 92px, lines: [380px, 220px] },
        { name: 120px, lines: [300px] },
        { name: 76px, lines: [420px, 340px, 160px] },
        { name: 104px, lines: [260px] },
        { name: 88px, lines: [360px, 200px] },
    ]: HorizontalLayout {
        spacing: 16px; alignment: start;
        VerticalLayout {
            alignment: start;
            Skeleton { width: 40px; height: 40px; border-radius: 20px; }
        }
        VerticalLayout {
            spacing: 8px; padding-top: 4px; alignment: start;
            Skeleton { width: line.name; height: 12px; border-radius: 6px; }
            for width in line.lines: Skeleton { width: width; height: 12px; border-radius: 6px; }
        }
    }
}

component SpoilerCover inherits Rectangle {
    background: #00000059;
    Rectangle {
        width: label.preferred-width + 24px; height: 28px; border-radius: 14px; background: #000000b3;
        label := Text { text: "SPOILER"; color: #ffffff; font-size: 13px; font-weight: 800; letter-spacing: 0.5px; vertical-alignment: center; }
    }
}

// Whether Discord's things carry its badge. A build without Matrix shows
// nothing else, so it leaves them off.
export global Badges {
    in property <bool> discord: true;
}

component DiscordBadge inherits Rectangle {
    in property <length> size;
    in property <color> ring;
    visible: Badges.discord;
    width: root.size + 4px; height: self.width; border-radius: self.width / 2;
    background: root.ring;
    Rectangle {
        width: root.size; height: root.size; border-radius: root.size / 2;
        background: #5865f2;
        Image {
            source: @image-url("icons/discord.svg");
            width: root.size * 0.62; height: self.width; image-fit: contain;
            colorize: white;
        }
    }
}

// Linking Discord by QR code: the risk to the account first, then the code to
// scan with the phone app, then who scanned it while they confirm. The phase
// is 0 before linking, 1 while Talk gets a code, 2 showing it, 3 once it's
// scanned, and 4 when linking failed.
component DiscordLinkPanel inherits VerticalLayout {
    in property <int> phase;
    in property <image> code;
    in property <string> name;
    in property <string> note;
    callback begin;
    spacing: 16px;
    if root.phase == 0 || root.phase == 4: VerticalLayout {
        spacing: 12px;
        Rectangle {
            min-height: warning.preferred-height;
            background: Theme.danger.with-alpha(0.1); border-radius: 8px;
            border-width: 1px; border-color: Theme.danger.with-alpha(0.35);
            warning := HorizontalLayout {
                padding: 12px; spacing: 10px;
                VerticalLayout {
                    alignment: start;
                    Image { source: @image-url("icons/triangle-alert.svg"); width: 18px; height: 18px; colorize: Theme.danger; }
                }
                Text {
                    text: "Discord doesn't allow apps like Talk on personal accounts. Linking puts your account at some risk of being suspended.";
                    color: Theme.text; font-size: 14px; wrap: word-wrap; horizontal-stretch: 1;
                }
            }
        }
        if root.phase == 4: Text { text: root.note; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
        HorizontalLayout {
            alignment: start;
            ActionButton {
                text: root.phase == 4 ? "Try again" : "Show the code"; primary: true;
                clicked => { root.begin(); }
            }
        }
    }
    if root.phase >= 1 && root.phase <= 3: HorizontalLayout {
        spacing: 20px;
        Rectangle {
            width: 184px; height: 184px; border-radius: 12px;
            background: root.phase == 2 ? #ffffff : Theme.sunken;
            if root.phase == 2: Image {
                source: root.code; width: 176px; height: 176px; image-rendering: pixelated;
                accessible-role: image; accessible-label: "QR code that links Discord";
            }
            if root.phase == 1: Text { text: "Getting a code..."; color: Theme.muted; font-size: 14px; }
            if root.phase == 3: VerticalLayout {
                alignment: center; spacing: 8px;
                HorizontalLayout {
                    alignment: center;
                    Image { source: @image-url("icons/check.svg"); width: 40px; height: 40px; colorize: Theme.live; }
                }
                Text { text: "Scanned"; color: Theme.text; font-size: 15px; font-weight: 700; horizontal-alignment: center; }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 8px; horizontal-stretch: 1;
            Text {
                text: root.phase == 3 ? "Confirm on your phone" : "Scan it with the Discord app";
                color: Theme.text; font-size: 17px; font-weight: 700; wrap: word-wrap;
            }
            Text {
                text: root.phase == 3
                    ? "Linking " + root.name + ". Tap Log in on your phone to finish."
                    : "On your phone, open Discord, go to Settings, tap Scan QR Code, and point the camera here. A new code replaces this one after a couple of minutes.";
                color: Theme.secondary; font-size: 14px; wrap: word-wrap;
            }
        }
    }
}

// A server or the DM home: a circle that becomes a squircle, with a pill at the rail edge.
export struct FriendRequestRow {
    id: string, name: string, initial: string, tint: color, picture: image,
    /// Sent to this account, which answers it, rather than by it.
    incoming: bool,
    /// "Incoming friend request" and the like.
    detail: string,
}

// A friend request in the DM list: accepted or ignored when it came to this
// account, or cancelled when it sent it.
component FriendRequest inherits Rectangle {
    in property <FriendRequestRow> request;
    /// What it sits on, for the badge's ring.
    in property <brush> surface: Theme.sidebar;
    callback accept;
    callback remove;
    height: 42px; border-radius: 6px;
    background: pointer.has-hover ? Theme.hover : transparent;
    accessible-role: groupbox;
    accessible-label: root.request.name + ", " + root.request.detail;
    pointer := TouchArea { }
    HorizontalLayout {
        padding-left: 8px; padding-right: 4px; spacing: 12px;
        Middle {
            Avatar {
                size: 32px; initial: root.request.initial; tint: root.request.tint; picture: root.request.picture;
                DiscordBadge { x: -2px; y: -2px; size: 13px; ring: pointer.has-hover ? Theme.hover : root.surface; }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 0px; horizontal-stretch: 1;
            Text { text: root.request.name; color: Theme.text; font-size: 15px; font-weight: 500; overflow: elide; }
            Text { text: root.request.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        if root.request.incoming: Middle {
            IconButton {
                icon: @image-url("icons/check.svg"); label: "Accept"; size: 30px; glyph: 18px; tint: Theme.live; tip-side: 2;
                clicked => { root.accept(); }
            }
        }
        Middle {
            IconButton {
                icon: @image-url("icons/x.svg"); label: root.request.incoming ? "Ignore" : "Cancel"; size: 30px; glyph: 18px; tip-side: 2;
                clicked => { root.remove(); }
            }
        }
    }
}

component RailItem inherits Rectangle {
    in property <string> label;
    /// The tooltip; the accessible label may add state such as "unread".
    in property <string> tip: root.label;
    in property <string> initial;
    in property <image> icon;
    /// The server's own icon, filling the item instead of the initial.
    in property <image> picture;
    in property <bool> selected;
    in property <bool> unread;
    /// Marks a Discord server.
    in property <bool> discord;
    callback clicked;
    width: 72px; height: 48px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <bool> lit: root.selected || pointer.has-hover;
    Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: 4px;
        height: root.selected ? 40px : pointer.has-hover ? 20px : root.unread ? 8px : 0px;
        border-top-right-radius: 4px; border-bottom-right-radius: 4px;
        background: Theme.text;
        animate height { duration: 160ms; easing: ease-out; }
    }
    // A picture only changes shape when lit, as in Discord.
    tile := Rectangle {
        x: 12px; width: 48px; height: 48px;
        border-radius: root.lit ? 16px : 24px;
        background: root.lit && root.picture.width == 0 ? Theme.accent : Theme.raised;
        animate border-radius, background { duration: 160ms; easing: ease-out; }
        clip: true;
        if root.picture.width > 0: Image {
            source: root.picture; width: 48px; height: 48px; image-fit: cover;
        }
        if root.icon.width > 0: Image {
            source: root.icon; width: 24px; height: 24px;
            colorize: root.lit ? Theme.on-accent : Theme.text;
        }
        if root.icon.width == 0 && root.picture.width == 0: Text {
            text: root.initial; font-size: 17px; font-weight: 700;
            color: root.lit ? Theme.on-accent : Theme.text;
        }
        // The focus ring, drawn over the picture.
        Rectangle {
            width: 48px; height: 48px; border-radius: tile.border-radius;
            border-width: focus.has-focus ? 2px : 0px;
            border-color: Theme.text;
        }
    }
    // Discord's logo on its blurple, at the top left on a ring of the rail's
    // colour so it reads as a tag.
    if root.discord: DiscordBadge {
        x: 12px - 2px; y: (parent.height - 48px) / 2 - 2px;
        size: 16px; ring: Theme.rail;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.tip;
                    Tip.side = 1;
                    Tip.x = root.absolute-position.x + root.width;
                    Tip.y = root.absolute-position.y + root.height / 2;
                } else if Tip.text == root.tip {
                    Tip.text = "";
                }
            }
        }
    }
}

// A channel or DM in the sidebar.
// A presence dot on a ring cut from the background, as in Discord: green when
// online, a moon when idle, a bar when they don't want to be disturbed, and a
// grey ring when offline. Anything else counts as offline.
component StatusDot inherits Rectangle {
    in property <string> presence;
    in property <color> ring;
    property <bool> online: root.presence == "online" || root.presence == "idle" || root.presence == "dnd";
    width: 16px; height: 16px; border-radius: 8px;
    background: root.ring;
    accessible-role: image;
    accessible-label: root.presence == "dnd" ? "Do not disturb" : root.presence == "idle" ? "Idle" : root.presence == "online" ? "Online" : "Offline";
    Rectangle {
        width: 10px; height: 10px; border-radius: 5px;
        background: root.presence == "dnd" ? Theme.danger : root.presence == "idle" ? Theme.accent : root.presence == "online" ? Theme.live : Theme.faint;
    }
    if !root.online: Rectangle {
        width: 4px; height: 4px; border-radius: 2px; background: root.ring;
    }
    if root.presence == "idle": Rectangle {
        x: 2px; y: 2px; width: 6px; height: 6px; border-radius: 3px; background: root.ring;
    }
    if root.presence == "dnd": Rectangle {
        width: 6px; height: 2px; border-radius: 1px; background: root.ring;
    }
}

component ChannelRow inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <image> icon;
    in property <bool> person;
    in property <string> initial;
    in property <color> tint;
    in property <image> picture;
    /// Marks a Discord DM, as the rail marks Discord servers.
    in property <bool> discord;
    in property <bool> selected;
    in property <bool> unread;
    in property <string> badge;
    /// A channel this account may not join: drawn faint.
    in property <bool> locked;
    /// A DM with a call going on.
    in property <bool> call;
    /// A DM person's presence, as RoomRow has it, and a line under the name.
    in property <string> presence;
    in property <string> detail;
    callback clicked;
    /// A right click, where it happened in the window.
    callback context-menu(length, length);
    height: root.person ? 42px : 34px;
    border-radius: 6px;
    background: root.selected ? Theme.active : pointer.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <color> ink: root.locked ? (root.selected ? Theme.muted : Theme.faint) : root.selected || root.unread ? Theme.text : pointer.has-hover ? Theme.secondary : Theme.muted;
    // Unread activity is marked at the sidebar's edge, as on the server rail.
    if root.unread && !root.selected: Rectangle {
        x: -8px; y: (parent.height - self.height) / 2; width: 4px; height: 8px;
        border-top-right-radius: 4px; border-bottom-right-radius: 4px; background: Theme.text;
    }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: root.person ? 12px : 8px;
        if root.person: Middle {
            Avatar {
                size: 32px; initial: root.initial; tint: root.tint; picture: root.picture;
                if root.discord: DiscordBadge {
                    x: -2px; y: -2px; size: 13px;
                    ring: root.selected ? Theme.active : pointer.has-hover ? Theme.hover : Theme.sidebar;
                }
                if root.presence != "": StatusDot {
                    x: 20px; y: 20px; presence: root.presence;
                    ring: root.selected ? Theme.active : pointer.has-hover ? Theme.hover : Theme.sidebar;
                }
            }
        }
        if !root.person: Image { source: root.icon; width: 20px; image-fit: contain; colorize: root.selected || root.unread ? Theme.secondary : Theme.faint; }
        VerticalLayout {
            alignment: center; spacing: 0px; horizontal-stretch: 1;
            Text {
                text: root.text; color: root.ink; font-size: 16px; font-weight: root.unread || root.selected ? 700 : 500;
                vertical-alignment: center; overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail; color: Theme.muted; font-size: 12px; overflow: elide;
            }
        }
        if root.call: Image {
            source: @image-url("icons/phone.svg"); width: 16px; image-fit: contain; colorize: Theme.live;
            accessible-role: image; accessible-label: "In a call";
        }
        if root.badge != "": Middle {
            Rectangle {
                width: max(18px, badge-text.preferred-width + 10px); height: 18px; border-radius: 9px; background: Theme.danger;
                badge-text := Text { text: root.badge; color: #ffffff; font-size: 11px; font-weight: 700; }
            }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
            pointer-event(event) => {
                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                    root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }
}

// One choice in a menu, with a check beside the current one.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> checked;
    /// A destructive choice, such as deleting: drawn in red.
    in property <bool> danger;
    callback clicked;
    height: 32px;
    border-radius: 4px;
    background: pointer.has-hover ? (root.danger ? Theme.danger.with-alpha(0.16) : Theme.active) : transparent;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        Image {
            source: root.checked ? @image-url("icons/check.svg") : root.icon;
            width: 16px; image-fit: contain;
            colorize: root.checked ? Theme.accent : root.danger ? Theme.danger : pointer.has-hover ? Theme.text : Theme.muted;
        }
        Text {
            text: root.text; color: root.danger ? Theme.danger : root.checked || pointer.has-hover ? Theme.text : Theme.secondary;
            font-size: 15px; font-weight: root.checked ? 700 : 400;
            vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
}

/// An emoji: what shows, its name, and the reaction it adds, which for a custom
/// emoji is Discord's `name:id`.
export struct EmojiCell { glyph: string, name: string, key: string }
/// A heading, or up to a row's worth of emoji, in the emoji picker.
export struct EmojiRow { heading: string, cells: [EmojiCell] }

// An emoji to react with, named by a tooltip unless it reports hovering instead.
component EmojiButton inherits Rectangle {
    in property <EmojiCell> emoji;
    in property <string> font;
    in property <length> size: 32px;
    in property <length> glyph: 20px;
    in property <color> fill: transparent;
    in property <bool> tip: true;
    callback clicked;
    callback hovered;
    width: root.size; height: root.size;
    border-radius: 6px;
    background: pointer.has-hover ? #ffffff1f : root.fill;
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: "React with " + root.emoji.name;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    Text {
        text: root.emoji.glyph; font-family: root.font; font-size: root.glyph;
        horizontal-alignment: center; vertical-alignment: center;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { Tip.text = ""; root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    root.hovered();
                    if root.tip {
                        Tip.text = root.emoji.name;
                        Tip.side = 0;
                        Tip.x = root.absolute-position.x + root.width / 2;
                        Tip.y = root.absolute-position.y;
                    }
                } else if Tip.text == root.emoji.name {
                    Tip.text = "";
                }
            }
        }
    }
}

// The menu behind a toggle's caret: its devices, anything placed inside, then
// a way into the full settings.
component DeviceMenu inherits Rectangle {
    in property <string> heading;
    in property <[string]> devices;
    in property <int> current;
    in property <string> empty;
    callback select(int);
    callback settings;
    background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    VerticalLayout {
        padding: 6px; spacing: 6px;
        HorizontalLayout {
            padding-left: 8px; padding-top: 4px;
            Text { text: root.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
        }
        if root.devices.length > 0: ScrollView {
            // Five devices before the list scrolls.
            height: min(5, root.devices.length) * 32px;
            VerticalLayout {
                for device[index] in root.devices: MenuItem {
                    text: device; checked: index == root.current;
                    clicked => { root.select(index); }
                }
            }
        }
        if root.devices.length == 0: HorizontalLayout {
            padding-left: 8px; padding-right: 8px;
            Label { text: root.empty; }
        }
        @children
        Rectangle { height: 1px; background: Theme.line; }
        MenuItem { text: "Voice settings"; icon: @image-url("icons/settings.svg"); clicked => { root.settings(); } }
    }
}

// Settings: a section's title, a group's heading, a switch with what it does, and
// a row of exclusive choices with the current one raised.
component SettingsTitle inherits Text {
    color: Theme.text; font-size: 20px; font-weight: 700;
}

component SettingsHeading inherits Text {
    color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
}

// A marigold switch, with its label beside it and what it does below. A click on
// either, or Space or Enter with the keyboard, toggles it.
// How loud someone sounds, from 0% to 200% as Discord allows: a marigold fill
// up to the value over a mark at 100%, which a drag snaps to nearby. Dragging
// reports each step through `changed` and the last through `committed`; the
// arrow keys move 5% at a time.
component VolumeSlider inherits Rectangle {
    in property <string> label;
    in-out property <int> value: 100;
    callback changed(int);
    callback committed(int);
    height: column.preferred-height;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: 0;
    accessible-value-maximum: 200;
    accessible-value-step: 5;
    accessible-action-increment => { root.step(5); }
    accessible-action-decrement => { root.step(-5); }
    forward-focus: focus;
    function set(value: int) {
        let clamped = max(0, min(200, value));
        if clamped != root.value {
            root.value = clamped;
            root.changed(clamped);
        }
    }
    function step(by: int) {
        root.set(root.value + by);
        root.committed(root.value);
    }
    function point(x: length) {
        let value = round(max(0, min(1, x / track.width)) * 200);
        root.set(abs(value - 100) <= 4 ? 100 : value);
    }
    column := VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            Text { text: root.label; color: Theme.secondary; font-size: 13px; font-weight: 600; horizontal-stretch: 1; }
            Text { text: root.value + "%"; color: Theme.text; font-size: 13px; font-weight: 600; }
        }
        track := Rectangle {
            height: 18px;
            Rectangle { y: (parent.height - self.height) / 2; height: 4px; border-radius: 2px; background: Theme.field; }
            Rectangle {
                x: 0; y: (parent.height - self.height) / 2; width: parent.width * root.value / 200; height: 4px;
                border-radius: 2px; background: Theme.accent;
            }
            Rectangle { x: parent.width / 2 - 1px; y: (parent.height - self.height) / 2; width: 2px; height: 10px; background: Theme.secondary; }
            Rectangle {
                x: parent.width * root.value / 200 - self.width / 2; y: (parent.height - self.height) / 2;
                width: 14px; height: 14px; border-radius: 7px; background: Theme.text;
                border-width: focus.has-focus ? 2px : 0px; border-color: Theme.accent;
            }
            touch := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        focus.focus();
                        root.point(self.mouse-x);
                    }
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                        root.committed(root.value);
                    }
                }
                moved => { if self.pressed { root.point(self.mouse-x); } }
            }
        }
    }
    focus := FocusScope {
        width: 0; height: 0;
        key-pressed(event) => {
            if event.text == Key.LeftArrow || event.text == Key.DownArrow { root.step(-5); return accept; }
            if event.text == Key.RightArrow || event.text == Key.UpArrow { root.step(5); return accept; }
            return reject;
        }
    }
}

component SettingsSwitch inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: column.preferred-height;
    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    column := VerticalLayout {
        spacing: 4px;
        row := HorizontalLayout {
            spacing: 12px;
            Middle {
                Rectangle {
                    width: 40px; height: 22px; border-radius: 11px;
                    background: !root.enabled ? Theme.field : root.checked ? (pointer.has-hover ? Theme.accent-hover : Theme.accent) : (pointer.has-hover ? Theme.active : Theme.field);
                    border-width: focus.has-focus ? 2px : 1px;
                    border-color: focus.has-focus ? Theme.text : root.checked && root.enabled ? transparent : Theme.line;
                    animate background { duration: Theme.quick; }
                    Rectangle {
                        x: root.checked ? parent.width - self.width - 3px : 3px;
                        width: 16px; height: 16px; border-radius: 8px;
                        background: !root.enabled ? Theme.faint : root.checked ? Theme.on-accent : Theme.secondary;
                        animate x, background { duration: Theme.quick; easing: ease-out; }
                    }
                }
            }
            Text {
                text: root.text; color: root.enabled ? Theme.text : Theme.muted; font-size: 15px;
                vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1;
            }
        }
        if root.description != "": Label { text: root.description; }
    }
    focus := FocusScope {
        x: 0px; y: 0px; width: root.width; height: row.height;
        enabled: root.enabled;
        accessible-role: switch;
        accessible-label: root.text;
        accessible-description: root.description;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-enabled: root.enabled;
        accessible-action-default => { root.toggle(); }
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" { root.toggle(); return accept; }
            return reject;
        }
        pointer := TouchArea {
            enabled: root.enabled; mouse-cursor: MouseCursor.pointer;
            clicked => { root.toggle(); }
        }
    }
}

component Choices inherits Rectangle {
    in property <[string]> options;
    in property <string> label;
    in-out property <int> current;
    callback chosen(int);
    height: 36px; max-width: 360px;
    border-radius: 8px; background: Theme.sunken;
    accessible-role: groupbox;
    accessible-label: root.label;
    HorizontalLayout {
        padding: 3px; spacing: 3px;
        for option[index] in root.options: Rectangle {
            border-radius: 6px;
            background: index == root.current ? Theme.active : choice.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.quick; }
            accessible-role: button;
            accessible-label: index == root.current ? option + ", chosen" : option;
            accessible-action-default => { root.current = index; root.chosen(index); }
            Text {
                text: option; font-size: 14px;
                color: index == root.current ? Theme.text : Theme.secondary;
                font-weight: index == root.current ? 700 : 500;
            }
            choice := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.current = index; root.chosen(index); }
            }
        }
    }
}

// A reaction under a message: the emoji in a color emoji font, then the count.
component ReactionToggle inherits Rectangle {
    in property <string> key;
    in property <string> label: root.key;
    in property <int> count;
    in property <bool> mine;
    in property <bool> enabled;
    in property <string> emoji-font;
    callback clicked;
    min-width: chip.preferred-width; height: 28px; border-radius: 8px;
    background: root.mine ? Theme.accent-soft : Theme.raised;
    border-width: 1px;
    border-color: root.mine ? Theme.accent.with-alpha(0.7) : pointer.has-hover && root.enabled ? #ffffff26 : transparent;
    accessible-role: button;
    accessible-label: root.key + ", " + root.count + (root.mine ? ", including you. Remove your reaction" : ". Add this reaction");
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    chip := HorizontalLayout {
        padding-left: 8px; padding-right: 9px; spacing: 6px;
        Text { text: root.label; font-family: root.emoji-font; font-size: 16px; vertical-alignment: center; }
        Text { text: root.count; color: root.mine ? Theme.accent : Theme.secondary; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    }
    pointer := TouchArea { enabled: root.enabled; mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
}

// A header control with an icon and a short text that opens or closes a panel.
component HeaderToggle inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> label;
    in property <bool> open;
    callback clicked;
    width: content.preferred-width; height: 32px;
    border-radius: 6px;
    background: pointer.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    property <color> ink: root.open || pointer.has-hover ? Theme.text : Theme.muted;
    content := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 6px;
        Image { source: root.icon; width: 18px; image-fit: contain; colorize: root.ink; }
        Text { text: root.text; color: root.ink; font-size: 14px; font-weight: 500; vertical-alignment: center; }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { Tip.text = ""; root.clicked(); }
            changed has-hover => {
                if self.has-hover {
                    Tip.text = root.label;
                    Tip.side = 2;
                    Tip.x = root.absolute-position.x + root.width / 2;
                    Tip.y = root.absolute-position.y + root.height;
                } else if Tip.text == root.label {
                    Tip.text = "";
                }
            }
        }
    }
}

/// A member of the open room. A heading starts each role's group.
// Someone or something the `@` word being typed may mention.
export struct MentionRow {
    name: string, initial: string, tint: color, picture: image,
    // The name's colour, from a coloured Discord role.
    color: color, has-color: bool,
    // A role or a group such as @everyone, rather than a person.
    group: bool,
    // What a group reaches, such as "Everyone in this channel"; for roles, "Role".
    detail: string,
}

export struct MemberRow {
    id: string, name: string, initial: string, tint: color, picture: image, heading: string,
    /// Discord's presence: "online", "idle", "dnd" or "offline"; empty for Matrix.
    presence: string,
    /// The name's colour, from a coloured Discord role.
    color: color, has-color: bool,
    /// A custom status or what they're doing, under the name.
    activity: string,
}

// The open room's members, grouped by role under the conversation header.
component MemberPanel inherits Rectangle {
    in property <[MemberRow]> rows;
    /// Shown instead of the list while it loads or when it can't.
    in property <string> note;
    /// The member whose profile card is open.
    in property <string> selected;
    /// A member was clicked: their id, and where their row is in the window.
    callback open-profile(string, length);
    background: Theme.sidebar;
    accessible-role: list;
    accessible-label: "Members";
    ScrollView {
        VerticalLayout {
            padding-left: 8px; padding-right: 8px; padding-top: 8px; padding-bottom: 12px; spacing: 2px;
            for member in root.rows: VerticalLayout {
                spacing: 2px; vertical-stretch: 0;
                if member.heading != "": HorizontalLayout {
                    padding-left: 8px; height: 36px;
                    Text { text: member.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: center; }
                }
                Rectangle {
                  height: 42px; border-radius: 6px;
                  background: member.id == root.selected ? Theme.active : member-pointer.has-hover ? Theme.hover : transparent;
                  accessible-role: button;
                  accessible-label: member.name + ", " + member.id + ", show profile";
                  accessible-action-default => { root.open-profile(member.id, self.absolute-position.y); }
                  member-pointer := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open-profile(member.id, self.absolute-position.y); }
                  }
                  HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; spacing: 12px;
                    // Offline Discord members are faded, as in Discord.
                    Middle {
                        Rectangle {
                            width: 32px; height: 32px;
                            Avatar { size: 32px; initial: member.initial; tint: member.tint; picture: member.picture; opacity: member.presence == "offline" ? 0.4 : 1; }
                            if member.presence != "" && member.presence != "offline": StatusDot { x: 20px; y: 20px; presence: member.presence; ring: Theme.sidebar; }
                        }
                    }
                    VerticalLayout {
                        alignment: center; horizontal-stretch: 1;
                        Text {
                            text: member.name; color: member.has-color ? member.color : Theme.secondary; font-size: 16px; font-weight: 500; overflow: elide;
                            opacity: member.presence == "offline" ? 0.5 : 1;
                        }
                        if member.activity != "": Text {
                            text: member.activity; color: Theme.muted; font-size: 12px; overflow: elide;
                            opacity: member.presence == "offline" ? 0.5 : 1;
                        }
                    }
                  }
                }
            }
            if root.note != "": HorizontalLayout { padding: 8px; Label { text: root.note; } }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

export struct ProfileRole { name: string, color: color, has-color: bool }
/// A profile card's roles a row at a time, laid out to fit the card.
export struct ProfileRoleRow { roles: [ProfileRole] }
/// A server a profile's person shares with this account, and their nickname there.
export struct ProfileServerRow {
    id: string, name: string, initial: string, picture: image, banner: image,
    /// "12 members", when known, and "4 channels".
    members: string, channels: string,
    nick: string,
}
/// A friend a profile's person shares with this account; presence as in MemberRow.
export struct ProfileFriendRow { id: string, name: string, initial: string, tint: color, picture: image, presence: string }
export struct ProfileData {
    id: string, name: string, initial: string, tint: color, picture: image,
    /// A Discord username or Matrix ID, then pronouns when they give them.
    handle: string,
    /// The banner picture, else its colour.
    banner: image, accent: color, has-accent: bool,
    /// As in MemberRow.
    presence: string, activity: string,
    bio: styled-text, has-bio: bool,
    role-rows: [ProfileRoleRow], role-rows-large: [ProfileRoleRow],
    /// Dates: on Discord since, and in this server since.
    created: string, joined: string,
    servers: [ProfileServerRow], friends: [ProfileFriendRow],
    /// Loading, or why there's no more.
    note: string,
    /// Friendship on Discord: 0 nothing to offer, 1 send a friend request,
    /// 2 one was sent, 3 accept theirs.
    friend: int,
}

component ProfileHeading inherits Text {
    color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px;
}

// A server a profile lists as mutual, as a card: what it is, and a way in.
component ServerCard inherits Rectangle {
    in property <ProfileServerRow> server;
    callback open;
    height: body.preferred-height;
    background: Theme.sidebar;
    border-radius: 12px; border-width: 1px; border-color: Theme.edge;
    drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
    accessible-role: groupbox;
    accessible-label: root.server.name;
    // Clicks on the card stay on it, instead of closing it.
    TouchArea { }
    Rectangle {
        border-radius: 12px; clip: true;
        body := VerticalLayout {
            padding-bottom: 16px; spacing: 0px;
            // The banner, with the icon hanging over its lower edge.
            Rectangle {
                height: 90px + 32px + 8px;
                Rectangle {
                    y: 0px; height: 90px; background: Theme.raised;
                    if root.server.banner.width > 0: Image {
                        width: parent.width; height: parent.height; source: root.server.banner; image-fit: cover;
                    }
                }
                Rectangle {
                    x: 10px; y: 90px - 32px - 6px; width: 76px; height: 76px; border-radius: 22px;
                    background: Theme.sidebar;
                    Rectangle {
                        width: 64px; height: 64px; border-radius: 18px; clip: true;
                        background: root.server.picture.width > 0 ? transparent : Theme.raised;
                        if root.server.picture.width == 0: Text {
                            text: root.server.initial; color: Theme.text; font-size: 24px; font-weight: 700;
                        }
                        if root.server.picture.width > 0: Image { source: root.server.picture; width: 64px; height: 64px; image-fit: cover; }
                    }
                }
            }
            VerticalLayout {
                padding-left: 16px; padding-right: 16px; spacing: 14px;
                VerticalLayout {
                    spacing: 4px;
                    Text { text: root.server.name; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; }
                    HorizontalLayout {
                        spacing: 14px; alignment: start;
                        if root.server.members != "": HorizontalLayout {
                            spacing: 6px;
                            Middle { Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.faint; } }
                            Text { text: root.server.members; color: Theme.secondary; font-size: 13px; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Middle { Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.faint; } }
                            Text { text: root.server.channels; color: Theme.secondary; font-size: 13px; }
                        }
                    }
                }
                if root.server.nick != "": VerticalLayout {
                    spacing: 4px;
                    ProfileHeading { text: "THEIR NICKNAME"; }
                    Text { text: root.server.nick; color: Theme.text; font-size: 14px; overflow: elide; }
                }
                ActionButton { text: "Go to server"; primary: true; clicked => { root.open(); } }
            }
        }
    }
}

// A mutual server or friend in a profile. Clicking it goes there.
component ProfileListRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> initial;
    in property <color> tint: Theme.raised;
    in property <image> picture;
    /// A person, drawn round with their status dot; else a server, drawn as
    /// a rounded square.
    in property <bool> person;
    in property <string> presence;
    in property <string> label;
    callback clicked;
    height: root.detail != "" ? 46px : 40px; border-radius: 6px;
    background: pointer.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 12px;
        Middle {
            Rectangle {
                width: 32px; height: 32px;
                if root.person: Avatar { size: 32px; initial: root.initial; tint: root.tint; picture: root.picture; }
                if root.person && root.presence != "": StatusDot {
                    x: 20px; y: 20px; presence: root.presence; ring: pointer.has-hover ? Theme.hover : Theme.sidebar;
                }
                if !root.person: Rectangle {
                    border-radius: 10px; clip: true;
                    background: root.picture.width > 0 ? transparent : Theme.raised;
                    if root.picture.width == 0: Text {
                        text: root.initial; color: Theme.text; font-size: 13px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.picture.width > 0: Image { source: root.picture; width: 32px; height: 32px; image-fit: cover; }
                }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 0px; horizontal-stretch: 1;
            Text { text: root.name; color: Theme.text; font-size: 15px; font-weight: 500; overflow: elide; }
            if root.detail != "": Text { text: root.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
}

// A person's profile: a card beside the member list, large over the
// window, where it scrolls once it's taller than the window allows, or
// docked beside a one-to-one DM, where it fills the height.
component ProfileCard inherits Rectangle {
    in property <ProfileData> data;
    in property <bool> large;
    in property <bool> docked;
    /// It shows everything: the bio in full, and mutual servers and friends.
    property <bool> full: root.large || root.docked;
    /// The tallest the card may be.
    in property <length> limit: 100000px;
    callback enlarge;
    callback close;
    callback open-link(string);
    callback befriend;
    /// A mutual server or friend was clicked, with where its row is in the window.
    callback open-server(ProfileServerRow, length, length, length, length);
    callback open-friend(string, length, length, length, length);
    property <length> banner-height: root.large ? 210px : root.docked ? 120px : 105px;
    property <length> avatar-size: root.large ? 120px : 80px;
    property <length> pad: root.large ? 24px : 16px;
    height: min(body.preferred-height, root.limit);
    background: Theme.sidebar;
    border-radius: root.docked ? 0px : 12px; border-width: root.docked ? 0px : 1px; border-color: Theme.edge;
    drop-shadow-blur: root.docked ? 0px : 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: root.docked ? 0px : 8px;
    accessible-role: groupbox;
    accessible-label: root.data.name + "'s profile";
    // Clicks on the card stay on it, instead of closing it.
    TouchArea { }
    Rectangle {
        border-radius: root.docked ? 0px : 12px; clip: true;
        // Sized by what the card wants rather than the least it can take, so a
        // long one scrolls to its end.
        ScrollView {
            content-height: body.preferred-height;
            body := VerticalLayout {
                padding-bottom: root.pad; spacing: 0px;
                // The banner, with the avatar hanging over its lower edge.
                Rectangle {
                    height: root.banner-height + root.avatar-size / 2 + 8px;
                    Rectangle {
                        y: 0px; height: root.banner-height;
                        background: root.data.has-accent ? root.data.accent : Theme.raised;
                        if root.data.banner.width > 0: Image {
                            width: parent.width; height: parent.height; source: root.data.banner; image-fit: cover;
                        }
                    }
                    Rectangle {
                        x: root.pad - 6px; y: root.banner-height - root.avatar-size / 2 - 6px;
                        width: root.avatar-size + 12px; height: self.width; border-radius: self.width / 2;
                        background: Theme.sidebar;
                        Avatar { size: root.avatar-size; initial: root.data.initial; tint: root.data.tint; picture: root.data.picture; }
                        if root.data.presence != "" && root.data.presence != "offline": StatusDot {
                            x: parent.width - self.width - (root.large ? 14px : 10px); y: parent.height - self.height - (root.large ? 14px : 10px);
                            presence: root.data.presence; ring: Theme.sidebar;
                        }
                        if !root.large: TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.enlarge(); } }
                    }
                }
                VerticalLayout {
                    padding-left: root.pad; padding-right: root.pad; spacing: 16px;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: root.data.name; color: Theme.text; font-size: root.large ? 26px : 20px; font-weight: 700;
                            overflow: elide;
                            if !root.large: TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.enlarge(); } }
                        }
                        if root.data.handle != "": Text { text: root.data.handle; color: Theme.secondary; font-size: 14px; font-weight: 500; overflow: elide; }
                        if root.data.activity != "": Text {
                            text: root.data.activity; color: Theme.secondary; font-size: 14px;
                            wrap: word-wrap; overflow: elide; max-height: 40px;
                        }
                    }
                    if root.data.friend > 0: HorizontalLayout {
                        alignment: start;
                        ActionButton {
                            small: true; primary: root.data.friend != 2; enabled: root.data.friend != 2;
                            text: root.data.friend == 1 ? "Send friend request" : root.data.friend == 2 ? "Friend request sent" : "Accept friend request";
                            clicked => { root.befriend(); }
                        }
                    }
                    if root.data.has-bio: VerticalLayout {
                        spacing: 6px;
                        ProfileHeading { text: "ABOUT ME"; }
                        // The card shows the start; the full profile shows it all.
                        // A fixed height, since the text would otherwise stretch it past its limit.
                        Rectangle {
                            clip: true;
                            height: root.full ? bio-text.preferred-height : min(110px, bio-text.preferred-height);
                            VerticalLayout {
                                bio-text := StyledText {
                                    text: root.data.bio; default-color: Theme.text; link-color: Theme.link;
                                    link-clicked(link) => { root.open-link(link); }
                                }
                            }
                        }
                    }
                    if root.data.created != "" || root.data.joined != "": VerticalLayout {
                        spacing: 6px;
                        ProfileHeading { text: "MEMBER SINCE"; }
                        HorizontalLayout {
                            spacing: 24px; alignment: start;
                            if root.data.created != "": VerticalLayout {
                                Text { text: root.data.created; color: Theme.text; font-size: 14px; font-weight: 500; }
                                Text { text: "On Discord"; color: Theme.muted; font-size: 12px; }
                            }
                            if root.data.joined != "": VerticalLayout {
                                Text { text: root.data.joined; color: Theme.text; font-size: 14px; font-weight: 500; }
                                Text { text: "In this server"; color: Theme.muted; font-size: 12px; }
                            }
                        }
                    }
                    if (root.large ? root.data.role-rows-large : root.data.role-rows).length > 0: VerticalLayout {
                        spacing: 6px;
                        ProfileHeading { text: "ROLES"; }
                        for row in (root.large ? root.data.role-rows-large : root.data.role-rows): HorizontalLayout {
                            spacing: 4px; alignment: start;
                            for role in row.roles: Rectangle {
                                height: 24px; border-radius: 4px; background: Theme.raised;
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 6px;
                                    Middle { Rectangle { width: 10px; height: 10px; border-radius: 5px; background: role.has-color ? role.color : Theme.faint; } }
                                    Text { text: role.name; color: Theme.secondary; font-size: 13px; font-weight: 500; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                    if root.full && root.data.servers.length > 0: VerticalLayout {
                        spacing: 6px;
                        ProfileHeading { text: "MUTUAL SERVERS — " + root.data.servers.length; }
                        VerticalLayout {
                            spacing: 0px;
                            for server in root.data.servers: ProfileListRow {
                                name: server.name; initial: server.initial; picture: server.picture;
                                detail: server.nick;
                                label: "Open " + server.name + (server.nick != "" ? ", where they're " + server.nick : "");
                                clicked => { root.open-server(server, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                            }
                        }
                    }
                    if root.full && root.data.friends.length > 0: VerticalLayout {
                        spacing: 6px;
                        ProfileHeading { text: "MUTUAL FRIENDS — " + root.data.friends.length; }
                        VerticalLayout {
                            spacing: 0px;
                            for friend in root.data.friends: ProfileListRow {
                                person: true; name: friend.name; initial: friend.initial; tint: friend.tint;
                                picture: friend.picture; presence: friend.presence;
                                label: friend.name + "'s profile";
                                clicked => { root.open-friend(friend.id, self.absolute-position.x, self.absolute-position.y, self.width, self.height); }
                            }
                        }
                    }
                    if root.data.note != "": Text { text: root.data.note; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                    if !root.large: ActionButton { text: "View full profile"; small: true; clicked => { root.enlarge(); } }
                }
            }
        }
    }
    if root.large: Rectangle {
        x: parent.width - 44px; y: 10px; width: 34px; height: 34px; border-radius: 17px; background: #00000080;
        IconButton { icon: @image-url("icons/x.svg"); label: "Close profile"; tint: #ffffff; clicked => { root.close(); } }
    }
}

// A dismissible message that applies to the whole window, such as a renderer fallback.
component Banner inherits Rectangle {
    in-out property <string> text;
    callback dismissed;
    min-height: banner-content.preferred-height; vertical-stretch: 0; background: Theme.raised;
    banner-content := HorizontalLayout {
        padding-left: 16px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 12px;
        Image { source: @image-url("icons/triangle-alert.svg"); width: 18px; image-fit: contain; colorize: Theme.accent; }
        Text { text: root.text; color: Theme.text; font-size: 15px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
        Middle { ActionButton { text: "Dismiss"; ghost: true; small: true; clicked => { root.dismissed(); } } }
    }
}

export struct ServerRow { id: string, name: string, initial: string, picture: image, selected: bool, unread: bool, discord: bool }
export struct PersonRow {
    id: string, name: string, status: string, muted: bool, deafened: bool, speaking: bool, connected: bool, initial: string, tint: color, picture: image,
    /// Sharing their screen.
    live: bool,
    /// This account, in a call.
    local: bool,
    /// Who they are across calls, by Discord or Matrix user id, which their
    /// volumes are remembered by.
    person: string,
}

// Marks someone sharing their screen, as Discord's red LIVE tag does.
// Clickable when it opens the stream.
component LivePill inherits Rectangle {
    in property <bool> clickable;
    in property <string> label: "Watch stream";
    callback clicked;
    width: live-text.preferred-width + 10px; height: 16px; border-radius: 8px;
    background: root.clickable && live-touch.has-hover ? Theme.danger-hover : Theme.danger;
    accessible-role: button; accessible-enabled: root.clickable; accessible-label: root.clickable ? root.label : "Live";
    accessible-action-default => { if root.clickable { root.clicked(); } }
    live-text := Text { text: "LIVE"; color: #ffffff; font-size: 10px; font-weight: 800; letter-spacing: 0.4px; }
    live-touch := TouchArea {
        enabled: root.clickable; mouse-cursor: root.clickable ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}
export struct RoomRow {
    id: string, name: string, heading: string, icon: image, selected: bool, unread: bool, badge: string,
    voice: bool, direct: bool, initial: string, tint: color,
    /// A DM's avatar or group icon, and whether it's a Discord DM.
    picture: image, discord: bool,
    /// Listed but not open to join, such as a Discord channel the account's roles keep it out of.
    locked: bool,
    /// A one-to-one DM, whose other person has a profile.
    person: bool,
    /// Who is in a Discord voice channel, shown without joining it.
    people: [PersonRow],
    /// A DM with a call going on.
    call: bool,
    /// A one-to-one Discord DM's other person: "online", "idle", "dnd" or
    /// "offline", empty when unknown; and their custom status or what
    /// they're doing, or a group DM's size.
    presence: string,
    detail: string,
}

component RequestsHeading inherits HorizontalLayout {
    in property <string> text;
    padding-left: 8px; height: 36px;
    Text { text: root.text; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: center; }
}

export struct FriendRow {
    id: string, name: string, initial: string, tint: color, picture: image,
    /// As in MemberRow: "online", "idle", "dnd" or "offline".
    presence: string,
    /// Their custom status or what they're doing.
    activity: string,
}

// A friend in the friends list. Clicking it opens your DM with them.
component FriendItem inherits Rectangle {
    in property <FriendRow> friend;
    callback message;
    property <string> status: root.friend.presence == "dnd" ? "Do Not Disturb" : root.friend.presence == "idle" ? "Idle" : root.friend.presence == "online" ? "Online" : "Offline";
    property <brush> surface: pointer.has-hover ? Theme.hover : Theme.chat;
    height: 62px; border-radius: 8px;
    background: pointer.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.friend.name + ", " + root.status + (root.friend.activity != "" ? ", " + root.friend.activity : "") + ", message";
    accessible-action-default => { root.message(); }
    // Rows are ruled apart, as in Discord's list; hovering a row hides its rule.
    if !pointer.has-hover: Rectangle { x: 10px; y: 0px; width: parent.width - 20px; height: 1px; background: Theme.line; }
    pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.message(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 12px;
        Middle {
            Rectangle {
                width: 32px; height: 32px;
                Avatar { size: 32px; initial: root.friend.initial; tint: root.friend.tint; picture: root.friend.picture; }
                StatusDot { x: 20px; y: 20px; presence: root.friend.presence; ring: root.surface; }
            }
        }
        VerticalLayout {
            alignment: center; spacing: 1px; horizontal-stretch: 1;
            Text { text: root.friend.name; color: Theme.text; font-size: 16px; font-weight: 700; overflow: elide; }
            Text { text: root.friend.activity != "" ? root.friend.activity : root.status; color: Theme.muted; font-size: 13px; overflow: elide; }
        }
        Middle {
            IconButton {
                icon: @image-url("icons/message-circle.svg"); label: "Message"; size: 36px; glyph: 20px; radius: 18px;
                fill: Theme.raised; tip-side: 2;
                clicked => { root.message(); }
            }
        }
    }
}

/// The Discord friends list, in place of a conversation: those around, or all.
component FriendsScreen inherits Rectangle {
    in property <[FriendRow]> rows;
    in property <bool> all;
    /// Friends in all, before the search.
    in property <int> total;
    in-out property <string> filter;
    callback filter-edited;
    callback message(string);
    callback add-friend;
    if root.total == 0: VerticalLayout {
        padding: 32px; spacing: 10px; alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
                Image { source: @image-url("icons/users.svg"); width: 36px; height: 36px; colorize: Theme.secondary; }
            }
        }
        Text { text: "No friends yet"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "Add someone with their Discord username."; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
        HorizontalLayout {
            alignment: center;
            ActionButton { text: "Add a friend"; primary: true; clicked => { root.add-friend(); } }
        }
    }
    if root.total > 0: VerticalLayout {
        padding: 16px; padding-bottom: 0px; spacing: 8px;
        TextField {
            min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken; ring: false;
            placeholder: "Search"; label: "Search friends"; text <=> root.filter;
            edited => { root.filter-edited(); }
        }
        RequestsHeading { text: (root.all ? "ALL FRIENDS — " : "ONLINE — ") + root.rows.length; }
        if root.rows.length == 0: HorizontalLayout {
            padding-left: 8px;
            Label {
                text: root.filter != "" ? "No friend's name matches that." : "None of your friends are around right now.";
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-bottom: 16px; spacing: 0px; alignment: start;
                for friend in root.rows: FriendItem {
                    friend: friend;
                    message => { root.message(friend.id); }
                }
            }
        }
    }
}

// A tab in the friends list's header.
component HeaderTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    width: tab-text.preferred-width + 20px; height: 28px; border-radius: 6px;
    background: root.selected ? Theme.active : pointer.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    tab-text := Text {
        text: root.text; font-size: 15px; font-weight: 500;
        color: root.selected || pointer.has-hover ? Theme.text : Theme.secondary;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == "\n" || event.text == " " {
                root.clicked(); return accept;
            }
            return reject;
        }
        pointer := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.clicked(); } }
    }
}

/// Friend requests, message requests and spam, in place of a conversation.
component RequestsScreen inherits Rectangle {
    in property <[FriendRequestRow]> friend-requests;
    in property <[RoomRow]> message-requests;
    in property <[RoomRow]> spam;
    callback accept(string);
    callback remove(string);
    callback open(string);
    property <bool> empty: root.friend-requests.length == 0 && root.message-requests.length == 0 && root.spam.length == 0;
    if root.empty: VerticalLayout {
        padding: 32px; spacing: 10px; alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
                Image { source: @image-url("icons/inbox.svg"); width: 36px; height: 36px; colorize: Theme.secondary; }
            }
        }
        Text { text: "No requests"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "Friend requests and messages from people you don't know show up here."; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
    }
    if !root.empty: ScrollView {
        VerticalLayout {
            padding: 16px; padding-top: 8px; spacing: 2px; alignment: start;
            if root.friend-requests.length > 0: RequestsHeading { text: "FRIEND REQUESTS — " + root.friend-requests.length; }
            for request in root.friend-requests: FriendRequest {
                request: request; surface: Theme.chat;
                accept => { root.accept(request.id); }
                remove => { root.remove(request.id); }
            }
            if root.message-requests.length > 0: RequestsHeading { text: "MESSAGE REQUESTS — " + root.message-requests.length; }
            for room in root.message-requests: ChannelRow {
                text: room.name; label: room.name + ", message request" + (room.unread ? ", unread" : "");
                icon: room.icon; person: room.direct; initial: room.initial; tint: room.tint;
                picture: room.picture; discord: room.discord; unread: room.unread;
                clicked => { root.open(room.id); }
            }
            if root.spam.length > 0: RequestsHeading { text: "SPAM — " + root.spam.length; }
            for room in root.spam: ChannelRow {
                text: room.name; label: room.name + ", spam";
                icon: room.icon; person: room.direct; initial: room.initial; tint: room.tint;
                picture: room.picture; discord: room.discord;
                clicked => { root.open(room.id); }
            }
        }
    }
}

/// A reaction: `key` names it, and `label` shows it, with a custom emoji's glyph once it has one.
export struct ReactionChip { key: string, label: string, count: int, mine: bool }
/// An image in a message's gallery, placed in pixels; `index` is its place
/// among the message's attachments. A spoiler's picture shows blurred, under a
/// SPOILER label, until clicked.
/// An animation's `frames` show in turn, each for its `delays` in milliseconds.
export struct ImageCell {
    index: int, name: string, image: image, x: int, y: int, width: int, height: int, spoiler: bool,
    frames: [image], delays: [int],
    /// On its way: a skeleton shows in its place, at the size it will take.
    loading: bool,
}
/// A file, or an image without a preview, as a card.
export struct FileCell { index: int, name: string, detail: string }
/// An embed's field, and a row of them: inline fields share a row.
export struct EmbedField { name: styled-text, value: styled-text }
export struct EmbedFieldRow { fields: [EmbedField] }
/// A Discord link preview or bot card. `title` links to the page when
/// there's one. A video's pictures are its poster, which opens `url`.
export struct EmbedCard {
    color: color, has-color: bool,
    provider: styled-text, has-provider: bool, author: styled-text, has-author: bool, title: styled-text, has-title: bool, url: string,
    description: styled-text, has-description: bool,
    field-rows: [EmbedFieldRow],
    footer: styled-text, has-footer: bool,
    /// The small picture beside the text; `thumbnail-index` is its place among the message's attachments.
    thumbnail: image, thumbnail-index: int, has-thumbnail: bool, thumbnail-loading: bool,
    images: [ImageCell], gallery-width: int, gallery-height: int,
    video: bool,
}
export struct MessageRow {
    id: string, item: string, author: string, initial: string, tint: color, picture: image, body: string, time: string, short-time: string, own: bool,
    /// The author's Discord role colour, when they have one.
    color: color, has-color: bool,
    /// Starts a group: shows the avatar and author. Later messages from the same person follow compactly.
    first: bool,
    /// A date divider above this message, when it starts a new day.
    day: string,
    /// The body, and the author and time as selectable text: a selection runs across messages
    /// through all three. A body of nothing but emoji shows them large.
    jumbo: bool,
    styled: styled-text, author-styled: styled-text, time-styled: styled-text, edited: bool, deleted: bool,
    reply-author: string, reply-body: string, reply-initial: string, reply-tint: color, reply-picture: image, has-reply: bool,
    /// The original message's item; clicking the reply jumps to it.
    reply-item: string,
    reactions: [ReactionChip],
    /// Images with previews, laid out in a gallery of this size; other
    /// attachments show as file cards.
    images: [ImageCell], gallery-width: int, gallery-height: int,
    /// Discord stickers, drawn on their own at their size.
    stickers: [ImageCell],
    files: [FileCell],
    embeds: [EmbedCard],
    /// Says a card is hidden, for a message that is only one, with link previews off.
    hidden-card: string,
    delivery: string, delivery-failed: bool, can-retry: bool, can-cancel: bool,
    can-reply: bool, can-edit: bool, can-delete: bool, can-react: bool, can-forward: bool,
}
/// A conversation a message can be forwarded to.
// Someone the new conversation dialog found.
export struct ContactRow {
    name: string, detail: string, initial: string, tint: color, picture: image, discord: bool,
}

export struct ForwardRow {
    id: string, name: string, place: string, icon: image, direct: bool, initial: string, tint: color,
    /// The message went there during this forward.
    sent: bool,
}

export component TalkWindow inherits Window {
    title: "Talk";
    preferred-width: 1120px; preferred-height: 760px;
    min-width: 800px; min-height: 560px;
    background: Theme.chat;
    default-font-family: "Satoshi";
    // Satoshi's x-height is small, so text defaults to 16px.
    default-font-size: 16px;
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }
    in property <bool> workspace;
    in property <bool> preview;
    in property <bool> busy;
    in property <bool> trusted;
    in property <bool> online;
    in property <bool> restore-available;
    in property <bool> dms-selected;
    in property <bool> dms-unread;
    // The dialog for starting a DM: who it found, and whether one is starting.
    // Adding a Discord friend by username: whether the request went, and what to say.
    in property <bool> add-friend-open;
    in property <bool> add-friend-sending;
    in property <string> add-friend-note;
    in property <bool> add-friend-sent;
    in-out property <string> add-friend-name;
    callback open-add-friend;
    callback add-friend(string);
    callback close-add-friend;
    // The Discord custom status and its dialog. Clear-after picks from
    // never, 30 minutes, an hour, four hours and today.
    in property <bool> has-custom-status;
    in property <bool> status-open;
    in property <bool> status-saving;
    in property <string> status-error;
    in-out property <string> status-text;
    in-out property <EmojiCell> status-emoji;
    in-out property <int> status-clear-after;
    callback open-status;
    callback save-status;
    callback clear-status;
    callback close-status;
    in property <bool> new-dm-open;
    in-out property <string> new-dm-query;
    in property <[ContactRow]> new-dm-people;
    in property <bool> new-dm-starting;
    in property <string> new-dm-note;
    callback open-new-dm;
    callback new-dm-search;
    callback start-dm(int);
    callback close-new-dm;
    in property <string> sidebar-title;
    in property <string> filter-placeholder;
    in property <string> sidebar-empty;
    in property <[ServerRow]> servers;
    in property <[RoomRow]> rooms;
    in property <[MessageRow]> messages;
    in property <string> account;
    in property <string> account-name;
    in property <string> account-initial;
    /// The Discord-only build's own status for the account's dot, as
    /// StatusDot takes it; empty to show the connection instead.
    in property <string> account-presence;
    in property <color> account-tint;
    in property <image> account-picture;
    in property <string> account-status;
    in property <string> storage;
    in property <string> notice;
    in-out property <string> graphics-notice;
    in property <string> room-name;
    in property <image> room-icon;
    in property <bool> room-direct;
    in property <string> room-initial;
    in property <color> room-tint;
    in property <image> room-picture;
    in property <string> members;
    /// The open room lists its members: a text channel or a group DM.
    /// The zoom level, such as "110%", shown for a moment after it changes.
    in property <string> zoom-note;
    in property <bool> members-available;
    /// A one-to-one DM is open, whose other person's profile can show beside it.
    in property <bool> profile-available;
    /// Whether it does: shown until someone hides it.
    in-out property <bool> profile-panel: true;
    callback profile-panel-toggled(bool);
    /// That profile, once Talk has it.
    in property <bool> panel-profile-shown;
    in property <ProfileData> panel-profile;
    callback enlarge-panel-profile;
    /// A one-to-one DM's other person, as in RoomRow: whether they're around,
    /// and their custom status or what they're doing.
    in property <string> room-presence;
    in property <string> room-activity;
    in property <[MemberRow]> roster;
    in property <string> roster-note;
    /// Whether the member list is wanted beside the conversation; Talk stores it.
    in-out property <bool> member-list: true;
    callback member-list-toggled(bool);
    /// A Discord account is linked, so its settings show.
    in property <bool> discord-linked;
    // Which networks this build carries.
    in property <bool> discord-build;
    in property <bool> matrix-build: true;
    // Linking Discord by QR code; see DiscordLinkPanel.
    in property <int> link-phase;
    in property <image> link-code;
    in property <string> link-name;
    in property <string> link-note;
    callback link-discord;
    callback cancel-discord-link;
    callback unlink-discord;
    in-out property <bool> show-hidden-channels;
    callback show-hidden-channels-toggled(bool);
    /// A link in a message was clicked.
    callback open-link(string);
    in-out property <bool> sync-discord-reads;
    callback sync-discord-reads-toggled(bool);
    in property <bool> room-selected;
    in property <bool> room-ready;
    in property <bool> room-encrypted;
    in property <bool> voice-room;
    in property <bool> composer-enabled;
    /// The selected conversation is a Discord message request, introduced by
    /// the title; it's answered instead of written to.
    in property <bool> room-request;
    in property <string> request-title;
    callback accept-request;
    callback ignore-request;
    in property <bool> can-send;
    in property <bool> sending;
    in property <bool> loading-history;
    in property <string> composer-hint;
    // Who else is typing in the open conversation; it takes the hint's place.
    in property <string> typing;
    // Who the `@` word being typed may mention; the chosen one is highlighted.
    in property <[MentionRow]> mentions;
    in-out property <int> mention-index;
    callback composer-caret(string, int);
    callback mention-chosen(int);
    callback mention-dismissed;
    /// "Replying to …" or "Editing your message"; empty for a new message.
    in property <string> compose-label;
    in property <bool> can-attach;
    /// Files waiting to go with the next message.
    in property <[StagedFile]> staged;
    callback unstage(int);
    callback paste-into-composer;
    public function paste-composer-text() { composer.paste-text(); }
    in property <string> confirm-delete;
    in-out property <string> react-item;
    in-out property <string> active-item;
    // Where the active message is in the timeline, so the keyboard can step from it.
    in-out property <int> active-index: -1;
    // The message list has the keyboard: Up and Down step through messages and
    // letters act on the active one.
    property <bool> browsing: timeline-keys.has-focus;
    // A popup the keyboard asked for, "menu" or "react", which the active row opens
    // beside itself.
    property <string> keyboard-popup;
    property <MessageRow> keyed-message: root.active-index >= 0 && root.active-index < root.messages.length ? root.messages[root.active-index] : {};
    // Room kept around the keyboard's message, so the next one is in view.
    property <length> keyboard-margin: min(160px, timeline.height / 3);
    callback edit-last;
    // Moves the keyboard to the newest message, from the composer.
    public function browse-messages() {
        if root.messages.length > 0 {
            root.step-message(root.messages.length - 1);
            timeline-keys.focus();
        }
    }
    function step-message(index: int) {
        root.active-index = max(0, min(root.messages.length - 1, index));
        root.active-item = root.messages[root.active-index].item;
    }
    /// The reactions this device uses most: three on the hover bar, four in the menu.
    in property <[EmojiCell]> bar-reactions;
    in property <[EmojiCell]> menu-reactions;
    /// The emoji picker's grid for `emoji-query`, refreshed through emoji-search.
    in property <[EmojiRow]> emoji-rows;
    in-out property <string> emoji-query;
    /// The forward dialog, open while Talk forwards a message of the open room.
    in property <bool> forward-open;
    /// The image viewer: the image, its full size in pixels, and what to say about it.
    /// The open profile card: beside the member list, or large over the window.
    in property <bool> profile-open;
    in property <bool> profile-large;
    in property <ProfileData> profile;
    /// Where the member whose card is open is listed.
    property <length> profile-y;
    /// The card opened from a mention or a role's list, beside the pointer rather
    /// than the member list.
    in-out property <bool> profile-at-pointer;
    /// A role mentioned in a message, with the members known to have it.
    in property <bool> role-open;
    in property <string> role-name;
    in property <color> role-color;
    in property <bool> role-has-color;
    in property <[MemberRow]> role-members;
    in property <string> role-note;
    callback close-role();
    // Where the role's card opened; a card opened from it moves the anchor, not it.
    property <length> role-x;
    property <length> role-y;
    property <length> role-width;
    changed role-open => {
        if root.role-open { root.role-x = root.anchor-x; root.role-y = root.anchor-y; root.role-width = root.anchor-width; }
    }
    /// The member whose card is beside the list, highlighted in it.
    in property <string> profile-member;
    callback show-profile(string);
    callback show-dm-profile(string);
    /// Show a mutual friend's profile, by Discord user id: as a card, or large.
    callback show-friend-profile(string, bool);
    /// A mutual server's card, beside the profile that lists it.
    property <bool> server-card-open;
    property <ProfileServerRow> server-card;
    function open-server-card(server: ProfileServerRow, x: length, y: length, width: length, height: length) {
        root.anchor(x, y, width, height, false);
        root.server-card = server;
        root.server-card-open = true;
    }
    callback enlarge-profile();
    callback close-profile();
    in property <bool> viewer-open;
    in property <image> viewer-image;
    in property <[image]> viewer-frames;
    in property <[int]> viewer-delays;
    in property <int> viewer-width;
    in property <int> viewer-height;
    in property <string> viewer-name;
    /// Such as "2 / 3"; empty for a message's only image.
    in property <string> viewer-position;
    /// While the full image loads, or why it can't show.
    in property <string> viewer-note;
    in property <string> viewer-item;
    in property <int> viewer-index;
    in property <string> forward-preview;
    in property <[ForwardRow]> forward-targets;
    in-out property <string> forward-query;
    /// The platform's color emoji font, so reactions do not fall back to outline glyphs.
    in property <string> emoji-font;
    in-out property <string> homeserver: "https://matrix.org";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> recovery;
    in-out property <string> draft;
    in-out property <string> filter;
    in property <bool> voice-visible;
    in property <bool> voice-active;
    in property <bool> voice-ready;
    in property <bool> voice-leaving;
    in property <bool> voice-here;
    /// The voice channel this account is connected to, whose participants are listed under it.
    in property <string> voice-channel;
    /// 0 while joining or reconnecting, 1 when connected, 2 after a failure.
    in property <int> voice-tone;
    in property <bool> can-join;
    in property <bool> muted;
    in property <bool> deafened;
    in property <string> voice-status;
    in property <string> voice-name;
    in property <string> voice-detail;
    in property <string> voice-microphone-status;
    in property <string> voice-description;
    in property <string> voice-error;
    in property <string> voice-warning;
    in property <[PersonRow]> participants;
    /// Sharing a screen is offered in Discord calls.
    in property <bool> can-share;
    in property <bool> sharing;
    in property <bool> share-live;
    /// The quality chosen last time: 0 for 720p, 1 for 1080p, 2 for the
    /// screen's own size, and frames a second.
    in property <int> share-resolution: 1;
    in property <int> share-fps: 30;
    in property <string> share-status;
    /// The newest preview of what's shared, refreshed by stream-tick while sharing.
    in-out property <image> share-frame;
    /// Watching someone's stream in the call.
    in property <bool> watching;
    in property <string> watch-title;
    in property <string> watch-status;
    /// The newest picture of the watched stream, refreshed by stream-tick.
    in-out property <image> watch-frame;
    in property <string> switch-prompt;
    /// Discord friend requests, message requests and spam, on the requests
    /// screen, which the top of the DM list opens.
    in property <[FriendRequestRow]> friend-requests;
    in property <[RoomRow]> message-requests;
    in property <[RoomRow]> spam-rooms;
    in property <bool> requests-open;
    /// The Discord friends list, the friends around in it, and how many
    /// friends there are before its search.
    in property <bool> friends-open;
    in property <[FriendRow]> friends;
    in property <[FriendRow]> friends-online;
    in property <int> friend-count;
    in-out property <string> friend-filter;
    /// The list shows all friends rather than those around.
    in-out property <bool> friends-all;
    callback friend-filter-edited;
    callback open-friends;
    /// Open the DM with a friend, by user id.
    callback message-friend(string);
    /// The requests screen, or a request from it, is on screen.
    in property <bool> requests-current;
    /// Requests waiting for an answer, as a badge.
    in property <string> requests-badge;
    callback open-requests;
    /// Send a Discord user a friend request or accept theirs, by user id, or
    /// ignore or cancel one.
    callback befriend(string);
    callback remove-friend-request(string);
    /// The open DM's other person, as in ProfileData.friend: whether the header
    /// offers to send them a friend request or accept theirs.
    in property <int> dm-friend;
    in property <string> dm-person;
    /// A Discord DM is open, whose call can be started or joined from its header.
    in property <bool> can-call;
    /// Someone is in the open DM's call, so the header joins rather than starts it.
    in property <bool> call-going;
    callback start-call;
    /// The open DM's call shows above its messages: this account is in it, or
    /// others are, or it rings this account.
    in property <bool> call-shown;
    /// The open DM, whose call the panel answers.
    in property <string> call-room;
    /// Who is in the open DM's call, while this account isn't.
    in property <[PersonRow]> call-people;
    in property <string> call-note;
    /// The open DM's call rings this account.
    in property <bool> call-incoming;
    /// Join a DM call ringing this account, by the DM's id, or decline it.
    callback answer-call(string, bool);
    /// A call ringing this account in a DM that isn't open, shown over everything.
    in property <bool> incoming-open;
    in property <string> incoming-room;
    in property <string> incoming-name;
    in property <string> incoming-detail;
    in property <string> incoming-initial;
    in property <color> incoming-tint;
    in property <image> incoming-picture;
    /// The settings screen covers the window, showing one section: 0 account, 1 voice and
    /// audio, 2 messages, 3 notifications, 4 Discord.
    in-out property <bool> settings-open;
    // Closing settings stops linking Discord there.
    changed settings-open => { if !self.settings-open && self.link-phase != 0 { self.cancel-discord-link(); } }
    in-out property <int> settings-section;
    /// Preferences people set in the settings; preferences-changed reports any change.
    in-out property <bool> twelve-hour-clock;
    /// Message text: 0 small, 1 default, 2 large.
    in-out property <int> text-size: 1;
    in-out property <bool> link-previews: true;
    in-out property <bool> unmute-on-join;
    in-out property <bool> level-voice: true;
    in-out property <bool> share-typing: true;
    in-out property <bool> notifications: true;
    in-out property <bool> notification-sound: true;
    in-out property <bool> notification-text: true;
    callback preferences-changed();
    out property <length> message-font-size: root.text-size == 0 ? 14px : root.text-size == 2 ? 18px : 16px;
    // The sidebar keeps 180 to 380px. Dragging also leaves the conversation 420px;
    // the window width cannot enter this binding, because it depends on the layout.
    out property <length> sidebar-shown: max(180px, min(380px, root.sidebar-width));
    in property <[string]> microphones;
    in property <[string]> speakers;
    in property <int> microphone-index;
    in property <int> speaker-index;
    /// The microphone level from 0 to 1, refreshed by meter-tick while the input menu is open.
    in-out property <float> input-level;
    /// Why the level can't be shown, if it can't.
    in-out property <string> meter-note;

    callback login;
    callback restore;
    callback explore-preview;
    callback logout;
    callback recover;
    callback refresh-trust;
    callback retry-sync;
    callback navigate-dms;
    callback navigate-server(string);
    callback select-room(string);
    callback draft-edited(string);
    callback filter-edited;
    callback send;
    callback earlier;
    callback join-voice;
    callback toggle-mute;
    callback toggle-deafen;
    callback toggle-share;
    /// Share the screen at this resolution, as in share-resolution, and frame rate.
    callback go-live(int, int);
    callback stream-tick;
    /// Watch the participant with this id's stream.
    callback watch-stream(string);
    // Someone's volumes, from a right click on them in a call, as percentages.
    callback volume-of(string, bool) -> int;
    /// A person, whether it's their stream, the volume, and whether it's
    /// the last of a drag, which is when it's remembered.
    callback volume-changed(string, bool, int, bool);
    property <string> volume-person;
    property <string> volume-name;
    property <bool> volume-live;
    property <int> voice-volume: 100;
    property <int> stream-volume: 100;
    function open-volume(person: PersonRow, x: length, y: length) {
        if person.local || person.person == "" { return; }
        root.anchor(x, y, 0px, 0px, true);
        root.volume-person = person.person;
        root.volume-name = person.name;
        root.volume-live = person.live;
        root.voice-volume = root.volume-of(person.person, false);
        root.stream-volume = root.volume-of(person.person, true);
        volume-menu.show();
    }
    callback stop-watching;
    callback leave-voice;
    callback confirm-switch;
    callback cancel-switch;
    callback dismiss-voice-error;
    callback refresh-devices;
    callback select-microphone(int);
    callback select-speaker(int);
    /// Whether the input menu wants the microphone level measured.
    callback metering(bool);
    callback meter-tick;
    callback reply(string);
    callback edit(string);
    callback react(string, string);
    callback request-delete(string);
    callback emoji-search(string);
    callback start-forward(string);
    callback forward-to(string);
    callback forward-search;
    callback close-forward;
    callback confirm-delete-message;
    callback cancel-delete;
    callback retry(string);
    callback cancel-send(string);
    callback attach;
    callback save-attachment(string, int);
    callback view-image(string, int);
    callback step-image(int);
    callback close-image();
    callback cancel-compose;
    callback dismiss-notice;
    // The sidebar's width, chosen by dragging its edge; Talk stores it on release.
    in-out property <length> sidebar-width: 240px;
    callback sidebar-resized(length);

    public function focus-composer() { composer.focus-input(); }
    public function place-composer-caret(offset: int) { composer.place-caret(offset); }
    // The Matrix sign-in, which only a build with Matrix has, focuses its first
    // field each time this counts up.
    property <int> sign-in-focus;
    public function focus-sign-in() { root.sign-in-focus += 1; }
    public function timeline-at-end() -> bool { return root.follow-latest; }
    // How far the newest message is below the view; zero at the end.
    public function timeline-below() -> length { return max(0px, timeline.content-y - min(0px, timeline.height - timeline.content-height)); }
    public function timeline-extent() -> length { return timeline.content-height; }
    /// Where in the window the link just clicked is, so a card it opens sits beside it.
    public function anchor-link(x: length, y: length, width: length, height: length) {
        root.anchor(x, y, width, height, false);
    }
    // The message a reply's click jumped to, highlighted while it's set.
    in-out property <string> jump-item;
    property <int> jump-tick;
    callback jump-to(string);
    // Uncovers a spoiler picture: the message's item and the attachment's index.
    callback reveal-attachment(string, int);
    /// Brings the message at `index` into view: an estimate first, so the list builds its
    /// row, then the row places itself on each `settle-jump` as the rows around it measure.
    public function show-message(index: int, item: string) {
        root.follow-latest = false;
        root.jump-item = item;
        timeline.content-y = max(min(0px, timeline.height - timeline.content-height),
            min(0px, timeline.height / 3 - timeline.content-height * index / max(1, root.messages.length)));
        root.jump-tick += 1;
    }
    public function settle-jump() { root.jump-tick += 1; }
    public function scroll-to-latest() {
        root.follow-latest = true;
        timeline.content-y = min(0px, timeline.height - timeline.content-height);
    }
    // While the newest message is in view, keep it there as rows grow, for example
    // when an image preview or a reaction arrives after the row first appeared.
    // Only scrolling stops following, and reaching the end again resumes it. The
    // list re-estimates its height as it measures rows, so heights can't tell
    // whether someone scrolled; and a wheel scroll is reported before its
    // animation moves the list, so the position at that moment can't either.
    property <bool> follow-latest: true;
    property <length> timeline-position: timeline.content-y;
    property <length> timeline-content: timeline.content-height;
    // The composer grows for a reply or edit, which shortens the list.
    property <length> timeline-viewport: timeline.height;
    // A short history sits against the composer, as in a conversation: the first
    // row is padded by the space the rows leave. A changed handler, not a binding,
    // because the list's height decides which rows it measures.
    property <length> lead;
    function settle-lead() { root.lead = max(0px, timeline.height - (timeline.content-height - root.lead)); }
    changed timeline-viewport => { root.settle-lead(); if root.follow-latest { root.scroll-to-latest(); } }
    changed timeline-position => {
        if timeline.content-y <= min(0px, timeline.height - timeline.content-height) + 0.5px { root.follow-latest = true; }
    }
    changed timeline-content => {
        root.settle-lead();
        if root.follow-latest { root.scroll-to-latest(); }
    }
    public function preserve-history-position(delta: length) { timeline.content-y = timeline.content-y - delta; }
    // Formatted messages are not selectable, so Copy goes through a hidden text field.
    function copy-text(text: string) { clipboard.text = text; clipboard.select-all(); clipboard.copy(); clipboard.text = ""; }
    clipboard := TextInput { visible: false; width: 0px; height: 0px; }
    // A tooltip must not outlive the toolbar that showed it.
    changed active-item => { Tip.text = ""; }

    // The member list is a second sidebar, on the right of the conversation.
    property <bool> members-docked: root.members-available && root.member-list;
    // Rows remade under the pointer show their tooltip again; it goes with the screen.
    changed friends-open => { Tip.text = ""; }
    property <bool> profile-docked: root.profile-available && root.profile-panel && root.panel-profile-shown;
    function toggle-profile-panel() {
        root.profile-panel = !root.profile-panel;
        root.profile-panel-toggled(root.profile-panel);
    }
    function toggle-members() {
        root.member-list = !root.member-list;
        root.member-list-toggled(root.member-list);
    }

    property <bool> is-editing: root.compose-label == "Editing your message";
    property <color> voice-color: root.voice-tone == 1 ? Theme.live : root.voice-tone == 2 ? Theme.danger : Theme.accent;

    // Talk joins calls muted; this preference turns the microphone on once connected.
    changed voice-ready => {
        if root.voice-ready && root.unmute-on-join && root.muted { root.toggle-mute(); }
    }

    // The device menus open above the toggle whose caret was clicked.
    property <length> menu-x;
    property <length> menu-y;
    function open-settings() { input-menu.close(); output-menu.close(); root.settings-section = 1; root.settings-open = true; root.refresh-devices(); }
    property <bool> input-open: input-menu.is-open;
    property <bool> output-open: output-menu.is-open;
    changed input-open => { root.input-level = 0; root.meter-note = ""; root.metering(root.input-open); }
    Timer { interval: 50ms; running: root.input-open; triggered => { root.meter-tick(); } }
    Timer { interval: 33ms; running: root.sharing || root.watching; triggered => { root.stream-tick(); } }
    input-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        width: 280px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        DeviceMenu {
            heading: "INPUT DEVICE"; devices: root.microphones; current: root.microphone-index;
            empty: "No microphones found. Connect one, then reopen this menu.";
            select(index) => { root.select-microphone(index); }
            settings => { root.open-settings(); }
            Rectangle { height: 1px; background: Theme.line; }
            VerticalLayout {
                padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; spacing: 8px;
                Text { text: "INPUT LEVEL"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                HorizontalLayout {
                    height: 10px; spacing: 3px;
                    accessible-role: progress-indicator;
                    accessible-label: "Input level";
                    accessible-value: round(root.input-level * 100) + "%" + (root.muted ? ", muted" : "");
                    // Muted, the level still shows, in a faded green: heard here, sent nowhere.
                    for segment in 24: Rectangle {
                        border-radius: 2px;
                        background: (segment + 0.5) / 24 > root.input-level ? Theme.line
                            : root.muted ? Theme.live.with-alpha(0.4) : Theme.live;
                    }
                }
                if root.meter-note != "": Label { text: root.meter-note; }
                if root.meter-note == "" && root.muted: Label { text: "Muted. Nothing you say is sent."; }
            }
        }
    }
    output-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        width: 280px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        DeviceMenu {
            heading: "OUTPUT DEVICE"; devices: root.speakers; current: root.speaker-index;
            empty: "No speakers found. Connect one, then reopen this menu.";
            select(index) => { root.select-speaker(index); }
            settings => { root.open-settings(); }
        }
    }
    // The quality picked in the share menu, from the last choice each time it opens.
    property <int> pick-resolution;
    property <int> pick-fps;
    function open-share-menu(x: length, y: length) {
        root.menu-x = x; root.menu-y = y;
        root.pick-resolution = root.share-resolution;
        root.pick-fps = root.share-fps;
        share-menu.show();
    }
    share-menu := PopupWindow {
        x: max(8px, min(root.width - self.width - 8px, root.menu-x - 6px));
        y: max(8px, root.menu-y - self.height - 6px);
        width: 240px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            VerticalLayout {
                padding: 6px; spacing: 2px;
                HorizontalLayout {
                    padding-left: 8px; padding-top: 4px; padding-bottom: 4px;
                    Text { text: "RESOLUTION"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                }
                for choice[index] in ["720p", "1080p", "Source"]: MenuItem {
                    text: choice; checked: index == root.pick-resolution;
                    clicked => { root.pick-resolution = index; }
                }
                HorizontalLayout {
                    padding-left: 8px; padding-top: 8px; padding-bottom: 4px;
                    Text { text: "FRAME RATE"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                }
                for fps in [15, 30, 60]: MenuItem {
                    text: fps + " fps"; checked: fps == root.pick-fps;
                    clicked => { root.pick-fps = fps; }
                }
                HorizontalLayout {
                    padding: 4px; padding-top: 8px;
                    ActionButton {
                        text: "Go Live"; icon: @image-url("icons/screen-share.svg"); primary: true; horizontal-stretch: 1;
                        clicked => { root.go-live(root.pick-resolution, root.pick-fps); share-menu.close(); }
                    }
                }
            }
        }
    }
    // The emoji picker and a message's menu open beside the control that asked for
    // them, flipping above it near the bottom of the window. A menu opened by a
    // right click starts at the pointer.
    property <length> anchor-x;
    property <length> anchor-y;
    property <length> anchor-width;
    property <length> anchor-height;
    property <bool> anchor-pointer;
    function anchor(x: length, y: length, width: length, height: length, pointer: bool) {
        root.anchor-x = x; root.anchor-y = y; root.anchor-width = width; root.anchor-height = height;
        root.anchor-pointer = pointer;
    }
    // A card opened from a mention sits right of what was clicked, or left of it
    // when there isn't room.
    pure function beside(x: length, width: length, card: length) -> length {
        return x + width + 8px + card <= root.width - 8px ? x + width + 8px : max(8px, x - card - 8px);
    }
    // Closing a popup ends the handler that closed it, so callers close last.
    function open-picker(item: string) {
        root.react-item = item;
        root.emoji-query = "";
        root.emoji-hover = { glyph: "", name: "" };
        root.emoji-search("");
        emoji-picker.show();
    }
    // The message whose menu is open.
    property <MessageRow> menu-message;
    property <string> menu-item: menu-open ? root.menu-message.item : "";
    property <bool> menu-open: message-menu.is-open;
    // The DM whose menu is open.
    property <string> menu-room;
    room-menu := PopupWindow {
        width: 200px; height: room-menu-content.preferred-height;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-x));
        y: root.anchor-y + self.height <= root.height - 8px ? root.anchor-y : max(8px, root.anchor-y - self.height);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            room-menu-content := VerticalLayout {
                padding: 6px;
                MenuItem {
                    text: "Profile"; icon: @image-url("icons/user.svg");
                    clicked => { root.show-dm-profile(root.menu-room); room-menu.close(); }
                }
            }
        }
    }
    function open-menu(message: MessageRow) {
        root.menu-message = message;
        message-menu.show();
    }
    property <bool> picker-open: emoji-picker.is-open;
    changed picker-open => { if !root.picker-open { root.react-item = ""; } }
    property <EmojiCell> emoji-hover;
    // The status dialog borrows the picker for its emoji.
    function pick(cell: EmojiCell) {
        if root.react-item == "talk:status" {
            root.status-emoji = cell;
        } else {
            root.react(root.react-item, cell.key);
        }
        emoji-picker.close();
    }
    emoji-picker := PopupWindow {
        width: 360px; height: 432px;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-pointer ? root.anchor-x : root.anchor-x + root.anchor-width - self.width));
        y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
            ? root.anchor-y + root.anchor-height + 4px : max(8px, root.anchor-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 10px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            clip: true;
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { emoji-picker.close(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    spacing: 0px;
                    HorizontalLayout {
                        padding: 10px; padding-bottom: 6px;
                        // The picker's contents are created each time it opens.
                        picker-field := TextField {
                            init => { self.focus-input(); }
                            min-height: 34px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                            placeholder: "Find an emoji"; label: "Find an emoji"; text <=> root.emoji-query;
                            edited(text) => { root.emoji-search(text); }
                            // Enter picks the first match.
                            accepted => {
                                if root.emoji-query != "" && root.emoji-rows.length > 0 && root.emoji-rows[0].cells.length > 0 {
                                    root.pick(root.emoji-rows[0].cells[0]);
                                }
                            }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for row in root.emoji-rows: VerticalLayout {
                            padding-left: 8px; padding-right: 8px;
                            if row.heading != "": HorizontalLayout {
                                padding-left: 4px; height: 30px;
                                Text { text: row.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: bottom; }
                            }
                            if row.cells.length > 0: HorizontalLayout {
                                alignment: start; padding-top: 2px;
                                for cell in row.cells: EmojiButton {
                                    emoji: cell; font: root.emoji-font; size: 40px; glyph: 26px; tip: false;
                                    hovered => { root.emoji-hover = cell; }
                                    clicked => { root.pick(cell); }
                                }
                            }
                        }
                    }
                    if root.emoji-rows.length == 0: HorizontalLayout {
                        padding: 16px; vertical-stretch: 1;
                        Label { text: "No emoji match \"" + root.emoji-query + "\"."; horizontal-alignment: center; }
                    }
                    // The hovered emoji, larger, with its name.
                    Rectangle {
                        height: 48px; background: Theme.panel;
                        HorizontalLayout {
                            padding-left: 14px; padding-right: 14px; spacing: 10px;
                            if root.emoji-hover.glyph != "": Text { text: root.emoji-hover.glyph; font-family: root.emoji-font; font-size: 26px; vertical-alignment: center; }
                            Text {
                                text: root.emoji-hover.glyph != "" ? root.emoji-hover.name
                                    : root.react-item == "talk:status" ? "Pick an emoji for your status." : "Pick an emoji to react with.";
                                color: root.emoji-hover.glyph != "" ? Theme.text : Theme.muted; font-size: 15px;
                                font-weight: root.emoji-hover.glyph != "" ? 700 : 400;
                                vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
    // A message's actions, from its hover bar's "More" button or a right click.
    property <bool> menu-can-react: root.menu-message.can-react && root.composer-enabled;
    volume-menu := PopupWindow {
        width: 260px; height: volume-content.preferred-height;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-x));
        y: root.anchor-y + self.height <= root.height - 8px ? root.anchor-y : max(8px, root.anchor-y - self.height);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            accessible-role: groupbox; accessible-label: root.volume-name + "'s volume";
            volume-content := VerticalLayout {
                padding: 12px; spacing: 12px;
                Text { text: root.volume-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                VolumeSlider {
                    label: "User volume";
                    value <=> root.voice-volume;
                    changed(volume) => { root.volume-changed(root.volume-person, false, volume, false); }
                    committed(volume) => { root.volume-changed(root.volume-person, false, volume, true); }
                }
                if root.volume-live: VolumeSlider {
                    label: "Stream volume";
                    value <=> root.stream-volume;
                    changed(volume) => { root.volume-changed(root.volume-person, true, volume, false); }
                    committed(volume) => { root.volume-changed(root.volume-person, true, volume, true); }
                }
            }
        }
    }
    message-menu := PopupWindow {
        width: 224px; height: menu-content.preferred-height;
        x: max(8px, min(root.width - self.width - 8px, root.anchor-pointer ? root.anchor-x : root.anchor-x + root.anchor-width - self.width));
        y: root.anchor-y + root.anchor-height + 4px + self.height <= root.height - 8px
            ? root.anchor-y + root.anchor-height + (root.anchor-pointer ? 0px : 4px) : max(8px, root.anchor-y - self.height - 4px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            menu-content := VerticalLayout {
                padding: 6px; spacing: 2px;
                if root.menu-can-react: HorizontalLayout {
                    spacing: 4px; padding-bottom: 4px;
                    for cell in root.menu-reactions: EmojiButton {
                        emoji: cell; font: root.emoji-font; size: 50px; height: 40px; glyph: 22px; fill: Theme.field;
                        clicked => { root.react(root.menu-message.item, cell.key); message-menu.close(); }
                    }
                }
                if root.menu-can-react: MenuItem {
                    text: "Add reaction"; icon: @image-url("icons/smile-plus.svg");
                    clicked => { root.open-picker(root.menu-message.item); message-menu.close(); }
                }
                if root.menu-message.can-edit && root.composer-enabled: MenuItem {
                    text: "Edit message"; icon: @image-url("icons/pencil.svg");
                    clicked => { root.edit(root.menu-message.item); root.focus-composer(); message-menu.close(); }
                }
                if root.menu-message.can-reply && root.composer-enabled: MenuItem {
                    text: "Reply"; icon: @image-url("icons/reply.svg");
                    clicked => { root.reply(root.menu-message.item); root.focus-composer(); message-menu.close(); }
                }
                if root.menu-message.can-forward && (root.trusted || root.preview): MenuItem {
                    text: "Forward"; icon: @image-url("icons/forward.svg");
                    clicked => { root.start-forward(root.menu-message.item); message-menu.close(); }
                }
                if root.menu-message.body != "": MenuItem {
                    text: "Copy text"; icon: @image-url("icons/copy.svg");
                    clicked => { root.copy-text(root.menu-message.body); message-menu.close(); }
                }
                if root.menu-message.can-delete && root.composer-enabled: Rectangle { height: 1px; background: Theme.line; }
                if root.menu-message.can-delete && root.composer-enabled: MenuItem {
                    text: "Delete message"; icon: @image-url("icons/trash-2.svg"); danger: true;
                    clicked => { root.request-delete(root.menu-message.item); message-menu.close(); }
                }
            }
        }
    }

    // Sign in: a centred card on the darkest ground, with the local preview beside it.
    Rectangle {
        visible: !root.workspace;
        background: Theme.rail;
        Text { x: 32px; y: 24px; text: "Talk"; color: Theme.accent; font-size: 24px; font-weight: 900; letter-spacing: -0.4px; }
        ScrollView {
            y: 64px; height: parent.height - 64px;
            VerticalLayout {
                padding: 24px; padding-top: 0px; spacing: 16px;
                alignment: center;
                min-height: root.height - 64px;
                if root.graphics-notice != "": HorizontalLayout {
                    alignment: center;
                    Banner { max-width: 760px; text <=> root.graphics-notice; dismissed => { root.graphics-notice = ""; } }
                }
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        max-width: 760px; horizontal-stretch: 1;
                        background: Theme.chat; border-radius: 12px;
                        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
                        HorizontalLayout {
                            padding: 32px; spacing: 32px;
                            // A build without Matrix signs in by linking Discord.
                            if !root.matrix-build: VerticalLayout {
                                spacing: 8px; horizontal-stretch: 1; min-width: 300px;
                                Text { text: "Sign in to Talk"; color: Theme.text; font-size: 26px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "Link your Discord account with your phone."; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
                                Rectangle { height: 12px; }
                                if !root.busy: DiscordLinkPanel {
                                    phase: root.link-phase; code: root.link-code; name: root.link-name; note: root.link-note;
                                    begin => { root.link-discord(); }
                                }
                                if root.notice != "" && (root.busy || root.link-phase == 0): Text {
                                    text: root.notice; color: root.busy ? Theme.secondary : Theme.danger; font-size: 15px; wrap: word-wrap;
                                }
                            }
                            if root.matrix-build: VerticalLayout {
                                property <int> focus-asked: root.sign-in-focus;
                                changed focus-asked => { username-field.focus-input(); }
                                spacing: 8px; horizontal-stretch: 1; min-width: 300px;
                                Text { text: "Sign in to Talk"; color: Theme.text; font-size: 26px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "Use your existing Matrix account."; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
                                Rectangle { height: 12px; }
                                Text { text: "HOMESERVER"; color: Theme.secondary; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                                TextField { text <=> root.homeserver; enabled: !root.busy; label: "Homeserver"; }
                                Rectangle { height: 4px; }
                                Text { text: "MATRIX ID"; color: Theme.secondary; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                                username-field := TextField { text <=> root.username; placeholder: "@you:matrix.org"; enabled: !root.busy; label: "Matrix ID"; }
                                Rectangle { height: 4px; }
                                Text { text: "PASSWORD"; color: Theme.secondary; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                                TextField { text <=> root.password; password: true; enabled: !root.busy; label: "Password"; accepted => { root.login(); } }
                                Rectangle { height: 12px; }
                                ActionButton { min-height: 44px; text: root.busy ? "Connecting..." : "Sign in"; primary: true; enabled: !root.busy; clicked => { root.login(); } }
                                if root.notice != "": Text { text: root.notice; color: Theme.danger; font-size: 15px; wrap: word-wrap; }
                                if root.restore-available && !root.busy: ActionButton { text: "Retry saved session"; clicked => { root.restore(); } }
                                Label { text: "Sign in with your Matrix password. Single sign-on isn't available yet."; }
                            }
                            Rectangle { width: 1px; background: Theme.line; }
                            VerticalLayout {
                                width: 220px; spacing: 12px; alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 72px; height: 72px; border-radius: 24px; background: Theme.raised;
                                        Image { source: @image-url("icons/message-circle.svg"); width: 34px; height: 34px; colorize: Theme.accent; }
                                    }
                                }
                                Text { text: "Just looking?"; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "Try the layout with sample conversations. Nothing leaves this computer."; color: Theme.secondary; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
                                ActionButton { text: "Explore local preview"; enabled: !root.busy; clicked => { root.explore-preview(); } }
                            }
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        visible: root.workspace;
        spacing: 0px;
        // Navigation: the rail and the sidebar, with the voice and account dock across both.
        Rectangle {
            width: 72px + root.sidebar-shown; background: Theme.rail;
            VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    vertical-stretch: 1; spacing: 0px;
                    // Server rail.
                    Rectangle {
                        width: 72px; background: Theme.rail;
                        VerticalLayout {
                            padding-top: 12px; padding-bottom: 12px; spacing: 8px;
                            RailItem {
                                icon: @image-url("icons/message-circle.svg");
                                label: root.dms-unread ? "Direct messages, unread" : "Direct messages"; tip: "Direct messages";
                                selected: root.dms-selected; unread: root.dms-unread;
                                clicked => { root.navigate-dms(); }
                            }
                            HorizontalLayout {
                                alignment: center;
                                Rectangle { width: 32px; height: 2px; border-radius: 1px; background: Theme.line; }
                            }
                            // A list view makes only the servers in sight, which
                            // matters on accounts in many servers.
                            ListView {
                                vertical-stretch: 1;
                                for server in root.servers: Rectangle {
                                    height: 48px + 8px;
                                    RailItem {
                                        y: 0px;
                                        initial: server.initial; picture: server.picture;
                                        label: server.name + (server.discord ? ", Discord" : "") + (server.unread ? ", unread" : "");
                                        tip: server.discord ? server.name + " (Discord)" : server.name;
                                        selected: server.selected; unread: server.unread; discord: server.discord;
                                        clicked => { root.navigate-server(server.id); }
                                    }
                                }
                            }
                        }
                    }
                    // Channel sidebar: a lighter sheet held by the rail and the dock.
                    Rectangle {
                        width: root.sidebar-shown; background: Theme.sidebar;
                        border-top-left-radius: 10px; border-bottom-left-radius: 10px;
                        clip: true;
                        VerticalLayout {
                            spacing: 0px;
                            Rectangle {
                                height: 48px;
                                Text { x: 16px; width: parent.width - (root.dms-selected && !root.preview ? (root.discord-linked ? 88px : 56px) : 32px); text: root.sidebar-title; font-size: 16px; font-weight: 700; color: Theme.text; vertical-alignment: center; overflow: elide; }
                                if root.dms-selected && !root.preview && root.discord-linked: IconButton {
                                    x: parent.width - 2 * self.width - 14px;
                                    icon: @image-url("icons/user-plus.svg"); label: "Add a friend"; size: 28px; glyph: 18px; tip-side: 2;
                                    clicked => { root.open-add-friend(); }
                                }
                                if root.dms-selected && !root.preview: IconButton {
                                    x: parent.width - self.width - 10px;
                                    icon: @image-url("icons/square-pen.svg"); label: "New message"; size: 28px; glyph: 18px; tip-side: 2;
                                    clicked => { root.open-new-dm(); }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
                            }
                            HorizontalLayout {
                                padding: 10px; padding-bottom: 6px;
                                TextField {
                                    min-height: 30px; text-size: 14px; pad: 8px; fill: Theme.sunken; ring: false;
                                    placeholder: root.filter-placeholder; text <=> root.filter; label: root.filter-placeholder;
                                    edited => { root.filter-edited(); }
                                }
                            }
                            ScrollView {
                                min-height: 96px; vertical-stretch: 1;
                                VerticalLayout {
                                    padding-left: 8px; padding-right: 8px; padding-bottom: 12px; spacing: 2px;
                                    // The friends list, and friend requests, message requests
                                    // and spam, open on their own screens.
                                    if root.dms-selected && root.discord-linked && !root.preview: VerticalLayout {
                                        padding-top: 6px; padding-bottom: 6px; spacing: 2px;
                                        ChannelRow {
                                            text: "Friends";
                                            icon: @image-url("icons/users.svg");
                                            selected: root.friends-open;
                                            clicked => { root.open-friends(); }
                                        }
                                        ChannelRow {
                                            text: "Requests";
                                            label: "Requests" + (root.requests-badge != "" ? ", " + root.requests-badge + " waiting" : "");
                                            icon: @image-url("icons/inbox.svg");
                                            selected: root.requests-current; badge: root.requests-badge;
                                            clicked => { root.open-requests(); }
                                        }
                                    }
                                    for room in root.rooms: VerticalLayout {
                                        spacing: 2px; vertical-stretch: 0;
                                        if room.heading != "": HorizontalLayout {
                                            padding-left: 8px; height: 36px;
                                            Text { text: room.heading; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: center; }
                                        }
                                        ChannelRow {
                                            text: room.name;
                                            label: room.name + (room.discord ? ", Discord" : "")
                                                + (room.presence == "dnd" ? ", do not disturb" : room.presence != "" ? ", " + room.presence : "")
                                                + (room.detail != "" ? ", " + room.detail : "")
                                                + (room.locked ? ", locked" : "") + (room.call ? ", in a call" : "") + (room.badge != "" ? ", " + room.badge + " mentions" : room.unread ? ", unread" : "");
                                            icon: room.icon; person: room.direct; initial: room.initial; tint: room.tint;
                                            picture: room.picture; discord: room.discord;
                                            selected: room.selected; unread: room.unread; badge: room.badge; locked: room.locked;
                                            call: room.call; presence: room.presence; detail: room.detail;
                                            clicked => { root.select-room(room.id); }
                                            // A DM's menu offers its other person's profile.
                                            context-menu(x, y) => {
                                                if room.person {
                                                    root.anchor(x, y, 0px, 0px, true);
                                                    root.menu-room = room.id;
                                                    room-menu.show();
                                                }
                                            }
                                        }
                                        // Discord reports who is in every voice channel; Matrix
                                        // only shows the call Talk is in, below.
                                        if room.voice && room.id != root.voice-channel && room.people.length > 0: VerticalLayout {
                                            padding-left: 32px; padding-bottom: 4px; spacing: 0px;
                                            for person in room.people: HorizontalLayout {
                                                height: 30px; spacing: 8px; padding-left: 4px; padding-right: 8px;
                                                Middle { Avatar { size: 22px; initial: person.initial; tint: person.tint; picture: person.picture; } }
                                                Text {
                                                    text: person.name; font-size: 15px; font-weight: 500; color: Theme.secondary;
                                                    vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                                                }
                                                if person.live: Middle { LivePill { } }
                                                if person.muted || person.deafened: Image {
                                                    source: @image-url("icons/mic-off.svg"); width: 16px; image-fit: contain;
                                                    colorize: Theme.muted; accessible-role: image; accessible-label: person.name + " is muted";
                                                }
                                                if person.deafened: Image {
                                                    source: @image-url("icons/headphone-off.svg"); width: 16px; image-fit: contain;
                                                    colorize: Theme.muted; accessible-role: image; accessible-label: person.name + " is deafened";
                                                }
                                            }
                                        }
                                        if room.voice && room.id == root.voice-channel: VerticalLayout {
                                            padding-left: 32px; padding-bottom: 4px; spacing: 0px;
                                            for person in root.participants: Rectangle {
                                                height: 30px; border-radius: 4px;
                                                background: !person.local && participant-touch.has-hover ? Theme.hover : transparent;
                                                // A right click sets their volumes.
                                                participant-touch := TouchArea {
                                                    pointer-event(event) => {
                                                        if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                                            root.open-volume(person, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    spacing: 8px; padding-left: 4px; padding-right: 8px;
                                                    Middle { Avatar { size: 22px; initial: person.initial; tint: person.tint; picture: person.picture; speaking: person.speaking; } }
                                                    Text {
                                                        text: person.name; font-size: 15px; font-weight: person.speaking ? 700 : 500;
                                                        color: person.speaking ? Theme.text : person.connected ? Theme.secondary : Theme.muted;
                                                        vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                                                    }
                                                    if person.live: Middle {
                                                        LivePill {
                                                            clickable: !person.local; label: "Watch " + person.name + "'s stream";
                                                            clicked => { root.watch-stream(person.id); }
                                                        }
                                                    }
                                                    if person.muted || person.deafened: Image {
                                                        source: @image-url("icons/mic-off.svg"); width: 16px; image-fit: contain;
                                                        colorize: Theme.muted; accessible-role: image; accessible-label: person.name + " is muted";
                                                    }
                                                    if person.deafened: Image {
                                                        source: @image-url("icons/headphone-off.svg"); width: 16px; image-fit: contain;
                                                        colorize: Theme.muted; accessible-role: image; accessible-label: person.name + " is deafened";
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.sidebar-empty != "": HorizontalLayout { padding: 8px; Label { text: root.sidebar-empty; } }
                                    Rectangle { vertical-stretch: 1; }
                                }
                            }
                        }
                    }
                }
                // The dock spans the rail and the sidebar. Its avatar and voice icon sit on the
                // rail's axis, 36px from the left; names and status start at 64px.
                if root.voice-visible: Rectangle {
                    background: Theme.panel;
                    VerticalLayout {
                        padding-top: 10px; padding-bottom: 8px; padding-right: 8px; spacing: 6px;
                        HorizontalLayout {
                            spacing: 0px;
                            Rectangle {
                                width: 64px;
                                Image {
                                    x: 26px; width: 20px; height: 20px; source: @image-url("icons/volume-2.svg");
                                    image-fit: contain; colorize: root.voice-color;
                                }
                            }
                            VerticalLayout {
                                alignment: center; horizontal-stretch: 1;
                                Text { text: root.voice-status; color: root.voice-color; font-size: 15px; font-weight: 700; overflow: elide; }
                                if root.voice-active: Text { text: root.voice-detail; color: Theme.muted; font-size: 13px; overflow: elide; }
                            }
                            if root.voice-active: IconButton {
                                icon: @image-url("icons/phone-off.svg"); label: "Leave voice"; danger: true;
                                enabled: !root.voice-leaving;
                                clicked => { root.leave-voice(); }
                            }
                        }
                        // Wrapped in the dock's width; a scroll view would neither wrap nor stay short.
                        if root.voice-warning != "" && root.voice-error == "": HorizontalLayout {
                            padding-left: 64px;
                            Label { text: root.voice-warning; color: Theme.accent; }
                        }
                        if root.voice-error != "": HorizontalLayout {
                            padding-left: 64px;
                            Text { text: root.voice-error; color: Theme.text; font-size: 14px; wrap: word-wrap; }
                        }
                        if !root.voice-active: HorizontalLayout {
                            padding-left: 54px;
                            ActionButton { text: "Dismiss"; ghost: true; small: true; clicked => { root.dismiss-voice-error(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
                // Account panel.
                Rectangle {
                    height: 56px; background: Theme.panel;
                    if root.voice-visible: Rectangle { x: 12px; y: 0px; width: parent.width - 24px; height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        padding-right: 8px; spacing: 2px;
                        Rectangle {
                            width: 58px;
                            Avatar { x: 19px; y: (parent.height - self.height) / 2; size: 34px; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture; }
                            if root.account-presence != "": StatusDot {
                                x: 40px; y: parent.height / 2 + 3px; presence: root.account-presence; ring: Theme.panel;
                            }
                            if root.account-presence == "": Rectangle {
                                x: 41px; y: parent.height / 2 + 4px; width: 14px; height: 14px; border-radius: 7px; background: Theme.panel;
                                Rectangle {
                                    width: 8px; height: 8px; border-radius: 4px;
                                    background: root.preview ? Theme.accent : root.online ? Theme.live : Theme.faint;
                                }
                            }
                        }
                        // With Discord linked, the name opens the custom status.
                        Rectangle {
                            horizontal-stretch: 1; y: 6px; height: parent.height - 12px; border-radius: 6px;
                            background: account-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-enabled: root.discord-linked;
                            accessible-label: root.account-name + ", " + root.account-status + (root.discord-linked ? ". Set a custom status" : "");
                            accessible-action-default => { if root.discord-linked { root.open-status(); } }
                            VerticalLayout {
                                alignment: center; padding-left: 6px; padding-right: 6px;
                                Text { text: root.account-name; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                                Text { text: root.account-status; color: Theme.muted; font-size: 13px; overflow: elide; }
                            }
                            account-touch := TouchArea {
                                enabled: root.discord-linked; mouse-cursor: MouseCursor.pointer;
                                clicked => { root.open-status(); }
                            }
                        }
                        if root.voice-active: DeviceToggle {
                            icon: root.muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                            label: root.muted ? "Unmute" : "Mute"; alert: root.muted;
                            menu-label: "Input options"; open: root.input-open;
                            enabled: root.voice-ready;
                            clicked => { root.toggle-mute(); }
                            menu => {
                                root.menu-x = self.absolute-position.x; root.menu-y = self.absolute-position.y + (self.height - 32px) / 2;
                                root.refresh-devices(); input-menu.show();
                            }
                        }
                        if root.voice-active: DeviceToggle {
                            icon: root.deafened ? @image-url("icons/headphone-off.svg") : @image-url("icons/headphones.svg");
                            label: root.deafened ? "Undeafen" : "Deafen"; alert: root.deafened;
                            menu-label: "Output options"; open: root.output-open;
                            enabled: root.voice-ready;
                            clicked => { root.toggle-deafen(); }
                            menu => {
                                root.menu-x = self.absolute-position.x; root.menu-y = self.absolute-position.y + (self.height - 32px) / 2;
                                root.refresh-devices(); output-menu.show();
                            }
                        }
                        if !root.preview && !root.online: IconButton {
                            icon: @image-url("icons/refresh-cw.svg"); label: "Reconnect"; enabled: !root.busy;
                            clicked => { root.retry-sync(); }
                        }
                        IconButton {
                            icon: @image-url("icons/settings.svg"); label: "Settings";
                            clicked => { root.settings-open = true; root.refresh-devices(); }
                        }
                    }
                }
            }
        }
        // Conversation.
        Rectangle {
            background: Theme.chat;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px;
                        if root.room-direct: Middle {
                            Rectangle {
                                width: 26px; height: 26px;
                                Avatar { size: 26px; initial: root.room-initial; tint: root.room-tint; picture: root.room-picture; }
                                if root.room-presence != "": StatusDot {
                                    x: 14px; y: 14px; width: 14px; height: 14px; presence: root.room-presence; ring: Theme.chat;
                                }
                            }
                        }
                        if !root.room-direct && root.room-selected: Image { source: root.room-icon; width: 22px; image-fit: contain; colorize: Theme.muted; }
                        if root.requests-open: Image { source: @image-url("icons/inbox.svg"); width: 22px; image-fit: contain; colorize: Theme.muted; }
                        if root.friends-open: Image { source: @image-url("icons/users.svg"); width: 22px; image-fit: contain; colorize: Theme.muted; }
                        Text {
                            text: root.room-selected ? root.room-name : root.requests-open ? "Requests" : root.friends-open ? "Friends" : root.sidebar-title;
                            color: root.room-selected || root.requests-open || root.friends-open ? Theme.text : Theme.secondary;
                            font-size: 16px; font-weight: 700; overflow: elide; vertical-alignment: center;
                            // The name gives way to what follows it, and fills the bar when nothing does.
                            horizontal-stretch: (root.room-activity != "" && root.room-direct) || root.friends-open ? 0 : 1;
                        }
                        // What they're up to, as a bubble beside their name.
                        if root.room-direct && root.room-activity != "": Middle {
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 24px; border-radius: 12px; background: Theme.raised;
                                    accessible-role: text; accessible-label: "Status: " + root.room-activity;
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 10px;
                                        Text {
                                            text: root.room-activity; color: Theme.secondary; font-size: 13px; font-weight: 500;
                                            overflow: elide; vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        if root.friends-open: Middle { Rectangle { width: 1px; height: 24px; background: Theme.line; } }
                        if root.friends-open: Middle {
                            HeaderTab { text: "Online"; selected: !root.friends-all; clicked => { root.friends-all = false; } }
                        }
                        if root.friends-open: Middle {
                            HeaderTab { text: "All"; selected: root.friends-all; clicked => { root.friends-all = true; } }
                        }
                        if root.friends-open: Middle {
                            ActionButton { text: "Add Friend"; small: true; primary: true; clicked => { root.open-add-friend(); } }
                        }
                        if root.friends-open: Rectangle { horizontal-stretch: 1; }
                        if root.dm-friend == 1 || root.dm-friend == 3: Middle {
                            IconButton {
                                icon: @image-url("icons/user-plus.svg");
                                label: root.dm-friend == 1 ? "Send friend request" : "Accept friend request";
                                size: 32px; glyph: 20px; emphasis: root.dm-friend == 3; tip-side: 2;
                                clicked => { root.befriend(root.dm-person); }
                            }
                        }
                        if root.can-call: Middle {
                            IconButton {
                                icon: @image-url("icons/phone.svg"); label: root.call-going ? "Join the call" : "Start a call";
                                size: 32px; glyph: 20px; enabled: root.can-join; tip-side: 2;
                                clicked => { root.start-call(); }
                            }
                        }
                        if root.members-available: Middle {
                            HeaderToggle {
                                icon: @image-url("icons/users.svg"); text: root.members; open: root.member-list;
                                label: root.member-list ? "Hide member list" : "Show member list";
                                clicked => { root.toggle-members(); }
                            }
                        }
                        if root.profile-available: Middle {
                            IconButton {
                                icon: @image-url("icons/user.svg"); label: root.profile-panel ? "Hide profile" : "Show profile";
                                size: 32px; glyph: 20px; tip-side: 2;
                                clicked => { root.toggle-profile-panel(); }
                            }
                        }
                        if !root.members-available && !root.profile-available && root.members != "": HorizontalLayout {
                            spacing: 6px;
                            Image { source: @image-url("icons/users.svg"); width: 18px; image-fit: contain; colorize: Theme.muted; }
                            Text { text: root.members; color: Theme.muted; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
                }
                HorizontalLayout {
                    spacing: 0px;
                    VerticalLayout {
                        spacing: 0px; horizontal-stretch: 1;
                        if root.preview: Rectangle {
                            min-height: preview-content.preferred-height; background: Theme.raised; vertical-stretch: 0;
                            preview-content := HorizontalLayout {
                                padding-left: 16px; padding-right: 16px; padding-top: 7px; padding-bottom: 7px; spacing: 10px;
                                Image { source: @image-url("icons/triangle-alert.svg"); width: 16px; image-fit: contain; colorize: Theme.accent; }
                                Text {
                                    text: "Local preview: sample data. Nothing leaves this computer.";
                                    color: Theme.secondary; font-size: 14px; font-weight: 500; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1;
                                }
                            }
                        }
                        if !root.preview && !root.trusted: Rectangle {
                            min-height: trust-content.preferred-height; background: Theme.raised; vertical-stretch: 0;
                            trust-content := HorizontalLayout {
                                padding: 16px; spacing: 14px;
                                Rectangle {
                                    width: 36px; height: 36px; border-radius: 18px; background: Theme.accent-soft;
                                    Image { source: @image-url("icons/lock.svg"); width: 18px; height: 18px; colorize: Theme.accent; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    Text { text: "Verify this device to send messages"; color: Theme.text; font-weight: 700; }
                                    Label { text: "Use your Matrix recovery key, or verify Talk in another client and check again."; color: Theme.secondary; font-size: 14px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        TextField { text <=> root.recovery; password: true; placeholder: "Recovery key"; label: "Matrix recovery key"; enabled: !root.busy; min-height: 36px; accepted => { root.recover(); } }
                                        ActionButton { text: "Recover"; primary: true; enabled: !root.busy; clicked => { root.recover(); } }
                                        ActionButton { text: "Check again"; enabled: !root.busy; clicked => { root.refresh-trust(); } }
                                    }
                                }
                            }
                        }
                        if root.graphics-notice != "": Banner { text <=> root.graphics-notice; dismissed => { root.graphics-notice = ""; } }
                        if root.notice != "": Banner { text: root.notice; dismissed => { root.dismiss-notice(); } }
                        // Voice channel: a stage of participants, or an invitation to join.
                        // A DM's call shows the same above its messages.
                        if root.voice-room || root.call-shown: Rectangle {
                            // Above a DM's messages, a call takes less than half the room,
                            // more while watching a stream, and little while offering to join.
                            vertical-stretch: root.voice-room ? 1 : !root.voice-here ? 0 : root.watching ? 1.8 : 0.8;
                            min-height: root.voice-room ? 0px : root.voice-here ? 260px : 210px;
                            max-height: root.voice-room || root.voice-here ? 100000px : 210px;
                            background: Theme.stage;
                            if !root.voice-here && !root.voice-room: VerticalLayout {
                                padding: 20px; spacing: 12px; alignment: center;
                                HorizontalLayout {
                                    alignment: center; spacing: 8px;
                                    for person in root.call-people: Avatar {
                                        size: 56px; initial: person.initial; tint: person.tint; picture: person.picture;
                                        accessible-role: image; accessible-label: person.name;
                                    }
                                }
                                Text { text: root.call-note; color: Theme.secondary; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
                                HorizontalLayout {
                                    alignment: center; spacing: 16px;
                                    if root.call-incoming: CallButton {
                                        icon: @image-url("icons/phone-off.svg"); label: "Decline"; fill: Theme.danger;
                                        clicked => { root.answer-call(root.call-room, false); }
                                    }
                                    CallButton {
                                        icon: @image-url("icons/phone.svg"); label: root.call-incoming ? "Accept" : "Join the call";
                                        fill: Theme.live; enabled: root.can-join;
                                        clicked => { root.answer-call(root.call-room, true); }
                                    }
                                }
                            }
                            if !root.voice-room: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.edge; }
                            if !root.voice-here && root.voice-room: VerticalLayout {
                                padding: 32px; spacing: 14px; alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
                                        Image { source: @image-url("icons/volume-2.svg"); width: 38px; height: 38px; colorize: Theme.secondary; }
                                    }
                                }
                                Text { text: root.room-name; color: Theme.text; font-size: 26px; font-weight: 900; horizontal-alignment: center; overflow: elide; }
                                Text { text: root.voice-description; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
                                if !root.preview && !root.room-encrypted: Text { text: "This channel is unencrypted. Talk only joins encrypted voice channels."; color: Theme.accent; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
                                HorizontalLayout {
                                    alignment: center; padding-top: 6px;
                                    ActionButton { min-height: 42px; text: root.voice-active ? "Switch voice channel" : "Join voice"; primary: true; enabled: root.can-join; clicked => { root.join-voice(); } }
                                }
                            }
                            if root.voice-here: VerticalLayout {
                                spacing: 0px;
                                HorizontalLayout {
                                    padding: 16px; padding-bottom: 0px;
                                    Text { text: root.voice-description; color: Theme.muted; font-size: 14px; wrap: word-wrap; horizontal-alignment: center; }
                                }
                                if root.watching: Rectangle {
                                    vertical-stretch: 1;
                                    Rectangle {
                                        x: 16px; y: 12px; width: parent.width - 32px; height: parent.height - 12px;
                                        border-radius: 12px; background: #000000; clip: true;
                                        accessible-role: image; accessible-label: root.watch-title;
                                        Image { width: parent.width; height: parent.height; source: root.watch-frame; image-fit: contain; }
                                        if root.watch-frame.width == 0: Text {
                                            width: parent.width; height: parent.height;
                                            text: root.watch-status; color: Theme.secondary; font-size: 15px;
                                            horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap;
                                        }
                                        Rectangle {
                                            x: 12px; y: 12px; height: 28px;
                                            width: min(parent.width - 72px, watch-chip.preferred-width);
                                            border-radius: 6px; background: #000000a6;
                                            watch-chip := HorizontalLayout {
                                                padding-left: 10px; padding-right: 10px; spacing: 8px;
                                                Text { text: root.watch-title; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                Middle { LivePill { } }
                                            }
                                        }
                                        IconButton {
                                            x: parent.width - self.width - 10px; y: 10px; height: self.size;
                                            icon: @image-url("icons/x.svg"); label: "Stop watching"; tint: #ffffff;
                                            fill: #000000a6; radius: 16px;
                                            clicked => { root.stop-watching(); }
                                        }
                                    }
                                }
                                if !root.watching: stage := Flickable {
                                    vertical-stretch: 1;
                                    property <length> gap: 12px;
                                    property <length> inset: 24px;
                                    property <length> span: self.width - 2 * self.inset;
                                    // Your shared screen leads the grid.
                                    property <int> extra: root.sharing ? 1 : 0;
                                    property <int> count: root.participants.length + self.extra;
                                    property <int> columns: max(1, min(self.count, floor((self.span + self.gap) / (240px + self.gap))));
                                    property <length> tile-width: min(420px, (self.span - (self.columns - 1) * self.gap) / self.columns);
                                    property <length> tile-height: self.tile-width * 0.5625;
                                    property <int> rows: ceil(self.count / self.columns);
                                    property <length> grid-height: self.rows * self.tile-height + max(0, self.rows - 1) * self.gap;
                                    property <length> grid-width: self.columns * self.tile-width + (self.columns - 1) * self.gap;
                                    content-height: max(self.height, self.grid-height + 2 * self.inset);
                                    if root.sharing: Rectangle {
                                        x: (stage.width - stage.grid-width) / 2;
                                        y: max(stage.inset, (stage.height - stage.grid-height) / 2);
                                        width: stage.tile-width; height: stage.tile-height;
                                        border-radius: 12px; background: #000000; clip: true;
                                        accessible-role: text;
                                        accessible-label: "Your screen, " + root.share-status;
                                        Image { width: parent.width; height: parent.height; source: root.share-frame; image-fit: contain; }
                                        if root.share-frame.width == 0: VerticalLayout {
                                            alignment: center; spacing: 10px;
                                            Image { height: 34px; source: @image-url("icons/screen-share.svg"); image-fit: contain; colorize: Theme.secondary; }
                                            Text { text: root.share-status; color: Theme.secondary; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; }
                                        }
                                        Rectangle {
                                            x: 10px; y: parent.height - self.height - 10px;
                                            width: min(parent.width - 20px, share-chip.preferred-width); height: 26px;
                                            border-radius: 6px; background: #000000a6;
                                            share-chip := HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                                Text { text: "Your screen"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                if root.share-live: Middle { LivePill { } }
                                                if !root.share-live && root.share-frame.width > 0: Text {
                                                    text: root.share-status; color: Theme.accent; font-size: 13px; vertical-alignment: center; overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                    for person[position] in root.participants: Rectangle {
                                        property <int> index: position + stage.extra;
                                        x: (stage.width - stage.grid-width) / 2 + mod(self.index, stage.columns) * (stage.tile-width + stage.gap);
                                        y: max(stage.inset, (stage.height - stage.grid-height) / 2) + floor(self.index / stage.columns) * (stage.tile-height + stage.gap);
                                        width: stage.tile-width; height: stage.tile-height;
                                        border-radius: 12px; background: Theme.raised;
                                        border-width: person.speaking ? 3px : 0px; border-color: Theme.live;
                                        accessible-role: text;
                                        accessible-label: person.name + ", " + person.status;
                                        Avatar {
                                            size: min(80px, parent.height * 0.45); initial: person.initial; tint: person.tint; picture: person.picture;
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 - 8px;
                                            opacity: person.connected ? 1 : 0.5;
                                        }
                                        // A click watches someone's stream; a right click sets their volumes.
                                        TouchArea {
                                            mouse-cursor: person.live && !person.local ? MouseCursor.pointer : MouseCursor.default;
                                            clicked => { if person.live && !person.local { root.watch-stream(person.id); } }
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                                    root.open-volume(person, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                        }
                                        if person.live && !person.local: Rectangle {
                                            x: parent.width - self.width - 10px; y: 10px; height: 26px;
                                            width: watch-label.preferred-width + 20px; border-radius: 13px;
                                            background: Theme.danger;
                                            accessible-role: button; accessible-label: "Watch " + person.name + "'s stream";
                                            accessible-action-default => { root.watch-stream(person.id); }
                                            watch-label := Text { text: "Watch stream"; color: #ffffff; font-size: 13px; font-weight: 700; }
                                        }
                                        Rectangle {
                                            x: 10px; y: parent.height - self.height - 10px;
                                            width: min(parent.width - 20px, chip.preferred-width); height: 26px;
                                            border-radius: 6px; background: #000000a6;
                                            chip := HorizontalLayout {
                                                padding-left: 8px; padding-right: 8px; spacing: 6px;
                                                if person.muted && !person.deafened: Image { source: @image-url("icons/mic-off.svg"); width: 14px; image-fit: contain; colorize: Theme.danger; }
                                                if person.deafened: Image { source: @image-url("icons/headphone-off.svg"); width: 14px; image-fit: contain; colorize: Theme.danger; }
                                                Text { text: person.name; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                if person.live: Middle { LivePill { } }
                                                if person.status != "Muted" && person.status != "Deafened" && person.status != "Speaking" && person.status != "Listening": Text {
                                                    text: person.status; color: Theme.accent; font-size: 13px; vertical-alignment: center; overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: center; spacing: 12px; padding: 16px; padding-top: 8px;
                                    IconButton {
                                        size: 52px; glyph: 22px; radius: 26px;
                                        icon: root.muted ? @image-url("icons/mic-off.svg") : @image-url("icons/mic.svg");
                                        label: root.muted ? "Unmute" : "Mute"; alert: root.muted; tint: Theme.text;
                                        enabled: root.voice-ready;
                                        fill: self.alert ? Theme.danger.with-alpha(0.18) : Theme.raised;
                                        clicked => { root.toggle-mute(); }
                                    }
                                    IconButton {
                                        size: 52px; glyph: 22px; radius: 26px;
                                        icon: root.deafened ? @image-url("icons/headphone-off.svg") : @image-url("icons/headphones.svg");
                                        label: root.deafened ? "Undeafen" : "Deafen"; alert: root.deafened; tint: Theme.text;
                                        enabled: root.voice-ready;
                                        fill: self.alert ? Theme.danger.with-alpha(0.18) : Theme.raised;
                                        clicked => { root.toggle-deafen(); }
                                    }
                                    if root.can-share || root.sharing: IconButton {
                                        size: 52px; glyph: 22px; radius: 26px;
                                        icon: root.sharing ? @image-url("icons/screen-share-off.svg") : @image-url("icons/screen-share.svg");
                                        label: root.sharing ? "Stop sharing" : "Share your screen"; tint: Theme.text;
                                        enabled: root.voice-ready;
                                        fill: root.sharing ? Theme.live.with-alpha(0.22) : Theme.raised;
                                        clicked => {
                                            if root.sharing {
                                                root.toggle-share();
                                            } else {
                                                root.open-share-menu(self.absolute-position.x, self.absolute-position.y);
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 76px; height: 52px; border-radius: 26px;
                                        background: leave-touch.has-hover ? Theme.danger-hover : Theme.danger;
                                        opacity: root.voice-leaving ? 0.5 : 1;
                                        accessible-role: button; accessible-label: "Leave voice"; accessible-enabled: !root.voice-leaving;
                                        accessible-action-default => { if !root.voice-leaving { root.leave-voice(); } }
                                        Image { source: @image-url("icons/phone-off.svg"); width: 22px; height: 22px; colorize: #ffffff; }
                                        leave-touch := TouchArea { enabled: !root.voice-leaving; mouse-cursor: MouseCursor.pointer; clicked => { root.leave-voice(); } }
                                    }
                                }
                            }
                        }
                        // Text conversation.
                        Rectangle {
                            visible: !root.voice-room;
                            min-height: 0px;
                            max-height: root.voice-room ? 0px : 100000px;
                            vertical-stretch: root.voice-room ? 0 : 1;
                            // Up and Down step through messages; R replies, E edits, Delete deletes,
                            // C copies, F forwards, + reacts, Enter opens the menu, Escape returns
                            // to the composer.
                            timeline-keys := FocusScope {
                                width: parent.width; height: parent.height;
                                focus-on-click: false;
                                accessible-role: list;
                                accessible-label: "Messages";
                                key-pressed(event) => {
                                    if root.messages.length == 0 { return reject; }
                                    if root.confirm-delete != "" && root.confirm-delete == root.active-item {
                                        if event.text == Key.Return { root.confirm-delete-message(); return accept; }
                                        if event.text == Key.Escape { root.cancel-delete(); return accept; }
                                    }
                                    if event.text == Key.UpArrow { root.step-message(root.active-index < 0 ? root.messages.length - 1 : root.active-index - 1); return accept; }
                                    if event.text == Key.DownArrow { root.step-message(root.active-index < 0 ? root.messages.length - 1 : root.active-index + 1); return accept; }
                                    if event.text == Key.PageUp { root.step-message(root.active-index - 5); return accept; }
                                    if event.text == Key.PageDown { root.step-message(root.active-index + 5); return accept; }
                                    if event.text == Key.Home { root.step-message(0); return accept; }
                                    if event.text == Key.End { root.step-message(root.messages.length - 1); return accept; }
                                    if event.text == Key.Escape { root.focus-composer(); return accept; }
                                    if root.active-index < 0 || root.active-index >= root.messages.length { return reject; }
                                    if root.keyed-message.deleted || root.keyed-message.delivery != "" { return reject; }
                                    if event.text == Key.Return || event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift) {
                                        root.keyboard-popup = "menu"; return accept;
                                    }
                                    if (event.text == "+" || event.text == "=") && root.keyed-message.can-react && root.composer-enabled {
                                        root.keyboard-popup = "react"; return accept;
                                    }
                                    if (event.text == "r" || event.text == "R") && root.keyed-message.can-reply && root.composer-enabled {
                                        root.reply(root.keyed-message.item); root.focus-composer(); return accept;
                                    }
                                    if (event.text == "e" || event.text == "E") && root.keyed-message.own && root.keyed-message.can-edit && root.composer-enabled {
                                        root.edit(root.keyed-message.item); root.focus-composer(); return accept;
                                    }
                                    if (event.text == Key.Delete || event.text == Key.Backspace) && root.keyed-message.can-delete && root.composer-enabled {
                                        root.request-delete(root.keyed-message.item); return accept;
                                    }
                                    if (event.text == "c" || event.text == "C") && root.keyed-message.body != "" {
                                        root.copy-text(root.keyed-message.body); return accept;
                                    }
                                    if (event.text == "f" || event.text == "F") && root.keyed-message.can-forward && (root.trusted || root.preview) {
                                        root.start-forward(root.keyed-message.item); return accept;
                                    }
                                    return reject;
                                }
                                timeline := ListView {
                                    width: parent.width; height: parent.height;
                                    scrolled => { root.follow-latest = false; }
                                    for message[index] in root.messages: Rectangle {
                                        property <bool> lit: root.active-item == message.item;
                                        property <bool> jumped: root.jump-item != "" && root.jump-item == message.item;
                                        property <int> jump-tick: root.jump-tick;
                                        changed jump-tick => {
                                            if self.jumped {
                                                timeline.content-y = max(min(0px, timeline.height - timeline.content-height), min(0px, timeline.height / 3 - self.y));
                                            }
                                        }
                                        // The keyboard's message stays in view, with room for the next one,
                                        // so stepping on finds it built.
                                        changed lit => {
                                            if self.lit && root.browsing {
                                                root.active-index = index;
                                                if self.y + timeline.content-y < root.keyboard-margin {
                                                    root.follow-latest = false;
                                                    timeline.content-y = min(0px, root.keyboard-margin - self.y);
                                                } else if self.y + self.height + timeline.content-y > timeline.height - root.keyboard-margin {
                                                    timeline.content-y = max(min(0px, timeline.height - timeline.content-height), timeline.height - root.keyboard-margin - self.y - self.height);
                                                }
                                            }
                                        }
                                        property <bool> keyed: self.lit && root.keyboard-popup != "";
                                        changed keyed => {
                                            if self.keyed {
                                                root.anchor(self.absolute-position.x + self.width - 16px, self.absolute-position.y + self.top - 16px, 0px, 32px, false);
                                                if root.keyboard-popup == "menu" { root.open-menu(message); } else { root.open-picker(message.item); }
                                                root.keyboard-popup = "";
                                            }
                                        }
                                        // The space that holds a short history down stays outside the row.
                                        property <length> top: index == 0 ? root.lead : 0px;
                                        height: col.preferred-height + self.top;
                                        Rectangle {
                                            y: parent.top; height: parent.height - parent.top;
                                            background: parent.jumped ? Theme.accent.transparentize(0.86) : parent.lit ? Theme.row-hover : transparent;
                                            animate background { duration: 400ms; }
                                        }
                                        // The keyboard's message has a marigold edge.
                                        if self.lit && root.browsing: Rectangle { x: 0px; y: parent.top; width: 3px; height: parent.height - parent.top; background: Theme.accent; }
                                        // The pointer area wraps the row, so hovering selectable text still counts.
                                        // The last hovered or clicked message keeps its actions: the list takes
                                        // the pointer when a press starts, which ends hover, so a hover-only bar
                                        // would vanish before its button saw the click.
                                        row-pointer := TouchArea {
                                            y: parent.top; height: parent.height - parent.top;
                                            changed has-hover => { if self.has-hover { root.active-item = message.item; root.active-index = index; } }
                                            clicked => { root.active-item = message.item; root.active-index = index; }
                                            // A right click opens the same menu as the hover bar's More button.
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                                                    && !message.deleted && message.delivery == "" {
                                                    root.active-item = message.item;
                                                    root.anchor(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, 0px, 0px, true);
                                                    root.open-menu(message);
                                                }
                                            }
                                            col := VerticalLayout {
                                                padding-top: message.day != "" ? 12px : message.first ? 14px : 1px;
                                                padding-bottom: index == root.messages.length - 1 ? 20px : 1px;
                                                spacing: 0px;
                                                // History starts with a way to load more of it.
                                                if index == 0 && !root.preview && root.room-ready: HorizontalLayout {
                                                    alignment: center; padding-top: 4px; padding-bottom: 8px;
                                                    Rectangle {
                                                        width: earlier-content.preferred-width; height: 30px; border-radius: 15px;
                                                        background: earlier-touch.has-hover && !root.loading-history ? Theme.active : Theme.raised;
                                                        accessible-role: button; accessible-label: "Earlier messages"; accessible-enabled: !root.loading-history && !root.busy;
                                                        accessible-action-default => { if !root.loading-history && !root.busy { root.earlier(); } }
                                                        earlier-content := HorizontalLayout {
                                                            padding-left: 12px; padding-right: 14px; spacing: 6px;
                                                            Image { source: @image-url("icons/history.svg"); width: 16px; image-fit: contain; colorize: Theme.secondary; }
                                                            Text { text: root.loading-history ? "Loading..." : "Earlier messages"; color: Theme.secondary; font-size: 14px; font-weight: 500; vertical-alignment: center; }
                                                        }
                                                        earlier-touch := TouchArea { enabled: !root.loading-history && !root.busy; mouse-cursor: MouseCursor.pointer; clicked => { root.earlier(); } }
                                                    }
                                                }
                                                if message.day != "": HorizontalLayout {
                                                    padding-left: 16px; padding-right: 16px; padding-bottom: 6px; spacing: 10px; height: 26px;
                                                    Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.line; } }
                                                    Text { text: message.day; color: Theme.muted; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                                    Rectangle { horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.line; } }
                                                }
                                                HorizontalLayout {
                                                    padding-left: 16px; padding-right: 48px; padding-top: 2px; padding-bottom: 2px; spacing: 16px;
                                                    Rectangle {
                                                        width: 40px;
                                                        min-height: message.first ? (message.has-reply ? 64px : 40px) : 0px;
                                                        if message.has-reply: Rectangle {
                                                            x: 19px; y: 11px; width: 33px; height: 13px; clip: true;
                                                            Rectangle {
                                                                x: 0px; y: 0px; width: parent.width + 12px; height: parent.height + 12px;
                                                                border-width: 2px; border-color: #4a4c56; border-top-left-radius: 6px;
                                                            }
                                                        }
                                                        if message.first: Avatar {
                                                            x: 0px; y: message.has-reply ? 24px : 2px;
                                                            initial: message.initial; tint: message.tint; picture: message.picture;
                                                        }
                                                        if !message.first && root.active-item == message.item: Text {
                                                            x: 0px; y: 4px; width: 40px;
                                                            text: message.short-time; color: Theme.muted; font-size: 12px; font-weight: 500;
                                                            horizontal-alignment: right; overflow: elide;
                                                        }
                                                    }
                                                    VerticalLayout {
                                                        spacing: 3px; horizontal-stretch: 1;
                                                        // Clicking the quote jumps to the message it quotes.
                                                        if message.has-reply: Rectangle {
                                                            height: 22px;
                                                            accessible-role: button;
                                                            accessible-enabled: message.reply-item != "";
                                                            accessible-label: "Jump to the original message: " + message.reply-body;
                                                            accessible-action-default => { if message.reply-item != "" { root.jump-to(message.reply-item); } }
                                                            HorizontalLayout {
                                                                spacing: 6px;
                                                                if message.reply-author != "": Middle { Avatar { size: 16px; initial: message.reply-initial; tint: message.reply-tint; picture: message.reply-picture; } }
                                                                if message.reply-author != "": Text { text: message.reply-author; color: Theme.secondary; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                                Text {
                                                                    text: message.reply-body; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                                                                    color: reply-touch.has-hover ? Theme.text : Theme.muted;
                                                                }
                                                            }
                                                            reply-touch := TouchArea {
                                                                enabled: message.reply-item != "";
                                                                mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                                                                clicked => { root.jump-to(message.reply-item); }
                                                            }
                                                        }
                                                        if message.first: HorizontalLayout {
                                                            spacing: 8px;
                                                            StyledText { text: message.author-styled; link-color: Theme.link; default-color: message.has-color ? message.color : Theme.text; default-font-size: root.message-font-size; max-lines: 1; vertical-alignment: center; }
                                                            StyledText { text: message.time-styled; link-color: Theme.link; default-color: Theme.muted; default-font-size: root.message-font-size - 3px; max-lines: 1; vertical-alignment: center; }
                                                            Rectangle { horizontal-stretch: 1; }
                                                        }
                                                        if message.body != "": StyledText {
                                                            text: message.styled; default-color: message.deleted || message.delivery != "" ? Theme.muted : Theme.text; link-color: Theme.link;
                                                            // Discord's large emoji are 48 pixels where text's are 22.
                                                            default-font-size: message.jumbo ? root.message-font-size * 2.2 : root.message-font-size;
                                                            // A mention's card opens beside the pointer.
                                                            link-clicked(link) => {
                                                                root.anchor(row-pointer.absolute-position.x + row-pointer.mouse-x, row-pointer.absolute-position.y + row-pointer.mouse-y, 0px, 0px, true);
                                                                root.open-link(link);
                                                            }
                                                            accessible-role: text; accessible-label: "Message from " + message.author + ": " + message.body;
                                                        }
                                                        if message.edited && !message.deleted: Text { text: "(edited)"; color: Theme.muted; font-size: 12px; }
                                                        // Fixed-size children sit beside a spacer, so they do not cap the column's width.
                                                        // Clicking an image opens it large.
                                                        if message.images.length > 0: HorizontalLayout {
                                                            padding-top: 4px;
                                                            Rectangle {
                                                                width: message.gallery-width * 1px; height: message.gallery-height * 1px;
                                                                for cell in message.images: Rectangle {
                                                                    x: cell.x * 1px; y: cell.y * 1px; width: cell.width * 1px; height: cell.height * 1px;
                                                                    border-radius: 8px; clip: true; background: Theme.sunken;
                                                                    if cell.loading: Skeleton { width: parent.width; height: parent.height; }
                                                                    if !cell.loading: Picture { still: cell.image; frames: cell.frames; delays: cell.delays; width: parent.width; height: parent.height; image-fit: cover; accessible-role: image; accessible-label: cell.spoiler ? "Spoiler" : cell.name; }
                                                                    if cell.spoiler: SpoilerCover {}
                                                                    TouchArea {
                                                                        mouse-cursor: MouseCursor.pointer;
                                                                        clicked => {
                                                                            if cell.spoiler { root.reveal-attachment(message.item, cell.index); } else { root.view-image(message.item, cell.index); }
                                                                        }
                                                                    }
                                                                    if root.active-item == message.item && !root.preview && message.delivery == "" && !cell.spoiler: Rectangle {
                                                                        x: parent.width - self.width - 8px; y: 8px; width: 32px; height: 32px; border-radius: 6px; background: #000000b3;
                                                                        IconButton {
                                                                            icon: @image-url("icons/download.svg"); label: "Save " + cell.name; tint: Theme.text;
                                                                            clicked => { root.save-attachment(message.item, cell.index); }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            Rectangle { horizontal-stretch: 1; }
                                                        }
                                                        if message.stickers.length > 0: HorizontalLayout {
                                                            padding-top: 4px; spacing: 8px;
                                                            for cell in message.stickers: Rectangle {
                                                                width: cell.width * 1px; height: cell.height * 1px;
                                                                if cell.loading: Skeleton { width: parent.width; height: parent.height; border-radius: 12px; }
                                                                if !cell.loading: Picture {
                                                                    still: cell.image; frames: cell.frames; delays: cell.delays;
                                                                    width: parent.width; height: parent.height; image-fit: contain;
                                                                    accessible-role: image; accessible-label: "Sticker: " + cell.name;
                                                                }
                                                            }
                                                            Rectangle { horizontal-stretch: 1; }
                                                        }
                                                        for file in message.files: HorizontalLayout {
                                                            padding-top: 4px;
                                                            Rectangle {
                                                                min-height: file-card.preferred-height; max-width: 432px; horizontal-stretch: 100;
                                                                background: Theme.sidebar; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                                                                file-card := HorizontalLayout {
                                                                    padding: 12px; padding-right: 8px; spacing: 12px;
                                                                    Image { source: @image-url("icons/file.svg"); width: 30px; image-fit: contain; colorize: Theme.accent; }
                                                                    VerticalLayout {
                                                                        alignment: center; horizontal-stretch: 1;
                                                                        Text { text: file.name; color: Theme.text; font-weight: 500; overflow: elide; }
                                                                        if file.detail != "": Label { text: file.detail; }
                                                                    }
                                                                    IconButton {
                                                                        icon: @image-url("icons/download.svg"); label: "Save " + file.name;
                                                                        enabled: !root.preview && message.delivery == "";
                                                                        clicked => { root.save-attachment(message.item, file.index); }
                                                                    }
                                                                }
                                                            }
                                                            Rectangle { horizontal-stretch: 1; }
                                                        }
                                                        if message.hidden-card != "": Text {
                                                            text: message.hidden-card; color: Theme.muted; font-size: root.message-font-size * 0.875; font-italic: true; wrap: word-wrap;
                                                        }
                                                        // Link previews and bot cards, behind a bar of their colour.
                                                        for embed in message.embeds: HorizontalLayout {
                                                            padding-top: 4px;
                                                            Rectangle {
                                                                min-height: embed-body.preferred-height; max-width: 432px; horizontal-stretch: 100;
                                                                background: Theme.sidebar; border-radius: 4px; clip: true;
                                                                Rectangle { x: 0px; width: 4px; background: embed.has-color ? embed.color : Theme.edge; }
                                                                embed-body := HorizontalLayout {
                                                                    padding: 12px; padding-left: 16px; padding-right: 16px; spacing: 16px;
                                                                    VerticalLayout {
                                                                        spacing: 8px; horizontal-stretch: 1; alignment: start;
                                                                        if embed.has-provider: StyledText { text: embed.provider; link-color: Theme.link; default-color: Theme.muted; default-font-size: 12px; max-lines: 1; }
                                                                        if embed.has-author: StyledText { text: embed.author; link-color: Theme.link; default-color: Theme.text; default-font-size: 14px; }
                                                                        if embed.has-title: StyledText {
                                                                            text: embed.title; default-color: Theme.text; link-color: Theme.link; default-font-size: 16px;
                                                                            link-clicked(link) => { root.open-link(link); }
                                                                        }
                                                                        if embed.has-description: StyledText {
                                                                            text: embed.description; default-color: Theme.secondary; link-color: Theme.link; default-font-size: 14px;
                                                                            link-clicked(link) => { root.open-link(link); }
                                                                        }
                                                                        for row in embed.field-rows: HorizontalLayout {
                                                                            spacing: 8px;
                                                                            for field in row.fields: VerticalLayout {
                                                                                spacing: 2px; horizontal-stretch: 1;
                                                                                StyledText { text: field.name; link-color: Theme.link; default-color: Theme.text; default-font-size: 14px; }
                                                                                StyledText {
                                                                                    text: field.value; default-color: Theme.secondary; link-color: Theme.link; default-font-size: 14px;
                                                                                    link-clicked(link) => { root.open-link(link); }
                                                                                }
                                                                            }
                                                                        }
                                                                        // A video's poster opens the video; other pictures open in the viewer.
                                                                        if embed.images.length > 0: HorizontalLayout {
                                                                            Rectangle {
                                                                                width: embed.gallery-width * 1px; height: embed.gallery-height * 1px;
                                                                                for cell in embed.images: Rectangle {
                                                                                    x: cell.x * 1px; y: cell.y * 1px; width: cell.width * 1px; height: cell.height * 1px;
                                                                                    border-radius: 4px; clip: true; background: Theme.sunken;
                                                                                    if cell.loading: Skeleton { width: parent.width; height: parent.height; }
                                                                                    if !cell.loading: Picture { still: cell.image; frames: cell.frames; delays: cell.delays; width: parent.width; height: parent.height; image-fit: cover; accessible-role: image; accessible-label: cell.spoiler ? "Spoiler" : cell.name; }
                                                                                    if cell.spoiler: SpoilerCover {}
                                                                                    if embed.video && !cell.spoiler: Rectangle {
                                                                                        width: 48px; height: 48px; border-radius: 24px; background: #000000b3;
                                                                                        Path {
                                                                                            width: 18px; height: 20px; x: 17px; y: 14px;
                                                                                            commands: "M 0 0 L 18 10 L 0 20 Z"; fill: #ffffff;
                                                                                        }
                                                                                    }
                                                                                    TouchArea {
                                                                                        mouse-cursor: MouseCursor.pointer;
                                                                                        clicked => {
                                                                                            if cell.spoiler { root.reveal-attachment(message.item, cell.index); }
                                                                                            else if embed.video { root.open-link(embed.url); } else { root.view-image(message.item, cell.index); }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                            Rectangle { horizontal-stretch: 1; }
                                                                        }
                                                                        if embed.has-footer: StyledText { text: embed.footer; link-color: Theme.link; default-color: Theme.muted; default-font-size: 12px; }
                                                                    }
                                                                    if embed.has-thumbnail: VerticalLayout {
                                                                        alignment: start;
                                                                        Rectangle {
                                                                            width: 80px; height: 80px; border-radius: 4px; clip: true;
                                                                            if embed.thumbnail-loading: Skeleton { width: parent.width; height: parent.height; }
                                                                            Image { source: embed.thumbnail; width: parent.width; height: parent.height; image-fit: contain; accessible-role: image; accessible-label: "Thumbnail"; }
                                                                            TouchArea {
                                                                                mouse-cursor: MouseCursor.pointer;
                                                                                clicked => { root.view-image(message.item, embed.thumbnail-index); }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            Rectangle { horizontal-stretch: 1; }
                                                        }
                                                        if message.reactions.length > 0: HorizontalLayout {
                                                            spacing: 6px; alignment: start; padding-top: 4px;
                                                            for reaction in message.reactions: ReactionToggle {
                                                                key: reaction.key; label: reaction.label; count: reaction.count; mine: reaction.mine; emoji-font: root.emoji-font;
                                                                enabled: message.can-react && root.composer-enabled;
                                                                clicked => { root.react(message.item, reaction.key); }
                                                            }
                                                        }
                                                        if message.delivery != "": HorizontalLayout {
                                                            spacing: 4px; alignment: start;
                                                            Text { text: message.delivery; color: message.delivery-failed ? Theme.danger : Theme.muted; font-size: 13px; vertical-alignment: center; wrap: word-wrap; }
                                                            if message.can-retry: ActionButton { text: "Retry"; ghost: true; small: true; clicked => { root.retry(message.item); } }
                                                            if message.can-cancel: ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { root.cancel-send(message.item); } }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // Actions, the reaction picker and delete confirmation float over the
                                        // row's top edge, so opening them never moves the timeline.
                                        if (self.lit || root.react-item == message.item || root.menu-item == message.item || root.confirm-delete == message.item) && !message.deleted && message.delivery == "": Rectangle {
                                            x: parent.width - self.width - 16px; y: parent.top + (index == 0 ? 4px : -16px);
                                            width: actions.preferred-width; height: actions.preferred-height;
                                            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
                                            drop-shadow-blur: 10px; drop-shadow-color: #00000059; drop-shadow-offset-y: 2px;
                                            actions := HorizontalLayout {
                                                padding: 3px; spacing: 0px;
                                                if root.confirm-delete == message.item: HorizontalLayout {
                                                    spacing: 4px; padding-left: 8px;
                                                    Text { text: "Delete for everyone?"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                                    ActionButton { text: "Delete"; danger: true; small: true; clicked => { root.confirm-delete-message(); } }
                                                    ActionButton { text: "Cancel"; ghost: true; small: true; clicked => { root.cancel-delete(); } }
                                                }
                                                // Frequent reactions, then the picker, Edit on your own message or
                                                // Reply on someone else's, and everything else under More.
                                                if root.confirm-delete != message.item: HorizontalLayout {
                                                    spacing: 0px;
                                                    if message.can-react && root.composer-enabled: HorizontalLayout {
                                                        spacing: 0px;
                                                        for cell in root.bar-reactions: EmojiButton {
                                                            emoji: cell; font: root.emoji-font;
                                                            clicked => { root.react(message.item, cell.key); }
                                                        }
                                                        Rectangle {
                                                            width: 9px;
                                                            Rectangle { width: 1px; height: 20px; background: Theme.line; }
                                                        }
                                                        IconButton {
                                                            icon: @image-url("icons/smile-plus.svg"); label: "Add reaction";
                                                            clicked => {
                                                                root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                                root.open-picker(message.item);
                                                            }
                                                        }
                                                    }
                                                    if message.own && message.can-edit && root.composer-enabled: IconButton { icon: @image-url("icons/pencil.svg"); label: "Edit"; clicked => { root.edit(message.item); root.focus-composer(); } }
                                                    if !(message.own && message.can-edit) && message.can-reply && root.composer-enabled: IconButton { icon: @image-url("icons/reply.svg"); label: "Reply"; clicked => { root.reply(message.item); root.focus-composer(); } }
                                                    IconButton {
                                                        icon: @image-url("icons/ellipsis.svg"); label: "More";
                                                        clicked => {
                                                            root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, false);
                                                            root.open-menu(message);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.requests-open: RequestsScreen {
                                width: parent.width; height: parent.height;
                                friend-requests: root.friend-requests;
                                message-requests: root.message-requests;
                                spam: root.spam-rooms;
                                accept(id) => { root.befriend(id); }
                                remove(id) => { root.remove-friend-request(id); }
                                open(id) => { root.select-room(id); }
                            }
                            if root.friends-open: FriendsScreen {
                                width: parent.width; height: parent.height;
                                rows: root.friends-all ? root.friends : root.friends-online;
                                all: root.friends-all; total: root.friend-count;
                                filter <=> root.friend-filter;
                                filter-edited => { root.friend-filter-edited(); }
                                message(id) => { root.message-friend(id); }
                                add-friend => { root.open-add-friend(); }
                            }
                            // The conversation's opening, or what to do when none is chosen.
                            if !root.room-selected && !root.requests-open && !root.friends-open: VerticalLayout {
                                width: parent.width; height: parent.height;
                                padding: 32px; spacing: 10px; alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 80px; height: 80px; border-radius: 40px; background: Theme.raised;
                                        Image { source: @image-url("icons/message-circle.svg"); width: 36px; height: 36px; colorize: Theme.secondary; }
                                    }
                                }
                                Text { text: "Pick a conversation"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                                Text { text: "Choose a DM or a server channel on the left."; color: Theme.secondary; horizontal-alignment: center; wrap: word-wrap; }
                            }
                            if root.room-selected && root.messages.length == 0 && !root.room-ready: MessagesSkeleton {
                                width: parent.width; height: parent.height;
                            }
                            if root.room-selected && root.messages.length == 0 && root.room-ready: VerticalLayout {
                                width: parent.width; height: parent.height;
                                padding: 24px; spacing: 8px; alignment: end;
                                if root.room-selected && root.room-ready && root.room-direct: Avatar { size: 72px; initial: root.room-initial; tint: root.room-tint; picture: root.room-picture; }
                                if root.room-selected && root.room-ready && !root.room-direct: Rectangle {
                                    width: 68px; height: 68px; border-radius: 34px; background: Theme.raised;
                                    Image { source: root.room-icon; width: 36px; height: 36px; colorize: Theme.text; }
                                }
                                Text {
                                    text: !root.room-ready ? "Loading conversation..." : root.room-direct ? root.room-name : "Welcome to #" + root.room-name;
                                    color: Theme.text; font-size: root.room-ready ? 28px : 18px; font-weight: 900; wrap: word-wrap;
                                }
                                if root.room-ready: Text {
                                    text: root.room-direct ? "This is the beginning of your messages with " + root.room-name + "."
                                        : "This is the start of #" + root.room-name + ". No messages here yet.";
                                    color: Theme.secondary; wrap: word-wrap;
                                }
                            }
                            // Who else is typing, just above the composer in the room the
                            // last message leaves under it, so the timeline doesn't move.
                            // Its text lines up with the messages' (16px, a 40px avatar
                            // and 16px in), and it breathes gently while they type.
                            if root.typing != "" && root.room-selected && !root.voice-room: Rectangle {
                                x: 72px - 4px; y: parent.height - self.height;
                                width: min(parent.width - 72px - 12px, typing-text.preferred-width + 8px); height: 20px;
                                background: Theme.chat;
                                typing-text := Text {
                                    x: 4px; width: parent.width - 8px;
                                    text: root.typing; color: Theme.text; font-size: 13px; font-weight: 500;
                                    vertical-alignment: center; overflow: elide;
                                    opacity: 0.75 + 0.25 * sin(animation-tick() / 1ms * 0.25deg);
                                }
                            }
                        }
                        // Composer.
                        VerticalLayout {
                            visible: !root.voice-room && root.room-selected;
                            min-height: 0px;
                            max-height: root.voice-room || !root.room-selected ? 0px : 100000px;
                            padding-left: 16px; padding-right: 16px; padding-top: 0px; padding-bottom: 0px;
                            spacing: 0px; vertical-stretch: 0;
                            if root.room-request: Rectangle {
                                background: Theme.field; border-radius: 10px;
                                HorizontalLayout {
                                    padding: 12px; padding-left: 16px; spacing: 10px;
                                    VerticalLayout {
                                        alignment: center; spacing: 2px; horizontal-stretch: 1;
                                        // One line each: a wrapped line would spill over the hint below.
                                        Text { text: root.request-title; color: Theme.text; font-size: 15px; font-weight: 700; overflow: elide; }
                                        Text { text: "Accept to reply. Ignoring removes it without telling them."; color: Theme.secondary; font-size: 14px; overflow: elide; }
                                    }
                                    Middle { ActionButton { text: "Ignore"; label: "Ignore the message request"; clicked => { root.ignore-request(); } } }
                                    Middle { ActionButton { text: "Accept"; label: "Accept the message request"; primary: true; clicked => { root.accept-request(); } } }
                                }
                            }
                            if root.compose-label != "": Rectangle {
                                height: 36px; background: Theme.sidebar;
                                border-top-left-radius: 10px; border-top-right-radius: 10px;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 4px; spacing: 8px;
                                    Image { source: root.is-editing ? @image-url("icons/pencil.svg") : @image-url("icons/reply.svg"); width: 16px; image-fit: contain; colorize: Theme.muted; }
                                    Text { text: root.compose-label; color: Theme.secondary; font-size: 14px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    IconButton { icon: @image-url("icons/x.svg"); label: root.is-editing ? "Cancel editing" : "Cancel reply"; size: 28px; glyph: 16px; clicked => { root.cancel-compose(); } }
                                }
                            }
                            Rectangle {
                                visible: !root.room-request;
                                min-height: root.room-request ? 0px : 48px; max-height: root.room-request ? 0px : 100000px;
                                background: Theme.field;
                                border-radius: 10px;
                                border-top-left-radius: root.compose-label != "" ? 0px : 10px;
                                border-top-right-radius: root.compose-label != "" ? 0px : 10px;
                                VerticalLayout {
                                    spacing: 0px;
                                    // Files waiting to go with the message, in a row that scrolls sideways.
                                    if root.staged.length > 0: Flickable {
                                        height: 152px;
                                        content-width: max(self.width, staged-row.preferred-width);
                                        staged-row := HorizontalLayout {
                                            padding: 10px; padding-bottom: 2px; spacing: 8px; alignment: start;
                                            for file[index] in root.staged: StagedTile {
                                                file: file;
                                                remove => { root.unstage(index); }
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px; padding-right: 8px; spacing: 6px;
                                        // The buttons stay on the last line as the composer grows.
                                        VerticalLayout {
                                            alignment: end; padding-bottom: 8px;
                                            IconButton {
                                                icon: @image-url("icons/circle-plus.svg"); label: "Attach files";
                                                glyph: 22px;
                                                enabled: root.can-attach; clicked => { root.attach(); }
                                            }
                                        }
                                        composer := Composer {
                                            text <=> root.draft; enabled: root.composer-enabled; label: "Message";
                                            placeholder: root.is-editing ? "Edit your message" : root.compose-label != "" ? "Write a reply" : root.room-selected && !root.room-direct ? "Message #" + root.room-name : root.room-selected ? "Message " + root.room-name : "Write a message";
                                            edited(text) => { root.draft-edited(text); }
                                            accepted => { root.send(); }
                                            suggesting: root.mentions.length > 0;
                                            caret(text, offset) => { root.composer-caret(text, offset); }
                                            suggestion-moved(step) => { root.mention-index = Math.mod(root.mention-index + step + root.mentions.length, root.mentions.length); }
                                            suggestion-chosen => { root.mention-chosen(root.mention-index); }
                                            suggestion-dismissed => { root.mention-dismissed(); }
                                            up-from-empty => { root.edit-last(); }
                                            up-to-messages => { root.browse-messages(); }
                                            paste => { root.paste-into-composer(); }
                                        }
                                        VerticalLayout {
                                            alignment: end; padding-bottom: 8px;
                                            IconButton {
                                                icon: @image-url("icons/send-horizontal.svg");
                                                label: root.sending ? "Sending..." : root.is-editing ? "Save" : "Send";
                                                enabled: root.can-send; emphasis: root.can-send;
                                                clicked => { root.send(); }
                                            }
                                        }
                                    }
                                }
                            }
                            // A hint under the field when there is one; otherwise as much
                            // room below it as beside it.
                            if root.composer-hint != "": HorizontalLayout {
                                height: 22px; spacing: 6px; padding-left: 4px;
                                if root.room-encrypted || root.preview: Image { source: @image-url("icons/lock.svg"); width: 12px; image-fit: contain; colorize: Theme.muted; }
                                Text { text: root.composer-hint; color: Theme.muted; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            }
                            if root.composer-hint == "": Rectangle { height: 16px; }
                        }
                    }
                    if root.members-docked: MemberPanel {
                        width: 240px; rows: root.roster; note: root.roster-note; selected: root.profile-member;
                        open-profile(id, y) => { root.profile-y = y; root.profile-at-pointer = false; root.show-profile(id); }
                    }
                    if root.profile-docked: Rectangle {
                        width: 300px;
                        ProfileCard {
                            docked: true; width: parent.width; height: parent.height;
                            data: root.panel-profile;
                            enlarge => { root.enlarge-panel-profile(); }
                            befriend => { root.befriend(root.panel-profile.id); }
                            open-link(link) => { root.open-link(link); }
                            open-server(server, x, y, width, height) => { root.open-server-card(server, x, y, width, height); }
                            open-friend(id, x, y, width, height) => {
                                root.anchor(x, y, width, height, false);
                                root.profile-at-pointer = true;
                                root.show-friend-profile(id, false);
                            }
                        }
                    }
                }
            }
            // The header casts a soft shadow over the conversation.
            Rectangle {
                y: 48px; height: 6px;
                background: @linear-gradient(180deg, #00000040 0%, #00000000 100%);
            }
        }
    }
    // The edge between sidebar and conversation resizes the sidebar. A double-click
    // restores the default width.
    if root.workspace: TouchArea {
        x: 72px + root.sidebar-shown - 4px; y: 0px; width: 8px; height: root.height;
        mouse-cursor: ew-resize;
        moved => {
            if self.pressed {
                root.sidebar-width = max(180px, min(380px, root.width - 72px - 420px - (root.members-docked ? 240px : 0px) - (root.profile-docked ? 300px : 0px), root.sidebar-shown + self.mouse-x - self.pressed-x));
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.up { root.sidebar-resized(root.sidebar-shown); }
        }
        double-clicked => { root.sidebar-width = 240px; root.sidebar-resized(240px); }
        Rectangle {
            x: 3px; width: 2px;
            background: parent.pressed ? Theme.faint : Theme.line;
            opacity: parent.has-hover || parent.pressed ? 1 : 0;
            animate opacity { duration: 120ms; }
        }
    }

    // Switching voice channels asks first, over everything else. Clicking
    // outside or Escape cancels; Enter switches. The dialog stays in the tree
    // so it can fade out, keeping its text while it goes.
    // A call ringing this account elsewhere, at the top until it's answered or stops.
    if root.incoming-open: Rectangle {
        x: (root.width - self.width) / 2; y: 64px;
        width: 300px; height: incoming-content.preferred-height;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
        drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        accessible-role: groupbox;
        accessible-label: "Incoming call from " + root.incoming-name;
        // Clicks on the card never reach what's under it.
        TouchArea { }
        incoming-content := VerticalLayout {
            padding: 20px; spacing: 10px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 92px; height: 92px;
                    // A ring that pulses while it rings.
                    Rectangle {
                        border-radius: self.width / 2; border-width: 3px; border-color: Theme.live;
                        opacity: 0.45 + 0.4 * sin(animation-tick() / 1ms * 0.36deg);
                    }
                    Avatar {
                        x: 10px; y: 10px; size: 72px;
                        initial: root.incoming-initial; tint: root.incoming-tint; picture: root.incoming-picture;
                    }
                }
            }
            Text { text: root.incoming-name; color: Theme.text; font-size: 18px; font-weight: 700; horizontal-alignment: center; overflow: elide; }
            Text { text: root.incoming-detail; color: Theme.secondary; font-size: 15px; horizontal-alignment: center; wrap: word-wrap; }
            HorizontalLayout {
                alignment: center; spacing: 20px; padding-top: 6px;
                CallButton {
                    icon: @image-url("icons/phone-off.svg"); label: "Decline"; fill: Theme.danger;
                    clicked => { root.answer-call(root.incoming-room, false); }
                }
                CallButton {
                    icon: @image-url("icons/phone.svg"); label: "Accept"; fill: Theme.live;
                    clicked => { root.answer-call(root.incoming-room, true); }
                }
            }
        }
    }

    property <bool> switching: root.switch-prompt != "";
    property <string> switch-text;
    changed switch-prompt => { if root.switch-prompt != "" { root.switch-text = root.switch-prompt; } }
    changed switching => { if root.switching { switch-keys.focus(); } else { switch-keys.clear-focus(); } }
    Rectangle {
        visible: self.opacity > 0;
        opacity: root.switching ? 1 : 0;
        animate opacity { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
        background: #00000099;
        TouchArea { enabled: root.switching; clicked => { root.cancel-switch(); } }
        Rectangle {
            width: min(420px, root.width - 48px); height: switch-content.preferred-height;
            y: (parent.height - self.height) / 2 + (root.switching ? 0px : 10px);
            transform-scale: root.switching ? 1 : 0.96;
            animate y, transform-scale { duration: 220ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
            drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
            accessible-role: groupbox;
            accessible-label: "Switch voice channel?";
            // Clicks on the dialog itself never reach the backdrop.
            TouchArea { enabled: root.switching; }
            switch-keys := FocusScope {
                enabled: root.switching;
                key-pressed(event) => {
                    if event.text == Key.Escape { root.cancel-switch(); return accept; }
                    if event.text == "\n" { root.confirm-switch(); return accept; }
                    return reject;
                }
                switch-content := VerticalLayout {
                    padding: 20px; spacing: 18px;
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: 40px; height: 40px; border-radius: 20px; background: Theme.accent-soft;
                                Image { source: @image-url("icons/volume-2.svg"); width: 20px; height: 20px; colorize: Theme.accent; }
                            }
                        }
                        VerticalLayout {
                            spacing: 6px; horizontal-stretch: 1;
                            Text { text: "Switch voice channel?"; color: Theme.text; font-size: 18px; font-weight: 700; }
                            Text { text: root.switch-text; color: Theme.secondary; font-size: 15px; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        alignment: end; spacing: 8px;
                        // A fading dialog no longer acts.
                        ActionButton { text: "Cancel"; ghost: true; clicked => { if root.switching { root.cancel-switch(); } } }
                        ActionButton { text: "Switch channel"; primary: true; clicked => { if root.switching { root.confirm-switch(); } } }
                    }
                }
            }
        }
    }
    // An image shown large over everything. Arrow keys or the side buttons
    // step through the message's images; Escape, the close button or a click
    // outside the image closes it.
    // Mention suggestions, just above the composer: Up and Down choose, Tab or Enter
    // or a click mentions, Escape closes them.
    if root.mentions.length > 0 && root.composer-enabled: Rectangle {
        x: composer.absolute-position.x - 6px;
        width: min(composer.width + 12px, 420px);
        height: suggestions.preferred-height;
        y: composer.absolute-position.y - self.height - 12px;
        background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
        drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
        suggestions := VerticalLayout {
            padding: 6px; spacing: 0px;
            Text {
                text: "MENTION"; color: Theme.muted; font-size: 11px; font-weight: 700;
                height: 22px; vertical-alignment: center;
            }
            for mention[index] in root.mentions: Rectangle {
                height: 36px; border-radius: 6px;
                background: index == root.mention-index ? Theme.active : pick.has-hover ? Theme.hover : transparent;
                pick := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.mention-chosen(index); }
                }
                HorizontalLayout {
                    padding-left: 8px; padding-right: 10px; spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        if !mention.group: Avatar { size: 24px; initial: mention.initial; tint: mention.tint; picture: mention.picture; }
                        if mention.group: Rectangle {
                            width: 24px; height: 24px; border-radius: 12px;
                            background: (mention.has-color ? mention.color : Theme.muted).with-alpha(0.2);
                            Text { text: "@"; color: mention.has-color ? mention.color : Theme.secondary; font-size: 13px; font-weight: 700; }
                        }
                    }
                    Text {
                        text: mention.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1;
                        color: mention.has-color ? mention.color : Theme.text; font-size: 14px; font-weight: 600;
                    }
                    Text { text: mention.detail; vertical-alignment: center; color: Theme.muted; font-size: 12px; }
                }
            }
        }
    }
    // Settings cover the window: sections on the left, the chosen one on the right.
    // Escape or the close button returns to the conversation.
    if root.settings-open: Rectangle {
        background: Theme.chat;
        accessible-role: groupbox;
        accessible-label: "Settings";
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.settings-open = false; return accept; }
                return reject;
            }
            HorizontalLayout {
                Rectangle {
                    background: Theme.sidebar; horizontal-stretch: 1; min-width: 232px;
                    HorizontalLayout {
                        alignment: end;
                        VerticalLayout {
                            width: 232px; padding: 16px; padding-top: 56px; spacing: 2px; alignment: start;
                            HorizontalLayout { padding-left: 8px; padding-bottom: 6px; SettingsHeading { text: "SETTINGS"; } }
                            ChannelRow {
                                text: "My account"; icon: @image-url("icons/user.svg");
                                selected: root.settings-section == 0; clicked => { root.settings-section = 0; }
                            }
                            ChannelRow {
                                text: "Voice & audio"; icon: @image-url("icons/headphones.svg");
                                selected: root.settings-section == 1; clicked => { root.settings-section = 1; root.refresh-devices(); }
                            }
                            ChannelRow {
                                text: "Messages"; icon: @image-url("icons/message-circle.svg");
                                selected: root.settings-section == 2; clicked => { root.settings-section = 2; }
                            }
                            ChannelRow {
                                text: "Notifications"; icon: @image-url("icons/bell.svg");
                                selected: root.settings-section == 3; clicked => { root.settings-section = 3; }
                            }
                            if root.discord-build && !root.preview: ChannelRow {
                                text: "Discord"; icon: @image-url("icons/discord.svg");
                                selected: root.settings-section == 4; clicked => { root.settings-section = 4; }
                            }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 2; min-width: 440px;
                    ScrollView {
                        HorizontalLayout {
                            padding-left: 40px; padding-right: 96px; padding-top: 56px; padding-bottom: 56px;
                            VerticalLayout {
                                max-width: 660px; horizontal-stretch: 1; spacing: 16px; alignment: start;
                                if root.settings-section == 0: VerticalLayout {
                                    spacing: 16px;
                                    SettingsTitle { text: "My account"; }
                                    Rectangle {
                                        background: Theme.sidebar; border-radius: 8px;
                                        HorizontalLayout {
                                            padding: 16px; spacing: 16px;
                                            Middle { Avatar { size: 64px; initial: root.account-initial; tint: root.account-tint; picture: root.account-picture; } }
                                            VerticalLayout {
                                                alignment: center; spacing: 2px; horizontal-stretch: 1;
                                                Text { text: root.account-name; color: Theme.text; font-size: 20px; font-weight: 700; overflow: elide; }
                                                Label { text: root.account-status; wrap: no-wrap; overflow: elide; }
                                            }
                                        }
                                    }
                                    if root.storage != "": Label { text: root.storage; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        if !root.preview && !root.online: ActionButton {
                                            text: "Reconnect"; icon: @image-url("icons/refresh-cw.svg"); enabled: !root.busy;
                                            clicked => { root.retry-sync(); }
                                        }
                                        if root.discord-linked: ActionButton {
                                            text: root.has-custom-status ? "Change custom status" : "Set a custom status"; icon: @image-url("icons/smile-plus.svg");
                                            clicked => { root.settings-open = false; root.open-status(); }
                                        }
                                        ActionButton {
                                            text: root.preview ? "Back to sign in" : "Sign out"; icon: @image-url("icons/log-out.svg");
                                            danger: !root.preview; enabled: !root.busy && !root.sending;
                                            clicked => { root.settings-open = false; root.logout(); }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                }
                                if root.settings-section == 1: VerticalLayout {
                                    spacing: 16px;
                                    SettingsTitle { text: "Voice & audio"; }
                                    HorizontalLayout {
                                        spacing: 16px;
                                        VerticalLayout {
                                            spacing: 8px; horizontal-stretch: 1;
                                            SettingsHeading { text: "MICROPHONE"; }
                                            ComboBox { model: root.microphones; current-index: root.microphone-index; enabled: root.microphones.length > 0; accessible-label: "Microphone device"; selected => { root.select-microphone(self.current-index); } }
                                        }
                                        VerticalLayout {
                                            spacing: 8px; horizontal-stretch: 1;
                                            SettingsHeading { text: "SPEAKERS"; }
                                            ComboBox { model: root.speakers; current-index: root.speaker-index; enabled: root.speakers.length > 0; accessible-label: "Speaker device"; selected => { root.select-speaker(self.current-index); } }
                                        }
                                    }
                                    if root.microphones.length == 0 && root.speakers.length == 0: Label { text: "No audio devices found. Connect one, then refresh."; }
                                    HorizontalLayout {
                                        ActionButton { text: "Refresh devices"; icon: @image-url("icons/refresh-cw.svg"); ghost: true; small: true; clicked => { root.refresh-devices(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    SettingsSwitch {
                                        text: "Turn on your microphone when you join a call";
                                        description: "Otherwise you join muted, and unmute when you're ready.";
                                        checked <=> root.unmute-on-join;
                                        toggled => { root.preferences-changed(); }
                                    }
                                    SettingsSwitch {
                                        text: "Even out your voice";
                                        description: "Keeps your voice steady as you lean towards the microphone or away from it. Whispers and shouts still come through as they are.";
                                        checked <=> root.level-voice;
                                        toggled => { root.preferences-changed(); }
                                    }
                                }
                                if root.settings-section == 2: VerticalLayout {
                                    spacing: 16px;
                                    SettingsTitle { text: "Messages"; }
                                    // A message as the chosen text size and clock show it.
                                    Rectangle {
                                        border-radius: 8px; border-width: 1px; border-color: Theme.line;
                                        accessible-role: groupbox; accessible-label: "Preview";
                                        HorizontalLayout {
                                            padding: 16px; spacing: 16px;
                                            VerticalLayout { alignment: start; Avatar { initial: "S"; tint: #c0679a; } }
                                            VerticalLayout {
                                                spacing: 3px; horizontal-stretch: 1;
                                                HorizontalLayout {
                                                    spacing: 8px;
                                                    Text { text: "Sam"; color: Theme.text; font-size: root.message-font-size; font-weight: 700; }
                                                    Text { text: root.twelve-hour-clock ? "9:41 PM" : "21:41"; color: Theme.muted; font-size: root.message-font-size - 3px; vertical-alignment: center; }
                                                    Rectangle { horizontal-stretch: 1; }
                                                }
                                                Text { text: "Thinking co-op after nine, if people are up for it."; color: Theme.text; font-size: root.message-font-size; wrap: word-wrap; }
                                            }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 8px;
                                        SettingsHeading { text: "TEXT SIZE"; }
                                        Choices {
                                            label: "Text size"; options: ["Small", "Default", "Large"];
                                            current <=> root.text-size;
                                            chosen => { root.preferences-changed(); }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 8px;
                                        SettingsHeading { text: "CLOCK"; }
                                        Choices {
                                            label: "Clock"; options: ["24-hour", "12-hour"];
                                            current: root.twelve-hour-clock ? 1 : 0;
                                            chosen(index) => { root.twelve-hour-clock = index == 1; root.preferences-changed(); }
                                        }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    SettingsSwitch {
                                        text: "Show link previews";
                                        description: "Cards for links, videos and bots under messages. Linked pictures still show.";
                                        checked <=> root.link-previews;
                                        toggled => { root.preferences-changed(); }
                                    }
                                    SettingsSwitch {
                                        text: "Let others see when you're typing";
                                        description: "Discord and Matrix show \"typing...\" while you write. Others still show here when they type.";
                                        checked <=> root.share-typing;
                                        toggled => { root.preferences-changed(); }
                                    }
                                }
                                if root.settings-section == 3: VerticalLayout {
                                    spacing: 16px;
                                    SettingsTitle { text: "Notifications"; }
                                    SettingsSwitch {
                                        text: "Show desktop notifications";
                                        description: "For new messages while Talk isn't in front. Each Discord server's notification settings and your Matrix notification rules decide which: usually DMs and mentions. Clicking one opens the conversation.";
                                        checked <=> root.notifications;
                                        toggled => { root.preferences-changed(); }
                                    }
                                    SettingsSwitch {
                                        text: "Play a sound";
                                        description: "Your desktop's message sound, with each notification.";
                                        checked <=> root.notification-sound;
                                        enabled: root.notifications;
                                        toggled => { root.preferences-changed(); }
                                    }
                                    SettingsSwitch {
                                        text: "Show what messages say";
                                        description: "Off shows only who wrote and where, for a screen others can see.";
                                        checked <=> root.notification-text;
                                        enabled: root.notifications;
                                        toggled => { root.preferences-changed(); }
                                    }
                                }
                                if root.settings-section == 4 && !root.discord-linked: VerticalLayout {
                                    spacing: 16px;
                                    SettingsTitle { text: "Discord"; }
                                    Label { text: "Link your Discord account to see its servers and DMs in Talk, and join its calls. The login stays on this computer, in the system's credential store."; }
                                    DiscordLinkPanel {
                                        phase: root.link-phase; code: root.link-code; name: root.link-name; note: root.link-note;
                                        begin => { root.link-discord(); }
                                    }
                                }
                                if root.settings-section == 4 && root.discord-linked: VerticalLayout {
                                    spacing: 16px;
                                    SettingsTitle { text: "Discord"; }
                                    if root.matrix-build: HorizontalLayout {
                                        spacing: 12px;
                                        Label { text: "Unlinking signs Talk out of Discord on this computer."; vertical-alignment: center; horizontal-stretch: 1; }
                                        ActionButton {
                                            text: "Unlink Discord"; icon: @image-url("icons/log-out.svg"); danger: true;
                                            clicked => { root.unlink-discord(); }
                                        }
                                    }
                                    SettingsSwitch {
                                        text: "Show channels you can't access";
                                        description: "They appear locked. Server admins hid them on purpose.";
                                        checked: root.show-hidden-channels;
                                        toggled(shown) => { root.show-hidden-channels = shown; root.show-hidden-channels-toggled(shown); }
                                    }
                                    SettingsSwitch {
                                        text: "Mark messages read on Discord";
                                        description: "Channels you read in Talk show as read in the Discord apps too.";
                                        checked: root.sync-discord-reads;
                                        toggled(sync) => { root.sync-discord-reads = sync; root.sync-discord-reads-toggled(sync); }
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        x: parent.width - 80px; y: 48px; width: 56px; height: self.preferred-height; spacing: 6px;
                        HorizontalLayout {
                            alignment: center;
                            IconButton {
                                icon: @image-url("icons/x.svg"); label: "Close settings"; size: 36px; glyph: 18px; radius: 18px;
                                fill: Theme.raised; clicked => { root.settings-open = false; }
                            }
                        }
                        Text { text: "ESC"; color: Theme.muted; font-size: 12px; font-weight: 700; horizontal-alignment: center; }
                    }
                }
            }
        }
    }
    // A role mentioned in a message: who Talk knows has it. Clicking someone opens
    // their card over it; Escape or a click outside closes it.
    if root.role-open: Rectangle {
        TouchArea { clicked => { root.close-role(); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-role(); return accept; }
                return reject;
            }
        }
        role-card := Rectangle {
            width: 260px; height: min(root.height - 16px, role-content.preferred-height);
            x: root.beside(root.role-x, root.role-width, self.width);
            y: max(8px, min(root.height - self.height - 8px, root.role-y - 8px));
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 8px;
            drop-shadow-blur: 24px; drop-shadow-color: #00000080; drop-shadow-offset-y: 8px;
            accessible-role: groupbox;
            accessible-label: "Role " + root.role-name;
            TouchArea { }
            role-content := VerticalLayout {
                padding: 12px; spacing: 4px;
                HorizontalLayout {
                    spacing: 8px; padding-bottom: 4px;
                    Middle { Rectangle { width: 12px; height: 12px; border-radius: 6px; background: root.role-has-color ? root.role-color : Theme.muted; } }
                    Text { text: "@" + root.role-name; color: root.role-has-color ? root.role-color : Theme.text; font-size: 16px; font-weight: 700; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                }
                if root.role-note != "": Label { text: root.role-note; }
                ScrollView {
                    max-height: 320px;
                    VerticalLayout {
                        spacing: 0px; alignment: start;
                        for member in root.role-members: Rectangle {
                            height: 40px; border-radius: 6px;
                            background: member-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: member.name;
                            accessible-action-default => { root.profile-at-pointer = true; root.show-profile(member.id); }
                            HorizontalLayout {
                                padding-left: 6px; padding-right: 6px; spacing: 10px;
                                Middle { Avatar { size: 28px; initial: member.initial; tint: member.tint; picture: member.picture; } }
                                Text { text: member.name; color: member.has-color ? member.color : Theme.text; font-size: 15px; font-weight: 500; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                            member-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.anchor(role-card.x, self.absolute-position.y, role-card.width, self.height, true);
                                    root.profile-at-pointer = true;
                                    root.show-profile(member.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // A member's card, beside the member list. Escape or a click outside closes it.
    if root.profile-open && !root.profile-large: Rectangle {
        TouchArea { clicked => { root.close-profile(); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-profile(); return accept; }
                return reject;
            }
        }
        ProfileCard {
            width: 300px; limit: root.height - 16px;
            x: root.profile-at-pointer
                ? root.beside(root.anchor-x, root.anchor-width, self.width)
                : root.width - 240px - 8px - self.width;
            y: max(8px, min(root.height - self.height - 8px, (root.profile-at-pointer ? root.anchor-y - 8px : root.profile-y - 16px)));
            data: root.profile;
            enlarge => { root.enlarge-profile(); }
            close => { root.close-profile(); }
            befriend => { root.befriend(root.profile.id); }
            open-link(link) => { root.open-link(link); }
        }
    }
    // A full profile over the window, as the viewer shows images.
    if root.profile-open && root.profile-large: Rectangle {
        background: #000000b3;
        TouchArea { clicked => { root.close-profile(); } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-profile(); return accept; }
                return reject;
            }
        }
        ProfileCard {
            large: true;
            width: min(600px, root.width - 64px); limit: root.height - 64px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            data: root.profile;
            close => { root.close-profile(); }
            befriend => { root.befriend(root.profile.id); }
            open-link(link) => { root.open-link(link); }
            open-server(server, x, y, width, height) => { root.open-server-card(server, x, y, width, height); }
            // In the full profile, a friend's opens full too.
            open-friend(id, x, y, width, height) => { root.show-friend-profile(id, true); }
        }
    }
    // A mutual server's card, over the profile that lists it. Clicking
    // outside or Escape closes it.
    if root.server-card-open: Rectangle {
        TouchArea { clicked => { root.server-card-open = false; } }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.server-card-open = false; return accept; }
                return reject;
            }
        }
        ServerCard {
            width: 300px;
            x: root.beside(root.anchor-x, root.anchor-width, self.width);
            y: max(8px, min(root.height - self.height - 8px, root.anchor-y - 8px));
            server: root.server-card;
            open => {
                root.server-card-open = false;
                root.close-profile();
                root.navigate-server(root.server-card.id);
            }
        }
    }
    if root.viewer-open: Rectangle {
        background: #000000e6;
        accessible-role: groupbox;
        accessible-label: "Image viewer";
        TouchArea { clicked => { root.close-image(); } }
        viewer-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.close-image(); return accept; }
                if event.text == Key.LeftArrow && root.viewer-position != "" { root.step-image(-1); return accept; }
                if event.text == Key.RightArrow && root.viewer-position != "" { root.step-image(1); return accept; }
                return reject;
            }
            // Shown at full size, shrunk to fit beside the bars and arrows.
            property <length> room-width: root.width - 160px;
            property <length> room-height: root.height - 128px;
            property <length> natural-width: max(1, root.viewer-width) * 1px;
            property <length> natural-height: max(1, root.viewer-height) * 1px;
            property <float> scale: min(1, min(self.room-width / self.natural-width, self.room-height / self.natural-height));
            Picture {
                width: viewer-keys.natural-width * viewer-keys.scale; height: viewer-keys.natural-height * viewer-keys.scale;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                still: root.viewer-image; frames: root.viewer-frames; delays: root.viewer-delays; image-fit: contain;
                accessible-role: image; accessible-label: root.viewer-name;
                TouchArea { }
            }
            HorizontalLayout {
                y: 0px; height: 64px; padding-left: 20px; padding-right: 12px; spacing: 8px;
                VerticalLayout {
                    alignment: center; horizontal-stretch: 1;
                    Text { text: root.viewer-name; color: #ffffff; font-size: 15px; font-weight: 700; overflow: elide; }
                    if root.viewer-position != "": Text { text: root.viewer-position; color: #ffffffb3; font-size: 13px; }
                }
                if !root.preview: Middle {
                    IconButton {
                        icon: @image-url("icons/download.svg"); label: "Save " + root.viewer-name; tint: #ffffff;
                        clicked => { root.save-attachment(root.viewer-item, root.viewer-index); }
                    }
                }
                Middle { IconButton { icon: @image-url("icons/x.svg"); label: "Close"; tint: #ffffff; clicked => { root.close-image(); } } }
            }
            if root.viewer-position != "": Rectangle {
                x: 20px; y: (parent.height - self.height) / 2; width: 48px; height: 48px; border-radius: 24px;
                background: previous-touch.has-hover ? #ffffff33 : #ffffff1a;
                Image { source: @image-url("icons/chevron-left.svg"); width: 28px; height: 28px; colorize: #ffffff; }
                previous-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.step-image(-1); } }
                accessible-role: button; accessible-label: "Previous image";
                accessible-action-default => { root.step-image(-1); }
            }
            if root.viewer-position != "": Rectangle {
                x: parent.width - self.width - 20px; y: (parent.height - self.height) / 2; width: 48px; height: 48px; border-radius: 24px;
                background: next-touch.has-hover ? #ffffff33 : #ffffff1a;
                Image { source: @image-url("icons/chevron-right.svg"); width: 28px; height: 28px; colorize: #ffffff; }
                next-touch := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.step-image(1); } }
                accessible-role: button; accessible-label: "Next image";
                accessible-action-default => { root.step-image(1); }
            }
            if root.viewer-note != "": Rectangle {
                x: (parent.width - self.width) / 2; y: parent.height - self.height - 20px;
                width: viewer-note-text.preferred-width + 24px; height: 32px; border-radius: 6px; background: #000000b3;
                viewer-note-text := Text { text: root.viewer-note; color: #ffffffd9; font-size: 13px; }
            }
        }
    }
    // Forwarding a message: pick conversations to send it to, one click each.
    // Clicking outside or Escape closes it.
    // Adding a Discord friend by username. Clicking outside or Escape closes it.
    if root.add-friend-open: Rectangle {
        background: #00000099;
        TouchArea { clicked => { root.close-add-friend(); } }
        Rectangle {
            width: min(460px, root.width - 48px); height: add-friend-content.preferred-height;
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
            drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
            accessible-role: groupbox;
            accessible-label: "Add a friend";
            TouchArea { }
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { root.close-add-friend(); return accept; }
                    return reject;
                }
                add-friend-content := VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: "Add a friend"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close-add-friend(); } }
                    }
                    Label { text: "Send someone a friend request on Discord with their username."; }
                    HorizontalLayout {
                        spacing: 8px;
                        TextField {
                            init => { self.focus-input(); }
                            min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                            placeholder: "Username"; label: "Username"; text <=> root.add-friend-name;
                            accepted => { root.add-friend(root.add-friend-name); }
                        }
                        ActionButton {
                            text: "Send request"; primary: true;
                            enabled: !root.add-friend-sending && root.add-friend-name != "";
                            clicked => { root.add-friend(root.add-friend-name); }
                        }
                    }
                    if root.add-friend-note != "": Text {
                        text: root.add-friend-note; font-size: 14px; wrap: word-wrap;
                        color: root.add-friend-sent ? Theme.live : root.add-friend-sending ? Theme.muted : Theme.danger;
                    }
                }
            }
        }
    }
    // The custom status: an emoji from the picker, words, and when it clears.
    if root.status-open: Rectangle {
        background: #00000099;
        TouchArea { clicked => { root.close-status(); } }
        Rectangle {
            width: min(460px, root.width - 48px); height: status-content.preferred-height;
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
            drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
            accessible-role: groupbox;
            accessible-label: "Set a custom status";
            TouchArea { }
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { root.close-status(); return accept; }
                    return reject;
                }
                status-content := VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: "Set a custom status"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close-status(); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 40px; height: 40px; border-radius: 6px;
                            background: status-emoji-touch.has-hover ? Theme.hover : Theme.sunken;
                            accessible-role: button;
                            accessible-label: root.status-emoji.glyph != "" ? "Emoji, " + root.status-emoji.name + ". Change it" : "Pick an emoji";
                            accessible-action-default => { root.open-picker("talk:status"); }
                            if root.status-emoji.glyph != "": Text {
                                text: root.status-emoji.glyph; font-family: root.emoji-font; font-size: 22px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            if root.status-emoji.glyph == "": Image {
                                source: @image-url("icons/smile-plus.svg"); width: 20px; colorize: Theme.secondary;
                            }
                            status-emoji-touch := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => {
                                    root.anchor(self.absolute-position.x, self.absolute-position.y, self.width, self.height, true);
                                    root.open-picker("talk:status");
                                }
                            }
                            // Taking the emoji off: a small badge on its corner.
                            if root.status-emoji.glyph != "": Rectangle {
                                x: parent.width - 12px; y: -6px; width: 18px; height: 18px; border-radius: 9px;
                                background: remove-touch.has-hover ? Theme.danger : Theme.faint;
                                border-width: 2px; border-color: Theme.raised;
                                accessible-role: button;
                                accessible-label: "Remove the emoji";
                                accessible-action-default => { root.status-emoji = { glyph: "", name: "", key: "" }; }
                                Image { source: @image-url("icons/x.svg"); width: 10px; colorize: Theme.text; }
                                remove-touch := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.status-emoji = { glyph: "", name: "", key: "" }; }
                                }
                            }
                        }
                        TextField {
                            init => { self.focus-input(); }
                            min-height: 40px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                            placeholder: "What's happening?"; label: "Status"; text <=> root.status-text;
                            accepted => { root.save-status(); }
                        }
                    }
                    Text { text: "CLEAR AFTER"; color: Theme.muted; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; }
                    Choices {
                        label: "Clear after"; options: ["Never", "30 min", "1 hour", "4 hours", "Today"];
                        current <=> root.status-clear-after;
                    }
                    if root.status-error != "": Text { text: root.status-error; color: Theme.danger; font-size: 14px; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px; padding-top: 4px;
                        if root.has-custom-status: ActionButton {
                            text: "Clear status"; ghost: true; enabled: !root.status-saving;
                            clicked => { root.clear-status(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { text: "Cancel"; ghost: true; clicked => { root.close-status(); } }
                        ActionButton {
                            text: root.status-saving ? "Saving..." : "Save"; primary: true; enabled: !root.status-saving;
                            clicked => { root.save-status(); }
                        }
                    }
                }
            }
        }
    }
    // Starting a DM: find someone on Discord or Matrix, then open the conversation
    // with them, which starts it if there's none yet.
    if root.new-dm-open: Rectangle {
        background: #00000099;
        TouchArea { clicked => { root.close-new-dm(); } }
        Rectangle {
            width: min(440px, root.width - 48px); height: min(520px, root.height - 48px);
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
            drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
            accessible-role: groupbox;
            accessible-label: "New message";
            TouchArea { }
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { root.close-new-dm(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: "New message"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close-new-dm(); } }
                    }
                    TextField {
                        init => { self.focus-input(); }
                        min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                        placeholder: "Find a friend, or type a Matrix id"; label: "Find people"; text <=> root.new-dm-query;
                        edited => { root.new-dm-search(); }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px; alignment: start;
                            for person[index] in root.new-dm-people: Rectangle {
                                height: 48px; border-radius: 6px;
                                background: person-touch.has-hover && !root.new-dm-starting ? Theme.hover : transparent;
                                accessible-role: button;
                                accessible-label: "Message " + person.name + ", " + person.detail;
                                accessible-action-default => { root.start-dm(index); }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 12px;
                                    Middle {
                                        Rectangle {
                                            width: 36px; height: 32px;
                                            Avatar { x: 0; y: 0; size: 32px; initial: person.initial; tint: person.tint; picture: person.picture; }
                                            if person.discord: DiscordBadge { x: 18px; y: 16px; size: 14px; ring: Theme.raised; }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 1;
                                        Text { text: person.name; color: Theme.text; font-size: 16px; font-weight: 500; overflow: elide; }
                                        Text { text: person.detail; color: Theme.muted; font-size: 13px; overflow: elide; }
                                    }
                                    Middle {
                                        ActionButton { text: "Message"; small: true; primary: person-touch.has-hover; enabled: !root.new-dm-starting; clicked => { root.start-dm(index); } }
                                    }
                                }
                                person-touch := TouchArea {
                                    enabled: !root.new-dm-starting; mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.start-dm(index); }
                                }
                            }
                            if root.new-dm-note != "": HorizontalLayout {
                                padding: 8px;
                                Label { text: root.new-dm-note; }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.forward-open: Rectangle {
        background: #00000099;
        TouchArea { clicked => { root.close-forward(); } }
        Rectangle {
            width: min(440px, root.width - 48px); height: min(520px, root.height - 48px);
            background: Theme.raised; border-color: Theme.edge; border-width: 1px; border-radius: 12px;
            drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
            accessible-role: groupbox;
            accessible-label: "Forward message";
            TouchArea { }
            FocusScope {
                key-pressed(event) => {
                    if event.text == Key.Escape { root.close-forward(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 20px; spacing: 12px;
                    HorizontalLayout {
                        Text { text: "Forward message"; color: Theme.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        IconButton { icon: @image-url("icons/x.svg"); label: "Close"; size: 28px; glyph: 18px; clicked => { root.close-forward(); } }
                    }
                    // The message, as a quote.
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle { width: 3px; border-radius: 1.5px; background: Theme.line; }
                        Text { text: root.forward-preview; color: Theme.secondary; font-size: 15px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                    forward-field := TextField {
                        init => { self.focus-input(); }
                        min-height: 36px; text-size: 15px; pad: 10px; fill: Theme.sunken;
                        placeholder: "Find a conversation"; label: "Find a conversation"; text <=> root.forward-query;
                        edited => { root.forward-search(); }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px; alignment: start;
                            for target in root.forward-targets: Rectangle {
                                height: 48px; border-radius: 6px;
                                background: target-touch.has-hover && !target.sent ? Theme.hover : transparent;
                                accessible-role: button;
                                accessible-label: (target.sent ? "Sent to " : "Forward to ") + target.name + ", " + target.place;
                                accessible-action-default => { if !target.sent { root.forward-to(target.id); } }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 12px;
                                    if target.direct: Middle { Avatar { size: 32px; initial: target.initial; tint: target.tint; } }
                                    if !target.direct: Middle {
                                        Rectangle {
                                            width: 32px; height: 32px; border-radius: 16px; background: Theme.field;
                                            Image { source: target.icon; width: 18px; height: 18px; colorize: Theme.secondary; }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center; horizontal-stretch: 1;
                                        Text { text: target.name; color: Theme.text; font-size: 16px; font-weight: 500; overflow: elide; }
                                        Text { text: target.place; color: Theme.muted; font-size: 13px; overflow: elide; }
                                    }
                                    if target.sent: HorizontalLayout {
                                        spacing: 4px;
                                        Image { source: @image-url("icons/check.svg"); width: 16px; image-fit: contain; colorize: Theme.live; }
                                        Text { text: "Sent"; color: Theme.secondary; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                    }
                                    if !target.sent: Middle {
                                        ActionButton { text: "Send"; small: true; primary: target-touch.has-hover; clicked => { root.forward-to(target.id); } }
                                    }
                                }
                                target-touch := TouchArea {
                                    enabled: !target.sent; mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.forward-to(target.id); }
                                }
                            }
                            if root.forward-targets.length == 0: HorizontalLayout {
                                padding: 8px;
                                Label { text: root.forward-query != "" ? "No conversations match." : "There's nowhere to forward to yet. Talk forwards only into encrypted conversations."; }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        ActionButton { text: "Done"; clicked => { root.close-forward(); } }
                    }
                }
            }
        }
    }
    // The zoom level, for a moment after it changes.
    if root.zoom-note != "": Rectangle {
        x: (root.width - self.width) / 2; y: 12px;
        width: zoom-text.preferred-width + 28px; height: 36px;
        border-radius: 18px; background: #0b0c0e;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 3px;
        accessible-role: text; accessible-label: "Zoom " + root.zoom-note;
        zoom-text := Text { text: root.zoom-note; color: Theme.text; font-size: 15px; font-weight: 700; }
    }
    if Tip.text != "": Rectangle {
        property <length> w: tip-text.preferred-width + 20px;
        property <length> h: 32px;
        x: Tip.side == 1 ? Tip.x + 10px : max(8px, min(root.width - self.w - 8px, Tip.x - self.w / 2));
        y: Tip.side == 1 ? Tip.y - self.h / 2 : Tip.side == 0 ? max(4px, Tip.y - self.h - 6px) : Tip.y + 6px;
        width: self.w; height: self.h;
        border-radius: 6px; background: #0b0c0e;
        drop-shadow-blur: 12px; drop-shadow-color: #00000080; drop-shadow-offset-y: 3px;
        tip-text := Text { text: Tip.text; color: Theme.text; font-size: 14px; font-weight: 700; }
    }
}
