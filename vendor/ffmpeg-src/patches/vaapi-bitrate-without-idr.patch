+/* Follows a bitrate changed on the AVCodecContext while encoding, as
+ * nvenc.c does: returns 1 when the rate control parameters have changed,
+ * to go to the driver with the next picture rather than wait for an IDR. */
+static int vaapi_encode_follow_bit_rate(AVCodecContext *avctx)
+{
+    VAAPIEncodeContext *ctx = avctx->priv_data;
+    const VAAPIEncodeRCMode *rc_mode = ctx->rc_mode;
+    int64_t bits_per_second, buffer_size;
+
+    if (!rc_mode || !rc_mode->bitrate || rc_mode->mode == RC_MODE_AVBR ||
+        avctx->bit_rate <= 0 || avctx->bit_rate == ctx->rc_bit_rate)
+        return 0;
+
+    if (rc_mode->maxrate && avctx->rc_max_rate >= avctx->bit_rate) {
+        bits_per_second = avctx->rc_max_rate;
+        ctx->rc_params.target_percentage = avctx->bit_rate * 100 / avctx->rc_max_rate;
+    } else if (rc_mode->maxrate) {
+        bits_per_second = 2 * avctx->bit_rate;
+        ctx->rc_params.target_percentage = 50;
+    } else {
+        bits_per_second = avctx->bit_rate;
+        ctx->rc_params.target_percentage = 100;
+    }
+    buffer_size = avctx->rc_buffer_size ? avctx->rc_buffer_size :
+                  avctx->rc_max_rate > 0 ? avctx->rc_max_rate : avctx->bit_rate;
+    if (bits_per_second > UINT32_MAX || buffer_size > UINT32_MAX)
+        return 0;
+
+    ctx->rc_params.bits_per_second = bits_per_second;
+    if (rc_mode->hrd) {
+        ctx->hrd_params.buffer_size             = buffer_size;
+        ctx->hrd_params.initial_buffer_fullness = buffer_size * 3 / 4;
+        ctx->rc_params.window_size              = buffer_size * 1000 / bits_per_second;
+    }
+    ctx->va_bit_rate = bits_per_second;
+    ctx->rc_bit_rate = avctx->bit_rate;
+    av_log(avctx, AV_LOG_VERBOSE, "RC target now %"PRId64" bps.\n",
+           bits_per_second);
+    return 1;
+}
