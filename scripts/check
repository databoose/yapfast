#!/usr/bin/env bash
# Formatting, doc links, Clippy for every network combination, tests and
# smoke runs.
# Usage: scripts/check [--fast]
# --fast builds with the `fast` profile, which local work uses. Each step
# prints `=== step` and `rc=N` when it ends; its full output is in
# target/check/. The script exits non-zero when any step failed, after running
# them all.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop path:./nix --command "$0" "$@"
fi

profile=()
profile_dir=debug
case "${1:-}" in
  --fast) profile=(--profile fast) profile_dir=fast ;;
  "") ;;
  *) echo "usage: scripts/check [--fast]" >&2; exit 2 ;;
esac

logs=target/check
mkdir -p "$logs"
rm -f "$logs"/*.log "$logs"/*.rc

# Runs a step and prints its report in one write, so the reports of steps
# running at the same time don't interleave.
run() {
  local name=$1
  shift
  "$@" >"$logs/$name.log" 2>&1
  local rc=$?
  echo "$rc" >"$logs/$name.rc"
  local report
  report="=== $name: $*"$'\n'"rc=$rc"
  if [[ $rc -ne 0 ]]; then
    # Rust's own diagnostics, without the C compilers' warnings around them,
    # or the end of the output when there are none.
    report+=$'\n'$(grep -E -A12 '^(error|warning)(\[|:)|^test .* FAILED|panicked at' "$logs/$name.log" | head -80 ||
      tail -20 "$logs/$name.log")
    report+=$'\n'"(full output: $logs/$name.log)"
  fi
  printf '%s\n' "$report"
}

clippy=(cargo clippy --locked "${profile[@]}" --all-targets)

# Each network alone, in the desktop and in the shared core with its tests,
# and the headless build. These build talk and talk-core with other features
# than the steps below, so they run alongside them in a target directory of
# their own: Cargo lets one build at a time use a target directory. The
# headless binary stays out of target/<profile>/ that way too.
combinations() {
  export CARGO_TARGET_DIR=target/check-combinations
  run clippy-discord-only "${clippy[@]}" -p talk -p talk-core --no-default-features \
    --features talk/desktop,talk/discord,talk-core/discord -- -D warnings
  run clippy-matrix-only "${clippy[@]}" -p talk -p talk-core --no-default-features \
    --features talk/desktop,talk/matrix,talk-core/matrix -- -D warnings
  run clippy-headless "${clippy[@]}" -p talk --no-default-features --features matrix,discord -- -D warnings
  run smoke-headless cargo run --locked "${profile[@]}" --no-default-features --features matrix,discord -- --smoke-test
}

# In a process group of its own, so an interrupt can stop all of it: a
# background job doesn't get the terminal's Ctrl-C.
set -m
combinations &
combinations_pid=$!
set +m
trap 'kill -TERM -- -"$combinations_pid" 2>/dev/null; exit 130' INT TERM

run fmt cargo fmt --all -- --check
run doc-links scripts/check-doc-links
run clippy "${clippy[@]}" --workspace -- -D warnings
run test cargo test --locked "${profile[@]}" --workspace
run build cargo build --locked "${profile[@]}" --workspace
# The binary the build step made: `cargo run` would resolve the dependencies'
# features for talk alone, not the workspace, and compile it again.
if [[ "$(cat "$logs/build.rc")" == 0 ]]; then
  run smoke "target/$profile_dir/talk" --smoke-test
else
  echo "=== smoke: skipped, as the build failed"
fi
wait "$combinations_pid"

failed=()
for name in fmt doc-links clippy test clippy-discord-only clippy-matrix-only clippy-headless \
  build smoke-headless smoke; do
  # A step without a result was skipped.
  [[ ! -e "$logs/$name.rc" || "$(cat "$logs/$name.rc")" == 0 ]] || failed+=("$name")
done
if [[ ${#failed[@]} -gt 0 ]]; then
  echo "FAILED: ${failed[*]}"
  exit 1
fi
echo "All checks passed."
