#!/usr/bin/env python3
"""Aggregate recorded Linux screens; retain repeat variation and renderer checks."""
import argparse
import json
from pathlib import Path
import statistics
import sys


def summarize(directory):
    suite = json.loads((directory / 'suite.json').read_text())
    groups = {}
    failures = []
    for case in suite['cases']:
        if case.get('status') != 'passed':
            failures.append(case)
            continue
        report = json.loads((directory / case['output']).read_text())
        groups.setdefault((case['configuration'], case['scenario']), []).append((case, report))

    rows = []
    for (configuration, scenario), runs in sorted(groups.items()):
        row = {'configuration': configuration, 'scenario': scenario, 'runs': len(runs),
            'renderer_verified': all(case['renderer_verification']['verified'] for case, _ in runs),
            'reports': [case['output'] for case, _ in runs]}
        for metric in ('pss_mib', 'private_resident_mib', 'rss_mib', 'cpu_percent_one_core',
                       'nvidia_framebuffer_mib', 'process_count', 'threads', 'swap_pss_mib'):
            means = [report['summary'][metric]['mean'] for _, report in runs]
            row[metric] = {'median_run_mean': statistics.median(means),
                'min_run_mean': min(means), 'max_run_mean': max(means),
                'sampled_peak': max(report['summary'][metric]['peak'] for _, report in runs)}
        row['cpu_accounting_warning_count'] = sum(
            len(report['cpu_accounting_warnings']) for _, report in runs)
        if scenario in ('gpu-scroll', 'gpu-grid') and any('wayland_updates' not in report for _, report in runs):
            raise ValueError('Animated scenes require the surface submission probe: ' + scenario)
        if all('wayland_updates' in report for _, report in runs):
            rates, peak_gaps = [], []
            for case, report in runs:
                main = [surface for surface in report['wayland_updates']['surfaces']
                    if surface['surface_id'] == surface['main_surface_id']
                    and surface['max_current_width'] >= 1000
                    and surface['max_current_height'] >= 700]
                if len(main) > 1 or (scenario in ('gpu-scroll', 'gpu-grid') and len(main) != 1):
                    raise ValueError('Expected one owned animated main window: ' + case['output'])
                rates.append(main[0]['submissions_per_second'] if main else 0)
                if main and main[0]['submission_gap_ms_peak'] is not None:
                    peak_gaps.append(main[0]['submission_gap_ms_peak'])
            row['main_window_submissions_per_second'] = {
                'median': statistics.median(rates), 'min': min(rates), 'max': max(rates)}
            row['main_window_submission_gap_ms_peak'] = max(peak_gaps) if peak_gaps else None
            row['presented_fps_measured'] = False
        rows.append(row)
    return rows, failures


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directory', type=Path, help='Completed directory containing suite.json')
    args = parser.parse_args()
    rows, failures = summarize(args.directory)
    (args.directory / 'summary.json').write_text(json.dumps(rows, indent=2) + '\n')
    print('| Configuration / scenario | Runs | PSS MiB | Run mean range | Private MiB | CPU %, one core | GPU allocation MiB | Renderer verified |')
    print('| --- | ---: | ---: | ---: | ---: | ---: | ---: | --- |')
    for row in sorted(rows, key=lambda value: value['pss_mib']['median_run_mean']):
        memory = row['pss_mib']
        print(f"| {row['configuration']} / {row['scenario']} | {row['runs']} | "
            f"{memory['median_run_mean']:.1f} | {memory['min_run_mean']:.1f} to {memory['max_run_mean']:.1f} | "
            f"{row['private_resident_mib']['median_run_mean']:.1f} | "
            f"{row['cpu_percent_one_core']['median_run_mean']:.2f} | "
            f"{row['nvidia_framebuffer_mib']['median_run_mean']:.1f} | {row['renderer_verified']} |")
    if failures:
        print('Failed or unfinished cases: ' + json.dumps(failures), file=sys.stderr)
    if failures or any(not row['renderer_verified'] for row in rows):
        raise SystemExit(1)


if __name__ == '__main__':
    main()
