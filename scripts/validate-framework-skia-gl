#!/usr/bin/env python3
"""Check Skia drawing-stage counters against original-clock GPU frames."""
import argparse
import json
import math
from pathlib import Path


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('directory', type=Path)
args = parser.parse_args()
root = args.directory.resolve()
suite = json.loads((root / 'suite.json').read_text())
if suite.get('skia_gl_validation') is not True:
    raise SystemExit('Use a separate suite with Skia GL validation enabled.')
if not suite['cases']:
    raise SystemExit('Expected at least one Skia preflight case.')
runs = []
for case in suite['cases']:
    if case['candidate'] != 'slint-skia' or case['status'] != 'passed':
        raise SystemExit('Expected successful Skia preflight cases only.')
    path = root / case['report']
    report = json.loads(path.read_text())
    start = report['started_monotonic_ns'] + int(report['warmup_seconds'] * 1e9)
    end = start + int(report['measurement_seconds'] * 1e9)
    log = path.with_suffix('.app.log').read_text()
    if 'SKIA_GL_VALIDATION' in log:
        raise SystemExit('Validator reported an I/O error: ' + str(path))
    records = []
    for line in log.splitlines():
        if line.startswith('{'):
            value = json.loads(line)
            if value.get('kind', '').startswith('skia_gl_validation_'):
                records.append(value)
    metadata = [record for record in records if record['kind'] == 'skia_gl_validation_metadata']
    if not metadata or any(not record['supported'] or record['unwrapped_commands'] for record in metadata):
        raise SystemExit('Unsupported loaded GL command coverage: ' + str(path))
    frames = [record for record in records if record['kind'] == 'skia_gl_validation_frame'
        and isinstance(record.get('cpu_monotonic_ns'), int) and start <= record['cpu_monotonic_ns'] < end]
    gpu = [json.loads(line) for line in path.with_suffix('.frames.ndjson').read_text().splitlines()]
    gpu = [frame for frame in gpu if frame.get('kind') == 'gpu_frame'
        and start <= frame['cpu_monotonic_ns'] < end]
    for samples in (frames, gpu):
        identifiers = [frame['frame_id'] for frame in samples]
        if any(type(value) is not int or value <= 0 for value in identifiers) or len(set(identifiers)) != len(identifiers):
            raise SystemExit('Invalid or duplicate frame IDs: ' + str(path))
    identities = {(frame['frame_id'], frame['cpu_monotonic_ns']) for frame in frames}
    gpu_identities = {(frame['frame_id'], frame['cpu_monotonic_ns']) for frame in gpu}
    if not frames or len(identities) != len(frames) or len(gpu_identities) != len(gpu) or identities != gpu_identities:
        raise SystemExit('Validation/GPU frame identities do not match: ' + str(path))
    span = max(frame['frame_id'] for frame in frames) - min(frame['frame_id'] for frame in frames) + 1
    if len(frames) / span < .99 or any(
            type(frame.get('gpu_elapsed_ns')) not in (int, float)
            or not math.isfinite(frame['gpu_elapsed_ns']) or frame['gpu_elapsed_ns'] < 0
            or frame.get('status') != 'ok' for frame in gpu):
        raise SystemExit('Incomplete GPU query coverage: ' + str(path))
    totals = {stage: {} for stage in ('recording', 'final_flush_submit', 'after_end_hook')}
    for frame in frames:
        if not frame['supported'] or not frame['drawing_commands_inside_timer']:
            raise SystemExit('Drawing coverage failed: ' + str(path))
        for stage in totals:
            counts = frame[stage]
            if any(not isinstance(value, int) or value < 0 for value in counts.values()):
                raise SystemExit('Invalid GL command count: ' + str(path))
            if (stage != 'final_flush_submit' and sum(counts.values()) != 0) or (
                    stage == 'final_flush_submit' and sum(counts.values()) <= 0):
                raise SystemExit('GL drawing occurs outside the final flush interval: ' + str(path))
            for command, count in counts.items():
                totals[stage][command] = totals[stage].get(command, 0) + count
    runs.append({'scene': case['scene'], 'report': path.name, 'validated_frames': len(frames),
        'frame_id_span': span, 'original_clock_and_frame_ids_match': True,
        'drawing_commands_inside_timer': True, 'metadata': metadata, 'command_totals': totals})
summary = {'source_commit': suite['source_commit'], 'binary_sha256': suite['binary_sha256'],
    'runs': runs, 'limits': ['Validation wrappers are enabled; these runs are excluded from performance results.',
        'Only loaded Skia GL drawing/clear/blit/resource-clear/resolve entrypoints are covered.',
        'Uploads and other GPU work outside the interval remain unproven.']}
(root / 'validation-summary.json').write_text(json.dumps(summary, indent=2) + '\n')
print(json.dumps([{'scene': run['scene'], 'validated_frames': run['validated_frames'],
    'command_totals': run['command_totals']} for run in runs], indent=2))
