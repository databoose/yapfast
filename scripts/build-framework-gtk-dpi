#!/usr/bin/env python3
"""Build the GTK DPI module used only by the isolated comparison display."""
from pathlib import Path
import shlex
import subprocess
import sys
root = Path(__file__).resolve().parent.parent
output = Path(sys.argv[1]) if len(sys.argv)>1 else root / '.local/framework-gtk-dpi.so'
output.parent.mkdir(parents=True, exist_ok=True)
flags = shlex.split(subprocess.check_output(['pkg-config','--cflags','--libs','gtk+-3.0'],text=True))
subprocess.run(['cc','-shared','-fPIC','-O2','-Wall','-Wextra','-Werror',str(root / 'experiments/frameworks/display/gtk-dpi.c'),'-o',str(output),*flags],check=True,timeout=30)
print(output.resolve())
