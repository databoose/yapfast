#!/usr/bin/env python3
"""Capture typing and navigation on the private virtual display, for visual review."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import runpy
import signal
import subprocess
import tempfile
import time
import uuid

root = Path(__file__).resolve().parent.parent
input_api = runpy.run_path(str(root / 'scripts/framework-input'))
accounting = runpy.run_path(str(root / 'scripts/measure-framework'))
input_api['require_private_display']()
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--candidate', required=True, choices=['gpui', 'slint', 'freya', 'iced', 'dioxus-desktop', 'dioxus-native'])
parser.add_argument('--output', required=True, type=Path)
parser.add_argument('--start-after', type=float, default=3,
    help='Seconds after launch before interacting; allow for cold WebView startup')
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command[1:] if args.command and args.command[0] == '--' else args.command
if not command: parser.error('Executable is required after --.')
if args.start_after < 0: parser.error('--start-after must be nonnegative.')
args.output.mkdir(parents=True, exist_ok=True)
# Coordinates belong to the private 1600x1000 virtual output, never the desktop.
positions = {
    'gpui': {'composer': (650,829), 'send': (1315,829), 'dm': (152,126)},
    'slint': {'composer': (650,842), 'send': (1332,842), 'dm': (132,106)},
    'freya': {'composer': (650,810), 'send': (1330,810), 'dm': (118,89)},
    'iced': {'composer': (650,842), 'send': (1332,842), 'dm': (132,106)},
    'dioxus-desktop': {'composer': (650,855), 'send': (1275,855), 'dm': (77,170)},
    'dioxus-native': {'composer': (650,839), 'send': (1332,839), 'dm': (135,108)},
}[args.candidate]
token = uuid.uuid4().hex
def interrupted(signum, _frame):
    raise SystemExit(128 + signum)
for signum in (signal.SIGTERM, signal.SIGINT):
    signal.signal(signum, interrupted)
with (args.output / 'app.log').open('wb') as log:
    process = subprocess.Popen(command, env=dict(os.environ, YAPFAST_FRAMEWORK_RUN_ID=token), stdout=log, stderr=log, start_new_session=True)
    try:
        time.sleep(args.start_after)
        if process.poll() is not None: raise RuntimeError('Application exited; inspect app.log')
        def capture(name):
            with tempfile.TemporaryDirectory(prefix='yapfast-probe-shot-') as temporary:
                subprocess.run(['weston-screenshooter'], env=dict(os.environ, XDG_PICTURES_DIR=temporary), check=True, timeout=10, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                images = list(Path(temporary).glob('*.png'))
                if len(images) != 1: raise RuntimeError('Screenshot missing')
                subprocess.run(['ffmpeg','-hide_banner','-loglevel','error','-y','-i',str(images[0]),'-vf','vflip',str(args.output / (name+'.png'))], check=True, timeout=10)
        capture('startup')
        input_api['click'](*positions['composer'])
        for code in [33,23,45,20,22,19,18,57,20,18,31,20]: input_api['key'](code)
        time.sleep(.3)
        capture('typed')
        input_api['click'](*positions['send'])
        time.sleep(.5)
        capture('sent')
        input_api['click'](*positions['dm'])
        time.sleep(.5)
        capture('direct-messages')
        (args.output / 'actions.json').write_text(json.dumps({'candidate':args.candidate,
            'command':command,'binary_sha256':hashlib.sha256(Path(command[0]).read_bytes()).hexdigest(),
            'first_interaction_seconds':args.start_after,
            'renderer_environment':{key:os.environ[key] for key in ('FREYA_RENDERER','YAPFAST_WEBVIEW_ACCELERATION') if key in os.environ},
            'virtual_positions':positions,'requested_actions':['type fixture test','click send','click DM'],
            'validation':'Screenshots require visual inspection. This script does not assert an action succeeded from coordinates alone.',
            'screenshot_transform':'vflip corrects NVIDIA/Weston headless capture orientation.'},indent=2))
    finally:
        for signum in (signal.SIGTERM, signal.SIGINT):
            signal.signal(signum, signal.SIG_IGN)
        for pid in accounting['members'](process.pid,token,accounting['process_table']()):
            try: os.kill(pid,signal.SIGTERM)
            except ProcessLookupError: pass
        try: process.wait(timeout=5)
        except subprocess.TimeoutExpired: pass
        for pid in accounting['members'](process.pid,token,accounting['process_table']()):
            try: os.kill(pid,signal.SIGKILL)
            except ProcessLookupError: pass
        if process.poll() is None: process.wait(timeout=5)
