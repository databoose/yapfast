#!/usr/bin/env bash
# Gives a new worktree the main checkout's build, so its first build compiles
# the crates in this repository instead of every dependency.
# Usage: scripts/warm-worktree, inside the worktree, before its first build.
# It copies target/fast and target/check-combinations with reflinks, which
# take no space until the copies diverge, and skips one the worktree already
# has. It needs a filesystem with reflinks, such as btrfs. The copies keep
# their timestamps: Cargo rebuilds a crate whose dependencies look newer.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ -z "${IN_NIX_SHELL:-}" ]]; then
  exec nix develop path:./nix --command "$0" "$@"
fi

main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
if [[ "$main" == "$PWD" ]]; then
  echo "scripts/warm-worktree: run it inside a worktree, not the main checkout" >&2
  exit 2
fi

# The crates whose sources are in the repository: the workspace and vendor/.
# Cargo would reuse their copied builds, and a build script that names its
# inputs by absolute path, as Slint's does, would go on watching the main
# checkout's files. Cleaning them makes them build from this worktree's.
mapfile -t local_crates < <(cargo metadata --locked --format-version 1 |
  jq -r '.packages[] | select(.source == null) | "-p\n\(.name)"')

mkdir -p target
# Cargo cleans only a target directory that has this tag.
cp -n "$main/target/CACHEDIR.TAG" target/ 2>/dev/null || true
for dir in fast check-combinations; do
  if [[ ! -d "$main/target/$dir" ]]; then
    echo "$dir: the main checkout has none"
    continue
  fi
  if [[ -e "target/$dir" ]]; then
    echo "$dir: already here"
    continue
  fi
  if ! cp -a --reflink=always "$main/target/$dir" "target/$dir.partial"; then
    rm -rf "target/$dir.partial"
    echo "scripts/warm-worktree: could not reflink $main/target/$dir" >&2
    exit 1
  fi
  mv "target/$dir.partial" "target/$dir"
  # target/fast is the fast profile of target/; scripts/check builds
  # target/check-combinations/fast.
  target_dir=target
  [[ "$dir" == fast ]] || target_dir=target/$dir
  cargo clean --profile fast --target-dir "$target_dir" "${local_crates[@]}"
  echo "$dir: copied from $main"
done
