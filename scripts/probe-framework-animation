#!/usr/bin/env python3
"""Capture changing content on Talk's private display; this does not measure FPS."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import signal
import subprocess
import tempfile
import time
import uuid


root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--candidate', required=True)
parser.add_argument('--output', required=True, type=Path)
parser.add_argument('--start-after', type=float, default=3,
    help='Seconds after launch before the first snapshot; allow for cold WebView startup')
parser.add_argument('--crop', default='900:650:420:150', help='Content width:height:x:y in corrected screenshot pixels')
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command[1:] if args.command and args.command[0] == '--' else args.command
if not command:
    parser.error('Executable is required after --.')
if args.start_after < 0:
    parser.error('--start-after must be nonnegative.')
if not re.fullmatch(r'[1-9][0-9]*:[1-9][0-9]*:[0-9]+:[0-9]+', args.crop):
    parser.error('--crop requires positive width:height and nonnegative x:y.')

# Reuse the same guard as the input probe. A flag alone cannot admit the desktop.
input_api = runpy.run_path(str(root / 'scripts/framework-input'))
input_api['require_private_display']()
accounting = runpy.run_path(str(root / 'scripts/measure-framework'))
screenshooter = shutil.which('weston-screenshooter')
ffmpeg = shutil.which('ffmpeg')
if not screenshooter or not ffmpeg:
    raise SystemExit('weston-screenshooter and ffmpeg are required.')

args.output = args.output.resolve()
args.output.mkdir(parents=True, exist_ok=True)
token = uuid.uuid4().hex
captures = []


def interrupted(signum, _frame):
    raise SystemExit(128 + signum)


for signum in (signal.SIGTERM, signal.SIGINT):
    signal.signal(signum, interrupted)

with (args.output / 'app.log').open('wb') as log:
    started = time.monotonic()
    process = subprocess.Popen(command, env=dict(os.environ, TALK_FRAMEWORK_RUN_ID=token),
        stdout=log, stderr=log, start_new_session=True)
    try:
        for index in range(3):
            target = started + args.start_after + index * .71
            time.sleep(max(0, target - time.monotonic()))
            if process.poll() is not None:
                raise RuntimeError('Application exited; inspect app.log')
            capture_started = time.monotonic()
            name = f'frame-{index}.png'
            corrected = args.output / name
            with tempfile.TemporaryDirectory(prefix='talk-animation-shot-') as temporary:
                subprocess.run([screenshooter], env=dict(os.environ, XDG_PICTURES_DIR=temporary),
                    check=True, timeout=10, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                images = list(Path(temporary).glob('*.png'))
                if len(images) != 1:
                    raise RuntimeError('Expected exactly one private-display screenshot')
                subprocess.run([ffmpeg, '-hide_banner', '-loglevel', 'error', '-y',
                    '-i', str(images[0]), '-vf', 'vflip', str(corrected)],
                    check=True, timeout=10)
            pixels = subprocess.check_output([ffmpeg, '-hide_banner', '-loglevel', 'error',
                '-i', str(corrected), '-vf', 'crop=' + args.crop + ',format=rgba',
                '-frames:v', '1', '-f', 'rawvideo', '-pix_fmt', 'rgba', 'pipe:1'], timeout=10)
            width, height, _, _ = map(int, args.crop.split(':'))
            if len(pixels) != width * height * 4:
                raise RuntimeError('Crop did not yield the requested RGBA dimensions')
            captures.append({'index': index, 'scheduled_seconds': args.start_after + index * .71,
                'capture_started_seconds': capture_started - started, 'screenshot': name,
                'crop_rgba_sha256': hashlib.sha256(pixels).hexdigest()})
        distinct = len({capture['crop_rgba_sha256'] for capture in captures})
        report = {'candidate': args.candidate, 'command': command,
            'first_capture_seconds': args.start_after,
            'scenario': os.environ.get('TALK_FRAMEWORK_SCENARIO', 'chat'),
            'crop': args.crop, 'captures': captures, 'distinct_content_hashes': distinct,
            'distinct_content_observed': distinct > 1, 'visual_review_required': True,
            'fps_measured': False,
            'validation': 'Distinct content requires visual review: changing labels or controls can change a hash even when video is frozen. These snapshots do not measure FPS or prove smooth playback.',
            'screenshot_transform': 'vflip corrects NVIDIA/Weston headless capture orientation.',
            'display': {'wayland': os.environ.get('WAYLAND_DISPLAY'),
                'compositor_log': os.environ.get('TALK_FRAMEWORK_COMPOSITOR_LOG')}}
        (args.output / 'animation.json').write_text(json.dumps(report, indent=2))
        print(json.dumps({'candidate': args.candidate, 'distinct_content_hashes': distinct,
            'visual_review_required': True, 'fps_measured': False}), flush=True)
    finally:
        for signum in (signal.SIGTERM, signal.SIGINT):
            signal.signal(signum, signal.SIG_IGN)
        for pid in accounting['members'](process.pid, token, accounting['process_table']()):
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            pass
        for pid in accounting['members'](process.pid, token, accounting['process_table']()):
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        if process.poll() is None:
            process.wait(timeout=5)
