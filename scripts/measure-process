#!/usr/bin/env python3
"""Sample one Linux process. CPU percentages use one core as 100 percent."""

import argparse
import json
import os
from pathlib import Path
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("pid", type=int)
parser.add_argument("--seconds", type=int, default=30)
args = parser.parse_args()
if args.pid < 1 or args.seconds < 1:
    parser.error("PID and duration must be positive")
process = Path("/proc") / str(args.pid)


def ticks():
    fields = (process / "stat").read_text().rsplit(")", 1)[1].split()
    return int(fields[11]) + int(fields[12])


def memory():
    result = {}
    for line in (process / "smaps_rollup").read_text().splitlines():
        key, _, value = line.partition(":")
        if key in ("Rss", "Pss"):
            result[key.lower()] = int(value.split()[0]) / 1024
    return result


def gpu_counters():
    clients = {}
    for path in (process / "fdinfo").iterdir():
        try:
            values = dict(line.split(":", 1) for line in path.read_text().splitlines() if ":" in line)
        except (OSError, ValueError):
            continue
        client = values.get("drm-client-id")
        if client is None:
            continue
        key = (values.get("drm-pdev", ""), client)
        clients[key] = {
            k: int(v.split()[0])
            for k, v in values.items()
            if k.startswith("drm-engine-") and v.strip().endswith(" ns")
        }
    result = {}
    for client in clients.values():
        for engine, nanoseconds in client.items():
            result[engine] = result.get(engine, 0) + nanoseconds
    return result


started = time.monotonic()
start_ticks = ticks()
start_gpu = gpu_counters()
samples = [memory()]
for _ in range(args.seconds):
    time.sleep(1)
    samples.append(memory())
end_ticks = ticks()
end_gpu = gpu_counters()
elapsed = time.monotonic() - started
gpu = {
    engine: (end_gpu[engine] - value) / (elapsed * 1e9) * 100
    for engine, value in start_gpu.items()
    if engine in end_gpu
}
print(json.dumps({
    "pid": args.pid,
    "duration_seconds": round(elapsed, 3),
    "cpu_percent_one_core": round((end_ticks - start_ticks) / os.sysconf("SC_CLK_TCK") / elapsed * 100, 3),
    "rss_mib_mean": round(sum(sample["rss"] for sample in samples) / len(samples), 3),
    "rss_mib_peak": round(max(sample["rss"] for sample in samples), 3),
    "pss_mib_mean": round(sum(sample["pss"] for sample in samples) / len(samples), 3),
    "gpu_engine_percent": {engine: round(value, 3) for engine, value in gpu.items()},
    "gpu_measurement": "DRM per-process engine counters" if gpu else "Counters unavailable; GPU utilization not measured",
}, indent=2))
