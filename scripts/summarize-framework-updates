#!/usr/bin/env python3
"""Summarize owned Wayland surface submissions after the private compositor exits."""
import argparse
import json
from pathlib import Path
import statistics

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('report', type=Path)
parser.add_argument('surface_log', type=Path)
args = parser.parse_args()
report = json.loads(args.report.read_text())
start = report['started_monotonic_ns'] + int(report['warmup_seconds'] * 1_000_000_000)
end = start + int(report['measurement_seconds'] * 1_000_000_000)
owned = {member['pid'] for member in report['membership']}
groups = {}
for line in args.surface_log.read_text().splitlines():
    event = json.loads(line)
    if event['pid'] not in owned or not start <= event['monotonic_ns'] < end:
        continue
    key = (event['pid'], event['surface_id'])
    groups.setdefault(key, []).append(event)
surfaces = []
for (pid, identifier), events in sorted(groups.items()):
    updates = [event for event in events if event['new_buffer'] or event['damaged']]
    gaps = [(right['monotonic_ns'] - left['monotonic_ns']) / 1_000_000
        for left, right in zip(updates, updates[1:])]
    surfaces.append({'pid': pid, 'surface_id': identifier,
        'main_surface_id': events[-1]['main_surface_id'],
        'max_current_width': max(event['width_current'] for event in events),
        'max_current_height': max(event['height_current'] for event in events),
        'commits': len(events), 'buffer_or_damage_submissions': len(updates),
        'submissions_per_second': len(updates) / report['measurement_seconds'],
        'submission_gap_ms_median': statistics.median(gaps) if gaps else None,
        'submission_gap_ms_peak': max(gaps) if gaps else None})
report['wayland_updates'] = {'raw_log': args.surface_log.name,
    'window_start_monotonic_ns': start, 'window_end_monotonic_ns': end,
    'surfaces': surfaces, 'presented_fps_measured': False,
    'limits': 'Client buffer/damage submissions can be coalesced, unchanged, hidden or superseded. Separate surfaces must not be summed as FPS. Headless completion is timer-driven; physical presentation and unique video frame rate are not measured.'}
args.report.write_text(json.dumps(report, indent=2) + '\n')
print(json.dumps({'configuration': report['configuration'], 'wayland_updates': report['wayland_updates']}, indent=2))
