#!/usr/bin/env python3
"""Run the Windows SDK HLSL compiler for GPUI's Linux cross-build."""
import os
from pathlib import Path
import subprocess
import sys


def windows_path(value):
    # Wine's default Z: drive maps the host filesystem.
    return "Z:" + str(Path(value).resolve()).replace("/", "\\")


args = sys.argv[1:]
for index, argument in enumerate(args[:-1]):
    if argument in ("/Fh", "/Fo", "/I"):
        args[index + 1] = windows_path(args[index + 1])
args[-1] = windows_path(args[-1])
environment = os.environ.copy()
environment["WINEPREFIX"] = os.environ["YAPFAST_FXC_WINEPREFIX"]
environment["WINEDEBUG"] = "-all"
environment["WINEDLLOVERRIDES"] = "d3dcompiler_47=n"
result = subprocess.run(["wine", os.environ["YAPFAST_FXC_EXE"], *args], env=environment, timeout=60)
sys.exit(result.returncode)
