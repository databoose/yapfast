#!/usr/bin/env python3
"""Run a trial on a private Weston headless GPU display, never the user's desktop."""
import argparse
import os
from pathlib import Path
import shutil
import signal
import subprocess
import tempfile
import time
import uuid


def interrupted(signum, _frame):
    raise SystemExit(128 + signum)


for signum in (signal.SIGTERM, signal.SIGINT):
    signal.signal(signum, interrupted)


parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--weston', default=shutil.which('weston'))
parser.add_argument('--compositor-log', required=True, type=Path)
parser.add_argument('--seat-plugin', type=Path, default=Path(__file__).resolve().parent.parent / '.local/framework-weston-seat.so')
parser.add_argument('--gtk-dpi-module', type=Path, default=Path(__file__).resolve().parent.parent / '.local/framework-gtk-dpi.so')
parser.add_argument('--audio', action='store_true', help='Private PulseAudio with virtual devices only')
parser.add_argument('--alsa-plugins', type=Path, help='Directory containing the ALSA PulseAudio plugin')
parser.add_argument('command', nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command[1:] if args.command and args.command[0] == '--' else args.command
if not args.weston or not command:
    parser.error('Weston and an executable command are required.')
args.compositor_log.parent.mkdir(parents=True, exist_ok=True)
args.compositor_log = args.compositor_log.resolve()
if not args.seat_plugin.exists():
    subprocess.run([str(Path(__file__).with_name('build-framework-seat')), str(args.seat_plugin)], check=True, timeout=35)
if not args.gtk_dpi_module.exists():
    subprocess.run([str(Path(__file__).with_name('build-framework-gtk-dpi')), str(args.gtk_dpi_module)], check=True, timeout=35)
with tempfile.TemporaryDirectory(prefix='talk-framework-display-') as temporary:
    runtime = Path(temporary)
    runtime.chmod(0o700)
    configuration = runtime / 'config'
    (configuration / 'gtk-3.0').mkdir(parents=True)
    (configuration / 'gtk-3.0/settings.ini').write_text('[Settings]\ngtk-xft-dpi=98304\ngtk-application-prefer-dark-theme=1\n')
    run_token = uuid.uuid4().hex
    environment = dict(os.environ, XDG_RUNTIME_DIR=str(runtime), WAYLAND_DISPLAY='wayland-talk-frameworks',
        XDG_SESSION_TYPE='wayland', XDG_CURRENT_DESKTOP='Weston', GDK_BACKEND='wayland',
        XDG_CONFIG_HOME=str(configuration), XDG_CACHE_HOME=str(runtime / 'cache'),
        GDK_SCALE='1', GDK_DPI_SCALE='1',
        GTK_MODULES=str(args.gtk_dpi_module.resolve()),
        WINIT_UNIX_BACKEND='wayland', TALK_FRAMEWORK_ISOLATED_DISPLAY='1',
        TALK_FRAMEWORK_COMPOSITOR_LOG=str(args.compositor_log), TALK_FRAMEWORK_DISPLAY_RUN_ID=run_token)
    # Remove all inherited access to the desktop, including its private bus.
    for variable in ('DISPLAY', 'DBUS_SESSION_BUS_ADDRESS', 'HYPRLAND_INSTANCE_SIGNATURE', 'SWAYSOCK'):
        environment.pop(variable, None)
    compositor = subprocess.Popen([args.weston, '--backend=headless', '--renderer=gl',
        '--width=1600', '--height=1000', '--refresh-rate=60000', '--socket=wayland-talk-frameworks',
        '--no-config', '--idle-time=0', '--debug', '--modules=' + str(args.seat_plugin.resolve()), '--log=' + str(args.compositor_log)],
        env=environment, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    audio = None
    session = None
    try:
        deadline = time.monotonic() + 15
        while not (runtime / 'wayland-talk-frameworks').exists():
            if compositor.poll() is not None or time.monotonic() > deadline:
                raise SystemExit('Private compositor failed; see ' + str(args.compositor_log))
            time.sleep(.1)
        time.sleep(.3)
        if args.audio:
            if not args.alsa_plugins or not (args.alsa_plugins / 'libasound_module_pcm_pulse.so').exists():
                raise SystemExit('--audio requires --alsa-plugins with the PulseAudio PCM plugin')
            audio_socket = runtime / 'audio.sock'
            environment.update(PULSE_SERVER='unix:' + str(audio_socket), PULSE_SINK='talk_frameworks',
                PULSE_SOURCE='talk_frameworks.monitor', ALSA_PLUGIN_DIR=str(args.alsa_plugins))
            alsa = runtime / 'alsa.conf'
            alsa.write_text('pcm.!default { type pulse server "unix:' + str(audio_socket) + '" }\n')
            environment['ALSA_CONFIG_PATH'] = str(alsa)
            audio_log = args.compositor_log.with_suffix('.audio.log')
            audio = subprocess.Popen(['pulseaudio', '-n', '--daemonize=no', '--use-pid-file=no',
                '--exit-idle-time=-1', '--disable-shm=yes', '--log-target=file:' + str(audio_log),
                '--load=module-native-protocol-unix socket=' + str(audio_socket) + ' auth-anonymous=1',
                '--load=module-null-sink sink_name=talk_frameworks rate=48000'], env=environment,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            deadline = time.monotonic() + 5
            while not audio_socket.exists():
                if audio.poll() is not None or time.monotonic() > deadline:
                    raise SystemExit('Private audio failed; see ' + str(audio_log))
                time.sleep(.1)
        # Toolkits can require D-Bus. Give them a private session bus too.
        session = subprocess.Popen(['dbus-run-session', '--', *command], env=environment, start_new_session=True)
        raise SystemExit(session.wait())
    finally:
        for signum in (signal.SIGTERM, signal.SIGINT):
            signal.signal(signum, signal.SIG_IGN)
        for service in (session, audio, compositor):
            if service is not None:
                try:
                    os.killpg(service.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                try:
                    service.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(service.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    service.wait(timeout=5)
        # Catch reparented helpers or an app whose collector was killed. Every
        # owned child inherits this display's unique marker; no host app does.
        marker = b'TALK_FRAMEWORK_DISPLAY_RUN_ID=' + run_token.encode() + b'\0'
        for directory in Path('/proc').iterdir():
            if directory.name.isdecimal():
                try:
                    if marker in (directory / 'environ').read_bytes():
                        os.kill(int(directory.name), signal.SIGKILL)
                except (OSError, ProcessLookupError):
                    pass
