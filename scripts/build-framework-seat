#!/usr/bin/env python3
"""Build the test-only virtual input seat against the pinned comparison shell."""
from pathlib import Path
import shlex
import subprocess
import sys
root = Path(__file__).resolve().parent.parent
output = Path(sys.argv[1]) if len(sys.argv) > 1 else root / '.local/framework-weston-seat.so'
output.parent.mkdir(parents=True, exist_ok=True)
flags = shlex.split(subprocess.check_output(['pkg-config', '--cflags', '--libs', 'libweston-14', 'wayland-server', 'pixman-1', 'xkbcommon'], text=True))
subprocess.run(['cc', '-shared', '-fPIC', '-O2', '-Wall', '-Wextra', '-Werror', str(root / 'experiments/frameworks/display/seat.c'), '-o', str(output), *flags], check=True, timeout=30)
print(output.resolve())
